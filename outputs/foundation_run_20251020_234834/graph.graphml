      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">They had joined in the vote of confidence</data>
    </edge>
    <edge source="Sef Sermak" target="annexation of the Four Kingdoms" id="0">
      <data key="d12">WANTS</data>
      <data key="d13">0.9</data>
      <data key="d14">Sermak will be free to start all over. He wants outright annexation of the Four Kingdoms</data>
    </edge>
