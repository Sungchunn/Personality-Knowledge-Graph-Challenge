      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">our little Foundation, our single world</data>
    </edge>
    <edge source="Galactic Empire" target="The Foundation" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">I began the story of that interregnum and called it "Foundation." In it, I described how the psychohistorian, Hari Seldon, established a pair of Foundations at opposite ends of the Universe under such circumstances as to make sure that the forces of history would bring about the second Empire after one thousand years instead of the thirty thousand that would be required otherwise.</data>
    </edge>
    <edge source="Galactic Empire" target="EVENT" id="0">
      <data key="d12">DYING</data>
      <data key="d13">0.9</data>
      <data key="d14">"the Galactic Empire is dying!"</data>
    </edge>
    <edge source="Galactic Empire" target="Periphery" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Since the Galactic Empire abandoned the Periphery</data>
    </edge>
    <edge source="Galactic Empire" target="Fall" id="0">
      <data key="d12">EVENT</data>
      <data key="d13">0.9</data>
