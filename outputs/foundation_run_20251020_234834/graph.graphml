      <data key="d12">LEADS</data>
      <data key="d13">0.9</data>
      <data key="d14">Dr. Seldon has directed me to represent you</data>
    </edge>
    <edge source="Hari Seldon" target="psychohistory" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Dr. Seldon can predict the history of Trantor three hundred years into the future</data>
    </edge>
    <edge source="Hari Seldon" target="you" id="0">
      <data key="d12">VISITED</data>
      <data key="d13">0.9</data>
      <data key="d14">Dr. Seldon visited you yesterday for the purpose of forcing their hand.</data>
    </edge>
    <edge source="Hari Seldon" target="himself" id="0">
      <data key="d12">ARRESTED</data>
      <data key="d13">0.9</data>
      <data key="d14">Dr. Seldon is himself arrested.</data>
