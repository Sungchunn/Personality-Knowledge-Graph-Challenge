      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">the Chancellor of the Empire complains that nuclear technicians are scarce.</data>
    </edge>
    <edge source="Bor Alurin" target="Foundation series" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Why was it that among the original population of the Foundation not one first-class psychologist was included, except Bor Alurin?</data>
    </edge>
    <edge source="Yohan Lee" target="Foundation series" id="0">
      <data key="d12">MENTIONED_IN</data>
