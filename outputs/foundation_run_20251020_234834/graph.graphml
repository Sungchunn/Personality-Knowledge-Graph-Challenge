      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">All my project; my thirty thousand men with their wives and children, are devoting themselves to the preparation of an "Encyclopedia Galactica."</data>
    </edge>
