    </edge>
    <edge source="Hardin" target="Terminus" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">Hardin had been the leading spirit in the drive to incorporate Terminus into an autonomous municipality-he had been elected its first mayor</data>
