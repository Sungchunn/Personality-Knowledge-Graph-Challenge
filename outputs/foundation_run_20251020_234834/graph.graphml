    <edge source="Hardin" target="Haut Rodric" id="0">
      <data key="d12">FRIENDS_WITH</data>
      <data key="d13">0.8</data>
      <data key="d14">Friendship and good will were thus established, and if Hardin noted the barest bulge at Haut Rodric's shoulder, he prudently said nothing.</data>
    </edge>
    <edge source="Hardin" target="Encyclopedia" id="0">
      <data key="d12">WORKS_FOR</data>
