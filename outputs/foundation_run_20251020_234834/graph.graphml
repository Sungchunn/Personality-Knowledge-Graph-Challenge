    </edge>
    <edge source="Galactic Empire" target="Galaxy" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Within that rim there is still what is left of the Galactic Empire</data>
    </edge>
    <edge source="Hari Seldon" target="Foundations" id="0">
      <data key="d12">CREATED</data>
      <data key="d13">0.9</data>
