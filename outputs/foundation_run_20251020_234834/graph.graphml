    <edge source="Royal Governor of the Prefect of Anacreon" target="king" id="0">
      <data key="d12">ASSUMED_TITLE</data>
      <data key="d13">0.9</data>
      <data key="d14">The Royal Governor of the Prefect of Anacreon has assumed the title of king.</data>
    </edge>
    <edge source="king" target="priesthood" id="0">
      <data key="d12">LEADS</data>
      <data key="d13">0.9</data>
      <data key="d14">The priesthood forms a hierarchy at the apex of which is the king, who is regarded as a sort of minor god.</data>
    </edge>
    <edge source="king" target="people" id="0">
      <data key="d12">LEADS</data>
      <data key="d13">0.9</data>
      <data key="d14">He's an absolute monarch by divine right, and the people believe it, thoroughly, and the priests, too.</data>
    </edge>
    <edge source="Terminus City ultrawave set" target="news" id="0">
      <data key="d12">RECEIVED</data>
      <data key="d13">0.9</data>
