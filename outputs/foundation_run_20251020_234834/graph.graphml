      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">The Four Kingdoms were more our enemies than ever</data>
    </edge>
    <edge source="Four Kingdoms" target="Foundation Convention" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">Since the Four Kingdoms accepted the Foundation Convention</data>
    </edge>
