    <edge source="Hari Seldon" target="Vault" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">you said – stop me when I make a mistake – that Hari Seldon was the greatest psychologist in the System; that, hence, he could foresee the right and uncomfortable spot we're in now; that, hence, he established the Vault as a method of telling us the way out.</data>
    </edge>
    <edge source="Hari Seldon" target="Vault" id="1">
      <data key="d12">CREATED</data>
      <data key="d13">0.9</data>
