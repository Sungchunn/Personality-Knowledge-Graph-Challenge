    </edge>
    <edge source="Anacreon" target="king" id="0">
      <data key="d12">LEADS</data>
      <data key="d13">0.9</data>
      <data key="d14">their king received a joint ultimatum</data>
    </edge>
    <edge source="Anacreon" target="three neighbors" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.8</data>
