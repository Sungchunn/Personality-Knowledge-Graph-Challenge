n-1-asimov-isaac-foundation-libgen-li_78", "foundation-1-asimov-isaac-foundation-libgen-li_81", "foundation-1-asimov-isaac-foundation-libgen-li_85", "foundation-1-asimov-isaac-foundation-libgen-li_86", "foundation-1-asimov-isaac-foundation-libgen-li_89", "foundation-1-asimov-isaac-foundation-libgen-li_90", "foundation-1-asimov-isaac-foundation-libgen-li_92", "foundation-1-asimov-isaac-foundation-libgen-li_93", "foundation-1-asimov-isaac-foundation-libgen-li_96", "foundation-1-asimov-isaac-foundation-libgen-li_101", "foundation-1-asimov-isaac-foundation-libgen-li_103", "foundation-1-asimov-isaac-foundation-libgen-li_105", "foundation-1-asimov-isaac-foundation-libgen-li_106", "foundation-1-asimov-isaac-foundation-libgen-li_107", "foundation-1-asimov-isaac-foundation-libgen-li_108", "foundation-1-asimov-isaac-foundation-libgen-li_109", "foundation-1-asimov-isaac-foundation-libgen-li_110", "foundation-1-asimov-isaac-foundation-libgen-li_111", "foundation-1-asimov-isaac-foundation-libgen-li_113", "foundation-1-asimov-isaac-foundation-libgen-li_114", "foundation-1-asimov-isaac-foundation-libgen-li_115", "foundation-1-asimov-isaac-foundation-libgen-li_116", "foundation-1-asimov-isaac-foundation-libgen-li_117", "foundation-1-asimov-isaac-foundation-libgen-li_119", "foundation-1-asimov-isaac-foundation-libgen-li_121", "foundation-1-asimov-isaac-foundation-libgen-li_125", "foundation-1-asimov-isaac-foundation-libgen-li_131", "foundation-1-asimov-isaac-foundation-libgen-li_132", "foundation-1-asimov-isaac-foundation-libgen-li_133", "foundation-1-asimov-isaac-foundation-libgen-li_134", "foundation-1-asimov-isaac-foundation-libgen-li_135", "foundation-1-asimov-isaac-foundation-libgen-li_136", "foundation-1-asimov-isaac-foundation-libgen-li_139", "foundation-1-asimov-isaac-foundation-libgen-li_140", "foundation-1-asimov-isaac-foundation-libgen-li_141", "foundation-1-asimov-isaac-foundation-libgen-li_144", "foundation-1-asimov-isaac-foundation-libgen-li_147", "foundation-1-asimov-isaac-foundation-libgen-li_148", "foundation-1-asimov-isaac-foundation-libgen-li_152", "foundation-1-asimov-isaac-foundation-libgen-li_156", "foundation-1-asimov-isaac-foundation-libgen-li_159", "foundation-1-asimov-isaac-foundation-libgen-li_160", "foundation-1-asimov-isaac-foundation-libgen-li_161", "foundation-1-asimov-isaac-foundation-libgen-li_162", "foundation-1-asimov-isaac-foundation-libgen-li_163", "foundation-1-asimov-isaac-foundation-libgen-li_164"]}
{"person_name": "Outlanders", "traits": [{"trait_name": "openness", "score": 0.6, "confidence": 0.8, "evidence_spans": [{"text": "You're a Smyrnian. You know the Outlanders. Also, you're a trader and one of the best. You've been to Korell and you know the Korellians.", "start": 646, "end": 754}, {"text": "You ran the meeting. You had those red-necked oxen planted in their seats, then put them in your shirtpocket and walked off with them.", "start": 1465, "end": 1570}]}, {"trait_name": "conscientiousness", "score": 0.5, "confidence": 0.7, "evidence_spans": [{"text": "Mallow breathed deeply, \"As a spy?\" \"Not at all. As a trader – but with your eyes open.", "start": 755, "end": 825}, {"text": "Mallow lounged back in his chair and stared at his thick fingers, \"Uh-uh. Sorry, Twer. I'm leaving next week on business.", "start": 1780, "end": 1850}]}, {"trait_name": "extraversion", "score": 0.7, "confidence": 0.8, "evidence_spans": [{"text": "You ran the meeting. You had those red-necked oxen planted in their seats, then put them in your shirtpocket and walked off with them.", "start": 1465, "end": 1570}, {"text": "And you're all right with the Foundation masses, too. You've got glamor – or, at any rate, solid adventure-publicity, which is the same thing.", "start": 1571, "end": 1650}]}], "source_passage_ids": ["foundation-1-asimov-isaac-foundation-libgen-li_180", "foundation-1-asimov-isaac-foundation-libgen-li_183", "foundation-1-asimov-isaac-foundation-libgen-li_185"]}
{"person_name": "Haut Rodric", "traits": [{"trait_name": "openness", "score": 0.3, "confidence": 0.7, "evidence_spans": [{"text": "Sub-prefect Anselm received the cheers with the complaisant indifference of a soldier and a nobleman.", "start": 276, "end": 353}, {"text": "This is all very interesting,\" he said, \"but it seems a strange occupation for grown men.", "start": 1085, "end": 1155}]}, {"trait_name": "extraversion", "score": 0.6, "confidence": 0.7, "evidence_spans": [{"text": "Haut Rodric monopolized the conversation by describing – in minute technical detail and with incredible zest – his own exploits as battalion head during the recent war.", "start": 1230, "end": 1360}, {"text": "The sub-prefect seemed quite ready to stop fencing in favor of more direct statements.", "start": 1920, "end": 1980}]}, {"trait_name": "agreeableness", "score": 0.4, "confidence": 0.7, "evidence_spans": [{"text": "Haut Rodric's eyebrows lifted. \"And your leader – the man I am to meet?\"", "start": 800, "end": 860}, {"text": "Science be damned!\" swore the other. \"What the devil has that got to do with the fact that we're liable to see Terminus taken over by Smyrno at any time?", "start": 1680, "end": 1780}]}], "source_passage_ids": ["foundation-1-asimov-isaac-foundation-libgen-li_51", "foundation-1-asimov-isaac-foundation-libgen-li_52", "foundation-1-asimov-isaac-foundation-libgen-li_53", "foundation-1-asimov-isaac-foundation-libgen-li_54", "foundation-1-asimov-isaac-foundation-libgen-li_55", "foundation-1-asimov-isaac-foundation-libgen-li_56", "foundation-1-asimov-isaac-foundation-libgen-li_57", "foundation-1-asimov-isaac-foundation-libgen-li_58", "foundation-1-asimov-isaac-foundation-libgen-li_59", "foundation-1-asimov-isaac-foundation-libgen-li_77", "foundation-1-asimov-isaac-foundation-libgen-li_88", "foundation-1-asimov-isaac-foundation-libgen-li_89"]}
