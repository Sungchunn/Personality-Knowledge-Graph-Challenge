    <edge source="Mule" target="November and December 1945 issues" id="0">
      <data key="d2">MENTIONED_IN</data>
      <data key="d3">0.9</data>
      <data key="d4">"The Mule," my personal favorite among the Foundation stories, and the longest yet, for it was 50,000 words. It was printed as a two-part serial (the very first serial I was ever responsible for) in the November and December 1945 issues</data>
    </edge>
    <edge source="Mule" target="First Foundation" id="0">
      <data key="d2">ENEMY_OF</data>
      <data key="d3">0.9</data>
      <data key="d4">Before him, the First Foundation fell and Seldon’s schemes lay partly in ruins.</data>
    </edge>
    <edge source="Mule" target="Search for the Second Foundation" id="0">
      <data key="d2">PARTICIPATES_IN</data>
      <data key="d3">0.9</data>
      <data key="d4">The Mule must find it to make his conquest of the Galaxy complete.</data>
    </edge>
    <edge source="Mule" target="Union of Worlds" id="0">
      <data key="d2">LEADS</data>
      <data key="d3">0.9</data>
      <data key="d4">it was he who first presented history with a unified volume at space truly imperial in scope.</data>
    </edge>
    <edge source="Mule" target="Union" id="0">
      <data key="d2">LEADS</data>
      <data key="d3">0.9</data>
      <data key="d4">the Mule rose from nothing to vast dominion in five years</data>
