    <edge source="Lady Jessica" target="Paul" id="0">
      <data key="d2">FAMILY_OF</data>
      <data key="d3">0.9</data>
      <data key="d4">Jessica's hand went to Paul's shoulder, tightened there.</data>
    </edge>
    <edge source="Lady Jessica" target="Gaius Helen Mohiam" id="0">
      <data key="d2">ENEMY_OF</data>
      <data key="d3">0.7</data>
