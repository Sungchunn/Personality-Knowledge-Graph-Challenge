      <data key="d2">FAMILY_OF</data>
      <data key="d3">0.9</data>
      <data key="d4">"Remember that you're a duke's son," Jessica said.</data>
    </edge>
    <edge source="The old woman" target="Lady Jessica" id="0">
      <data key="d2">KNOWS</data>
      <data key="d3">0.9</data>
