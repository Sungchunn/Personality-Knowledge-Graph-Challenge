      <data key="d2">PARTICIPATES_IN</data>
      <data key="d3">0.9</data>
      <data key="d4">Your mother survived this test. Now it's your turn.</data>
    </edge>
    <edge source="Paul" target="gom jabbar" id="0">
      <data key="d2">PARTICIPATES_IN</data>
      <data key="d3">0.9</data>
      <data key="d4">trapped by that hand at his neck: the gom jabbar.</data>
    </edge>
    <edge source="Paul" target="Litany against Fear" id="0">
      <data key="d2">MENTIONED_IN</data>
      <data key="d3">0.9</data>
      <data key="d4">the Litany against Fear as his mother had taught him</data>
    </edge>
    <edge source="Paul" target="The old woman" id="0">
      <data key="d2">ENEMY_OF</data>
      <data key="d3">0.7</data>
      <data key="d4">He felt calmness return, said: "Get on with it, old woman."</data>
    </edge>
    <edge source="Paul" target="event with the old woman and the box" id="0">
      <data key="d2">PARTICIPATES_IN</data>
      <data key="d3">0.9</data>
      <data key="d4">He jerked his hand from the box, stared at it astonished.</data>
    </edge>
    <edge source="Paul" target="event with the old woman and the box" id="1">
      <data key="d2">MENTIONED_IN</data>
      <data key="d3">0.9</data>
      <data key="d4">Paul felt his right arm trembling, felt sweat bathing his body.</data>
    </edge>
    <edge source="Lady Jessica" target="House Atreides" id="0">
      <data key="d2">MEMBER_OF</data>
      <data key="d3">0.9</data>
      <data key="d4">Paul's mother answered in her soft contralto: "The Atreides are known to start late getting their growth, Your Reverence."</data>
    </edge>
    <edge source="Lady Jessica" target="Bene Gesserit" id="0">
      <data key="d2">MEMBER_OF</data>
      <data key="d3">0.9</data>
