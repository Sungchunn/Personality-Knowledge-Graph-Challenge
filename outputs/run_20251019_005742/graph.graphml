      <data key="d2">MENTIONED_IN</data>
      <data key="d3">0.9</data>
      <data key="d4">The epic days of Hardin and Mallow had gone and with them were gone a certain hard daring and resolution.... ENCYCLOPEDIA GALACTICA</data>
    </edge>
    <edge source="Salvor Hardin" target="ENCYCLOPEDIA GALACTICA" id="0">
      <data key="d2">MENTIONED_IN</data>
