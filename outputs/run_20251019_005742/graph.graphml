    <edge source="Sennett Forell" target="Hober Mallow" id="0">
      <data key="d2">FAMILY_OF</data>
      <data key="d3">0.9</data>
      <data key="d4">That Forell was a distant collateral relative of the late great Hober Mallow was recognized openly throughout the Foundation.</data>
    </edge>
    <edge source="Sennett Forell" target="Trade Fleet" id="0">
      <data key="d2">OWNS</data>
      <data key="d3">0.9</data>
      <data key="d4">I don’t suppose you forget that it was my own Trade Fleet that captured this scout ship of theirs.</data>
    </edge>
    <edge source="Sennett Forell" target="Trade Fleet" id="1">
      <data key="d2">LEADS</data>
      <data key="d3">0.8</data>
      <data key="d4">I don’t suppose you forget that it was my own Trade Fleet that captured this scout ship of theirs.</data>
    </edge>
