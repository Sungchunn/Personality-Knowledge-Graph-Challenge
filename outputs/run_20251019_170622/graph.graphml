    <edge source="Muad'Dib" target="Arrakis" id="0">
      <data key="d10">LOCATED_IN</data>
      <data key="d11">0.9</data>
      <data key="d12">Arrakis, the planet known as Dune, is forever his place.</data>
    </edge>
    <edge source="Muad'Dib" target="Caladan" id="0">
      <data key="d10">LOCATED_IN</data>
      <data key="d11">0.9</data>
      <data key="d12">he was born on Caladan and lived his first fifteen years there.</data>
    </edge>
    <edge source="Arrakis" target="Dune" id="0">
      <data key="d10">LOCATED_IN</data>
      <data key="d11">0.9</data>
      <data key="d12">Arrakis -- Dune -- Desert Planet</data>
    </edge>
    <edge source="Paul Atreides" target="Lady Jessica" id="0">
      <data key="d10">FAMILY_OF</data>
      <data key="d11">0.9</data>
      <data key="d12">an old crone came to visit the mother of the boy, Paul.</data>
    </edge>
    <edge source="Paul Atreides" target="Leto Atreides" id="0">
      <data key="d10">FAMILY_OF</data>
      <data key="d11">0.9</data>
      <data key="d12">mother of the ducal heir</data>
    </edge>
    <edge source="Paul Atreides" target="dream" id="0">
      <data key="d10">MENTIONED_IN</data>
      <data key="d11">0.9</data>
      <data key="d12">Paul fell asleep to dream of an Arrakeen cavern</data>
    </edge>
    <edge source="Paul Atreides" target="his mother" id="0">
      <data key="d10">FAMILY_OF</data>
      <data key="d11">0.9</data>
      <data key="d12">The hall door opened and his mother peered in</data>
    </edge>
    <edge source="Paul Atreides" target="House of Atreides" id="0">
      <data key="d10">MEMBER_OF</data>
      <data key="d11">0.9</data>
      <data key="d12">It carried the red Atreides hawk crest above the breast pocket.</data>
    </edge>
    <edge source="Paul Atreides" target="gom jabbar" id="0">
      <data key="d10">PARTICIPATES_IN</data>
      <data key="d11">0.9</data>
      <data key="d12">I hold at your neck the gom jabbar</data>
    </edge>
    <edge source="Paul Atreides" target="duke" id="0">
      <data key="d10">FAMILY_OF</data>
      <data key="d11">0.9</data>
      <data key="d12">you dare suggest a duke's son is an animal?</data>
    </edge>
    <edge source="Paul Atreides" target="test" id="0">
      <data key="d10">PARTICIPATES_IN</data>
      <data key="d11">0.9</data>
      <data key="d12">Your mother survived this test. Now it's your turn.</data>
    </edge>
    <edge source="Paul Atreides" target="Bene Gesserit" id="0">
      <data key="d10">MEMBER_OF</data>
      <data key="d11">0.7</data>
      <data key="d12">as his mother had taught him out of the Bene Gesserit rite.</data>
    </edge>
    <edge source="Paul Atreides" target="event with the old woman and the box" id="0">
      <data key="d10">PARTICIPATES_IN</data>
      <data key="d11">0.9</data>
      <data key="d12">He jerked his hand from the box, stared at it astonished.</data>
    </edge>
    <edge source="Lady Jessica" target="Bene Gesserit" id="0">
      <data key="d10">MEMBER_OF</data>
      <data key="d11">0.9</data>
      <data key="d12">This every sister of the Bene Gesserit knows.</data>
    </edge>
    <edge source="Lady Jessica" target="Leto Atreides" id="0">
      <data key="d10">LOVES</data>
      <data key="d11">0.9</data>
      <data key="d12">a duke's concubine</data>
    </edge>
    <edge source="Lady Jessica" target="Paul Atreides" id="0">
      <data key="d10">FAMILY_OF</data>
      <data key="d11">0.9</data>
      <data key="d12">mother and son approach</data>
    </edge>
    <edge source="Lady Jessica" target="Spacing Guild" id="0">
      <data key="d10">HATES</data>
      <data key="d11">0.7</data>
      <data key="d12">association with that abominable Spacing Guild and its secretive ways</data>
    </edge>
    <edge source="Lady Jessica" target="Gaius Helen Mohiam" id="0">
      <data key="d10">WORKS_FOR</data>
      <data key="d11">0.9</data>
      <data key="d12">The Lady Jessica was my serving wench, lad, for fourteen years at school.</data>
    </edge>
    <edge source="Lady Jessica" target="The Lady Jessica was my serving wench, lad, for fourteen years at school." id="0">
      <data key="d10">MENTIONED_IN</data>
      <data key="d11">0.9</data>
      <data key="d12">The Lady Jessica was my serving wench, lad, for fourteen years at school.</data>
    </edge>
    <edge source="Lady Jessica" target="test" id="0">
      <data key="d10">PARTICIPATES_IN</data>
      <data key="d11">0.9</data>
      <data key="d12">Your mother survived this test.</data>
    </edge>
    <edge source="House of Atreides" target="Caladan" id="0">
      <data key="d10">LOCATED_IN</data>
      <data key="d11">0.9</data>
      <data key="d12">Castle Caladan, and the ancient pile of stone that had served the Atreides family as home for twenty-six generations</data>
    </edge>
    <edge source="House of Atreides" target="Arrakis" id="0">
      <data key="d10">LOCATED_IN</data>
      <data key="d11">0.9</data>
      <data key="d12">Now the Harkonnens were leaving to be replaced by the House of Atreides in fief-complete</data>
    </edge>
    <edge source="House of Atreides" target="Harkonnens" id="0">
      <data key="d10">REPLACES</data>
      <data key="d11">0.9</data>
      <data key="d12">the Harkonnens were leaving to be replaced by the House of Atreides</data>
    </edge>
    <edge source="House of Atreides" target="farmlands" id="0">
      <data key="d10">OWNS</data>
      <data key="d11">0.9</data>
      <data key="d12">the green farmlands of the Atreides family holding</data>
    </edge>
    <edge source="Leto Atreides" target="Great Houses of the Landsraad" id="0">
      <data key="d10">POPULAR_AMONG</data>
      <data key="d11">0.9</data>
      <data key="d12">for the Duke Leto was popular among the Great Houses of the Landsraad</data>
    </edge>
    <edge source="Thufir Hawat" target="Leto Atreides" id="0">
      <data key="d10">WORKS_FOR</data>
      <data key="d11">0.9</data>
      <data key="d12">Thufir Hawat, his father's Master of Assassins</data>
    </edge>
    <edge source="Harkonnens" target="House of Atreides" id="0">
      <data key="d10">ENEMY_OF</data>
      <data key="d11">0.9</data>
      <data key="d12">their mortal enemies, the Harkonnens</data>
    </edge>
    <edge source="Harkonnens" target="Arrakis" id="0">
      <data key="d10">LOCATED_IN</data>
      <data key="d11">0.9</data>
      <data key="d12">the Harkonnens, had been on Arrakis eighty years</data>
    </edge>
    <edge source="Harkonnens" target="Arrakis" id="1">
      <data key="d10">LEAVES</data>
      <data key="d11">0.9</data>
      <data key="d12">the Harkonnens were leaving to be replaced by the House of Atreides</data>
    </edge>
    <edge source="CHOAM" target="Arrakis" id="0">
      <data key="d10">OWNS</data>
      <data key="d11">0.9</data>
      <data key="d12">under a CHOAM Company contract to mine the geriatric spice</data>
    </edge>
    <edge source="Dr. Yueh" target="Paul Atreides" id="0">
      <data key="d10">TEACHES</data>
      <data key="d11">0.9</data>
      <data key="d12">Dr. Yueh, his teacher, had hinted</data>
    </edge>
    <edge source="Fremen" target="Arrakis" id="0">
      <data key="d10">LOCATED_IN</data>
      <data key="d11">0.9</data>
      <data key="d12">the planet sheltered people who lived at the desert edge without caid or bashar to command them: will-o'-the-sand people called Fremen</data>
    </edge>
    <edge source="his mother" target="Bene Gesserit" id="0">
      <data key="d10">MEMBER_OF</data>
      <data key="d11">0.9</data>
      <data key="d12">she had trained him in the Bene Gesserit Way</data>
    </edge>
    <edge source="Gaius Helen Mohiam" target="Shaddam IV" id="0">
      <data key="d10">WORKS_FOR</data>
      <data key="d11">0.9</data>
      <data key="d12">Now, she's the Emperor's Truthsayer.</data>
    </edge>
    <edge source="Gaius Helen Mohiam" target="Paul's dream" id="0">
      <data key="d10">MENTIONED_IN</data>
      <data key="d11">0.9</data>
      <data key="d12">"I dreamed of her once," Paul said.</data>
    </edge>
    <edge source="Gaius Helen Mohiam" target="gom jabbar" id="0">
      <data key="d10">MENTIONED_IN</data>
      <data key="d11">0.8</data>
      <data key="d12">Reverend Mother is waiting in my morning room</data>
    </edge>
    <edge source="Gaius Helen Mohiam" target="Bene Gesserit" id="0">
      <data key="d10">MEMBER_OF</data>
      <data key="d11">0.9</data>
      <data key="d12">a mission that required personal attention from a Bene Gesserit-with-theSight</data>
    </edge>
    <edge source="Gaius Helen Mohiam" target="Lady Jessica" id="0">
      <data key="d10">KNOWS</data>
      <data key="d11">0.9</data>
      <data key="d12">"He's a cautious one, Jessica."</data>
    </edge>
    <edge source="Gaius Helen Mohiam" target="Organization" id="0">
      <data key="d10">WORKS_FOR</data>
      <data key="d11">0.7</data>
      <data key="d12">The Lady Jessica was my serving wench, lad, for fourteen years at school.</data>
    </edge>
    <edge source="old woman" target="gom jabbar" id="0">
      <data key="d10">MENTIONED_IN</data>
      <data key="d11">0.9</data>
      <data key="d12">Withdraw the hand and the gom jabbar takes you.</data>
    </edge>
    <edge source="old woman" target="event with Paul and the box" id="0">
      <data key="d10">MENTIONED_IN</data>
      <data key="d11">0.9</data>
      <data key="d12">The old woman muttered. "Kull wahad! No woman child ever withstood that much.</data>
    </edge>
    <edge source="old woman" target="pain by nerve induction" id="0">
      <data key="d10">CREATED</data>
      <data key="d11">0.9</data>
      <data key="d12">"Pain by nerve induction," she said.</data>
    </edge>
