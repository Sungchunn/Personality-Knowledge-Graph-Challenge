{"person_name": "House of Atreides", "traits": [{"trait_name": "openness", "score": 0.7, "confidence": 0.9, "evidence_spans": [{"text": "There had been so many things to learn. Arrakis would be a place so different from Caladan that Paul's mind whirled with the new knowledge.", "start": 451, "end": 556}, {"text": "Paul sensed his own tensions, decided to practice one of the mind-body lessons his mother had taught him.", "start": 1225, "end": 1305}]}, {"trait_name": "conscientiousness", "score": 0.6, "confidence": 0.7, "evidence_spans": [{"text": "Paul sensed his own tensions, decided to practice one of the mind-body lessons his mother had taught him.", "start": 1225, "end": 1305}, {"text": "The Duke's Mentat, Thufir Hawat, will have concluded rightly that Arrakeen is easier to defend.", "start": 1863, "end": 1930}]}, {"trait_name": "agreeableness", "score": 0.6, "confidence": 0.7, "evidence_spans": [{"text": "\"Freely given, freely accepted,\" Kynes said. He smiled at Jessica, resumed eating as though nothing had happened.", "start": 2430, "end": 2484}, {"text": "Jessica turned to the stillsuit manufacturer on her left, said: \"I find myself continually amazed by the importance of water on Arrakis.\"", "start": 2781, "end": 2865}]}], "source_passage_ids": ["dune-1-herbert-brian-herbert-frank-dune-libgen-li_1", "dune-1-herbert-brian-herbert-frank-dune-libgen-li_2", "dune-1-herbert-brian-herbert-frank-dune-libgen-li_20", "dune-1-herbert-brian-herbert-frank-dune-libgen-li_182"]}
