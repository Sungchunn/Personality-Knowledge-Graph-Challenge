    <edge source="Atreides line" target="Paul" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.8</data>
      <data key="d14">She had brought a regal beauty back into the Atreides line. He was glad that Paul favored her.</data>
    </edge>
    <edge source="Shadout Mapes" target="Fremen" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">they're Fremen all. They'll do until our own people can be released from their other duties.</data>
    </edge>
    <edge source="Shadout Mapes" target="My Lord" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">You may even want to keep the head housekeeper: the Shadout Mapes.</data>
    </edge>
    <edge source="Shadout Mapes" target="strategy conference" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.7</data>
