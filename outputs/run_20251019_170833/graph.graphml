      <data key="d12">HATES</data>
      <data key="d13">0.9</data>
      <data key="d14">Even my Duke's voice doesn't carry that weight of venom when he uses the hated name.</data>
    </edge>
    <edge source="Wellington" target="Wanna" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">You didn't know that my wife, my Wanna . . .</data>
    </edge>
    <edge source="the Duke" target="father" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.8</data>
