      <data key="d12">HATES</data>
      <data key="d13">0.9</data>
      <data key="d14">I wish to kill the Baron.</data>
    </edge>
    <edge source="Yueh" target="Duke" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">"Is this the Duke?" "This is the Duke."</data>
    </edge>
    <edge source="Yueh" target="Duke" id="1">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">"That's how Yueh caught him for us."</data>
    </edge>
    <edge source="Yueh" target="passage" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"You can relax, Yueh," the man said.</data>
    </edge>
