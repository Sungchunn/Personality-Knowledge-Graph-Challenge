    <edge source="Muad'Dib" target="57th year of the Padishah Emperor, Shaddam IV" id="0">
      <data key="d12">BORN_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">born in the 57th year of the Padishah Emperor, Shaddam IV</data>
    </edge>
    <edge source="Muad'Dib" target="Arrakis" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Arrakis, the planet known as Dune, is forever his place</data>
    </edge>
    <edge source="Muad'Dib" target="Arrakis" id="1">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">Many have marked the speed with which Muad'Dib learned the necessities of Arrakis.</data>
    </edge>
    <edge source="Muad'Dib" target="Caladan" id="0">
      <data key="d12">BORN_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">he was born on Caladan</data>
    </edge>
    <edge source="Muad'Dib" target="Harkonnens" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">To attempt an understanding of Muad'Dib without understanding his mortal enemies, the Harkonnens</data>
    </edge>
    <edge source="Muad'Dib" target="The Humanity of Muad'Dib" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">from "The Humanity of Muad'Dib" by the Princess Irulan</data>
    </edge>
    <edge source="Muad'Dib" target="inscription" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">there was an inscription that Muad'Dib was to repeat many times.</data>
    </edge>
    <edge source="Muad'Dib" target="Paul" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.8</data>
      <data key="d14">Muad'Dib rode through the streets of Arrakeen with his family</data>
    </edge>
    <edge source="Muad'Dib" target="EVENT" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">Muad'Dib rode through the streets of Arrakeen</data>
    </edge>
    <edge source="Arrakis" target="Dune" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Arrakis -- Dune -- Desert Planet</data>
    </edge>
    <edge source="Arrakis" target="Empire" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.7</data>
      <data key="d14">"Arrakis! Truly unique. A superb setting for a unique Victory."</data>
    </edge>
    <edge source="Arrakis" target="System" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.7</data>
      <data key="d14">"the Duke has contracted with the Guild to remove him to a place of safety outside the System."</data>
    </edge>
    <edge source="Arrakis" target="Missionaria Protectiva" id="0">
      <data key="d12">LOCATION</data>
      <data key="d13">0.9</data>
      <data key="d14">"The Missionaria Protectiva has been in there and softened it up somewhat."</data>
    </edge>
    <edge source="Arrakis" target="storms" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">I've been studying about the storms on Arrakis.</data>
    </edge>
    <edge source="Arrakis" target="wilderness" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">the wilderness that is empty, the wasteland where nothing lives except the spice and the sandworms</data>
    </edge>
    <edge source="Arrakis" target="LOCATION" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Tomorrow we go to Arrakis.</data>
    </edge>
    <edge source="Arrakis" target="planet" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">The planet seems to have opened its arms to certain terranic life forms.</data>
    </edge>
    <edge source="Arrakis" target="northern latitudes" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"It was taken in the northern latitudes."</data>
    </edge>
    <edge source="Arrakis" target="known universe" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.7</data>
      <data key="d14">The wisdom of seeding the known universe with a prophecy pattern</data>
    </edge>
    <edge source="Arrakis" target="Arrakeen" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">the milky light of the Arrakeen sun</data>
    </edge>
    <edge source="Arrakis" target="universe" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">Arrakis, the one source in the universe of melange</data>
    </edge>
    <edge source="Arrakis" target="Arrakis: His Imperial Majesty's Desert Botanical Testing Station" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">He thought of the filmbook Yueh had shown him--"Arrakis: His Imperial Majesty's Desert Botanical Testing Station."</data>
    </edge>
    <edge source="Arrakis" target="special climate" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">That would make sense on Arrakis where even the driest of off-planet growing things had to be irrigated.</data>
    </edge>
    <edge source="Arrakis" target="sun" id="0">
      <data key="d12">LOCATION</data>
      <data key="d13">0.7</data>
      <data key="d14">the sun of Arrakis was sinking</data>
    </edge>
    <edge source="Arrakis" target="flower fields" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">he saw great puddles of red blooms and, running through them, an articulate tread of violet . . . like giant footsteps.</data>
    </edge>
    <edge source="Arrakis" target="desert" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">Here, we must scrabble for desert power.</data>
    </edge>
    <edge source="Arrakis" target="Eden" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.7</data>
      <data key="d14">Arrakis could be an Eden if its rulers would look up from grubbing for spice!</data>
    </edge>
    <edge source="Arrakis" target="water" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">It came to Jessica that the banker had said: "I, too, control that ultimate source of power on Arrakis--water."</data>
    </edge>
    <edge source="Arrakis" target="EVENT" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">they are here . . . now . . . on Arrakis</data>
    </edge>
    <edge source="Arrakis" target="southern regions" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">almost nothing of the southern regions.</data>
    </edge>
    <edge source="Arrakis" target="home" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Arrakis, that's their home.</data>
    </edge>
    <edge source="Arrakis" target="House Atreides" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">transport the spice for House Atreides</data>
    </edge>
    <edge source="Arrakis" target="Liet" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">We change it . . . slowly but with certainty . . . to make it fit for human life.</data>
    </edge>
    <edge source="Caladan" target="latitudes" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.7</data>
      <data key="d14">It was still early afternoon here, and in these latitudes the sky looked black and cold -- so much darker than the warm blue of Caladan.</data>
    </edge>
    <edge source="Caladan" target="morning skies" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.7</data>
      <data key="d14">as green and clear as the morning skies of Caladan.</data>
    </edge>
    <edge source="Caladan" target="home" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Caladan was their home</data>
    </edge>
    <edge source="Caladan" target="prescient vision" id="0">
      <data key="d12">LOCATION</data>
      <data key="d13">0.9</data>
      <data key="d14">prescient vision he had experienced on Caladan.</data>
    </edge>
    <edge source="Caladan" target="paradise world" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">We came from Caladan--a paradise world for our form of fife.</data>
    </edge>
    <edge source="Paul" target="Jessica" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">the mother of the boy, Paul</data>
    </edge>
    <edge source="Paul" target="Jessica" id="1">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">"My mother's told me."</data>
    </edge>
    <edge source="Paul" target="Jessica" id="2">
      <data key="d12">LEADS</data>
      <data key="d13">0.8</data>
      <data key="d14">He separated us into two parties and arranged that he couldn't reveal where we are if he's captured.</data>
    </edge>
    <edge source="Paul" target="Castle Caladan" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">the side door down the vaulted passage by Paul's room</data>
    </edge>
    <edge source="Paul" target="Duke Leto" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">mother of the ducal heir</data>
    </edge>
    <edge source="Paul" target="dream" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Paul fell asleep to dream of an Arrakeen cavern</data>
    </edge>
    <edge source="Paul" target="dream" id="1">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">I dreamed a cavern . . . and water . . . and a girl there -- very skinny with big eyes.</data>
    </edge>
    <edge source="Paul" target="his mother" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">The hall door opened and his mother peered in</data>
    </edge>
    <edge source="Paul" target="Duke" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">As the Duke's son you'll never want for it</data>
    </edge>
    <edge source="Paul" target="Duke" id="1">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">Paul take the rear seats</data>
    </edge>
    <edge source="Paul" target="Lady Jessica" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">Is this how you obey your mother?</data>
    </edge>
    <edge source="Paul" target="gom jabbar" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">I hold at your neck the gom jabbar</data>
    </edge>
    <edge source="Paul" target="duke" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">you dare suggest a duke's son is an animal?</data>
    </edge>
    <edge source="Paul" target="mother" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">How did you trick my mother into leaving me alone with you?</data>
    </edge>
    <edge source="Paul" target="mother" id="1">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">Paul grabbed his mother's arm</data>
    </edge>
    <edge source="Paul" target="Harkonnens" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">Are you from the Harkonnens?</data>
    </edge>
    <edge source="Paul" target="Harkonnens" id="1">
      <data key="d12">HATES</data>
      <data key="d13">0.9</data>
      <data key="d14">"And I can assure you he hates the Harkonnens as bitterly as we do."</data>
    </edge>
    <edge source="Paul" target="test" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Your mother survived this test. Now it's your turn.</data>
    </edge>
    <edge source="Paul" target="gom jabbar test" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">She leaned back, withdrawing the gom jabbar from the side of his neck.</data>
    </edge>
    <edge source="Paul" target="Butlerian Jihad" id="0">
      <data key="d12">QUOTED</data>
      <data key="d13">0.9</data>
      <data key="d14">Paul quoted. "Right out of the Butlerian Jihad</data>
    </edge>
    <edge source="Paul" target="Orange Catholic Bible" id="0">
      <data key="d12">QUOTED</data>
      <data key="d13">0.9</data>
      <data key="d14">Paul quoted. "Right out of the Butlerian Jihad and the Orange Catholic Bible</data>
    </edge>
    <edge source="Paul" target="Orange Catholic Bible" id="1">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"It's a very old Orange Catholic Bible made for space travelers."</data>
    </edge>
    <edge source="Paul" target="ordeal" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">It was near sunset at Castle Caladan on the day of Paul's ordeal.</data>
    </edge>
    <edge source="Paul" target="dreams" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">"I must ask the other questions about these dreams of his."</data>
    </edge>
    <edge source="Paul" target="Reverend Mother" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">Wariness veiled his eyes when he glanced at the Reverend Mother, but this time he nodded to her, the nod one gives an equal.</data>
    </edge>
    <edge source="Paul" target="Caladan" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">I talk to her and tell her about you, about seeing the Reverend Mother on Caladan.</data>
    </edge>
    <edge source="Paul" target="Caladan" id="1">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">a road as broad as our Central Avenue on Caladan.</data>
    </edge>
    <edge source="Paul" target="poem" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">And I say I'll tell her a poem.</data>
    </edge>
    <edge source="Paul" target="his father" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">You talk as though my father were dead.</data>
    </edge>
    <edge source="Paul" target="Bene Gesserit lesson" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.7</data>
      <data key="d14">When you've learned to accept that as a fact, you've learned a real Bene Gesserit lesson.</data>
    </edge>
    <edge source="Paul" target="ordeal with the Reverend Mother" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">thinking back to the day a week ago and the ordeal with the Reverend Mother</data>
    </edge>
    <edge source="Paul" target="Arrakis" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Next time we meet it'll be on the soil of your new world.</data>
    </edge>
    <edge source="Paul" target="Arrakis" id="1">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">here on Arrakis.</data>
    </edge>
    <edge source="Paul" target="Paul's father" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">I tell you only as your father's helper.</data>
    </edge>
    <edge source="Paul" target="Thufir" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">My father has told me of Salusa Secundus," Paul said. "Do you know, Thufir,</data>
    </edge>
    <edge source="Paul" target="Thufir Hawat" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">"Thufir! "Paul called. Hawat turned, standing in the open doorway.</data>
    </edge>
    <edge source="Paul" target="Gurney Halleck" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">"Well, Gurney Halleck," Paul called, "are you the new weapons master?"</data>
    </edge>
    <edge source="Paul" target="Gurney Halleck" id="1">
      <data key="d12">FRIENDS_WITH</data>
      <data key="d13">0.9</data>
      <data key="d14">Paul grinned. Of all his father's men, he liked Gurney Halleck best, knew the man's moods and deviltry, his humors, and thought of him more as a friend than as a hired sword.</data>
    </edge>
    <edge source="Paul" target="Halleck" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">Paul stepped back, chagrined.</data>
    </edge>
    <edge source="Paul" target="Halleck" id="1">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.8</data>
      <data key="d14">This in the hand of an enemy can let out your life's blood!</data>
    </edge>
    <edge source="Paul" target="shield" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Paul fell back, parrying. He felt the field crackling as shield edges touched and repelled each other, sensed the electric tingling of the contact along his skin.</data>
    </edge>
    <edge source="Paul" target="EVENT" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Paul held himself in near catatonic immobility, knowing he had only his wits to meet this threat.</data>
    </edge>
    <edge source="Paul" target="EVENT" id="1">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Paul studied the yellow cloud belching from the crawler's pipe vents, looked out over the desert at the approaching worm track.</data>
    </edge>
    <edge source="Paul" target="training fight" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Paul activated his shield, parried and countered.</data>
    </edge>
    <edge source="Paul" target="crossing to Arrakis" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">I've arranged for you to have a filmbook viewer and several lessons during the crossing to Arrakis</data>
    </edge>
    <edge source="Paul" target="study more about the sandworms" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"I'd like to study more about the sandworms."</data>
    </edge>
    <edge source="Paul" target="Yueh" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">Paul stared at Yueh, finding in these few glimpses of the Fremen a power of words that caught his entire attention.</data>
    </edge>
    <edge source="Paul" target="conical projection chart of the northern Arrakeen latitudes" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Paul glanced down at a conical projection chart of the northern Arrakeen latitudes spread on the table.</data>
    </edge>
    <edge source="Paul" target="book" id="0">
      <data key="d12">OWNS</data>
      <data key="d13">0.9</data>
      <data key="d14">Paul looked down at the tiny book in his palm</data>
    </edge>
    <edge source="Paul" target="Mentat training" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"You see, you may have Mentat capabilities."</data>
    </edge>
    <edge source="Paul" target="lessons" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"Someplace around the house taking his lessons with Yueh."</data>
    </edge>
    <edge source="Paul" target="our strategy conference" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">I want him to attend our strategy conference.</data>
    </edge>
    <edge source="Paul" target="Dr. Yueh" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">It had been easy to palm Dr. Yueh's sleeping tablet</data>
    </edge>
    <edge source="Paul" target="Arrakis: His Imperial Majesty's Desert Botanical Testing Station" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">He thought of the filmbook Yueh had shown him--"Arrakis: His Imperial Majesty's Desert Botanical Testing Station."</data>
    </edge>
    <edge source="Paul" target="father" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">"Your father has sent for you," she said.</data>
    </edge>
    <edge source="Paul" target="father" id="1">
      <data key="d12">LOVES</data>
      <data key="d13">0.9</data>
      <data key="d14">I loved my father, Paul thought, and knew this for truth.</data>
    </edge>
    <edge source="Paul" target="Shadout Mapes" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">Paul's eyes came up, met the open stare of total blue from the Shadout Mapes.</data>
    </edge>
    <edge source="Paul" target="Shadout Mapes" id="1">
      <data key="d12">SAVED</data>
      <data key="d13">0.9</data>
      <data key="d14">"Then you saved my life," she said.</data>
    </edge>
    <edge source="Paul" target="hunter-seeker incident" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"I've caught a hunter-seeker in the house and they're to spread out and find the operator."</data>
    </edge>
    <edge source="Paul" target="Mapes" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.8</data>
      <data key="d14">Paul absorbed this in silence: a traitor. Before he could speak, the odd woman whirled away</data>
    </edge>
    <edge source="Paul" target="Hawat" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">And it would've succeeded were it not for the training given me by you and many others--including Hawat.</data>
    </edge>
    <edge source="Paul" target="Leto" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">Paul looked back at the white wall behind his father</data>
    </edge>
    <edge source="Paul" target="training" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">Now, Paul's training is our only hope, she thought.</data>
    </edge>
    <edge source="Paul" target="training" id="1">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">I've seen it come out in Paul.</data>
    </edge>
    <edge source="Paul" target="Mother" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">"And the message Mother--"</data>
    </edge>
    <edge source="Paul" target="Fremen religion" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">They directed the term at the young master.</data>
    </edge>
    <edge source="Paul" target="Fremen" id="0">
      <data key="d12">LEADS</data>
      <data key="d13">0.8</data>
      <data key="d14">They've a legend here, a prophecy, that a leader will come to them, child of a Bene Gesserit, to lead them to true freedom.</data>
    </edge>
    <edge source="Paul" target="Fremen" id="1">
      <data key="d12">KNOWS</data>
      <data key="d13">0.7</data>
      <data key="d14">Fremen! Paul thought.</data>
    </edge>
    <edge source="Paul" target="conference room" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">found it dark and Paul asleep on the table with a guard's robe thrown over him</data>
    </edge>
    <edge source="Paul" target="Collected Sayings of Muad'Dib" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"There is probably no more terrible instant of enlightenment than the one in which you discover your father is a man--with human flesh." -from "Collected Sayings of Muad'Dib" by the Princess Irulan</data>
    </edge>
    <edge source="Paul" target="guerrilla training" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">I must order new emphasis on guerrilla training for you.</data>
    </edge>
    <edge source="Paul" target="filmclip" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">That filmclip there--they call you 'Mahdi'--'Lisan al-Gaib'</data>
    </edge>
    <edge source="Paul" target="Kynes" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">"Are there any plants down there?" Paul asked. "Some," Kynes said.</data>
    </edge>
    <edge source="Paul" target="Worm" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">It reminded Paul of the way a big fish disturbed the water when swimming just under the surface.</data>
    </edge>
    <edge source="Paul" target="thopter" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Paul, looking out at the factory, saw how all the 'thopters were dwarfed by it</data>
    </edge>
    <edge source="Paul" target="crowded" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Paul, crowded into a corner by sweating men, smelled the perspiration of fear</data>
    </edge>
    <edge source="Paul" target="House Troop" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">Paul in the corner surrounded by a fawning group of the younger Arrakeen richece, and, aloof among them, three officers of the House Troop.</data>
    </edge>
    <edge source="Paul" target="Kwisatz Haderach" id="0">
      <data key="d12">LOVES</data>
      <data key="d13">0.7</data>
      <data key="d14">The thought fanned her secret hope for Paul. He could be the Kwisatz Haderach.</data>
    </edge>
    <edge source="Paul" target="dinner" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Jessica saw that Paul was looking at Kynes in admiration.</data>
    </edge>
    <edge source="Paul" target="Doctor Kynes" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">Paul said: "Please go on with your dinner. I believe Doctor Kynes was discussing water."</data>
    </edge>
    <edge source="Paul" target="Bene Gesserit" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">The mind-calming Bene Gesserit regimen his mother had taught him kept him poised, ready to expand any opportunity.</data>
    </edge>
    <edge source="Paul" target="ordeal with the Reverend Mother Gaius Helen Mohiam" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">The sense of terrible purpose he'd first experienced in his ordeal with the Reverend Mother Gaius Helen Mohiam pervaded him.</data>
    </edge>
    <edge source="Paul" target="family atomics" id="0">
      <data key="d12">LEADS</data>
      <data key="d13">0.9</data>
      <data key="d14">"Our immediate concern is our family atomics."</data>
    </edge>
    <edge source="Paul" target="Manual of 'The Friendly Desert'" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.7</data>
      <data key="d14">The glowing tab of the Fremkit manual between them on the tent floor caught her eye.</data>
    </edge>
    <edge source="Paul" target="Missionaria Protectiva" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">where your Missionaria Protectiva has bought us a bolt hole.</data>
    </edge>
    <edge source="Paul" target="Idaho" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">"It's Idaho," he breathed.</data>
    </edge>
    <edge source="Paul" target="dukedom" id="0">
      <data key="d12">LEADS</data>
      <data key="d13">0.9</data>
      <data key="d14">the boy who had taken on the mantle of manhood, masking grief, suppressing all except the position that now must be assumed--the dukedom.</data>
    </edge>
    <edge source="Paul" target="worms" id="0">
      <data key="d12">FRIENDS_WITH</data>
      <data key="d13">0.8</data>
      <data key="d14">"Our friends, the worms," he corrected her.</data>
    </edge>
    <edge source="Paul" target="launching" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.7</data>
      <data key="d14">Paul focused on the 'thopter's launching</data>
    </edge>
    <edge source="Paul" target="Kitab al-Ibar" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Paul took a deep breath, looked up at the moon-frosted escarpment, and quoted from the Kitab al-Ibar</data>
    </edge>
    <edge source="Paul" target="prescient vision" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">shaken by the remembered high relief imagery of a prescient vision he had experienced on Caladan.</data>
    </edge>
    <edge source="Paul" target="vision" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Idaho was with us in the vision, he remembered.</data>
    </edge>
    <edge source="Paul" target="escape" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">the Fremkit manual that had come with their escape pack.</data>
    </edge>
    <edge source="Paul" target="digging" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Paul directed the foam barrier, Jessica dug with her hands, hurling the sand down the slope.</data>
    </edge>
    <edge source="Paul" target="put up the tent" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"I'll put up the tent," he said.</data>
    </edge>
    <edge source="Paul" target="worked the pack up" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">More sand spilled down as they worked the pack up.</data>
    </edge>
    <edge source="Paul" target="witch" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.7</data>
      <data key="d14">he was lost with his mother in a desert storm.</data>
    </edge>
    <edge source="Paul" target="walking the sand" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"We must walk without rhythm," Paul said</data>
    </edge>
    <edge source="Paul" target="Stilgar" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">"I know you, Stilgar," Paul said.</data>
    </edge>
    <edge source="Paul" target="Council" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">I was with my father in Council when you came for the water of your friend.</data>
    </edge>
    <edge source="Paul" target="us" id="0">
      <data key="d12">LEADS</data>
      <data key="d13">0.8</data>
      <data key="d14">If you are the Bene Gesserit of the legend whose son will lead us to paradise</data>
    </edge>
    <edge source="Paul" target="Chani" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.8</data>
      <data key="d14">Chani pulled at his robe to hurry him</data>
    </edge>
    <edge source="Paul" target="amtal rule" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"I invoke the amtal rule," Jamis said. "It's my right."</data>
    </edge>
    <edge source="Paul" target="Duncan Idaho" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">his teachers men like Duncan Idaho and Gurney Halleck</data>
    </edge>
    <edge source="Paul" target="tahaddi ring" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">this was no soft offworlder in the tahaddi ring</data>
    </edge>
    <edge source="Paul" target="Sietch Tabr" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">We of Sietch Tabr may use it</data>
    </edge>
    <edge source="Paul" target="Usul" id="0">
      <data key="d12">KNOWN_AS</data>
      <data key="d13">0.9</data>
      <data key="d14">"You shall be known among us as Usul, the base of the pillar. This is your secret name, your troop name."</data>
    </edge>
    <edge source="Paul" target="Muad'Dib" id="0">
      <data key="d12">KNOWN_AS</data>
      <data key="d13">0.9</data>
      <data key="d14">"We call that one Muad'Dib," Stilgar said.</data>
    </edge>
    <edge source="Paul" target="Paul-Muad'Dib" id="0">
      <data key="d12">KNOWN_AS</data>
      <data key="d13">0.9</data>
      <data key="d14">"You are Paul-Muad'Dib," Stilgar said.</data>
    </edge>
    <edge source="Paul" target="passage" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Paul come out of the cave's depths</data>
    </edge>
    <edge source="Jessica" target="Bene Gesserit" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">This every sister of the Bene Gesserit knows</data>
    </edge>
    <edge source="Jessica" target="Bene Gesserit" id="1">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">his wife was a Bene Gesserit slain by the Harkonnens</data>
    </edge>
    <edge source="Jessica" target="Duke Leto" id="0">
      <data key="d12">LOVES</data>
      <data key="d13">0.9</data>
      <data key="d14">a duke's concubine</data>
    </edge>
    <edge source="Jessica" target="Duke Leto" id="1">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">I am the Duke's only . . . companion, the mother of his heir-designate.</data>
    </edge>
    <edge source="Jessica" target="Paul" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">mother and son approach</data>
    </edge>
    <edge source="Jessica" target="Paul" id="1">
      <data key="d12">TRAINING</data>
      <data key="d13">0.9</data>
      <data key="d14">"You've been training him in the Way -- I've seen the signs of it."</data>
    </edge>
    <edge source="Jessica" target="Paul" id="2">
      <data key="d12">LOVES</data>
      <data key="d13">0.8</data>
      <data key="d14">An urgent need to see her son gripped Jessica.</data>
    </edge>
    <edge source="Jessica" target="Paul" id="3">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">Paul may require a wakeshot.</data>
    </edge>
    <edge source="Jessica" target="Reverend Mother Gaius Helen Mohiam" id="0">
      <data key="d12">HATES</data>
      <data key="d13">0.8</data>
      <data key="d14">Damn that Jessica! the Reverend Mother thought</data>
    </edge>
    <edge source="Jessica" target="Reverend Mother" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">The Lady Jessica was my serving wench, lad, for fourteen years at school.</data>
    </edge>
    <edge source="Jessica" target="Reverend Mother" id="1">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">"You're as dear to me as any of my own daughters, but I cannot let that interfere with duty."</data>
    </edge>
    <edge source="Jessica" target="old woman" id="0">
      <data key="d12">HATES</data>
      <data key="d13">0.9</data>
      <data key="d14">"I both love and hate you," Jessica said.</data>
    </edge>
    <edge source="Jessica" target="old woman" id="1">
      <data key="d12">LOVES</data>
      <data key="d13">0.9</data>
      <data key="d14">"I both love and hate you," Jessica said.</data>
    </edge>
    <edge source="Jessica" target="Atreides" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">You were told to bear only daughters to the Atreides.</data>
    </edge>
    <edge source="Jessica" target="son" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">the life of your son.</data>
    </edge>
    <edge source="Jessica" target="Harkonnen" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">"I do not take orders from a damn' Harkonnen spy."</data>
    </edge>
    <edge source="Jessica" target="her son" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">And your son will pay with you.</data>
    </edge>
    <edge source="Jessica" target="Shadout Mapes" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.8</data>
      <data key="d14">I am called the Shadout Mapes, Noble Born.</data>
    </edge>
    <edge source="Jessica" target="Mapes" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">Jessica said. She read the more obvious signs in Mapes' actions and appearance</data>
    </edge>
    <edge source="Jessica" target="Dark Things" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">I know the Dark Things and the ways of the Great Mother</data>
    </edge>
    <edge source="Jessica" target="prophecy" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.7</data>
      <data key="d14">Jessica thought about the prophecy</data>
    </edge>
    <edge source="Jessica" target="crysknife" id="0">
      <data key="d12">OWNS</data>
      <data key="d13">0.9</data>
      <data key="d14">It's yours, a tooth of shai-hulud, for as long as you live.</data>
    </edge>
    <edge source="Jessica" target="EVENT" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Jessica withdrew the blade from its sheath.</data>
    </edge>
    <edge source="Jessica" target="EVENT" id="1">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Jessica thought he was going to push himself back</data>
    </edge>
    <edge source="Jessica" target="Missionaria Protectiva" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">That was a specific catchphrase from the Missionaria Protectiva's stock of incantations</data>
    </edge>
    <edge source="Jessica" target="Missionaria Protectiva" id="1">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">And not all the preparations of the Missionaria Protectiva nor Hawat's suspicious inspection of this castellated pile of rocks could dispel the feeling.</data>
    </edge>
    <edge source="Jessica" target="Dr. Yueh" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">"Good afternoon. Dr. Yueh," she said.</data>
    </edge>
    <edge source="Jessica" target="Caladan" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">So barren after Caladan.</data>
    </edge>
    <edge source="Jessica" target="Caladan" id="1">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">she remembered the waters of Caladan</data>
    </edge>
    <edge source="Jessica" target="the spice" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">The spice could make us rich.</data>
    </edge>
    <edge source="Jessica" target="the palm trees" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">The way the passing people looked at the palm trees!</data>
    </edge>
    <edge source="Jessica" target="Duke" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">But the hair was the Duke's</data>
    </edge>
    <edge source="Jessica" target="Duke" id="1">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">I am the Duke's secretary</data>
    </edge>
    <edge source="Jessica" target="Duke" id="2">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">sitting at table with her son and her Duke and their guests</data>
    </edge>
    <edge source="Jessica" target="Duke" id="3">
      <data key="d12">LOVES</data>
      <data key="d13">0.8</data>
      <data key="d14">"But he'll not marry anyone else," she said. "Not as long as I live."</data>
    </edge>
    <edge source="Jessica" target="Harkonnens" id="0">
      <data key="d12">HATES</data>
      <data key="d13">0.9</data>
      <data key="d14">Even my Duke's voice doesn't carry that weight of venom when he uses the hated name.</data>
    </edge>
    <edge source="Jessica" target="Wellington" id="0">
      <data key="d12">LOVES</data>
      <data key="d13">0.8</data>
      <data key="d14">A deep affection for him came over her.</data>
    </edge>
    <edge source="Jessica" target="Wellington" id="1">
      <data key="d12">FRIENDS_WITH</data>
      <data key="d13">0.9</data>
      <data key="d14">You're . . . my friend.</data>
    </edge>
    <edge source="Jessica" target="the Duke" id="0">
      <data key="d12">LOVES</data>
      <data key="d13">0.9</data>
      <data key="d14">One of them I love very much.</data>
    </edge>
    <edge source="Jessica" target="Yueh" id="0">
      <data key="d12">FRIENDS_WITH</data>
      <data key="d13">0.7</data>
      <data key="d14">I should place more trust in my friends.</data>
    </edge>
    <edge source="Jessica" target="Yueh" id="1">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">Jessica said. And she thought: This calls for shock treatment.</data>
    </edge>
    <edge source="Jessica" target="Arrakis" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Through the windows beneath the spiral stair she could see the great white sun of Arrakis moving on toward evening.</data>
    </edge>
    <edge source="Jessica" target="Arrakis" id="1">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Jessica turned her attention to Bewt. "Impossible?" "Impossible on Arrakis," he said.</data>
    </edge>
    <edge source="Jessica" target="hy Supreme Friend" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">hy Supreme Friend."   Jessica put her weight on the wheel.</data>
    </edge>
    <edge source="Jessica" target="wet-planet conservatory" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"A wet-planet conservatory," she breathed:</data>
    </edge>
    <edge source="Jessica" target="Paul's father" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">"My father must learn of this at once," he said.</data>
    </edge>
    <edge source="Jessica" target="Leto" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">As Leto approached Jessica's group</data>
    </edge>
    <edge source="Jessica" target="Leto" id="1">
      <data key="d12">LOVES</data>
      <data key="d13">0.8</data>
      <data key="d14">She smiled at Leto.</data>
    </edge>
    <edge source="Jessica" target="dinner" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">The custom here is for host and hostess to follow their guests to table</data>
    </edge>
    <edge source="Jessica" target="Esmar Tuek" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">The smuggler's called Tuek, Esmar Tuek. He's a power among his kind. They all know him here.</data>
    </edge>
    <edge source="Jessica" target="Gurney" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">"Gurney arranged the invitation."</data>
    </edge>
    <edge source="Jessica" target="Thufir Hawat" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">It was cleared with Hawat, although I thought Hawat was a little stiff about it.</data>
    </edge>
    <edge source="Jessica" target="conservatory plants in trust for Arrakis" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">it had been when Jessica had spoken of holding the conservatory plants in trust for Arrakis.</data>
    </edge>
    <edge source="Jessica" target="Duncan Idaho" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.8</data>
      <data key="d14">Jessica marked them--the smuggler, the stillsuit manufacturer's daughter, Duncan Idaho, the woman with the mysterious escort service.</data>
    </edge>
    <edge source="Jessica" target="Leto's message" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Jessica stared down at her plate, thinking of the coded part of Leto's message</data>
    </edge>
    <edge source="Jessica" target="dinner party" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">the dress shirt he had worn at the dinner party earlier</data>
    </edge>
    <edge source="Jessica" target="ENTITY" id="0">
      <data key="d12">PERSON</data>
      <data key="d13">0.9</data>
      <data key="d14">Jessica's attention. She turned, saw Yueh crossing to them</data>
    </edge>
    <edge source="Jessica" target="Idaho" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">Jessica shook her head. She stepped forward, slapped Idaho sharply across the cheek.</data>
    </edge>
    <edge source="Jessica" target="Hawat" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">"Hawat!" she snapped. "I want Thufir Hawat brought to me immediately!"</data>
    </edge>
    <edge source="Jessica" target="Thufir" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">"You poor fool, Thufir!" she raged.</data>
    </edge>
    <edge source="Jessica" target="Manual of 'The Friendly Desert'" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.7</data>
      <data key="d14">The glowing tab of the Fremkit manual between them on the tent floor caught her eye.</data>
    </edge>
    <edge source="Jessica" target="digging" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Jessica dug with her hands, hurling the sand down the slope.</data>
    </edge>
    <edge source="Jessica" target="worked the pack up" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">More sand spilled down as they worked the pack up.</data>
    </edge>
    <edge source="Jessica" target="walking the sand" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Jessica studied his progress for ten steps, followed, imitating him.</data>
    </edge>
    <edge source="Jessica" target="Chakobsa" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">Jessica recognized the speech. It was Chakobsa, one of the ancient hunting languages</data>
    </edge>
    <edge source="Jessica" target="Stilgar" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">"You there!" Stilgar roared. "Do as she says!"</data>
    </edge>
    <edge source="Jessica" target="weirding way" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">You mastered an armed Fremen. This is a weapon no search could expose.</data>
    </edge>
    <edge source="Jessica" target="Tabr" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.7</data>
      <data key="d14">"Did you know there're those among us who've lost from their catch-pockets by accident and will be in sore trouble before we reach Tabr this night?"</data>
    </edge>
    <edge source="Jessica" target="Sayyadina" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"Then we accept your blessing, Sayyadina."</data>
    </edge>
    <edge source="Jessica" target="Sayyadina" id="1">
      <data key="d12">KNOWN_AS</data>
      <data key="d13">0.9</data>
      <data key="d14">She was indeed Sayyadina.</data>
    </edge>
    <edge source="Jessica" target="passage" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Jessica thought.</data>
    </edge>
    <edge source="Atreides family" target="Castle Caladan" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Castle Caladan, and the ancient pile of stone that had served the Atreides family as home for twenty-six generations</data>
    </edge>
    <edge source="Atreides family" target="farmlands" id="0">
      <data key="d12">OWNS</data>
      <data key="d13">0.9</data>
      <data key="d14">the green farmlands of the Atreides family holding</data>
    </edge>
    <edge source="Bene Gesserit" target="schools" id="0">
      <data key="d12">LEADS</data>
      <data key="d13">0.9</data>
      <data key="d14">"Bene Gesserit schools?" She nodded.</data>
    </edge>
    <edge source="Bene Gesserit" target="schools" id="1">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.7</data>
      <data key="d14">I'm not fooled by what your schools tell the public: you exist only to serve.</data>
    </edge>
    <edge source="Bene Gesserit" target="Politics" id="0">
      <data key="d12">PERFORMS</data>
      <data key="d13">0.9</data>
      <data key="d14">Bene Gesserit performs another function." "Politics," he said.</data>
    </edge>
    <edge source="Bene Gesserit" target="prophecy" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">a Bene Gesserit of the Missionaria Protectiva dropped here long centuries ago</data>
    </edge>
    <edge source="Bene Gesserit" target="Duke's enemies" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.8</data>
      <data key="d14">"Why aren't you out destroying the Duke's enemies?" he asked.</data>
    </edge>
    <edge source="Bene Gesserit" target="Duke" id="0">
      <data key="d12">SERVES</data>
      <data key="d13">0.9</data>
      <data key="d14">"We truly exist only to serve."</data>
    </edge>
    <edge source="Bene Gesserit" target="pilot's statement" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"Bene Gesserit ain't all highborn," the pilot said.</data>
    </edge>
    <edge source="Bene Gesserit" target="legend and prophecy" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">It is said that a Bene Gesserit and her offspring hold the key to our future.</data>
    </edge>
    <edge source="Duke Leto" target="House of Atreides" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">an apparent victory for the Duke Leto</data>
    </edge>
    <edge source="Duke Leto" target="Great Houses of the Landsraad" id="0">
      <data key="d12">POPULAR_AMONG</data>
      <data key="d13">0.9</data>
      <data key="d14">for the Duke Leto was popular among the Great Houses of the Landsraad</data>
    </edge>
    <edge source="Duke Leto" target="Arrakis" id="0">
      <data key="d12">LEADS</data>
      <data key="d13">0.9</data>
      <data key="d14">He signs it: 'Duke Leto of Arrakis.'</data>
    </edge>
    <edge source="Duke Leto" target="campaign against the House of Atreides" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"our campaign against the House of Atreides."</data>
    </edge>
    <edge source="Duke Leto" target="Fremen" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.7</data>
      <data key="d14">The Duke Leto," Piter said, "may attempt to flee to the new Fremen scum along the desert's edge.</data>
    </edge>
    <edge source="Duke Leto" target="his son" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">this chip here, this is the Duke Leto, and this one's his son</data>
    </edge>
    <edge source="Duke Leto" target="A Child's History of Muad'Dib" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">the Duke Leto, whose qualities as a father have long been overlooked.</data>
    </edge>
    <edge source="Duke Leto" target="Jessica" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">The voice was Duke Leto's. She whirled, saw him striding from the arched passage to the dining hall.</data>
    </edge>
    <edge source="Duke Leto" target="Emperor" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.8</data>
      <data key="d14">He had become such a savage, driving person since the decision to bow to the Emperor's command.</data>
    </edge>
    <edge source="Duke Leto" target="Harkonnens" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">It will take more than a trap to catch the Duke Leto.</data>
    </edge>
    <edge source="Duke Leto" target="Caladan" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">We did not live this way on Caladan.</data>
    </edge>
    <edge source="Duke Leto" target="hostile soil" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">Especially when you put it down in hostile soil.</data>
    </edge>
    <edge source="Duke Leto" target="water riots" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.7</data>
      <data key="d14">There were water riots when it was learned how many people the Duke was adding to the population.</data>
    </edge>
    <edge source="Duke Leto" target="Harkonnen agents" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">Light signals could only mean that messages were being sent between his enemies--between Harkonnen agents.</data>
    </edge>
    <edge source="Duke Leto" target="EVENT" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"You be the Duke Leto, I warrant," he said.</data>
    </edge>
    <edge source="Duke Leto" target="Duke's ship" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">let the Duke fly his ship</data>
    </edge>
    <edge source="Duke Leto" target="his escort" id="0">
      <data key="d12">LEADS</data>
      <data key="d13">0.9</data>
      <data key="d14">His escort came down from circling stations, took up positions above and on both sides.</data>
    </edge>
    <edge source="Duke Leto" target="worm rescue mission" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">We'll send a ship from base for them! the Duke snapped.</data>
    </edge>
    <edge source="Thufir Hawat" target="Duke Leto" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">Thufir Hawat, his father's Master of Assassins</data>
    </edge>
    <edge source="Thufir Hawat" target="Mentat" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"I've studied with Thufir Hawat."</data>
    </edge>
    <edge source="Thufir Hawat" target="Muad'Dib" id="0">
      <data key="d12">FRIENDS_WITH</data>
      <data key="d13">0.8</data>
      <data key="d14">There was Thufir Hawat, the old Mentat Master of Assassins, who struck fear even into the heart of the Padishah Emperor.</data>
    </edge>
    <edge source="Thufir Hawat" target="A Child's History of Muad'Dib" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">was Thufir Hawat, the old Mentat Master of Assassins, who struck fear even into the heart of the Padishah Emperor.</data>
    </edge>
    <edge source="Thufir Hawat" target="Castle Caladan" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Thufir Hawat slipped into the training room of Castle Caladan, closed the door softly.</data>
    </edge>
    <edge source="Thufir Hawat" target="Reverend Mother" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">Did you meet the Reverend Mother? That Truthsayer witch from the Imperium? Hawat's eyes quickened with interest. I met her.</data>
    </edge>
    <edge source="Thufir Hawat" target="Hawat" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">Hawat sent advance agents in here by the battalion. Those guards outside are his men. The cargo handlers are his men.</data>
    </edge>
    <edge source="Thufir Hawat" target="Jessica" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.8</data>
      <data key="d14">Where Thufir Hawat goes, death and deceit follow.</data>
    </edge>
    <edge source="Thufir Hawat" target="Leto" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">Thufir Hawat strode through it looking older and more leathery than ever. He paced down the length of the table, stopped at attention facing Leto.</data>
    </edge>
    <edge source="Harkonnens" target="House of Atreides" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">their mortal enemies, the Harkonnens</data>
    </edge>
    <edge source="Harkonnens" target="House of Atreides" id="1">
      <data key="d12">LEAVES</data>
      <data key="d13">0.9</data>
      <data key="d14">the Harkonnens were leaving to be replaced by the House of Atreides</data>
    </edge>
    <edge source="Harkonnens" target="Arrakis" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">the Harkonnens, had been on Arrakis eighty years</data>
    </edge>
    <edge source="Harkonnens" target="Arrakis" id="1">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">The Harkonnens sealed off many sources of information about Arrakis.</data>
    </edge>
    <edge source="Harkonnens" target="CHOAM Company" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">under a CHOAM Company contract</data>
    </edge>
    <edge source="Harkonnens" target="Paul" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">"It's the Harkonnens, of course. We shall have to destroy them."</data>
    </edge>
    <edge source="Harkonnens" target="stockpiled melange" id="0">
      <data key="d12">OWNS</data>
      <data key="d13">0.9</data>
      <data key="d14">The Harkonnens have been stockpiling for more than twenty years</data>
    </edge>
    <edge source="Harkonnens" target="melange" id="0">
      <data key="d12">STOCKPILE</data>
      <data key="d13">0.9</data>
      <data key="d14">Knowing that the Harkonnens stockpile melange</data>
    </edge>
    <edge source="Harkonnens" target="Fremen" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">The Harkonnens sneered at the Fremen, hunted them for sport, never even bothered trying to count them.</data>
    </edge>
    <edge source="Harkonnens" target="this place" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.7</data>
      <data key="d14">They've known only the Harkonnens.</data>
    </edge>
    <edge source="Harkonnens" target="Duke" id="0">
      <data key="d12">HATES</data>
      <data key="d13">0.9</data>
      <data key="d14">Even my Duke's voice doesn't carry that weight of venom when he uses the hated name.</data>
    </edge>
    <edge source="Harkonnens" target="Duke" id="1">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">"They'll be here with Sardaukar disguised as Harkonnens at the first opportunity."</data>
    </edge>
    <edge source="Harkonnens" target="Wellington" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">And it's obvious the Harkonnens killed her.</data>
    </edge>
    <edge source="Harkonnens" target="Jessica" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">But this whole planet's a Harkonnen trap.</data>
    </edge>
    <edge source="Harkonnens" target="Sire" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">The fact that they're leaving suggests they're not part of the Harkonnen machine.</data>
    </edge>
    <edge source="Harkonnens" target="Leto" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">Let the Harkonnens fight that! And we'll be ruining a few more of the locals who grew fat under the Harkonnen system.</data>
    </edge>
    <edge source="Harkonnens" target="ten billion Solaris" id="0">
      <data key="d12">OWNS</data>
      <data key="d13">0.9</data>
      <data key="d14">The Harkonnens took ten billion Solaris out of here every three hundred and thirty Standard days.</data>
    </edge>
    <edge source="Harkonnens" target="Old Maria" id="0">
      <data key="d12">OWNS</data>
      <data key="d13">0.9</data>
      <data key="d14">I think the Harkonnens kept it as a punishment job</data>
    </edge>
    <edge source="Harkonnens" target="shields" id="0">
      <data key="d12">USES</data>
      <data key="d13">0.9</data>
      <data key="d14">The Harkonnens certainly used plenty of shields here</data>
    </edge>
    <edge source="Harkonnens" target="CHOAM" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">including the CHOAM percentage and military costs</data>
    </edge>
    <edge source="Harkonnens" target="Harkonnen methods" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Unless my Lord wishes to adopt Harkonnen methods.</data>
    </edge>
    <edge source="Harkonnens" target="Atreides" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">The Harkonnens want to destroy the Atreides line</data>
    </edge>
    <edge source="Harkonnens" target="spice investigation" id="0">
      <data key="d12">HATES</data>
      <data key="d13">0.9</data>
      <data key="d14">The Harkonnens discouraged investigation of the spice</data>
    </edge>
    <edge source="Harkonnens" target="Bene Gesserit" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">his wife was a Bene Gesserit slain by the Harkonnens</data>
    </edge>
    <edge source="Harkonnens" target="Kynes" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">We lived under the Harkonnens for eighty years</data>
    </edge>
    <edge source="Harkonnens" target="area" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">The Harkonnens will have a covering force over this area</data>
    </edge>
    <edge source="Harkonnens" target="covering force" id="0">
      <data key="d12">LEADS</data>
      <data key="d13">0.9</data>
      <data key="d14">The Harkonnens will have a covering force over this area</data>
    </edge>
    <edge source="Harkonnens" target="Dune" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">The Harkonnens have returned to Dune in force</data>
    </edge>
    <edge source="House of Atreides" target="Arrakis" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Now the Harkonnens were leaving to be replaced by the House of Atreides in fief-complete</data>
    </edge>
    <edge source="House of Atreides" target="campaign against the House of Atreides" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"our campaign against the House of Atreides."</data>
    </edge>
    <edge source="CHOAM Company" target="Arrakis" id="0">
      <data key="d12">OWNS</data>
      <data key="d13">0.9</data>
      <data key="d14">under a CHOAM Company contract to mine the geriatric spice, melange</data>
    </edge>
    <edge source="CHOAM Company" target="Imperium" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.7</data>
      <data key="d14">CHOAM was the key to wealth, each noble House dipping from the company's coffers whatever it could under the power of the directorships.</data>
    </edge>
    <edge source="CHOAM Company" target="spice" id="0">
      <data key="d12">CONTROLS</data>
      <data key="d13">0.9</data>
      <data key="d14">CHOAM controls the spice</data>
    </edge>
    <edge source="Dr. Yueh" target="Paul" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">Dr. Yueh, his teacher</data>
    </edge>
    <edge source="Dr. Yueh" target="end of all the Atreides" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Dr. Yueh will move against him soon, and that'll be the end of all the Atreides.</data>
    </edge>
    <edge source="Dr. Yueh" target="Baron" id="0">
      <data key="d12">AGENT_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">Dr. Yueh, who is indeed our agent.</data>
    </edge>
    <edge source="Dr. Yueh" target="Suk School" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">our doctor is a Suk School graduate</data>
    </edge>
    <edge source="Dr. Yueh" target="Emperor" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">safe enough to minister even to the Emperor</data>
    </edge>
    <edge source="Dr. Yueh" target="Mystery of Life" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">That's what Dr. Yueh calls the Mystery of Life.</data>
    </edge>
    <edge source="Dr. Yueh" target="A Child's History of Muad'Dib" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"Yueh! Yueh! Yueh!" goes the refrain. "A million deaths were not enough for Yueh!" -from "A Child's History of Muad'Dib" by the Princess Irulan</data>
    </edge>
    <edge source="Dr. Yueh" target="Harkonnens" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">his wife was a Bene Gesserit slain by the Harkonnens</data>
    </edge>
    <edge source="Fremen" target="Arrakis" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">the planet sheltered people who lived at the desert edge without caid or bashar to command them: will-o'-the-sand people called Fremen</data>
    </edge>
    <edge source="Fremen" target="passage" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Have you ever seen the Fremen?</data>
    </edge>
    <edge source="Fremen" target="Harkonnens" id="0">
      <data key="d12">HATES</data>
      <data key="d13">0.9</data>
      <data key="d14">they hate Harkonnens with a bloody passion.</data>
    </edge>
    <edge source="Fremen" target="Harkonnens" id="1">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">"We will kill Harkonnens," the Fremen said.</data>
    </edge>
    <edge source="Fremen" target="saying" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">They have a saying: 'Polish comes from the cities; wisdom from the desert.'</data>
    </edge>
    <edge source="Fremen" target="poems" id="0">
      <data key="d12">CREATED</data>
      <data key="d13">0.9</data>
      <data key="d14">They compose poems to their knives.</data>
    </edge>
    <edge source="Fremen" target="potential of a corps as strong and deadly as the Sardaukar" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">We have there the potential of a corps as strong and deadly as the Sardaukar.</data>
    </edge>
    <edge source="Fremen" target="Harkonnen" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">Hawat tells me the Fremen were a deep thorn in the Harkonnen side</data>
    </edge>
    <edge source="Fremen" target="Duke" id="0">
      <data key="d12">ALLIES_WITH</data>
      <data key="d13">0.9</data>
      <data key="d14">the Fremen appear more and more to be the allies we need</data>
    </edge>
    <edge source="Fremen" target="stillsuits" id="0">
      <data key="d12">CREATED</data>
      <data key="d13">0.9</data>
      <data key="d14">stillsuits of their own manufacture</data>
    </edge>
    <edge source="Fremen" target="maps" id="0">
      <data key="d12">SENT</data>
      <data key="d13">0.9</data>
      <data key="d14">maps of certain desert areas surrounding strongpoints the Harkonnens left behind</data>
    </edge>
    <edge source="Fremen" target="jewelry" id="0">
      <data key="d12">SENT</data>
      <data key="d13">0.9</data>
      <data key="d14">jewelry for the Lady Jessica</data>
    </edge>
    <edge source="Fremen" target="spice liquor" id="0">
      <data key="d12">SENT</data>
      <data key="d13">0.9</data>
      <data key="d14">spice liquor</data>
    </edge>
    <edge source="Fremen" target="medicinals" id="0">
      <data key="d12">SENT</data>
      <data key="d13">0.9</data>
      <data key="d14">medicinals</data>
    </edge>
    <edge source="Fremen" target="discussion" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.7</data>
      <data key="d14">The subject under discussion is spicing equipment.</data>
    </edge>
    <edge source="Fremen" target="courier" id="0">
      <data key="d12">SENT</data>
      <data key="d13">0.9</data>
      <data key="d14">The Fremen themselves sent us a courier to warn of the false band.</data>
    </edge>
    <edge source="Fremen" target="sietch" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">a blue-eyed man could penetrate any sietch in the land.</data>
    </edge>
    <edge source="Fremen" target="Kynes" id="0">
      <data key="d12">DEFER_TO</data>
      <data key="d13">0.9</data>
      <data key="d14">"And the Fremen defer to him."</data>
    </edge>
    <edge source="Fremen" target="raid on Giedi Prime" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">perhaps some of the Fremen would enjoy a trip off planet. A raid on Giedi Prime</data>
    </edge>
    <edge source="Fremen" target="Dune" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"Any Dune man who values his skin wears a Fremen suit."</data>
    </edge>
    <edge source="Fremen" target="EVENT" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">It's said that the Fremen scum drink the blood of their dead</data>
    </edge>
    <edge source="Fremen" target="EVENT" id="1">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">The Sardaukar approached the waiting group of Fremen in an enclosing halfcircle.</data>
    </edge>
    <edge source="Fremen" target="southern latitudes" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">It's said the Fremen travel there, that they go anywhere and have hunted out soaks and sip-wells even in the southern latitudes.</data>
    </edge>
    <edge source="Fremen" target="bond of water" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">This is the bond of water. We know the rites.</data>
    </edge>
    <edge source="Fremen" target="fight" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">"We will fight in the time of fighting," the man said.</data>
    </edge>
    <edge source="Fremen" target="Sardaukar" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">"We will kill Harkonnens," the Fremen said. He grinned. "And Sardaukar."</data>
    </edge>
    <edge source="Fremen" target="temporary hiding place" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">the Fremen have a temporary hiding place nearby</data>
    </edge>
    <edge source="Fremen" target="Paul" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.7</data>
      <data key="d14">He seemed confident the Fremen could find us</data>
    </edge>
    <edge source="Fremen" target="Jessica" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.7</data>
      <data key="d14">He seemed confident the Fremen could find us</data>
    </edge>
    <edge source="Fremen" target="ambush" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">a Fremen band ambushed a Sardaukar force</data>
    </edge>
    <edge source="Fremen" target="Thufir Hawat" id="0">
      <data key="d12">CAPTURED</data>
      <data key="d13">0.9</data>
      <data key="d14">It is said this Fremen force already had captured the Duke's redoubtable Thufir Hawat.</data>
    </edge>
    <edge source="Fremen" target="crossing the desert" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">"There's a way to get safely across that open sand," Paul said. "The Fremen do it."</data>
    </edge>
    <edge source="Fremen" target="walking the sand" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"This is how Fremen walk the sand."</data>
    </edge>
    <edge source="his mother" target="Bene Gesserit" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">she had trained him in the Bene Gesserit Way</data>
    </edge>
    <edge source="his mother" target="Bene Gesserit school" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">She was my teacher at the Bene Gesserit school.</data>
    </edge>
    <edge source="Reverend Mother" target="Emperor" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">she's the Emperor's Truthsayer</data>
    </edge>
    <edge source="Reverend Mother" target="Paul's dreams" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">"I dreamed of her once," Paul said.</data>
    </edge>
    <edge source="Reverend Mother" target="Jessica" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">The Lady Jessica was my serving wench, lad, for fourteen years at school.</data>
    </edge>
    <edge source="Reverend Mother" target="Jessica" id="1">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.8</data>
      <data key="d14">"How noble," the Reverend Mother sneered. "No regrets. We shall see when you're a fugitive with a price on your head and every man's hand turned against you to seek your life and the life of your son."</data>
    </edge>
    <edge source="Reverend Mother" target="Butlerian Jihad" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"Right out of the Butlerian Jihad and the Orange Catholic Bible," she said.</data>
    </edge>
    <edge source="Reverend Mother" target="Orange Catholic Bible" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"Right out of the Butlerian Jihad and the Orange Catholic Bible," she said.</data>
    </edge>
    <edge source="Reverend Mother" target="Bene Gesserit" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">The Reverend Mother returned her attention to Paul.</data>
    </edge>
    <edge source="Reverend Mother" target="Bene Gesserit" id="1">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">The old woman stared at Paul, then: "Young man, as a Proctor of the Bene Gesserit, I seek the Kwisatz Haderach, the male who truly can become one of us.</data>
    </edge>
    <edge source="Reverend Mother" target="Kwisatz Haderach" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Don't you want to hear what the Reverend Mother can tell you about the Kwisatz Haderach?</data>
    </edge>
    <edge source="Reverend Mother" target="Imperium" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">That Truthsayer witch from the Imperium</data>
    </edge>
    <edge source="Reverend Mother" target="warnings about Arrakis" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Did the Reverend Mother warn you?</data>
    </edge>
    <edge source="Emperor" target="his friends" id="0">
      <data key="d12">FRIENDS_WITH</data>
      <data key="d13">0.8</data>
      <data key="d14">The Emperor and his friends now command fifty-nine point six-five per cent of the CHOAM directorship's votes.</data>
    </edge>
    <edge source="Emperor" target="Paul Atreides" id="0">
      <data key="d12">ORDERS</data>
      <data key="d13">0.9</data>
      <data key="d14">Because the Emperor ordered it.</data>
    </edge>
    <edge source="Emperor" target="this" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">If he knows he must face her questions, then the Emperor is in on this for sure.</data>
    </edge>
    <edge source="Emperor" target="Atreides" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">Only the Emperor calls the Atreides the Red Duke.</data>
    </edge>
    <edge source="Emperor" target="passage" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Only the Emperor calls the Atreides the Red Duke.</data>
    </edge>
    <edge source="Reverend Mother Gaius Helen Mohiam" target="gom jabbar" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">Reverend Mother is waiting in my morning room</data>
    </edge>
    <edge source="Reverend Mother Gaius Helen Mohiam" target="Spacing Guild" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">association with that abominable Spacing Guild and its secretive ways</data>
    </edge>
    <edge source="Reverend Mother Gaius Helen Mohiam" target="Bene Gesserit" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">a mission that required personal attention from a Bene Gesserit-with-theSight</data>
    </edge>
    <edge source="Reverend Mother Gaius Helen Mohiam" target="Bene Gesserit school" id="0">
      <data key="d12">LEADS</data>
      <data key="d13">0.9</data>
      <data key="d14">Reverend Mother Gaius Helen Mohiam, Proctor Superior of the Bene Gesserit school on Wallach IX.</data>
    </edge>
    <edge source="Reverend Mother Gaius Helen Mohiam" target="ordeal" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">The sense of terrible purpose he'd first experienced in his ordeal with the Reverend Mother Gaius Helen Mohiam pervaded him.</data>
    </edge>
    <edge source="Spacing Guild" target="schools" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">the Bene Gesserit and the Spacing Guild. The Guild, so we think, emphasizes almost pure mathematics.</data>
    </edge>
    <edge source="Duke" target="Atreides" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">the Duke and his family</data>
    </edge>
    <edge source="Duke" target="Atreides" id="1">
      <data key="d12">LEADS</data>
      <data key="d13">0.9</data>
      <data key="d14">A move worthy of your grandsire, my Lord.</data>
    </edge>
    <edge source="Duke" target="Atreides" id="2">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.8</data>
      <data key="d14">the burnished reflections of the Atreides silver</data>
    </edge>
    <edge source="Duke" target="Atreides" id="3">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">The planetologist broke off as an uniformed Atreides trooper hurried in through the service door, was passed by the guard and rushed to the Duke's side.</data>
    </edge>
    <edge source="Duke" target="Residency" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">the Duke and his family will occupy the Residency</data>
    </edge>
    <edge source="Duke" target="Baron" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">"Loveliest of all," Piter said, "is that the Duke will know, too."</data>
    </edge>
    <edge source="Duke" target="CHOAM Company" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.8</data>
      <data key="d14">By giving me Arrakis, His Majesty is forced to give us a CHOAM directorship</data>
    </edge>
    <edge source="Duke" target="Paul" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">the hawk symbol above his father's breast glistened as the Duke shifted his position</data>
    </edge>
    <edge source="Duke" target="Paul" id="1">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">The Duke glanced at the darkness out the windows, looked back at Halleck.</data>
    </edge>
    <edge source="Duke" target="Paul" id="2">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">Gurney, you and Paul toss out that rear seat," the Duke said.</data>
    </edge>
    <edge source="Duke" target="Paul" id="3">
      <data key="d12">LOVES</data>
      <data key="d13">0.8</data>
      <data key="d14">By the very flatness of his father's voice, Paul sensed the deep anger.</data>
    </edge>
    <edge source="Duke" target="Arrakis" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.8</data>
      <data key="d14">walk into Arrakis, knowing the trap is there</data>
    </edge>
    <edge source="Duke" target="Arrakis" id="1">
      <data key="d12">HATES</data>
      <data key="d13">0.8</data>
      <data key="d14">he could not bring himself to call this dry wasteland of Arrakis his home, and he doubted he ever would.</data>
    </edge>
    <edge source="Duke" target="Arrakis" id="2">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">There's greater possibility for us here on Arrakis</data>
    </edge>
    <edge source="Duke" target="Arrakis" id="3">
      <data key="d12">LEADS</data>
      <data key="d13">0.9</data>
      <data key="d14">The people must learn how well I govern them.</data>
    </edge>
    <edge source="Duke" target="Arrakis" id="4">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"Arrakis is tough on equipment."</data>
    </edge>
    <edge source="Duke" target="Caladan" id="0">
      <data key="d12">LOVES</data>
      <data key="d13">0.8</data>
      <data key="d14">The longing for Caladan was a sudden pain in his breast.</data>
    </edge>
    <edge source="Duke" target="Caladan" id="1">
      <data key="d12">LEADS</data>
      <data key="d13">0.9</data>
      <data key="d14">"Our supremacy on Caladan," the Duke said, "depended on sea and air power.</data>
    </edge>
    <edge source="Duke" target="EVENT" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">the Duke thought</data>
    </edge>
    <edge source="Duke" target="EVENT" id="1">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Time to go down and get to work</data>
    </edge>
    <edge source="Duke" target="Hawat" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">Hawat told me that house was secure!</data>
    </edge>
    <edge source="Duke" target="Hawat" id="1">
      <data key="d12">LEADS</data>
      <data key="d13">0.9</data>
      <data key="d14">"The Duke turned to Hawat. "Set up another command post for intelligence and communications on this floor, Thufir."</data>
    </edge>
    <edge source="Duke" target="Imperium" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">we cannot even obey a simple order of the Imperium</data>
    </edge>
    <edge source="Duke" target="delegation" id="0">
      <data key="d12">LEADS</data>
      <data key="d13">0.9</data>
      <data key="d14">The Duke looked at Halleck. "Gurney, I want you to head a delegation, an embassy if you will, to contact these romantic businessmen.</data>
    </edge>
    <edge source="Duke" target="planetary base" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">"We're working for a solid and permanent planetary base," the Duke said.</data>
    </edge>
    <edge source="Duke" target="Fremen" id="0">
      <data key="d12">LEADS</data>
      <data key="d13">0.9</data>
      <data key="d14">"We'll have to move fast with the Fremen. I'd like five full battalions of Fremen troops before the first CHOAM audit."</data>
    </edge>
    <edge source="Duke" target="Fremen" id="1">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.7</data>
      <data key="d14">With a Fremen suit in good working order, you won't lose more than a thimbleful of moisture a day</data>
    </edge>
    <edge source="Duke" target="Harkonnen" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">We're presently in a war of assassins</data>
    </edge>
    <edge source="Duke" target="Leto" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">the Duke said.</data>
    </edge>
    <edge source="Duke" target="Halleck" id="0">
      <data key="d12">LEADS</data>
      <data key="d13">0.9</data>
      <data key="d14">"He looked at Halleck. "Gurney, take care of that smuggler situation first."</data>
    </edge>
    <edge source="Duke" target="Halleck" id="1">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">Halleck said. "Not on this ship," the Duke said.</data>
    </edge>
    <edge source="Duke" target="Thufir Hawat" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">The Duke found Thufir Hawat alone in the corner room</data>
    </edge>
    <edge source="Duke" target="Imperial" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.8</data>
      <data key="d14">the Imperial and Harkonnen stockpiles of spice attract my attention</data>
    </edge>
    <edge source="Duke" target="Harkonnens" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">The Harkonnens have hindered and hounded and hunted me for the last time, he thought.</data>
    </edge>
    <edge source="Duke" target="woman" id="0">
      <data key="d12">LOVES</data>
      <data key="d13">0.9</data>
      <data key="d14">The woman has opened her heart to me. "What better way to destroy me than to sow suspicion of the woman I love?"</data>
    </edge>
    <edge source="Duke" target="desert basin" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">A predawn hush had come over the desert basin.</data>
    </edge>
    <edge source="Duke" target="balcony" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">The Duke walked softly down the length of the room and onto the balcony overlooking the landing field.</data>
    </edge>
    <edge source="Duke" target="Great Houses" id="0">
      <data key="d12">LEADS</data>
      <data key="d13">0.8</data>
      <data key="d14">The melancholy degeneration of the Great Houses has afflicted me at last</data>
    </edge>
    <edge source="Duke" target="Paul's mother" id="0">
      <data key="d12">LOVES</data>
      <data key="d13">0.7</data>
      <data key="d14">I should wed your mother, make her my Duchess</data>
    </edge>
    <edge source="Duke" target="propaganda corps" id="0">
      <data key="d12">LEADS</data>
      <data key="d13">0.9</data>
      <data key="d14">My propaganda corps is one of the finest</data>
    </edge>
    <edge source="Duke" target="statecraft" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">"Power and fear," he said. "The tools of statecraft.</data>
    </edge>
    <edge source="Duke" target="Thufir" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">I told Thufir to have him here early.</data>
    </edge>
    <edge source="Duke" target="my father" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">the political necessities that made them enemies</data>
    </edge>
    <edge source="Duke" target="Kynes" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">"I understand we have you to thank for our stillsuits and these cloaks," the Duke said.</data>
    </edge>
    <edge source="Duke" target="Kynes" id="1">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.7</data>
      <data key="d14">Kynes said. The Duke said:</data>
    </edge>
    <edge source="Duke" target="change of government" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">"When you report to the Emperor on the change of government here, will you say we observed the rules?" Leto asked.</data>
    </edge>
    <edge source="Duke" target="Escort Gemma" id="0">
      <data key="d12">LEADS</data>
      <data key="d13">0.9</data>
      <data key="d14">The Duke reached down, brought up a microphone from the instrument panel, thumbed it to life, said: "Leader to Escort Gemma."</data>
    </edge>
    <edge source="Duke" target="rescue service" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">We're setting up a special rescue service.</data>
    </edge>
    <edge source="Duke" target="Gurney" id="0">
      <data key="d12">LEADS</data>
      <data key="d13">0.9</data>
      <data key="d14">The Duke said: "I forgot to mention that Gurney is also very talented in public relations."</data>
    </edge>
    <edge source="Duke" target="Delta Ajax niner's crew" id="0">
      <data key="d12">LEADS</data>
      <data key="d13">0.9</data>
      <data key="d14">This is your Duke. We are coming down to take off Delta Ajax niner's crew.</data>
    </edge>
    <edge source="Duke" target="his own air cover" id="0">
      <data key="d12">LEADS</data>
      <data key="d13">0.9</data>
      <data key="d14">repeated the order for his own air cover</data>
    </edge>
    <edge source="Duke" target="Delta Ajax niner" id="0">
      <data key="d12">LEADS</data>
      <data key="d13">0.9</data>
      <data key="d14">This is a command from your Duke!</data>
    </edge>
    <edge source="Duke" target="Delta Ajax niner" id="1">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">This is a command from your Duke!</data>
    </edge>
    <edge source="Duke" target="thopter" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">the Duke opened his door.</data>
    </edge>
    <edge source="Duke" target="men" id="0">
      <data key="d12">LEADS</data>
      <data key="d13">0.9</data>
      <data key="d14">The Duke hung the microphone on the panel, swung out onto the wing step, shouted: "Two men each into your spotters."</data>
    </edge>
    <edge source="Duke" target="escort" id="0">
      <data key="d12">LEADS</data>
      <data key="d13">0.9</data>
      <data key="d14">The Duke nodded, watched the last of his escort take off.</data>
    </edge>
    <edge source="Duke" target="dinner" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">After the dinner, beggars gathered outside</data>
    </edge>
    <edge source="Duke" target="Harkonnen fief" id="0">
      <data key="d12">HATES</data>
      <data key="d13">0.9</data>
      <data key="d14">How typical of a Harkonnen fief, the Duke thought. Every degradation of the spirit that can be conceived.</data>
    </edge>
    <edge source="Duke" target="serving woman" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.8</data>
      <data key="d14">He saw a serving woman--one of the old and gnarled ones the housekeeper had recommended--hovering at the doorway from the kitchen across from him.</data>
    </edge>
    <edge source="Duke" target="guard" id="0">
      <data key="d12">LEADS</data>
      <data key="d13">0.9</data>
      <data key="d14">I'm posting a guard to see that my orders are carried out to the letter.</data>
    </edge>
    <edge source="Duke" target="House Troop" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.8</data>
      <data key="d14">aloof among them, three officers of the House Troop</data>
    </edge>
    <edge source="Duke" target="Tuck" id="0">
      <data key="d12">FRIENDS_WITH</data>
      <data key="d13">0.8</data>
      <data key="d14">"Review, friends--troops long past review," the Duke intoned.</data>
    </edge>
    <edge source="Duke" target="worm" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.8</data>
      <data key="d14">"The blasted carry-all disappeared. It shouldn't be possible for anything that big to disappear!"</data>
    </edge>
    <edge source="Duke" target="carryall" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.8</data>
      <data key="d14">"The blasted carry-all disappeared. It shouldn't be possible for anything that big to disappear!"</data>
    </edge>
    <edge source="Duke" target="Gurney Halleck" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">The Duke turned to the alcove where Halleck sat, said: "Gurney, please take Paul's place at table.</data>
    </edge>
    <edge source="Duke" target="house guard" id="0">
      <data key="d12">LEADS</data>
      <data key="d13">0.9</data>
      <data key="d14">but I must ask that no one leave until our house guard says it's safe.</data>
    </edge>
    <edge source="Duke" target="kanly" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">The Duke has sworn kanly.</data>
    </edge>
    <edge source="Duke" target="Jessica" id="0">
      <data key="d12">LOVES</data>
      <data key="d13">0.9</data>
      <data key="d14">If I desired a puppet, the Duke would marry me</data>
    </edge>
    <edge source="Duke" target="passage" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"Is this the Duke?" "This is the Duke."</data>
    </edge>
    <edge source="Lady Jessica" target="old woman" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">The Lady Jessica was my serving wench, lad, for fourteen years at school.</data>
    </edge>
    <edge source="Lady Jessica" target="A Child's History of Muad'Dib" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">the Lady Jessica, who guided her son in the Bene Gesserit Way,</data>
    </edge>
    <edge source="Lady Jessica" target="Bene Gesserit" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">the Bene Gesserit system of sowing implant-legends through the Missionaria Protectiva</data>
    </edge>
    <edge source="Lady Jessica" target="Analysis: The Arrakeen Crisis" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">-from "Analysis: The Arrakeen Crisis" by the Princess Irulan</data>
    </edge>
    <edge source="Lady Jessica" target="Muad'Dib: Family Commentaries" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">-from "Muad'Dib: Family Commentaries" by the Princess Irulan</data>
    </edge>
    <edge source="Lady Jessica" target="message" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">TO THE LADY JESSICA-May this place give you as much pleasure as it has given me.</data>
    </edge>
    <edge source="Lady Jessica" target="Leto" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.8</data>
      <data key="d14">She's been with me for sixteen years!</data>
    </edge>
    <edge source="Lady Jessica" target="Great Hall" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">In the Great Hall, the Lady Jessica was the center of a mixed group standing in front of the fireplace.</data>
    </edge>
    <edge source="Lady Jessica" target="Great Hall" id="1">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">In the Great Hall, the Lady Jessica was the center of a mixed group standing in front of the fireplace.</data>
    </edge>
    <edge source="Lady Jessica" target="reflection in the windows" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">Jessica lowered her gaze from the reflection in the windows</data>
    </edge>
    <edge source="Lady Jessica" target="Hawat" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">There was no doubt in his mind who had betrayed them--the Lady Jessica</data>
    </edge>
    <edge source="old woman" target="Lady Jessica" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">The Lady Jessica was my serving wench, lad, for fourteen years at school.</data>
    </edge>
    <edge source="old woman" target="gom jabbar" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Withdraw the hand and the gom jabbar takes you.</data>
    </edge>
    <edge source="old woman" target="gom jabbar test" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">She leaned back, withdrawing the gom jabbar from the side of his neck.</data>
    </edge>
    <edge source="old woman" target="Bene Gesserit" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">"We Bene Gesserit sift people to find the humans."</data>
    </edge>
    <edge source="mother" target="Bene Gesserit" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">they had heard she was a Bene Gesserit</data>
    </edge>
    <edge source="Paul's mother" target="Bene Gesserit" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">his mother had taught him out of the Bene Gesserit rite.</data>
    </edge>
    <edge source="Paul's mother" target="Paul" id="0">
      <data key="d12">LOVES</data>
      <data key="d13">0.9</data>
      <data key="d14">The hand behind those warnings was your mother's. Take this as a sign of her love for us.</data>
    </edge>
    <edge source="Mentat" target="Duke" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.8</data>
      <data key="d14">Why have you never made full use of my abilities in your service to the Duke?</data>
    </edge>
    <edge source="Kwisatz Haderach" target="Truthsayer drug" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"You say maybe I'm the . . . Kwisatz Haderach. What's that, a human gom jabbar?"</data>
    </edge>
    <edge source="Kwisatz Haderach" target="Missionaria Protectiva legend" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Did our Missionaria Protectiva plant that legend here, too?</data>
    </edge>
    <edge source="Truthsayer drug" target="Kwisatz Haderach" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"You say maybe I'm the . . . Kwisatz Haderach. What's that, a human gom jabbar?"</data>
    </edge>
    <edge source="Baron" target="Piter" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">"Observe closely, Piter, and you, too, FeydRautha, my darling"</data>
    </edge>
    <edge source="Baron" target="Piter" id="1">
      <data key="d12">HATES</data>
      <data key="d13">0.8</data>
      <data key="d14">I must do away with that one soon. He has almost outlived his usefulness.</data>
    </edge>
    <edge source="Baron" target="Piter" id="2">
      <data key="d12">LEADS</data>
      <data key="d13">0.9</data>
      <data key="d14">"I give you an order, Mentat. Perform one of your various functions."</data>
    </edge>
    <edge source="Baron" target="FeydRautha" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">"Observe closely, Piter, and you, too, FeydRautha, my darling"</data>
    </edge>
    <edge source="Baron" target="FeydRautha" id="1">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">"it is not necessary to confuse my nephew."</data>
    </edge>
    <edge source="Baron" target="Duke" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">I must have him dead and his line ended.</data>
    </edge>
    <edge source="Baron" target="Leto" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">"I have ofttimes met your treachery and this all men know."</data>
    </edge>
    <edge source="Baron" target="Duke Leto" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">Your offer of a meeting is refused. I have ofttimes met your treachery and this all men know.</data>
    </edge>
    <edge source="Baron" target="Feyd-Rautha" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">"Feyd," the Baron said. "I told you to listen and learn when I invited you in here."</data>
    </edge>
    <edge source="Baron" target="Feyd-Rautha" id="1">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">Feyd-Rautha asked.</data>
    </edge>
    <edge source="Baron" target="Feyd-Rautha" id="2">
      <data key="d12">LOVES</data>
      <data key="d13">0.8</data>
      <data key="d14">Send for food, my darling.</data>
    </edge>
    <edge source="Baron" target="Emperor" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.8</data>
      <data key="d14">Already you have the Emperor's eyes on you, Baron.</data>
    </edge>
    <edge source="Baron" target="Feyd-Rautha Harkonnen" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">"Listen to my nephew," the Baron said.</data>
    </edge>
    <edge source="Baron" target="Mentat" id="0">
      <data key="d12">OWNS</data>
      <data key="d13">0.8</data>
      <data key="d14">"This is a Mentat, Feyd. It has been trained and conditioned to perform certain duties."</data>
    </edge>
    <edge source="Baron" target="Lady Jessica" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">Accursed woman!</data>
    </edge>
    <edge source="Baron" target="Hawat" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">Hawat's mind will be so filled with this prospect it'll impair his function as a Mentat.</data>
    </edge>
    <edge source="Baron" target="Feyd" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">"Feyd remembers him," the Baron said.</data>
    </edge>
    <edge source="Baron" target="House Harkonnen" id="0">
      <data key="d12">LEADS</data>
      <data key="d13">0.9</data>
      <data key="d14">"And the Great Houses will know that the Baron has destroyed the Atreides,"</data>
    </edge>
    <edge source="Baron" target="Atreides" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">"And the Great Houses will know that the Baron has destroyed the Atreides,"</data>
    </edge>
    <edge source="Baron" target="note" id="0">
      <data key="d12">CREATED</data>
      <data key="d13">0.9</data>
      <data key="d14">The note was under the Baron's own seal and I've authenticated the seal.</data>
    </edge>
    <edge source="Baron" target="Reverend Mother Gaius Helen" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">He fears the questioning of a Truthsayer, Jessica thought. Who? Ah-h-h, the Reverend Mother Gaius Helen, of course!</data>
    </edge>
    <edge source="Baron" target="Jessica's thoughts" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">reviewing the Baron's words</data>
    </edge>
    <edge source="Baron" target="guard captain" id="0">
      <data key="d12">LEADS</data>
      <data key="d13">0.8</data>
      <data key="d14">Piter glanced at the guard captain, back to the Baron.</data>
    </edge>
    <edge source="Baron" target="Rabban" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">No Mentat, my nephew . . . not a Piter de Vries, but perhaps something more precisely devised for the task at hand.</data>
    </edge>
    <edge source="Baron" target="Rabban" id="1">
      <data key="d12">HATES</data>
      <data key="d13">0.8</data>
      <data key="d14">Oh, how he'll be hated here on Arrakis!</data>
    </edge>
    <edge source="Baron" target="Rabban" id="2">
      <data key="d12">LEADS</data>
      <data key="d13">0.9</data>
      <data key="d14">I give you different instructions about Arrakis this time, Nephew.</data>
    </edge>
    <edge source="Baron" target="Yueh" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">But the Baron smiled. "I'm very careful about dangerous weapons," he said. "Doctor Yueh was a traitor. He gave me the Duke."</data>
    </edge>
    <edge source="Baron" target="CHOAM Company" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.8</data>
      <data key="d14">I'll have my own report in his hands through CHOAM Company channels.</data>
    </edge>
    <edge source="Baron" target="Arrakis" id="0">
      <data key="d12">OWNS</data>
      <data key="d13">0.9</data>
      <data key="d14">"When last you ruled this place, I held you in strong rein."</data>
    </edge>
    <edge source="Baron" target="Guild" id="0">
      <data key="d12">HATES</data>
      <data key="d13">0.9</data>
      <data key="d14">"The damnable Guild monopoly on space would've ruined us if I hadn't planned for this expense long ago."</data>
    </edge>
    <edge source="Baron" target="Sardaukar" id="0">
      <data key="d12">OWNS</data>
      <data key="d13">0.9</data>
      <data key="d14">"We even paid for transport of the Sardaukar."</data>
    </edge>
    <edge source="Piter" target="Baron" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">But, Baron! Never has revenge been more beautiful.</data>
    </edge>
    <edge source="Piter" target="Baron" id="1">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">"Truth without fear surprises the Baron," Piter said.</data>
    </edge>
    <edge source="Piter" target="Baron Vladimir Harkonnen" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">The trap will bring him to you, Baron," Piter muttered.</data>
    </edge>
    <edge source="Piter" target="Arrakeen" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.7</data>
      <data key="d14">He might've come directly from the Arrakeen labor pool.</data>
    </edge>
    <edge source="Piter" target="Jessica" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">Piter shrugged, turned, and went through the doorway. He hesitated there, and Jessica thought he might turn back for a last look at her, but he went out without turning.</data>
    </edge>
    <edge source="Leto" target="Arrakeen" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">Leto had been wise to choose this place for his seat of government.</data>
    </edge>
    <edge source="Leto" target="Leto's father" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">faced the painting of Leto's father.</data>
    </edge>
    <edge source="Leto" target="royal blood" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.8</data>
      <data key="d14">Leto is a cousin of the royal blood</data>
    </edge>
    <edge source="Leto" target="rooms" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Leto's right--these rooms are nicer than the ones in the other sections of the house.</data>
    </edge>
    <edge source="Leto" target="Duke" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">Leto spoke impatiently</data>
    </edge>
    <edge source="Leto" target="staff conference" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">having been brought to the ducal command post to participate in his father's first full staff conference.</data>
    </edge>
    <edge source="Leto" target="Halleck" id="0">
      <data key="d12">LEADS</data>
      <data key="d13">0.9</data>
      <data key="d14">Leto smiled. "We'll bank the entire tithe openly in the name of Shaddam IV and deduct it legally from our levy support costs.</data>
    </edge>
    <edge source="Leto" target="Hawat" id="0">
      <data key="d12">LEADS</data>
      <data key="d13">0.9</data>
      <data key="d14">The Duke turned to Hawat. "Thufir, did you get those account books you said you could buy?"</data>
    </edge>
    <edge source="Leto" target="Hawat" id="1">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">A look of understanding passed between Leto and Hawat.</data>
    </edge>
    <edge source="Leto" target="Arrakis" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">We make it here on Arrakis--win or die</data>
    </edge>
    <edge source="Leto" target="Leto the Just" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">They address you as 'Leto the Just'</data>
    </edge>
    <edge source="Leto" target="Sire" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">"And I keep you from your work," Leto said.</data>
    </edge>
    <edge source="Leto" target="Lady Jessica" id="0">
      <data key="d12">LOVES</data>
      <data key="d13">0.8</data>
      <data key="d14">I know my woman.</data>
    </edge>
    <edge source="Leto" target="Paul" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">Leto turned, looked down at his son.</data>
    </edge>
    <edge source="Leto" target="Harkonnens" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">Because the Harkonnens think to trick me by making me distrust your mother.</data>
    </edge>
    <edge source="Leto" target="Paul's mother" id="0">
      <data key="d12">LOVES</data>
      <data key="d13">0.8</data>
      <data key="d14">They don't know that I'd sooner distrust myself.</data>
    </edge>
    <edge source="Leto" target="Kynes" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">"There's Kynes," she said.</data>
    </edge>
    <edge source="Leto" target="Emperor" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.8</data>
      <data key="d14">you report to the Emperor on the change of government here</data>
    </edge>
    <edge source="Leto" target="fief" id="0">
      <data key="d12">LEADS</data>
      <data key="d13">0.8</data>
      <data key="d14">this is now my fief</data>
    </edge>
    <edge source="Leto" target="Collected Sayings of Muad'Dib" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Leto turned a hard stare at Kynes.</data>
    </edge>
    <edge source="Leto" target="Jessica" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">As Leto approached Jessica's group</data>
    </edge>
    <edge source="Leto" target="Jessica" id="1">
      <data key="d12">LOVES</data>
      <data key="d13">0.8</data>
      <data key="d14">Bless her! Leto thought.</data>
    </edge>
    <edge source="Leto" target="Thufir Hawat" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">Leto, watching the guests file past, recalled what Thufir Hawat had said when informed of the affair: "Sire! I forbid it!"</data>
    </edge>
    <edge source="Leto" target="Gurney" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">"Gurney arranged the invitation."</data>
    </edge>
    <edge source="Leto" target="house troopers" id="0">
      <data key="d12">LEADS</data>
      <data key="d13">0.9</data>
      <data key="d14">He gave a hand signal, and the house troopers in footman uniform around the table stepped back, standing at attention.</data>
    </edge>
    <edge source="Leto" target="dinner" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">As they emerged into the dining hall, she disengaged her arm, allowed Leto to seat her.</data>
    </edge>
    <edge source="Leto" target="Chevalier of the Imperium" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">"As a Chevalier of the Imperium, then," he said, "I give you a toast."</data>
    </edge>
    <edge source="Leto" target="EVENT" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Jessica saw that Leto was enjoying this</data>
    </edge>
    <edge source="Leto" target="his house" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Leto stood in the foyer of his house</data>
    </edge>
    <edge source="Leto" target="Duncan Idaho" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">Blast and damn that Duncan Idaho!</data>
    </edge>
    <edge source="Leto" target="Great Hall" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">gh the  Great Hall and down the passages toward the family wing.</data>
    </edge>
    <edge source="Leto" target="service passage" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Softly, the Duke moved down the service passage</data>
    </edge>
    <edge source="Leto" target="Mapes" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">darted down the passage, crouched beside the crawling figure. It was Mapes, the Fremen housekeeper</data>
    </edge>
    <edge source="Leto" target="Narcal" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.7</data>
      <data key="d14">that peg tooth I put in your mouth after the tumble at Narcal</data>
    </edge>
    <edge source="Leto" target="Baron Harkonnen" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.8</data>
      <data key="d14">He'll believe you're stupefied by drugs beyond any dying effort to attack him.</data>
    </edge>
    <edge source="Leto" target="Baron" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">You know, my dear Leto, you'll tell us in the end where they are.</data>
    </edge>
    <edge source="Sardaukar" target="Emperor" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">One day the Emperor will send a legion or two of his Sardaukar down here onto Giedi Prime</data>
    </edge>
    <edge source="Sardaukar" target="Harkonnen" id="0">
      <data key="d12">DISGUISED_AS</data>
      <data key="d13">0.9</data>
      <data key="d14">Disguised in Harkonnen livery, no doubt," the Duke said.</data>
    </edge>
    <edge source="Sardaukar" target="Harkonnen" id="1">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.8</data>
      <data key="d14">Those were Sardaukar in Harkonnen uniform</data>
    </edge>
    <edge source="Sardaukar" target="Duke" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">"They'll be here with Sardaukar disguised as Harkonnens at the first opportunity."</data>
    </edge>
    <edge source="Sardaukar" target="Duke" id="1">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">"Is this the Duke?" "This is the Duke."</data>
    </edge>
    <edge source="Sardaukar" target="Yueh" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">"You can relax, Yueh," the man said.</data>
    </edge>
    <edge source="Sardaukar" target="passage" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">the Sardaukar sneered.</data>
    </edge>
    <edge source="Sardaukar" target="EVENT" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">The Sardaukar approached the waiting group of Fremen in an enclosing halfcircle.</data>
    </edge>
    <edge source="Sardaukar" target="Arrakis" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">The Sardaukar on Arrakis</data>
    </edge>
    <edge source="Baron Vladimir Harkonnen" target="Giedi Prime" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">One day the Emperor will send a legion or two of his Sardaukar down here onto Giedi Prime and that'll be an end to the Baron Vladimir Harkonnen.</data>
    </edge>
    <edge source="Baron Vladimir Harkonnen" target="Corps of Sardaukar" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.8</data>
      <data key="d14">You'd enjoy seeing the Corps of Sardaukar pillage through my cities and sack this castle.</data>
    </edge>
    <edge source="Baron Vladimir Harkonnen" target="Feyd-Rautha" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">Uncle, do I have to stay?</data>
    </edge>
    <edge source="Baron Vladimir Harkonnen" target="Barony" id="0">
      <data key="d12">LEADS</data>
      <data key="d13">0.8</data>
      <data key="d14">He aspires to rule my Barony, yet he cannot rule himself.</data>
    </edge>
    <edge source="Baron Vladimir Harkonnen" target="Lady Jessica" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">Such a pity we cannot have our conversation, my dear Lady Jessica.</data>
    </edge>
    <edge source="Baron Vladimir Harkonnen" target="Piter de Vries" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">The Baron glanced behind him at the door. "Come in, Piter."</data>
    </edge>
    <edge source="Feyd-Rautha Harkonnen" target="Baron" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">"Listen to my nephew," the Baron said.</data>
    </edge>
    <edge source="Arrakeen" target="Arrakis" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">No planet of this system grew trees to make such beams -- unless the beams were imitation wood.</data>
    </edge>
    <edge source="Arrakeen" target="Broken Land" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">a cheap and brassy place some two hundred kilometers northeast across the Broken Land.</data>
    </edge>
    <edge source="Arrakeen" target="Old Empire" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">This had been the government mansion in the days of the Old Empire.</data>
    </edge>
    <edge source="Arrakeen" target="LOCATION" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">streets of Arrakeen</data>
    </edge>
    <edge source="Arrakeen" target="great house" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">In the dining hall of the Arrakeen great house</data>
    </edge>
    <edge source="House Atreides" target="Arrakis" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">House Atreides will go to Arrakis.</data>
    </edge>
    <edge source="Atreides" target="Landsraad Houses" id="0">
      <data key="d12">LEADS</data>
      <data key="d13">0.8</data>
      <data key="d14">Think of the Landsraad Houses that look to me for a certain amount of leadership -- their unofficial spokesman</data>
    </edge>
    <edge source="Atreides" target="Harkonnen" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">an Atreides had a Harkonnen banished for cowardice</data>
    </edge>
    <edge source="Atreides" target="forces" id="0">
      <data key="d12">LEADS</data>
      <data key="d13">0.9</data>
      <data key="d14">Both man and machine were turned over to our forces.</data>
    </edge>
    <edge source="Atreides" target="hopes the Atreides will bring peace and prosperity" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">The people have such hopes the Atreides will bring peace and prosperity.</data>
    </edge>
    <edge source="Count Fenring" target="Residency" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">lately the home of Count and Lady Fenring.</data>
    </edge>
    <edge source="Count Fenring" target="Ambassador to the Smugglers" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">The Ambassador to the Smugglers</data>
    </edge>
    <edge source="Guild" target="outside Imperial control" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">the Guild remains effectively outside Imperial control</data>
    </edge>
    <edge source="Guild" target="monopoly on interstellar transport" id="0">
      <data key="d12">OWNS</data>
      <data key="d13">0.9</data>
      <data key="d14">the Guild with its damnable monopoly on interstellar transport.</data>
    </edge>
    <edge source="Guild" target="Heighliner" id="0">
      <data key="d12">OWNS</data>
      <data key="d13">0.9</data>
      <data key="d14">"We'll be riding a Heighliner because it's a long trip."</data>
    </edge>
    <edge source="Guild" target="Harkonnens" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.8</data>
      <data key="d14">"There could be Harkonnen ships right alongside us and we'd have nothing to fear from them."</data>
    </edge>
    <edge source="Guild" target="Imperial inventory" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.7</data>
      <data key="d14">Wouldn't it be cheaper to reopen negotiations with the Guild for permission to orbit a frigate as a weather satellite?</data>
    </edge>
    <edge source="Guild" target="probing raids" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">the Guild for probing raids</data>
    </edge>
    <edge source="Guild" target="monopoly on space" id="0">
      <data key="d12">OWNS</data>
      <data key="d13">0.9</data>
      <data key="d14">"The damnable Guild monopoly on space would've ruined us if I hadn't planned for this expense long ago."</data>
    </edge>
    <edge source="Guild" target="free traders" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.8</data>
      <data key="d14">for the cursed Guild . . . may their faces be forever black.</data>
    </edge>
    <edge source="Guild" target="Stilgar" id="0">
      <data key="d12">BRIBED_BY</data>
      <data key="d13">0.9</data>
      <data key="d14">We bribe the Guild with a monstrous payment in spice</data>
    </edge>
    <edge source="Hawat" target="Paul" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">Hawat pulled up a chair across from Paul</data>
    </edge>
    <edge source="Hawat" target="Paul's father" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">Did my father send you up to test me?</data>
    </edge>
    <edge source="Hawat" target="Fremen" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">The Fremen took Hawat's arm, pressed him back with the others.</data>
    </edge>
    <edge source="Hawat" target="Arrakis" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">I leave today for Arrakis.</data>
    </edge>
    <edge source="Hawat" target="Duke" id="0">
      <data key="d12">AGREES_WITH</data>
      <data key="d13">0.9</data>
      <data key="d14">"Hawat agrees, Son. It's true."</data>
    </edge>
    <edge source="Hawat" target="Duke" id="1">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">"How many men can you let Hawat have?" the Duke asked.</data>
    </edge>
    <edge source="Hawat" target="Duke" id="2">
      <data key="d12">FRIENDS_WITH</data>
      <data key="d13">0.8</data>
      <data key="d14">This is the man of honor who deserves every bit of my loyalty and service</data>
    </edge>
    <edge source="Hawat" target="Duke" id="3">
      <data key="d12">LOYAL_TO</data>
      <data key="d13">0.9</data>
      <data key="d14">your loyalty to the Duke is all that guarantees your safety with me</data>
    </edge>
    <edge source="Hawat" target="My Lord" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">Hawat already has our own poison snooper over the dining table</data>
    </edge>
    <edge source="Hawat" target="my Lord" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">Hawat's men have been over it in depth.</data>
    </edge>
    <edge source="Hawat" target="passage" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Hawat's suspicious inspection of this castellated pile of rocks could dispel the feeling.</data>
    </edge>
    <edge source="Hawat" target="advance agents" id="0">
      <data key="d12">SENDS</data>
      <data key="d13">0.9</data>
      <data key="d14">Hawat sent advance agents in here by the battalion.</data>
    </edge>
    <edge source="Hawat" target="Jessica" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">Hawat certified this place, Jessica thought.</data>
    </edge>
    <edge source="Hawat" target="Jessica" id="1">
      <data key="d12">KNOWS</data>
      <data key="d13">0.8</data>
      <data key="d14">Both Hawat and I have inspected</data>
    </edge>
    <edge source="Hawat" target="Jessica" id="2">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.7</data>
      <data key="d14">Hawat slipped a hand beneath his tunic where he kept a tiny projector of poison darts.</data>
    </edge>
    <edge source="Hawat" target="door prop" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">The prop carried Hawat's personal mark.</data>
    </edge>
    <edge source="Hawat" target="Hawat's men" id="0">
      <data key="d12">LEADS</data>
      <data key="d13">0.9</data>
      <data key="d14">Hawat's men are searching the house right now</data>
    </edge>
    <edge source="Hawat" target="Atreides" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">a tall man in Atreides uniform with a Hawat insignia on his cap</data>
    </edge>
    <edge source="Hawat" target="Atreides" id="1">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">aware that the old man had served three generations of Atreides.</data>
    </edge>
    <edge source="Hawat" target="Harkonnens" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">"We will kill Harkonnens," the Fremen said.</data>
    </edge>
    <edge source="Hawat" target="Sire" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">Hawat has an agent there waiting to take them.</data>
    </edge>
    <edge source="Hawat" target="Sire" id="1">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">Hawat believes there could be some bad ones planted in the group</data>
    </edge>
    <edge source="Hawat" target="Leto" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">The Duke turned to Hawat. "Thufir, did you get those account books you said you could buy?"</data>
    </edge>
    <edge source="Hawat" target="Leto" id="1">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">Hawat continued to stare at him, thinking: This is how I like him best. This is the man of honor who deserves every bit of my loyalty and service.</data>
    </edge>
    <edge source="Hawat" target="Leto" id="2">
      <data key="d12">LOYAL_TO</data>
      <data key="d13">0.9</data>
      <data key="d14">This is the man of honor who deserves every bit of my loyalty and service.</data>
    </edge>
    <edge source="Hawat" target="Idaho's report" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"According to Idaho's report," Hawat said, "shields are dangerous in the desert.</data>
    </edge>
    <edge source="Hawat" target="Mentat semitrance" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">He closed his eyes in Mentat semitrance</data>
    </edge>
    <edge source="Hawat" target="Duncan" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">"Duncan was clear on one thing: those bases or the idea of them hold some deep significance for the Fremen."</data>
    </edge>
    <edge source="Hawat" target="city" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Hawat's in the city, my Lady.</data>
    </edge>
    <edge source="Hawat" target="High College" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">He's conditioned by the High College. That I know for certain.</data>
    </edge>
    <edge source="Hawat" target="Bene Gesserit" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.8</data>
      <data key="d14">"I don't trust your Bene Gesserit motives," he said.</data>
    </edge>
    <edge source="Hawat" target="Bene Gesserit" id="1">
      <data key="d12">KNOWS</data>
      <data key="d13">0.8</data>
      <data key="d14">they must know the Bene Gesserit make difficult targets</data>
    </edge>
    <edge source="Hawat" target="his men" id="0">
      <data key="d12">LEADS</data>
      <data key="d13">0.9</data>
      <data key="d14">Hawat glanced back at the huddle of his men</data>
    </edge>
    <edge source="Hawat" target="bond of water" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">Not buying," Hawat said. "We've joined these people.</data>
    </edge>
    <edge source="Hawat" target="fight" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">"We will fight in the time of fighting," the man said.</data>
    </edge>
    <edge source="Hawat" target="Sardaukar" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">"We will kill Harkonnens," the Fremen said. He grinned. "And Sardaukar."</data>
    </edge>
    <edge source="Hawat" target="Arrakeen" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.7</data>
      <data key="d14">"And they'll help us get to Arrakeen?"</data>
    </edge>
    <edge source="Hawat" target="EVENT" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">the Fremen beside Hawat said.</data>
    </edge>
    <edge source="Hawat" target="Fremen companion" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">Hawat's Fremen companion</data>
    </edge>
    <edge source="House Harkonnen" target="Imperial House" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.8</data>
      <data key="d14">since House Harkonnen is being used to do the Imperial dirty work</data>
    </edge>
    <edge source="House Harkonnen" target="CHOAM Company" id="0">
      <data key="d12">OWNS</data>
      <data key="d13">0.9</data>
      <data key="d14">we'll have an irrevocable directorship in the CHOAM Company</data>
    </edge>
    <edge source="House Harkonnen" target="subfief on Arrakis" id="0">
      <data key="d12">OWNS</data>
      <data key="d13">0.9</data>
      <data key="d14">"House Harkonnen will have a subfief on Arrakis within a Standard year."</data>
    </edge>
    <edge source="House Harkonnen" target="Arrakis" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Oh, how he'll be hated here on Arrakis!</data>
    </edge>
    <edge source="Kynes" target="His Majesty" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">that path is blocked by one of His Majesty's agents -- the planetary ecologist. You may remember him -- Kynes.</data>
    </edge>
    <edge source="Kynes" target="Imperial" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">"this Kynes is an Imperial servant."</data>
    </edge>
    <edge source="Kynes" target="Imperial" id="1">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">"this Kynes is an Imperial servant."</data>
    </edge>
    <edge source="Kynes" target="Imperial" id="2">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">The Imperial Planetologist, Kynes, is involved</data>
    </edge>
    <edge source="Kynes" target="Imperium" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">"This Kynes has arbiter authority from the Imperium."</data>
    </edge>
    <edge source="Kynes" target="Imperium" id="1">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">His Majesty supports my work</data>
    </edge>
    <edge source="Kynes" target="Gurney Halleck" id="0">
      <data key="d12">HATES</data>
      <data key="d13">0.8</data>
      <data key="d14">Kynes took a deep breath to still his resentment against Halleck</data>
    </edge>
    <edge source="Kynes" target="Duke" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">"They're of Fremen make and as near as possible the dimensions given me by your man Halleck here."</data>
    </edge>
    <edge source="Kynes" target="Duke" id="1">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">"Someday I may show you a sietch factory," Kynes said.</data>
    </edge>
    <edge source="Kynes" target="Duke" id="2">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Kynes took a deep breath, then: "It's the Duke's wish that you divide the bonus among your crew.</data>
    </edge>
    <edge source="Kynes" target="Duke" id="3">
      <data key="d12">LIKES</data>
      <data key="d13">0.9</data>
      <data key="d14">Kynes admitted to himself: I like this Duke.</data>
    </edge>
    <edge source="Kynes" target="Hawat" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.7</data>
      <data key="d14">Order me questioned half the night by that Mentat, will they?</data>
    </edge>
    <edge source="Kynes" target="Idaho" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.8</data>
      <data key="d14">And it was obvious they'd learned of the bases from Idaho. I will have Stilgar send Idaho's head to this Duke, Kynes told himself.</data>
    </edge>
    <edge source="Kynes" target="Imperial Planetologist" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">But I am in His Majesty's service, the Imperial Planetologist.</data>
    </edge>
    <edge source="Kynes" target="Judge of the Change" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Son, this is the Judge of the Change, the arbiter of dispute, the man set here to see that the forms are obeyed in our assumption of power over this fief.</data>
    </edge>
    <edge source="Kynes" target="ecologist" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"You're the ecologist," the Duke said.</data>
    </edge>
    <edge source="Kynes" target="Planetologist" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"We prefer the old title here, my Lord," Kynes said. "Planetologist."</data>
    </edge>
    <edge source="Kynes" target="Fremen escort" id="0">
      <data key="d12">LEADS</data>
      <data key="d13">0.9</data>
      <data key="d14">The Fremen escort Kynes had left in the shade of the administration building leaped up from their squatting repose, muttering in open agitation.</data>
    </edge>
    <edge source="Kynes" target="Fremen escort" id="1">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Kynes had come with a Fremen escort</data>
    </edge>
    <edge source="Kynes" target="Arrakis" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"You never talk of likelihoods on Arrakis. You speak only of possibilities."</data>
    </edge>
    <edge source="Kynes" target="Arrakis" id="1">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"Arrakis is tough on equipment."</data>
    </edge>
    <edge source="Kynes" target="Fremen" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">the man was Fremen.</data>
    </edge>
    <edge source="Kynes" target="Fremen" id="1">
      <data key="d12">KNOWS</data>
      <data key="d13">0.8</data>
      <data key="d14">You've associated so long with Fremen</data>
    </edge>
    <edge source="Kynes" target="Fremen" id="2">
      <data key="d12">LEADS</data>
      <data key="d13">0.9</data>
      <data key="d14">Kynes called and he veered left. Behind Kynes, other Fremen were throwing fabric covers over their ornithopters.</data>
    </edge>
    <edge source="Kynes" target="suit" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"Certainly," Kynes said. He felt up under the robe for the shoulder seals, speaking as he examined the suit.</data>
    </edge>
    <edge source="Kynes" target="Paul" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">Paul stretched up in the seat to peer ahead, saw a rolling yellow cloud low on the desert surface some thirty kilometers ahead. "One of your factory crawlers," Kynes said.</data>
    </edge>
    <edge source="Kynes" target="Paul" id="1">
      <data key="d12">LEADS</data>
      <data key="d13">0.8</data>
      <data key="d14">He did what any good guerrilla leader would</data>
    </edge>
    <edge source="Kynes" target="EVENT" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Kynes fastened his harness, focused on the padded comfort of the aircraft-soft luxury of gray-green upholstery, gleaming instruments, the sensation of filtered and washed air in his lungs as doors slammed and vent fans whirred alive.</data>
    </edge>
    <edge source="Kynes" target="EVENT" id="1">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"Rich spice bed by the color," Kynes said.</data>
    </edge>
    <edge source="Kynes" target="legend" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.7</data>
      <data key="d14">And Kynes rubbed his cheek, thinking of the legend: "He shall know your ways as though born to them."</data>
    </edge>
    <edge source="Kynes" target="propaganda" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">I've seen the propaganda you've flooded into sietch and village</data>
    </edge>
    <edge source="Kynes" target="Duke's question" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">He didn't answer my question, the Duke thought.</data>
    </edge>
    <edge source="Kynes" target="spice mining" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"We'll see actual spice mining today?" Paul asked. "Very likely," Kynes said.</data>
    </edge>
    <edge source="Kynes" target="the Duke" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">Kynes glanced at the Duke, said: "You do travel with a light complement of  guards, my Lord.</data>
    </edge>
    <edge source="Kynes" target="worms" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"You may see one today," Kynes said. "Wherever there is spice, there are worms."</data>
    </edge>
    <edge source="Kynes" target="eagle" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"That's likely an eagle," Kynes said.</data>
    </edge>
    <edge source="Kynes" target="desert" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"Not from the deep desert," Kynes said.</data>
    </edge>
    <edge source="Kynes" target="monograph" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">I'll give you my monograph on the subject.</data>
    </edge>
    <edge source="Kynes" target="Halleck" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.8</data>
      <data key="d14">"The worm always comes, eh?" Halleck asked.</data>
    </edge>
    <edge source="Kynes" target="Worm" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"Worm," Kynes said. "Big one."</data>
    </edge>
    <edge source="Kynes" target="Spotter Control" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.8</data>
      <data key="d14">Kynes spoke into the microphone: "Unlisted flight--north and east of you about three kilometers. Wormsign is on intercept course, your position, estimated contact twenty-five minutes." Another voice rumbled from the speaker: "This is Spotter Control. Sighting confirmed.</data>
    </edge>
    <edge source="Kynes" target="worm" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"I hear the worm, but I can't see it," Kynes said.</data>
    </edge>
    <edge source="Kynes" target="Collected Sayings of Muad'Dib" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Kynes said; "When God hath ordained a creature to die in a particular place.</data>
    </edge>
    <edge source="Kynes" target="Imperial Civil Servant" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">the planetologist wore an old-style dark brown uniform with epaulets of the Imperial Civil Servant</data>
    </edge>
    <edge source="Kynes" target="Jessica" id="0">
      <data key="d12">LOVES</data>
      <data key="d13">0.7</data>
      <data key="d14">The man was staring at Jessica. He appeared transfigured--like a man in love . . .</data>
    </edge>
    <edge source="Kynes" target="Jessica" id="1">
      <data key="d12">KNOWS</data>
      <data key="d13">0.8</data>
      <data key="d14">He smiled at Jessica as he caught her watching him, raised the empty flagon to her in a silent toast.</data>
    </edge>
    <edge source="Kynes" target="Jessica" id="2">
      <data key="d12">LEADS</data>
      <data key="d13">0.8</data>
      <data key="d14">He did what any good guerrilla leader would</data>
    </edge>
    <edge source="Kynes" target="dinner" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">The Guild Bank representative looked across at Kynes.</data>
    </edge>
    <edge source="Kynes" target="passage" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"There's Kynes," she said.</data>
    </edge>
    <edge source="Kynes" target="Tuek" id="0">
      <data key="d12">FRIENDS_WITH</data>
      <data key="d13">0.75</data>
      <data key="d14">There existed an accord of some sort between Kynes and Tuek.</data>
    </edge>
    <edge source="Kynes" target="banker" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.8</data>
      <data key="d14">Kynes would have killed him without hesitating, she thought.</data>
    </edge>
    <edge source="Kynes" target="banker" id="1">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">Kynes spoke to the banker: "Isn't another apology in order?"</data>
    </edge>
    <edge source="Kynes" target="Great House" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">It's rare to find members of a Great House aware of planetological problems," Kynes said.</data>
    </edge>
    <edge source="Kynes" target="Tansley Effect" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"We've had a long time in which to build up the Tansley Effect--small-unit experiments on an amateur basis from which my science may now draw its working facts." Kynes said.</data>
    </edge>
    <edge source="Kynes" target="prophecies" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"He dreams with the Fremen--of prophecies and messiahs."</data>
    </edge>
    <edge source="Kynes" target="messiahs" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"He dreams with the Fremen--of prophecies and messiahs."</data>
    </edge>
    <edge source="Kynes" target="people" id="0">
      <data key="d12">LEADS</data>
      <data key="d13">0.9</data>
      <data key="d14">Where Kynes leads, people follow, Jessica thought.</data>
    </edge>
    <edge source="Kynes" target="song" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.7</data>
      <data key="d14">I suspect it was an imaginative invention made solely for purposes of a song.</data>
    </edge>
    <edge source="Kynes" target="Paul Atreides" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.8</data>
      <data key="d14">Kynes realized in that moment the dukedom still existed and solely because of this youth</data>
    </edge>
    <edge source="Kynes" target="The Baron" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.8</data>
      <data key="d14">The Imperial lackey, this Kynes," the Baron said. "He was playing a double game, eh?</data>
    </edge>
    <edge source="Kynes" target="his father" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">It was the voice of his father who had been planetologist here before him-his father long dead, killed in the cave-in at Plaster Basin.</data>
    </edge>
    <edge source="Kynes" target="LOCATION" id="0">
      <data key="d12">LOVES</data>
      <data key="d13">0.8</data>
      <data key="d14">And I am a desert creature, Kynes thought. You see me, Father? I am a desert creature.</data>
    </edge>
    <edge source="Kynes" target="Private Reflections on Muad'Dib" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"Private Reflections on Muad'Dib" by the Princess Irulan</data>
    </edge>
    <edge source="St. Alia-of-the-Knife" target="Muad'Dib, Family Commentaries" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Thus spoke St. Alia-of-the-Knife: "The Reverend Mother must combine the seductive wiles of a courtesan with the untouchable majesty of a virgin goddess, holding these attributes in tension so long as the powers of her youth endure. For when youth and beauty have gone, she will find that the place-between, once occupied by tension, has become a wellspring of cunning and resourcefulness." -from "Muad'Dib, Family Commentaries" by the Princess Irulan</data>
    </edge>
    <edge source="CHOAM" target="passage" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">The Imperium, the CHOAM Company, all the Great Houses, they are but bits of flotsam in the path of the flood.</data>
    </edge>
    <edge source="CHOAM" target="path of the flood" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">path of the flood."   "CHOAM," Jessica muttered.</data>
    </edge>
    <edge source="CHOAM" target="Logs, donkeys, horses, cows, lumber, dung, sharks, whale fur" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Few products escape the CHOAM touch," the Duke said. "Logs, donkeys, horses, cows, lumber, dung, sharks, whale fur</data>
    </edge>
    <edge source="CHOAM" target="pundi rice from Caladan" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">even our poor pundi rice from Caladan</data>
    </edge>
    <edge source="CHOAM" target="art forms of Ecaz, the machines of Richesse and Ix" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">the art forms of Ecaz, the machines of Richesse and Ix</data>
    </edge>
    <edge source="Harkonnen" target="my Lord" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.8</data>
      <data key="d14">this planet's infested with Harkonnen intrigues.</data>
    </edge>
    <edge source="Harkonnen" target="CHOAM" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.7</data>
      <data key="d14">Harkonnen titles came out of the CHOAM pocketbook.</data>
    </edge>
    <edge source="Harkonnen" target="Duke Leto Atreides" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.8</data>
      <data key="d14">his enemies--between Harkonnen agents.</data>
    </edge>
    <edge source="Harkonnen" target="Duke's statement" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"Admirably suited to Harkonnen morality," the Duke said.</data>
    </edge>
    <edge source="Harkonnen" target="entrepreneur class" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">Most were well situated, my Lord--in the entrepreneur class.</data>
    </edge>
    <edge source="Imperial Household" target="Federated Great Houses of the Landsraad" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.8</data>
      <data key="d14">We've a three-point civilization: the Imperial Household balanced against the Federated Great Houses of the Landsraad, and between them, the Guild with its damnable monopoly on interstellar transport.</data>
    </edge>
    <edge source="Missionaria Protectiva" target="Bene Gesserit" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">a Bene Gesserit of the Missionaria Protectiva</data>
    </edge>
    <edge source="Gurney Halleck" target="tone poems" id="0">
      <data key="d12">CREATED</data>
      <data key="d13">0.9</data>
      <data key="d14">It's just one of Gurney Halleck's tone poems for sad times.</data>
    </edge>
    <edge source="Gurney Halleck" target="Muad'Dib" id="0">
      <data key="d12">FRIENDS_WITH</data>
      <data key="d13">0.8</data>
      <data key="d14">Muad'Dib did have wonderful companion-teachers. There was Gurney Halleck, the troubadour-warrior.</data>
    </edge>
    <edge source="Gurney Halleck" target="Paul" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.8</data>
      <data key="d14">"are you the new weapons master?" Halleck kicked the door shut with one heel.</data>
    </edge>
    <edge source="Gurney Halleck" target="Paul" id="1">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">Paul grinned. Of all his father's men, he liked Gurney Halleck best, knew the man's moods and deviltry, his humors, and thought of him more as a friend than as a hired sword.</data>
    </edge>
    <edge source="Gurney Halleck" target="Paul's father" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">Of all his father's men, he liked Gurney Halleck best</data>
    </edge>
    <edge source="Gurney Halleck" target="Duke" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">As to your father -the Duke'd punish me only if I failed to make a first-class fighting man out of you.</data>
    </edge>
    <edge source="Gurney Halleck" target="Duke" id="1">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">The Duke watched Halleck, admiring the ugly lump of a man</data>
    </edge>
    <edge source="Gurney Halleck" target="poem" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">a poem Gurney Halleck often repeated</data>
    </edge>
    <edge source="Gurney Halleck" target="EVENT" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Gurney Halleck strode along at the point of the crowd</data>
    </edge>
    <edge source="Gurney Halleck" target="Harkonnens" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.8</data>
      <data key="d14">"There are still some Harkonnens for you," the Duke said.</data>
    </edge>
    <edge source="Gurney Halleck" target="Kynes" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">With the two, garbed like them for the desert, came a man Kynes recognized-Gurney Halleck.</data>
    </edge>
    <edge source="Gurney Halleck" target="Idaho" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">She saw a handsignal pass from Halleck to Idaho</data>
    </edge>
    <edge source="Gurney Halleck" target="passage" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Leto suddenly recalled a thing Gurney Halleck had said once</data>
    </edge>
    <edge source="Gurney Halleck" target="smuggler friends" id="0">
      <data key="d12">FRIENDS_WITH</data>
      <data key="d13">0.9</data>
      <data key="d14">"Your man Gurney Halleck and part of his force are safe with our smuggler friends," the Fremen said.</data>
    </edge>
    <edge source="Gurney Halleck" target="Muad'Dib: Conversations" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"So you're the great Gurney Halleck," the man said.</data>
    </edge>
    <edge source="Gurney Halleck" target="Staban Tuek" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.8</data>
      <data key="d14">"So you're the great Gurney Halleck," the man said.</data>
    </edge>
    <edge source="Gurney Halleck" target="Tuek" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">They've followed you this far, Gurney Halleck.</data>
    </edge>
    <edge source="his father" target="Paul" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">"My father is dead," he said.</data>
    </edge>
    <edge source="his father" target="planetologist" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">It was the voice of his father who had been planetologist here before him</data>
    </edge>
    <edge source="his father" target="cave-in at Plaster Basin" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">his father long dead, killed in the cave-in at Plaster Basin.</data>
    </edge>
    <edge source="Duncan Idaho" target="Muad'Dib" id="0">
      <data key="d12">FRIENDS_WITH</data>
      <data key="d13">0.8</data>
      <data key="d14">There were Duncan Idaho, the Swordmaster of the Ginaz;</data>
    </edge>
    <edge source="Duncan Idaho" target="A Child's History of Muad'Dib" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">There were Duncan Idaho, the Swordmaster of the Ginaz;</data>
    </edge>
    <edge source="Duncan Idaho" target="second wave onto Arrakis" id="0">
      <data key="d12">LEADS</data>
      <data key="d13">0.9</data>
      <data key="d14">Duncan's gone to lead the second wave onto Arrakis</data>
    </edge>
    <edge source="Duncan Idaho" target="Duke" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">I sent a mission headed by Duncan Idaho</data>
    </edge>
    <edge source="Duncan Idaho" target="negotiating with the Fremen" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">I sent a mission headed by Duncan Idaho</data>
    </edge>
    <edge source="Duncan Idaho" target="people" id="0">
      <data key="d12">ADMIRE</data>
      <data key="d13">0.9</data>
      <data key="d14">Duncan Idaho says they're to be admired.</data>
    </edge>
    <edge source="Duncan Idaho" target="Duke Leto Atreides" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">Idaho's voice boomed across the room: "Hold!"</data>
    </edge>
    <edge source="Duncan Idaho" target="Fremen" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">He will be Fremen and soldier of the Atreides.</data>
    </edge>
    <edge source="Duncan Idaho" target="Atreides" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">He will be Fremen and soldier of the Atreides.</data>
    </edge>
    <edge source="Duncan Idaho" target="Turok" id="0">
      <data key="d12">FRIENDS_WITH</data>
      <data key="d13">0.9</data>
      <data key="d14">You are friends of Turok.</data>
    </edge>
    <edge source="Duncan Idaho" target="Hawat" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">He had been summoned back from the Fremen and had his orders from Hawat</data>
    </edge>
    <edge source="Duncan Idaho" target="surveillance" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Under pretext of guarding her, you will keep the Lady Jessica under constant surveillance.</data>
    </edge>
    <edge source="Duncan Idaho" target="house guards" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.8</data>
      <data key="d14">To her right near the front entry, she saw two house guards holding Duncan Idaho between them.</data>
    </edge>
    <edge source="Duncan Idaho" target="The Collected Sayings of Muad'Dib" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.7</data>
      <data key="d14">There is no escape--we pay for the violence of our ancestors. " -from "The Collected Sayings of Muad'Dib" by the Princess Irulan</data>
    </edge>
    <edge source="Duncan Idaho" target="Grumman" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">My sword was firs' blooded on Grumman!</data>
    </edge>
    <edge source="Duncan Idaho" target="dinner party" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">the dress shirt he had worn at the dinner party earlier</data>
    </edge>
    <edge source="Duncan Idaho" target="special surveillance of the ladies" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">They're always calling on Idaho for special surveillance of the ladies.</data>
    </edge>
    <edge source="Duncan Idaho" target="spice beer" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Tonight, he overindulged in something called spice beer.</data>
    </edge>
    <edge source="Duncan Idaho" target="Stilgar" id="0">
      <data key="d12">FRIENDS_WITH</data>
      <data key="d13">0.8</data>
      <data key="d14">You took away with you my father's man, Duncan Idaho--an exchange of friends.</data>
    </edge>
    <edge source="Duncan Idaho" target="Paul's memory" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Memory of Duncan Idaho's voice flowed through Paul's awareness</data>
    </edge>
    <edge source="Dr. Wellington Yueh" target="Muad'Dib" id="0">
      <data key="d12">FRIENDS_WITH</data>
      <data key="d13">0.8</data>
      <data key="d14">Dr. Wellington Yueh, a name</data>
    </edge>
    <edge source="Dr. Wellington Yueh" target="A Child's History of Muad'Dib" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Dr. Wellington Yueh, a name black in treachery but bright in knowledge;</data>
    </edge>
    <edge source="Proctor" target="whip our dear Lady Jessica into line" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">sent the old Proctor here -- to whip our dear Lady Jessica into line</data>
    </edge>
    <edge source="Paul Atreides" target="Duke" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">Paul Atreides, descendant of kings, son of a Duke</data>
    </edge>
    <edge source="Paul Atreides" target="Jessica" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">Paul had sensed his mother come up beside him</data>
    </edge>
    <edge source="Paul Atreides" target="Reverend Mother" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">Paul had been caught more by her tone</data>
    </edge>
    <edge source="Paul Atreides" target="moons" id="0">
      <data key="d12">FRIENDS_WITH</data>
      <data key="d13">0.7</data>
      <data key="d14">The moons will be your friends</data>
    </edge>
    <edge source="Paul Atreides" target="sun" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.7</data>
      <data key="d14">the sun your enemy</data>
    </edge>
    <edge source="Paul Atreides" target="Mother" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">he'd already been warned -- by you, by Mother</data>
    </edge>
    <edge source="Paul Atreides" target="Hawat" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">True enough," Hawat muttered.</data>
    </edge>
    <edge source="Paul Atreides" target="Duncan" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">How'd she figure your father attracted men like Duncan and Gurney?</data>
    </edge>
    <edge source="Paul Atreides" target="Gurney" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">How'd she figure your father attracted men like Duncan and Gurney?</data>
    </edge>
    <edge source="Paul Atreides" target="Dr. Yueh" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">that's what Dr. Yueh calls the Mystery of Life.</data>
    </edge>
    <edge source="Paul Atreides" target="Halleck" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">Halleck moved to place himself between the man and Paul</data>
    </edge>
    <edge source="Paul Atreides" target="legend" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">But he was remembering the words of the legend: "The Lisan al-Gaib shall see through all subterfuge."</data>
    </edge>
    <edge source="Paul Atreides" target="Fremen" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.7</data>
      <data key="d14">Fremen! Paul thought.</data>
    </edge>
    <edge source="Paul Atreides" target="toast" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"I'll give you a toast," he said. "To young Paul Atreides, still a lad by his looks, but a man by his actions."</data>
    </edge>
    <edge source="Paul Atreides" target="his father" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">His father wanted!</data>
    </edge>
    <edge source="Paul Atreides" target="making this planet a fit place for humans" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"To make this planet a fit place for humans," Paul said.</data>
    </edge>
    <edge source="Paul Atreides" target="Kynes" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">Kynes asked. How carefully he avoids my title, Paul thought.</data>
    </edge>
    <edge source="Paul Atreides" target="Arrakis" id="0">
      <data key="d12">LEADS</data>
      <data key="d13">0.8</data>
      <data key="d14">You are technically the Duke.</data>
    </edge>
    <edge source="Paul Atreides" target="Imperium" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">I'm a soldier of the Imperium</data>
    </edge>
    <edge source="Paul Atreides" target="Padishah Emperor" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.8</data>
      <data key="d14">Now, I will give the Padishah Emperor reasons to fear</data>
    </edge>
    <edge source="Duncan" target="My Lord" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">Hawat speaks highly of her on the basis of Duncan's report.</data>
    </edge>
    <edge source="Duncan" target="Jessica" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.8</data>
      <data key="d14">They're convinced she wants to serve -specifically that she wants to serve you.</data>
    </edge>
    <edge source="Duncan" target="Leto" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">"I'm your ambassador to the Fremen, Sire."</data>
    </edge>
    <edge source="Duncan" target="ambassador to the Fremen" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"I'm your ambassador to the Fremen, Sire."</data>
    </edge>
    <edge source="Duncan" target="reports" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"According to the reports I have from Duncan."</data>
    </edge>
    <edge source="Gurney" target="Paul" id="0">
      <data key="d12">FRIENDS_WITH</data>
      <data key="d13">0.8</data>
      <data key="d14">Gurney tells me you did well in weapons today</data>
    </edge>
    <edge source="Gurney" target="Duke" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">The Duke said: "I forgot to mention that Gurney is also very talented in public relations."</data>
    </edge>
    <edge source="Gurney" target="Sire" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">Gurney. Those men have experience and skills we need.</data>
    </edge>
    <edge source="Gurney" target="Leto" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">Hawat swallowed. "At once, my Lord." He swiveled in the chair, called to the open door: "Gurney, bring them in."</data>
    </edge>
    <edge source="Gurney" target="Esmar Tuek" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">"A late addition to the list," she whispered. "Gurney arranged the invitation. Smuggler."</data>
    </edge>
    <edge source="Thufir" target="Duke" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">Thufir has anything to add to his report on the Fremen," the Duke said. "Thufir?"</data>
    </edge>
    <edge source="Thufir" target="Duke" id="1">
      <data key="d12">LOVES</data>
      <data key="d13">0.8</data>
      <data key="d14">You and I, Thufir, of all those who love the Duke, are most ideally situated to destroy the other's place.</data>
    </edge>
    <edge source="Thufir" target="Bene Gesserit" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">"You'll say nothing about what has happened here to anyone," she said. "I know you, Thufir."</data>
    </edge>
    <edge source="Thufir" target="Lady Jessica" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">"You may go now, Thufir."</data>
    </edge>
    <edge source="Thufir" target="Lady Jessica" id="1">
      <data key="d12">ADMIRATION_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">he would never forget this moment nor lose this sense of supreme admiration for the Lady Jessica.</data>
    </edge>
    <edge source="Halleck" target="Paul" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">Halleck watched the action, turned at the last minute to let the blunted blade pass his chest.</data>
    </edge>
    <edge source="Halleck" target="Paul" id="1">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.8</data>
      <data key="d14">This in the hand of an enemy can let out your life's blood!</data>
    </edge>
    <edge source="Halleck" target="shield" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Halleck activated his own shield, crouched with kindjal outthrust in left hand, the rapier poised high in his right.</data>
    </edge>
    <edge source="Halleck" target="Giedi Prime" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">in a Harkonnen slave pit on Giedi Prime</data>
    </edge>
    <edge source="Halleck" target="EVENT" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"All secure, Sire," Halleck said.</data>
    </edge>
    <edge source="Halleck" target="EVENT" id="1">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"Shouldn't we be hearing them call in the carryall?" Halleck asked.</data>
    </edge>
    <edge source="Halleck" target="younger sister" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">he recalled his younger sister, her elfin face so clear in his mind.</data>
    </edge>
    <edge source="Halleck" target="Sire" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">Halleck said. "Where shall I send them?"</data>
    </edge>
    <edge source="Halleck" target="Duke" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">Halleck stopped in the act of turning away, caught Leto's eye.</data>
    </edge>
    <edge source="Halleck" target="Duke" id="1">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">Halleck sat back, resumed strumming the baliset. Presently, he sang: "Wild beasts of the desert do hunt there, Waiting for the innocents to pass. Oh-h-h, tempt not the gods of the desert, Lest you seek a lonely epitaph. The perils of the--" He broke off, leaned forward. "Dust cloud ahead, Sire." "I see it, Gurney."</data>
    </edge>
    <edge source="Halleck" target="Duke" id="2">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.7</data>
      <data key="d14">you must believe our Duke is dead.</data>
    </edge>
    <edge source="Halleck" target="Leto" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">Halleck stopped in the act of turning away, caught Leto's eye.</data>
    </edge>
    <edge source="Halleck" target="Leto" id="1">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">Halleck said: "Wouldn't it be cheaper to reopen negotiations with the Guild for permission to orbit a frigate as a weather satellite?"</data>
    </edge>
    <edge source="Halleck" target="Harkonnens" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">the heart of an assassin when it came to dealing with the Harkonnens.</data>
    </edge>
    <edge source="Halleck" target="file of men" id="0">
      <data key="d12">LEADS</data>
      <data key="d13">0.9</data>
      <data key="d14">Halleck led the file of men into the room</data>
    </edge>
    <edge source="Halleck" target="O.C. Bible" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">recognizing the quotation from the O.C. Bible</data>
    </edge>
    <edge source="Halleck" target="the Duke" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">The Duke chuckled. "Gurney's one of a kind. I like him with me for  his eyes.</data>
    </edge>
    <edge source="Halleck" target="Kynes" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">"Then what?" Halleck asked. Kynes shrugged.</data>
    </edge>
    <edge source="Halleck" target="helping" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Halleck helped, dragging them into the rear.</data>
    </edge>
    <edge source="Halleck" target="Idaho" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.8</data>
      <data key="d14">a handsignal pass from Halleck to Idaho</data>
    </edge>
    <edge source="Halleck" target="Jessica" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">Jessica saw the near perfection of the girl's act, realized: That empty-headed little female is not an empty-headed little female. She saw then the pattern of the threat and understood that Halleck, too, had detected it.</data>
    </edge>
    <edge source="Halleck" target="Rabban" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">I've a score of my own against Rabban. I owe him for the lives of my family . . .</data>
    </edge>
    <edge source="Halleck" target="Duke Leto" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">the smuggler reminded him of Duke Leto</data>
    </edge>
    <edge source="Halleck" target="Arrakis" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.8</data>
      <data key="d14">"Arrakis is our enemy."</data>
    </edge>
    <edge source="Beast Rabban" target="Halleck" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">it had been put there by Beast Rabban in a Harkonnen slave pit on Giedi Prime</data>
    </edge>
    <edge source="Beast Rabban" target="Dune" id="0">
      <data key="d12">LEADS</data>
      <data key="d13">0.9</data>
      <data key="d14">Beast Rabban, so they say, will sit once more in the seat of power here on Dune.</data>
    </edge>
    <edge source="younger sister" target="pansies" id="0">
      <data key="d12">LOVES</data>
      <data key="d13">0.7</data>
      <data key="d14">She had loved pansies . . . or was it daisies?</data>
    </edge>
    <edge source="Harkonnen troops" target="pleasure house" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">But she was dead now -- in a pleasure house for Harkonnen troops.</data>
    </edge>
    <edge source="Wellington Yueh" target="Suk School" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">medical doctor of the Suk School</data>
    </edge>
    <edge source="Wellington Yueh" target="Wanna Marcus" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">md: Wanna Marcus</data>
    </edge>
    <edge source="Wellington Yueh" target="Duke Leto Atreides" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">chiefly noted as betrayer of Duke Leto Atreides</data>
    </edge>
    <edge source="Wellington Yueh" target="Dictionary of Muad'Dib" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">-from "Dictionary of Muad'Dib" by the Princess Irulan</data>
    </edge>
    <edge source="Duke Leto Atreides" target="Bene Gesserit lady" id="0">
      <data key="d12">LOVES</data>
      <data key="d13">0.9</data>
      <data key="d14">his abiding love for his Bene Gesserit lady</data>
    </edge>
    <edge source="Duke Leto Atreides" target="Muad'Dib" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">Muad'Dib's father</data>
    </edge>
    <edge source="Duke Leto Atreides" target="Paul" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">Paul watched his father enter the training room</data>
    </edge>
    <edge source="Duke Leto Atreides" target="crossing to Arrakis" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">I must use every opportunity to rest during the crossing to Arrakis</data>
    </edge>
    <edge source="Duke Leto Atreides" target="Arrakis" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">There'll be no rest on Arrakis.</data>
    </edge>
    <edge source="Duke Leto Atreides" target="Arrakis" id="1">
      <data key="d12">LEADS</data>
      <data key="d13">0.8</data>
      <data key="d14">The Duke Leto determines whether--</data>
    </edge>
    <edge source="Duke Leto Atreides" target="Reverend Mother" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.7</data>
      <data key="d14">Paul nodded, suddenly overcome by memory of the Reverend Mother's words: " . . . for the father, nothing."</data>
    </edge>
    <edge source="Duke Leto Atreides" target="Arrakeen" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">The Duke Leto Atreides leaned against a parapet of the landing control tower outside Arrakeen.</data>
    </edge>
    <edge source="Duke Leto Atreides" target="Muad'Dib: Family Commentaries" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">-from "Muad'Dib: Family Commentaries" by the Princess Irulan</data>
    </edge>
    <edge source="Duke Leto Atreides" target="frigates" id="0">
      <data key="d12">OWNS</data>
      <data key="d13">0.9</data>
      <data key="d14">five of his own frigates were posted around the rim like monolithic sentries.</data>
    </edge>
    <edge source="Duke Leto Atreides" target="taking possession of Arrakis" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"Our Sublime Padishah Emperor has charged me to take possession of this planet and end all dispute."</data>
    </edge>
    <edge source="Duke Leto Atreides" target="the governed" id="0">
      <data key="d12">RULES_WITH_CONSENT_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">It is said that the Duke Leto Atreides rules with the consent of the governed</data>
    </edge>
    <edge source="Duke Leto Atreides" target="Fremen" id="0">
      <data key="d12">RESPECTS</data>
      <data key="d13">0.9</data>
      <data key="d14">Sir, I honor and respect the personal dignity of any man who respects my dignity.</data>
    </edge>
    <edge source="Duke Leto Atreides" target="Spotter credit" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Kynes hesitated, then lifted the microphone; "Spotter credit to the Duke Leto Atreides. The Duke Leto Atreides. Over."</data>
    </edge>
    <edge source="Yueh" target="Paul" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">Paul joined him at the table, buttoning his jacket.</data>
    </edge>
    <edge source="Yueh" target="Orange Catholic Bible" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"It's a very old Orange Catholic Bible made for space travelers."</data>
    </edge>
    <edge source="Yueh" target="Fremen" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">"By all accounts," Yueh said. "They compose poems to their knives. Their women are as fierce as the men. Even Fremen children are violent and dangerous."</data>
    </edge>
    <edge source="Yueh" target="Wanna" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">my . . . dead wife's favorite passage</data>
    </edge>
    <edge source="Yueh" target="Wanna" id="1">
      <data key="d12">LOVES</data>
      <data key="d13">0.9</data>
      <data key="d14">She loved me, certainly.</data>
    </edge>
    <edge source="Yueh" target="Harkonnen" id="0">
      <data key="d12">HATES</data>
      <data key="d13">0.9</data>
      <data key="d14">Damn those Harkonnen beasts!</data>
    </edge>
    <edge source="Yueh" target="book" id="0">
      <data key="d12">GAVE</data>
      <data key="d13">0.9</data>
      <data key="d14">I thank you for the gift. Dr. Yueh</data>
    </edge>
    <edge source="Yueh" target="lessons" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"Someplace around the house taking his lessons with Yueh."</data>
    </edge>
    <edge source="Yueh" target="Jessica" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">"We've known each other six years," she said.</data>
    </edge>
    <edge source="Yueh" target="Jessica" id="1">
      <data key="d12">LOVES</data>
      <data key="d13">0.9</data>
      <data key="d14">If only it were possible to hate these people instead of love them!</data>
    </edge>
    <edge source="Yueh" target="these people" id="0">
      <data key="d12">LOVES</data>
      <data key="d13">0.9</data>
      <data key="d14">If only it were possible to hate these people instead of love them!</data>
    </edge>
    <edge source="Yueh" target="the palm trees" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">A line of twenty palm trees grew there, the ground beneath them swept clean, barren. A screen fence separated them from the road upon which robed people were passing. Jessica detected a faint shimmering in the air between her and the people--a house shield--and went on to study the passing throng, wondering why Yueh found them so absorbing.</data>
    </edge>
    <edge source="Yueh" target="Harkonnens" id="0">
      <data key="d12">HATES</data>
      <data key="d13">0.9</data>
      <data key="d14">"And I can assure you he hates the Harkonnens as bitterly as we do."</data>
    </edge>
    <edge source="Yueh" target="ENTITY" id="0">
      <data key="d12">PERSON</data>
      <data key="d13">0.9</data>
      <data key="d14">Yueh crossing to them, his medical kit swinging in his left hand.</data>
    </edge>
    <edge source="Yueh" target="Idaho" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">Yueh stiffened, whirled to face Jessica.</data>
    </edge>
    <edge source="Yueh" target="Leto" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">Yueh stood in the open door of the generator room.</data>
    </edge>
    <edge source="Yueh" target="Leto" id="1">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">Yueh's face carried a look of sadness as he bent over, touched Leto's forehead.</data>
    </edge>
    <edge source="Yueh" target="house generators" id="0">
      <data key="d12">SABOTAGED</data>
      <data key="d13">0.9</data>
      <data key="d14">Yueh! Leto thought. He's sabotaged the house generators!</data>
    </edge>
    <edge source="Yueh" target="dartgun" id="0">
      <data key="d12">OWNS</data>
      <data key="d13">0.9</data>
      <data key="d14">Yueh began walking toward him, pocketing a dartgun.</data>
    </edge>
