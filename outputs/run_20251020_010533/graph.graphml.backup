      <data key="d12">CREATED</data>
      <data key="d13">0.9</data>
      <data key="d14">description from "A Manual of Muad'Dib" by the Princess Irulan</data>
    </edge>
    <edge source="Emperor's daughter" target="Arrakis Awakening" id="0">
      <data key="d12">CREATED</data>
      <data key="d13">0.9</data>
      <data key="d14">Arrakis Awakening by the Princess Irulan</data>
    </edge>
    <edge source="Emperor's daughter" target="Muad'Dib: The Religious Issues" id="0">
      <data key="d12">CREATED</data>
      <data key="d13">0.9</data>
      <data key="d14">-from "Muad'Dib: The Religious Issues" by the Princess Irulan</data>
    </edge>
    <edge source="Emperor's daughter" target="Collected Legends of Arrakis" id="0">
      <data key="d12">CREATED</data>
      <data key="d13">0.9</data>
      <data key="d14">-"Collected Legends of Arrakis" by the Princess Irulan</data>
    </edge>
    <edge source="Emperor's daughter" target="Emperor" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">And among the lackeys stood one of the Emperor's daughters, the Princess Irulan</data>
    </edge>
    <edge source="Emperor's daughter" target="Bene Gesserit Sisterhood" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">a woman they said was being trained in the deepest of the Bene Gesserit ways, destined to be a Reverend Mother.</data>
    </edge>
    <edge source="Bene Gesserit's need" target="Wallach IX" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Bene Gesserit school on Wallach IX</data>
    </edge>
    <edge source="Bene Gesserit's need" target="Gathering Hall" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.7</data>
      <data key="d14">larger, Jessica saw, than even the Gathering Hall of her Bene Gesserit school.</data>
    </edge>
    <edge source="Wallach IX" target="Laoujin" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">WALLACH IX: ninth planet of Laoujin</data>
    </edge>
    <edge source="Imperial Household" target="Federated Great Houses of the Landsraad" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.8</data>
      <data key="d14">We've a three-point civilization: the Imperial Household balanced against the Federated Great Houses of the Landsraad</data>
    </edge>
    <edge source="Missionaria Protectiva" target="Arrakis" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"The Missionaria Protectiva has been in there and softened it up somewhat."</data>
    </edge>
    <edge source="Gurney Halleck" target="tone poems" id="0">
      <data key="d12">CREATED</data>
      <data key="d13">0.9</data>
      <data key="d14">It's just one of Gurney Halleck's tone poems for sad times.</data>
    </edge>
    <edge source="Gurney Halleck" target="Muad'Dib" id="0">
      <data key="d12">FRIENDS_WITH</data>
      <data key="d13">0.8</data>
      <data key="d14">But Muad'Dib did have wonderful companion-teachers. There was Gurney Halleck, the troubadour-warrior.</data>
    </edge>
    <edge source="Gurney Halleck" target="Muad'Dib" id="1">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"So you're the great Gurney Halleck," the man said.</data>
    </edge>
    <edge source="Gurney Halleck" target="Paul Atreides" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">each wounded man with an Atreides companion.</data>
    </edge>
    <edge source="Gurney Halleck" target="Paul Atreides" id="1">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">Of all his father's men, he liked Gurney Halleck best, knew the man's moods and deviltry, his humors, and thought of him more as a friend than as a hired sword.</data>
    </edge>
    <edge source="Gurney Halleck" target="Paul Atreides" id="2">
      <data key="d12">FRIENDS_WITH</data>
      <data key="d13">0.9</data>
      <data key="d14">They were your friends, Gurney.</data>
    </edge>
    <edge source="Gurney Halleck" target="Paul Atreides" id="3">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.7</data>
      <data key="d14">Is this betrayal? Paul wondered.</data>
    </edge>
    <edge source="Gurney Halleck" target="Paul Atreides" id="4">
      <data key="d12">TEACHES</data>
      <data key="d13">0.9</data>
      <data key="d14">his teachers men like Duncan Idaho and Gurney Halleck</data>
    </edge>
    <edge source="Gurney Halleck" target="Paul Atreides" id="5">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">This is the rightful Duke of Arrakis. Do as he commands.</data>
    </edge>
    <edge source="Gurney Halleck" target="Paul Atreides" id="6">
      <data key="d12">LOVES</data>
      <data key="d13">0.7</data>
      <data key="d14">why do you insist the Atreides must kill those they love?</data>
    </edge>
    <edge source="Gurney Halleck" target="council" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.7</data>
      <data key="d14">it was decided in council that you being such a poor fighter we'd best teach you the music trade</data>
    </edge>
    <edge source="Gurney Halleck" target="fight" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"Then, let's fight!" Halleck's eyes went wide in mock surprise. "So! It was your wicked hand did that deed! Guard yourself today, young master -- guard yourself." He grabbed up a rapier, laced the air with it. "I'm a hellfiend out for revenge!"</data>
    </edge>
    <edge source="Gurney Halleck" target="Duke" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">"Yours to command, my Lord."</data>
    </edge>
    <edge source="Gurney Halleck" target="Duke" id="1">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">The Duke watched Halleck</data>
    </edge>
    <edge source="Gurney Halleck" target="Duke" id="2">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.7</data>
      <data key="d14">you must believe our Duke is dead.</data>
    </edge>
    <edge source="Gurney Halleck" target="Duke" id="3">
      <data key="d12">LOYAL_TO</data>
      <data key="d13">0.9</data>
      <data key="d14">I've betrayed my own Duke!</data>
    </edge>
    <edge source="Gurney Halleck" target="Giedi Prime" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">in a Harkonnen slave pit on Giedi Prime</data>
    </edge>
    <edge source="Gurney Halleck" target="Arrakis" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Tomorrow we go to Arrakis</data>
    </edge>
    <edge source="Gurney Halleck" target="Arrakis" id="1">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">I'll stay on Arrakis--with you . . . or with the Fremen.</data>
    </edge>
    <edge source="Gurney Halleck" target="Arrakis" id="2">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">"Arrakis is our enemy."</data>
    </edge>
    <edge source="Gurney Halleck" target="younger sister" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">he recalled his younger sister, her elfin face so clear in his mind.</data>
    </edge>
    <edge source="Gurney Halleck" target="poem" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">a poem Gurney Halleck often repeated</data>
    </edge>
    <edge source="Gurney Halleck" target="arrival" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Gurney Halleck strode along at the point of the crowd, bag over one shoulder, the neck of his nine-string baliset clutched in the other hand.</data>
    </edge>
    <edge source="Gurney Halleck" target="EVENT" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Gurney was right behind, weapon drawn.</data>
    </edge>
    <edge source="Gurney Halleck" target="EVENT" id="1">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Halleck asked.</data>
    </edge>
    <edge source="Gurney Halleck" target="men" id="0">
      <data key="d12">LEADS</data>
      <data key="d13">0.9</data>
      <data key="d14">"I can let him have three hundred of my best," Halleck said.</data>
    </edge>
    <edge source="Gurney Halleck" target="Sire" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">"Shall I get about it at once, Sire?"</data>
    </edge>
    <edge source="Gurney Halleck" target="Leto Atreides" id="0">
      <data key="d12">FRIENDS_WITH</data>
      <data key="d13">0.8</data>
      <data key="d14">Halleck was a continual amazement--a head full of songs, quotations, and flowery phrases . . . and the heart of an assassin when it came to dealing with the Harkonnens.</data>
    </edge>
    <edge source="Gurney Halleck" target="Leto Atreides" id="1">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">"Gurney, bring them in." Halleck led the file of men into the room</data>
    </edge>
    <edge source="Gurney Halleck" target="House Harkonnen" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">and the heart of an assassin when it came to dealing with the Harkonnens.</data>
    </edge>
    <edge source="Gurney Halleck" target="O.C. Bible" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Halleck quoted</data>
    </edge>
    <edge source="Gurney Halleck" target="flight" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"All secure, Sire," Halleck said.</data>
    </edge>
    <edge source="Gurney Halleck" target="Duke Leto" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">Kynes glanced at the Duke, said: "You do travel with a light complement of guards, my Lord. Are all of them such men of many talents?"   "Gurney?" The Duke chuckled.</data>
    </edge>
    <edge source="Gurney Halleck" target="Duke Leto" id="1">
      <data key="d12">FRIENDS_WITH</data>
      <data key="d13">0.8</data>
      <data key="d14">"Gurney?" The Duke chuckled. "Gurney's one of a kind. I like him with me for his eyes. His eyes miss very little."</data>
    </edge>
    <edge source="Gurney Halleck" target="Duke Leto" id="2">
      <data key="d12">LOYAL_TO</data>
      <data key="d13">0.9</data>
      <data key="d14">I gave loyalty to the Duke Leto for no greater reason.</data>
    </edge>
    <edge source="Gurney Halleck" target="Duke Leto" id="3">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">the smuggler reminded him of Duke Leto</data>
    </edge>
    <edge source="Gurney Halleck" target="Kynes" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">"Then what?" Halleck asked. Kynes shrugged.</data>
    </edge>
    <edge source="Gurney Halleck" target="helping spice workers" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Halleck helped, dragging them into the rear.</data>
    </edge>
    <edge source="Gurney Halleck" target="Esmar Tuek" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">Gurney arranged the invitation. Smuggler.</data>
    </edge>
    <edge source="Gurney Halleck" target="dinner" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Halleck's music still wafted over the room, but it had come out of its minor key, lilting and lively now as though he were trying to lift the mood.</data>
    </edge>
    <edge source="Gurney Halleck" target="Duncan Idaho" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.8</data>
      <data key="d14">She saw a handsignal pass from Halleck to Idaho</data>
    </edge>
    <edge source="Gurney Halleck" target="Lady Jessica" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">realized: That empty-headed little female is not an empty-headed little female. She saw then the pattern of the threat and understood that Halleck, too, had detected it.</data>
    </edge>
    <edge source="Gurney Halleck" target="Lady Jessica" id="1">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">she felt the touch of the knife tip against her back. Chill awareness spread out from that knife tip. She knew in that instant that Gurney meant to kill her.</data>
    </edge>
    <edge source="Gurney Halleck" target="Lady Jessica" id="2">
      <data key="d12">FRIENDS_WITH</data>
      <data key="d13">0.8</data>
      <data key="d14">Let us think of this as a misunderstanding among old friends</data>
    </edge>
    <edge source="Gurney Halleck" target="passage" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Leto suddenly recalled a thing Gurney Halleck had said once</data>
    </edge>
    <edge source="Gurney Halleck" target="smuggler friends" id="0">
      <data key="d12">FRIENDS_WITH</data>
      <data key="d13">0.9</data>
      <data key="d14">Your man Gurney Halleck and part of his force are safe with our smuggler friends</data>
    </edge>
    <edge source="Gurney Halleck" target="Staban Tuek" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.8</data>
      <data key="d14">"Then you're the one I owe thanks for the help we've received," Halleck</data>
    </edge>
    <edge source="Gurney Halleck" target="Tuek" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">Halleck turned from his reflection, stared at Tuek.</data>
    </edge>
    <edge source="Gurney Halleck" target="Tuek" id="1">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">"You and those of your men we've saved are welcome to sanctuary among us," Tuek said. "You speak of gratitude. Very well; work off your debt to us.</data>
    </edge>
    <edge source="Gurney Halleck" target="Jessica Atreides" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.7</data>
      <data key="d14">Thufir Hawat suspected the Lady Jessica.</data>
    </edge>
    <edge source="Gurney Halleck" target="Rabban" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">I've a score of my own against Rabban.</data>
    </edge>
    <edge source="Gurney Halleck" target="family" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">I owe him for the lives of my family . . .</data>
    </edge>
    <edge source="Gurney Halleck" target="revenge" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">Move slowly and the day of your revenge will come</data>
    </edge>
    <edge source="Gurney Halleck" target="Duke's lieutenants" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">"You're the only one of the Duke's lieutenants to escape," Tuek said.</data>
    </edge>
    <edge source="Gurney Halleck" target="Caladan-born" id="0">
      <data key="d12">LEADS</data>
      <data key="d13">0.9</data>
      <data key="d14">They've followed me this far, but most are Caladan-born.</data>
    </edge>
    <edge source="Gurney Halleck" target="Tuek's aides" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.7</data>
      <data key="d14">through which he and his men had been led by Tuek's aides.</data>
    </edge>
    <edge source="Gurney Halleck" target="his men" id="0">
      <data key="d12">LEADS</data>
      <data key="d13">0.9</data>
      <data key="d14">Halleck noted with a touch of pride that those of his men still able to stand were standing</data>
    </edge>
    <edge source="Gurney Halleck" target="baliset" id="0">
      <data key="d12">OWNS</data>
      <data key="d13">0.9</data>
      <data key="d14">One of his lieutenants stepped forward carrying Halleck's nine-string baliset out of its case.</data>
    </edge>
    <edge source="Gurney Halleck" target="song 'My Woman'" id="0">
      <data key="d12">CREATED</data>
      <data key="d13">0.7</data>
      <data key="d14">It's the one called 'My Woman,' sir.</data>
    </edge>
    <edge source="Gurney Halleck" target="Great House" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">Warmasters Gurney Halleck and Duncan Idaho had trained a fighting force</data>
    </edge>
    <edge source="Gurney Halleck" target="Hawat's thoughts" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">this new religious leader that Gurney Halleck hinted at from his hiding place among the smugglers</data>
    </edge>
    <edge source="Gurney Halleck" target="smuggler band" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">Gurney whose face he had seen in a smuggler band</data>
    </edge>
    <edge source="Gurney Halleck" target="spice factory operation" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">In the con-bubble of the factory, Gurney Halleck leaned forward, adjusted the oil lenses of his binoculars and examined the landscape.</data>
    </edge>
    <edge source="Gurney Halleck" target="ground party" id="0">
      <data key="d12">LEADS</data>
      <data key="d13">0.9</data>
      <data key="d14">decided it would be safest to lead a ground party through the ridge.</data>
    </edge>
    <edge source="Gurney Halleck" target="Harkonnen" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">You couldn't be too careful when Fremen and Harkonnen were at each other's throats.</data>
    </edge>
    <edge source="Gurney Halleck" target="Fremen" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">You couldn't be too careful when Fremen and Harkonnen were at each other's throats.</data>
    </edge>
    <edge source="Gurney Halleck" target="Fremen" id="1">
      <data key="d12">KNOWS</data>
      <data key="d13">0.8</data>
      <data key="d14">The eyes were the blue-in-blue of the deep-desert Fremen.</data>
    </edge>
    <edge source="Gurney Halleck" target="factory commander" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.8</data>
      <data key="d14">A head popped up into the con-bubble beside Gurney -- the factory commander</data>
    </edge>
    <edge source="Gurney Halleck" target="his personal guard" id="0">
      <data key="d12">LEADS</data>
      <data key="d13">0.9</data>
      <data key="d14">The five men of his personal guard were out with him, emerging from the nose hatch.</data>
    </edge>
    <edge source="Gurney Halleck" target="his platoon" id="0">
      <data key="d12">LEADS</data>
      <data key="d13">0.9</data>
      <data key="d14">They disgorged Gurney's platoon and lifted to hoverflight.</data>
    </edge>
    <edge source="Gurney Halleck" target="the business" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">Many things about this business worried him, but the rewards were great.</data>
    </edge>
    <edge source="Gurney Halleck" target="the rocks" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">He began climbing up into the rocks, checking the terrain</data>
    </edge>
    <edge source="Gurney Halleck" target="unknown man" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">"You know my name?" he said.</data>
    </edge>
    <edge source="Gurney Halleck" target="smugglers" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">"They're smugglers all," Gurney said.</data>
    </edge>
    <edge source="Gurney Halleck" target="stories and rumors" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">"There's been stories and rumors," Gurney said.</data>
    </edge>
    <edge source="Gurney Halleck" target="stories" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Many times have I heard you speak of the prowess of Gurney Halleck on the baliset.</data>
    </edge>
    <edge source="Gurney Halleck" target="Stilgar" id="0">
      <data key="d12">FRIENDS_WITH</data>
      <data key="d13">0.9</data>
      <data key="d14">"Any killer of Harkonnens I'd feel honored to count among my friends."</data>
    </edge>
    <edge source="Gurney Halleck" target="Caladan" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.8</data>
      <data key="d14">Gurney and his music had been a part of so many pleasant times on Caladan</data>
    </edge>
    <edge source="Gurney Halleck" target="Chusuk" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"Brought from Chusuk, a sweet instrument.</data>
    </edge>
    <edge source="Gurney Halleck" target="tune" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Gurney take up a tune behind him</data>
    </edge>
    <edge source="Gurney Halleck" target="Fedaykin" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.7</data>
      <data key="d14">"He talks like a Fedaykin."</data>
    </edge>
    <edge source="Gurney Halleck" target="storm" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Gurney turned to obey.</data>
    </edge>
    <edge source="Gurney Halleck" target="explosion" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Gurney depressed the blast trigger.</data>
    </edge>
    <edge source="Gurney Halleck" target="the day we first came here with your father" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.7</data>
      <data key="d14">"I remember the day we first came here with your father," Gurney said.</data>
    </edge>
    <edge source="his father" target="Paul Atreides" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">My father is dead</data>
    </edge>
    <edge source="his father" target="planetologist" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">It was the voice of his father who had been planetologist here before him</data>
    </edge>
    <edge source="his father" target="cave-in at Plaster Basin" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">his father long dead, killed in the cave-in at Plaster Basin.</data>
    </edge>
    <edge source="his father" target="entirely new form of ecological notation" id="0">
      <data key="d12">CREATED</data>
      <data key="d13">0.9</data>
      <data key="d14">I've created this entirely new form of ecological notation</data>
    </edge>
    <edge source="Duncan Idaho" target="Muad'Dib" id="0">
      <data key="d12">FRIENDS_WITH</data>
      <data key="d13">0.8</data>
      <data key="d14">There were Duncan Idaho, the Swordmaster of the Ginaz;</data>
    </edge>
    <edge source="Duncan Idaho" target="second wave onto Arrakis" id="0">
      <data key="d12">LEADS</data>
      <data key="d13">0.9</data>
      <data key="d14">Duncan's gone to lead the second wave onto Arrakis</data>
    </edge>
    <edge source="Duncan Idaho" target="Duke" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">I sent a mission headed by Duncan Idaho</data>
    </edge>
    <edge source="Duncan Idaho" target="negotiating with the Fremen" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">We're negotiating with the Fremen right now</data>
    </edge>
    <edge source="Duncan Idaho" target="Lady Jessica" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">"He's supposed to be here!" Jessica snapped. "He has a job to do here."</data>
    </edge>
    <edge source="Duncan Idaho" target="Lady Jessica" id="1">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">Idaho jerked himself upright, scowling down at her.</data>
    </edge>
    <edge source="Duncan Idaho" target="Lady Jessica" id="2">
      <data key="d12">FRIENDS_WITH</data>
      <data key="d13">0.8</data>
      <data key="d14">The Fremen from the ornithopters stopped above them. One called in a low voice: "We should get under cover, friends." Paul got to his feet as Idaho helped Jessica up.</data>
    </edge>
    <edge source="Duncan Idaho" target="Fremen" id="0">
      <data key="d12">ADMIRE</data>
      <data key="d13">0.9</data>
      <data key="d14">Duncan Idaho says they're to be admired.</data>
    </edge>
    <edge source="Duncan Idaho" target="Fremen" id="1">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">Idaho did say one thing: he said you couldn't mistake the Fremen attitude toward shields.</data>
    </edge>
    <edge source="Duncan Idaho" target="Fremen" id="2">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">He will be Fremen and soldier of the Atreides.</data>
    </edge>
    <edge source="Duncan Idaho" target="ten thousand people" id="0">
      <data key="d12">ESTIMATES</data>
      <data key="d13">0.9</data>
      <data key="d14">Idaho estimates the cave complex he visited consisted of some ten thousand people, all told.</data>
    </edge>
    <edge source="Duncan Idaho" target="sietch" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Idaho had free access to every part of the sietch</data>
    </edge>
    <edge source="Duncan Idaho" target="attack" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">In the attack, however, we found the Harkonnens had waylaid the Fremen courier--badly wounded him.</data>
    </edge>
    <edge source="Duncan Idaho" target="knife" id="0">
      <data key="d12">CREATED</data>
      <data key="d13">0.9</data>
      <data key="d14">Idaho glanced down at Leto. "A knife, m'Lord, a knife the like of which you've never seen."</data>
    </edge>
    <edge source="Duncan Idaho" target="Stilgar" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">"This is Stilgar, chief of the sietch I visited, leader of those who warned us of the false band," Idaho said.</data>
    </edge>
    <edge source="Duncan Idaho" target="Stilgar" id="1">
      <data key="d12">FRIENDS_WITH</data>
      <data key="d13">0.8</data>
      <data key="d14">"I remind you this is the blade of one who befriended you."</data>
    </edge>
    <edge source="Duncan Idaho" target="meeting" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Idaho's voice boomed across the room: "Hold!"</data>
    </edge>
    <edge source="Duncan Idaho" target="Paul Atreides" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">He will be Fremen and soldier of the Atreides.</data>
    </edge>
    <edge source="Duncan Idaho" target="Paul Atreides" id="1">
      <data key="d12">FRIENDS_WITH</data>
      <data key="d13">0.9</data>
      <data key="d14">Idaho had hidden them.</data>
    </edge>
    <edge source="Duncan Idaho" target="Paul Atreides" id="2">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.8</data>
      <data key="d14">receiver Idaho had left for them</data>
    </edge>
    <edge source="Duncan Idaho" target="Paul Atreides" id="3">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">"May I take your pack, Sire?" Idaho asked.</data>
    </edge>
    <edge source="Duncan Idaho" target="Paul Atreides" id="4">
      <data key="d12">TEACHES</data>
      <data key="d13">0.9</data>
      <data key="d14">his teachers men like Duncan Idaho and Gurney Halleck</data>
    </edge>
    <edge source="Duncan Idaho" target="Turok" id="0">
      <data key="d12">FRIENDS_WITH</data>
      <data key="d13">0.9</data>
      <data key="d14">You are friends of Turok.</data>
    </edge>
    <edge source="Duncan Idaho" target="Leto Atreides" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">"You understand what you're to do, Duncan?" "I'm your ambassador to the Fremen, Sire."</data>
    </edge>
    <edge source="Duncan Idaho" target="EVENT" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"Killed more'n three hunner' men f'r the Duke," he muttered.</data>
    </edge>
    <edge source="Duncan Idaho" target="EVENT" id="1">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Idaho had warned him time and again: "When in doubt of your surface, bare feet are best."</data>
    </edge>
    <edge source="Duncan Idaho" target="advance bases" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">"Duncan was clear on one thing: those bases or the idea of them hold some deep significance for the Fremen."</data>
    </edge>
    <edge source="Duncan Idaho" target="Hawat" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">He had been summoned back from the Fremen and had his orders from Hawat</data>
    </edge>
    <edge source="Duncan Idaho" target="Great Hall" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Nearby, more an outflanker than a member of the group, stood Duncan Idaho in glittering dress uniform</data>
    </edge>
    <edge source="Duncan Idaho" target="house guards" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.8</data>
      <data key="d14">To her right near the front entry, she saw two house guards holding Duncan Idaho between them.</data>
    </edge>
    <edge source="Duncan Idaho" target="The Collected Sayings of Muad'Dib" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.7</data>
      <data key="d14">He's boasting, Jessica thought. He shouldn't boast. No person who'll be sleeping far below ground level this night as a precaution against lasguns has the right to boast.</data>
    </edge>
    <edge source="Duncan Idaho" target="dinner party" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">A jagged rent in his tunic exposed an expanse of the dress shirt he had worn at the dinner party earlier.</data>
    </edge>
    <edge source="Duncan Idaho" target="Grumman" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">My sword was firs' blooded on Grumman!</data>
    </edge>
    <edge source="Duncan Idaho" target="Yueh" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">Idaho jerked himself upright, scowling down at her.</data>
    </edge>
    <edge source="Duncan Idaho" target="drinking spice beer" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"Tonight, he overindulged in something called spice beer."</data>
    </edge>
    <edge source="Duncan Idaho" target="his mother" id="0">
      <data key="d12">FRIENDS_WITH</data>
      <data key="d13">0.9</data>
      <data key="d14">Idaho had hidden them.</data>
    </edge>
    <edge source="Duncan Idaho" target="rescue" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">had recognized Duncan Idaho leaning out the 'thopter's open door shouting: "Hurry!</data>
    </edge>
    <edge source="Duncan Idaho" target="trapped in a cave" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.7</data>
      <data key="d14">trapped in a cave</data>
    </edge>
    <edge source="Duncan Idaho" target="the great house" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">He was in the great house when the shield went down,</data>
    </edge>
    <edge source="Duncan Idaho" target="explosion" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">They sprawled together in the sand as the roar of an explosion thundered over them.</data>
    </edge>
    <edge source="Duncan Idaho" target="them" id="0">
      <data key="d12">LEADS</data>
      <data key="d13">0.9</data>
      <data key="d14">The man Idaho led us to them, then?</data>
    </edge>
    <edge source="Duncan Idaho" target="suspicious circumstances" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">Idaho joined this Kynes under mysterious circumstances . . . I might even say suspicious circumstances.</data>
    </edge>
    <edge source="Duncan Idaho" target="vision" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">Idaho was with us in the vision, he remembered.</data>
    </edge>
    <edge source="Duncan Idaho" target="vision" id="1">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Idaho was with us in the vision, he remembered.</data>
    </edge>
    <edge source="Duncan Idaho" target="Paul's memory" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Memory of Duncan Idaho's voice flowed through Paul's awareness</data>
    </edge>
    <edge source="Duncan Idaho" target="Great House" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">Warmasters Gurney Halleck and Duncan Idaho had trained a fighting force</data>
    </edge>
    <edge source="Duncan Idaho" target="head count on the sietch he visited" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">I gave you Duncan Idaho's head count on the sietch he visited</data>
    </edge>
    <edge source="Duncan Idaho" target="raid" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"Idaho saved us the night of the raid," Paul said, distracted by the parting with Chani.</data>
    </edge>
    <edge source="Duncan Idaho" target="words" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Idaho's words came back to him</data>
    </edge>
    <edge source="Duke Paulus Atreides" target="painting" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">The painting of the Old Duke over there</data>
    </edge>
    <edge source="Duke Paulus Atreides" target="bull's head" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">this beast killed the Old Duke</data>
    </edge>
    <edge source="Proctor" target="whip our dear Lady Jessica into line" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">they sent the old Proctor here -- to whip our dear Lady Jessica into line.</data>
    </edge>
    <edge source="Duke Leto Atreides" target="Mentat" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.8</data>
      <data key="d14">The Duke couldn't afford the most efficient spies to provide his Mentat with the required information.</data>
    </edge>
    <edge source="Salusa Secundus" target="Emperor" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">Did Hawat talk to you about Salusa Secundus?" "The Emperor's prison planet?</data>
    </edge>
    <edge source="Salusa Secundus" target="suspicions about Arrakis" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">how Arrakis figures in your suspicions about Salusa Secundus.</data>
    </edge>
    <edge source="Salusa Secundus" target="penal colony" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"It's a penal colony," the Baron said.</data>
    </edge>
    <edge source="Salusa Secundus" target="Emperor's prison planet" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">What has this to do with the Emperor's prison planet?</data>
    </edge>
    <edge source="Salusa Secundus" target="Gamma Waiping" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">SALUSA SECUNDUS: third planet of Gamma Waiping</data>
    </edge>
    <edge source="Salusa Secundus" target="Fremen tradition" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Fremen tradition says they were slaves on S.S. for nine generations.</data>
    </edge>
    <edge source="Beast Rabban" target="Gurney Halleck" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">it had been put there by Beast Rabban in a Harkonnen slave pit on Giedi Prime</data>
    </edge>
    <edge source="Beast Rabban" target="Dune" id="0">
      <data key="d12">LEADS</data>
      <data key="d13">0.9</data>
      <data key="d14">Beast Rabban, so they say, will sit once more in the seat of power here on Dune.</data>
    </edge>
    <edge source="Beast Rabban" target="Lady Jessica" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.7</data>
      <data key="d14">trying to wrest Arrakis from the Harkonnen governor, the Mudir Nahya, the Beast Rabban</data>
    </edge>
    <edge source="Beast Rabban" target="Harkonnen" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">MUDIR NAHYA: the Fremen name for Beast Rabban (Count Rabban of Lankiveil), the Harkonnen cousin</data>
    </edge>
    <edge source="Beast Rabban" target="Arrakis" id="0">
      <data key="d12">LEADS</data>
      <data key="d13">0.9</data>
      <data key="d14">who was siridar governor on Arrakis for many years</data>
    </edge>
    <edge source="younger sister" target="pansies" id="0">
      <data key="d12">LOVES</data>
      <data key="d13">0.7</data>
      <data key="d14">She had loved pansies . . . or was it daisies?</data>
    </edge>
    <edge source="Harkonnen troops" target="younger sister" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">But she was dead now -- in a pleasure house for Harkonnen troops.</data>
    </edge>
    <edge source="shout for Yueh" target="Suk School" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">medical doctor of the Suk School</data>
    </edge>
    <edge source="shout for Yueh" target="Wanna Marcus" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">md: Wanna Marcus</data>
    </edge>
    <edge source="shout for Yueh" target="Leto Atreides" id="0">
      <data key="d12">BETRAYER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">chiefly noted as betrayer of Duke Leto Atreides</data>
    </edge>
    <edge source="shout for Yueh" target="Dictionary of Muad'Dib" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">-from "Dictionary of Muad'Dib" by the Princess Irulan</data>
    </edge>
    <edge source="Yueh" target="Paul Atreides" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">Paul joined him at the table, buttoning his jacket.</data>
    </edge>
    <edge source="Yueh" target="Paul Atreides" id="1">
      <data key="d12">TRAITOR</data>
      <data key="d13">0.9</data>
      <data key="d14">Logic said the traitor was Yueh</data>
    </edge>
    <edge source="Yueh" target="Paul Atreides" id="2">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">Yueh's own message to us admitting his treachery</data>
    </edge>
    <edge source="Yueh" target="O.C. Bible" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"It's a very old Orange Catholic Bible made for space travelers."</data>
    </edge>
    <edge source="Yueh" target="filmbook on a small specimen" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"I've a filmbook on a small specimen, only one hundred and ten meters long and twenty-two meters in diameter."</data>
    </edge>
    <edge source="Yueh" target="gift for Paul" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"Before I go, I've a gift for you, something I came across in packing."</data>
    </edge>
    <edge source="Yueh" target="book" id="0">
      <data key="d12">GAVE</data>
      <data key="d13">0.9</data>
      <data key="d14">He closed the book, handed it to Paul. "Try it."</data>
    </edge>
    <edge source="Yueh" target="book" id="1">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Yueh watched Paul work the page adjustment, thought: I salve my own conscience.</data>
    </edge>
    <edge source="Yueh" target="Wanna" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">my . . . dead wife's favorite passage</data>
    </edge>
    <edge source="Yueh" target="Wanna" id="1">
      <data key="d12">LOVES</data>
      <data key="d13">0.9</data>
      <data key="d14">She loved me, certainly.</data>
    </edge>
    <edge source="Yueh" target="Harkonnen" id="0">
      <data key="d12">HATES</data>
      <data key="d13">0.9</data>
      <data key="d14">Damn those Harkonnen beasts!</data>
    </edge>
    <edge source="Yueh" target="lessons" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Someplace around the house taking his lessons with Yueh.</data>
    </edge>
    <edge source="Yueh" target="Lady Jessica" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">"We've known each other six years," she said.</data>
    </edge>
    <edge source="Yueh" target="Lady Jessica" id="1">
      <data key="d12">LOVES</data>
      <data key="d13">0.8</data>
      <data key="d14">If only it were possible to hate these people instead of love them!</data>
    </edge>
    <edge source="Yueh" target="these people" id="0">
      <data key="d12">LOVES</data>
      <data key="d13">0.9</data>
      <data key="d14">If only it were possible to hate these people instead of love them!</data>
    </edge>
    <edge source="Yueh" target="Baron" id="0">
      <data key="d12">HATES</data>
      <data key="d13">0.8</data>
      <data key="d14">I must stand before that black Baron with his deed accomplished, and take my one chance to strike him where he is weakest--in his gloating moment!</data>
    </edge>
    <edge source="Yueh" target="Baron" id="1">
      <data key="d12">MADE_A_BARGAIN_WITH</data>
      <data key="d13">0.9</data>
      <data key="d14">I made a shaitan's bargain with the Baron.</data>
    </edge>
    <edge source="Yueh" target="Baron" id="2">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.7</data>
      <data key="d14">He'll be delivered to the Baron all properly trussed like a roast for the oven.</data>
    </edge>
    <edge source="Yueh" target="House Harkonnen" id="0">
      <data key="d12">HATES</data>
      <data key="d13">0.9</data>
      <data key="d14">"And I can assure you he hates the Harkonnens as bitterly as we do."</data>
    </edge>
    <edge source="Yueh" target="ENTITY" id="0">
      <data key="d12">PERSON</data>
      <data key="d13">0.9</data>
      <data key="d14">Yueh crossing to them, his medical kit swinging in his left hand.</data>
    </edge>
    <edge source="Yueh" target="Duncan Idaho" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">Yueh said. "I can take care of this." Jessica shook her head.</data>
    </edge>
    <edge source="Yueh" target="Leto Atreides" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">Yueh stood in the open door of the generator room.</data>
    </edge>
    <edge source="Yueh" target="Leto Atreides" id="1">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">Yueh's face carried a look of sadness as he bent over, touched Leto's forehead.</data>
    </edge>
    <edge source="Yueh" target="house generators" id="0">
      <data key="d12">SABOTAGED</data>
      <data key="d13">0.9</data>
      <data key="d14">Yueh! Leto thought. He's sabotaged the house generators!</data>
    </edge>
    <edge source="Yueh" target="passage" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Yueh stood in the open door of the generator room.</data>
    </edge>
    <edge source="Yueh" target="Baron Vladimir Harkonnen" id="0">
      <data key="d12">WANTS_TO_KILL</data>
      <data key="d13">0.9</data>
      <data key="d14">I wish to kill the Baron.</data>
    </edge>
    <edge source="Yueh" target="poison gas tooth" id="0">
      <data key="d12">CREATED</data>
      <data key="d13">0.9</data>
      <data key="d14">That peg tooth I put in your mouth after the tumble at Narcal--that tooth must be replaced, in a moment, I'll render you unconscious and replace that tooth.</data>
    </edge>
    <edge source="Yueh" target="Duke" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.8</data>
      <data key="d14">A man in Harkonnen uniform skidded to a stop at the end of the hall, stared in at Yueh, taking in at a single glance Mapes' body, the sprawled form of the Duke, Yueh standing there.</data>
    </edge>
    <edge source="Yueh" target="Duke" id="1">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">"Is this the Duke?" "This is the Duke."</data>
    </edge>
    <edge source="Yueh" target="Duke" id="2">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">"That's how Yueh caught him for us."</data>
    </edge>
    <edge source="Yueh" target="EVENT" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">When you dropped the house shields we came right in.</data>
    </edge>
    <edge source="Yueh" target="traitor" id="0">
      <data key="d12">KNOWN_AS</data>
      <data key="d13">0.9</data>
      <data key="d14">Traitor, Yueh thought. He lowered his gaze, pressed past the Sardaukar, knowing this as a foretaste of how history would remember him: Yueh the traitor.</data>
    </edge>
    <edge source="Yueh" target="destruction" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.7</data>
      <data key="d14">Abruptly, Yueh saw himself as cast away in this place of destruction, spared nothing, given not the smallest pity.</data>
    </edge>
    <edge source="Yueh" target="sense of foreboding" id="0">
      <data key="d12">CREATED</data>
      <data key="d13">0.8</data>
      <data key="d14">Yueh had filled him with a sense of foreboding.</data>
    </edge>
    <edge source="Yueh" target="poison gas" id="0">
      <data key="d12">CREATED</data>
      <data key="d13">0.9</data>
      <data key="d14">he remembered who had put the deadly weapon in his mouth. Yueh.</data>
    </edge>
    <edge source="Yueh" target="note" id="0">
      <data key="d12">CREATED</data>
      <data key="d13">0.9</data>
      <data key="d14">"Do not try to forgive me," Yueh had written.</data>
    </edge>
    <edge source="Yueh" target="note" id="1">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"Do not try to forgive me," Yueh had written.</data>
    </edge>
    <edge source="Yueh" target="royal house" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">Yueh was a conditioned medic, fit for a royal house</data>
    </edge>
    <edge source="Doctor Kynes" target="planetary ecologist" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">I must seek out the planetary ecologist when we arrive -- a Dr. Kynes --</data>
    </edge>
    <edge source="Doctor Kynes" target="betray" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">His first encounter with the people he had been ordered to betray left Dr. Kynes shaken.</data>
    </edge>
    <edge source="Doctor Kynes" target="passage" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">But Doctor Kynes is dead.</data>
    </edge>
    <edge source="Wanna" target="Bene Gesserit Sisterhood" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">His wife was Bene Gesserit--the signs are all over him.</data>
    </edge>
    <edge source="Harkonnen" target="Paul Atreides" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">an Atreides had a Harkonnen banished for cowardice</data>
    </edge>
    <edge source="Harkonnen" target="entrepreneur class" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">Most were well situated, my Lord--in the entrepreneur class.</data>
    </edge>
    <edge source="Harkonnen" target="reward" id="0">
      <data key="d12">OWNS</data>
      <data key="d13">0.9</data>
      <data key="d14">The mercenary says there's a Harkonnen reward of a million Solaris for anyone who'll bring in a single crysknife.</data>
    </edge>
    <edge source="Harkonnen" target="people" id="0">
      <data key="d12">HATES</data>
      <data key="d13">0.9</data>
      <data key="d14">people who draw knife at hearing the Harkonnen name, who hate the Harkonnens so much they'll burn a chair in which a Harkonnen has sat, salt the ground over which a Harkonnen has walked.</data>
    </edge>
    <edge source="Harkonnen" target="house" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">All were house troopers or wore Harkonnen uniform.</data>
    </edge>
    <edge source="Harkonnen" target="Harkonnen victory" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Harkonnen victory.</data>
    </edge>
    <edge source="Harkonnen" target="attack" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">The Harkonnens are testing</data>
    </edge>
    <edge source="Harkonnen" target="EVENT" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Harkonnen battle colors</data>
    </edge>
    <edge source="Harkonnen" target="Lady Jessica" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.8</data>
      <data key="d14">Idaho standing against a swarm of Harkonnen uniforms</data>
    </edge>
    <edge source="Harkonnen" target="Fremen" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">Harkonnen raids (although these were growing fewer as the Fremen took their toll</data>
    </edge>
    <edge source="Harkonnen" target="Gurney Halleck" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.8</data>
      <data key="d14">not too high because then they could be seen from afar by Harkonnen detectors.</data>
    </edge>
    <edge source="Harkonnen" target="CHOAM" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">Harkonnen frigates lined up there with a CHOAM Company banner waving gently from its staff on the ground beneath them.</data>
    </edge>
    <edge source="Harkonnen" target="adaptive zones" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Adaptive zones were laid out in the deep south far from Harkonnen watchers.</data>
    </edge>
    <edge source="spice" target="CHOAM" id="0">
      <data key="d12">OWNS</data>
      <data key="d13">0.7</data>
      <data key="d14">the enormous proportion of those profits dependent upon a single product -- the spice</data>
    </edge>
    <edge source="melange" target="Arrakis" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">it must be mined on Arrakis</data>
    </edge>
    <edge source="melange" target="Arrakis" id="1">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Arrakis, the one source in the universe of melange</data>
    </edge>
    <edge source="Landsraad" target="ORGANIZATION" id="0">
      <data key="d12">ORGANIZATION</data>
      <data key="d13">0.9</data>
      <data key="d14">an official appointed by the Landsraad High Council and the Emperor</data>
    </edge>
    <edge source="Padishah Emperor" target="Duke" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.8</data>
      <data key="d14">there is one other much more important: our beloved Padishah Emperor.</data>
    </edge>
    <edge source="Padishah Emperor" target="planetologist" id="0">
      <data key="d12">INSTALLED</data>
      <data key="d13">0.9</data>
      <data key="d14">this planetologist the Emperor and the Landsraad installed as Judge of the Change</data>
    </edge>
    <edge source="Padishah Emperor" target="Emperor's daughter" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">My father, the Padishah Emperor, took me by the hand</data>
    </edge>
    <edge source="Padishah Emperor" target="Emperor's daughter" id="1">
      <data key="d12">HATES</data>
      <data key="d13">0.9</data>
      <data key="d14">not excepting even me, for he said I was a witch like all the others.</data>
    </edge>
    <edge source="Padishah Emperor" target="Leto Atreides" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.8</data>
      <data key="d14">my father secretly wished the Duke had been his son, and disliked the political necessities that made them enemies.</data>
    </edge>
    <edge source="Padishah Emperor" target="Bene Gesserit Sisterhood" id="0">
      <data key="d12">HATES</data>
      <data key="d13">0.9</data>
      <data key="d14">He blamed my mother and the compact forced on him to place a Bene Gesserit on the throne.</data>
    </edge>
    <edge source="Padishah Emperor" target="Guild" id="0">
      <data key="d12">HATES</data>
      <data key="d13">0.9</data>
      <data key="d14">He blamed the Guild</data>
    </edge>
    <edge source="Padishah Emperor" target="Baron" id="0">
      <data key="d12">HATES</data>
      <data key="d13">0.9</data>
      <data key="d14">the evil old Baron</data>
    </edge>
    <edge source="Padishah Emperor" target="Duke Leto" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.8</data>
      <data key="d14">My father, the Padishah Emperor, was 72 yet looked no more than 35 the year he encompassed the death of Duke Leto</data>
    </edge>
    <edge source="Padishah Emperor" target="Arrakis" id="0">
      <data key="d12">OWNS</data>
      <data key="d13">0.9</data>
      <data key="d14">gave Arrakis back to the Harkonnens</data>
    </edge>
    <edge source="Padishah Emperor" target="Arrakis" id="1">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">The Padishah Emperor himself is there</data>
    </edge>
    <edge source="Padishah Emperor" target="Sardaukar" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">seldom appeared in public wearing other than a Sardaukar uniform</data>
    </edge>
    <edge source="Padishah Emperor" target="dynasty" id="0">
      <data key="d12">LEADS</data>
      <data key="d13">0.8</data>
      <data key="d14">he was an emperor, father-head of a dynasty that reached back into the dimmest history</data>
    </edge>
    <edge source="Padishah Emperor" target="prison planet" id="0">
      <data key="d12">OWNS</data>
      <data key="d13">0.9</data>
      <data key="d14">That the Padishah Emperor has a prison planet? Everyone knows this.</data>
    </edge>
    <edge source="Padishah Emperor" target="you" id="0">
      <data key="d12">ADVISES</data>
      <data key="d13">0.9</data>
      <data key="d14">Thus the Padishah Emperor advises you.</data>
    </edge>
    <edge source="Padishah Emperor" target="the old woman" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"You don't understand. Majesty," the old woman said.</data>
    </edge>
    <edge source="Padishah Emperor" target="Alia" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"Child, can you communicate with your brother?"</data>
    </edge>
    <edge source="Imperial Corps of Sardaukar" target="Salusa Secundus" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">every report on Salusa Secundus says S.S. is a hell world</data>
    </edge>
    <edge source="Imperial Corps of Sardaukar" target="Emperor" id="0">
      <data key="d12">PROTECTS</data>
      <data key="d13">0.9</data>
      <data key="d14">forming an arc there to protect the Emperor's retreat.</data>
    </edge>
    <edge source="Imperial Corps of Sardaukar" target="combat" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Sardaukar and leaping gyrating robed men who seemed to come down out of the storm.</data>
    </edge>
    <edge source="Carthag" target="Arrakis" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Carthag, when the reports of attack began arriving</data>
    </edge>
    <edge source="Carthag" target="Harkonnen" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Carthag! Jessica thought. That was a Harkonnen hotbed.</data>
    </edge>
    <edge source="Duke's father" target="painting" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Against a carton to her right stood the painting of the Duke's father.</data>
    </edge>
    <edge source="Mapes" target="Fremen" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">they're Fremen all. They'll do until our own people can be released from their other duties.</data>
    </edge>
    <edge source="Mapes" target="My Lord" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">You may even want to keep the head housekeeper: the Shadout Mapes.</data>
    </edge>
    <edge source="Mapes" target="strategy conference" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.7</data>
      <data key="d14">our strategy conference." He cleared his throat as though to say something else, then, without warning, turned and strode out, headed for the entry where she could hear more boxes being deposited.</data>
    </edge>
    <edge source="Mapes" target="legend" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"It was said that the Shadout Mapes gave this report on you," Stilgar said.</data>
    </edge>
    <edge source="Mapes" target="violence" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">you have done violence and will yet do more violence.</data>
    </edge>
    <edge source="Mapes" target="weapon" id="0">
      <data key="d12">OWNS</data>
      <data key="d13">0.9</data>
      <data key="d14">I know you came prepared for violence with a weapon in your bodice.</data>
    </edge>
    <edge source="Mapes" target="weapon" id="1">
      <data key="d12">GIVES</data>
      <data key="d13">0.9</data>
      <data key="d14">The weapon was sent as a gift to you should you prove to be the One.</data>
    </edge>
    <edge source="Mapes" target="Lady Jessica" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.8</data>
      <data key="d14">this Fremen has taken service with me</data>
    </edge>
    <edge source="Mapes" target="Lady Jessica" id="1">
      <data key="d12">LOVES</data>
      <data key="d13">0.7</data>
      <data key="d14">The eyes without whites stared at Jessica. "You are ours," she muttered. "You are the One."</data>
    </edge>
    <edge source="Mapes" target="sionaria Protectiva" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.8</data>
      <data key="d14">sionaria Protectiva dropped here long centuries ago -- long dead, no doubt, but her purpose accomplished: the protective legends implanted in these people against the day of a Bene Gesserit's need.</data>
    </edge>
    <edge source="Mapes" target="desert" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">I'm of the desert and I've seen blood aplenty.</data>
    </edge>
    <edge source="Mapes" target="passage" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Mapes said.</data>
    </edge>
    <edge source="Mapes" target="passage" id="1">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">darted down the passage,  crouched beside the crawling figure. It was Mapes, the Fremen housekeeper</data>
    </edge>
    <edge source="Mapes" target="Paul's family" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">"The Shadout Mapes, housekeeper."</data>
    </edge>
    <edge source="Mapes" target="Muad'Dib: Family Commentaries" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">-from "Muad'Dib: Family Commentaries" by the Princess Irulan</data>
    </edge>
    <edge source="Mapes" target="Duke" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.8</data>
      <data key="d14">"There are men in the great hall say they've been sent by the Duke to get young master Paul," Mapes said.</data>
    </edge>
    <edge source="Mapes" target="message of the leaf" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.7</data>
      <data key="d14">"The Shadout Mapes," Jessica said, remembering the encounter at the stairs.</data>
    </edge>
    <edge source="Mapes" target="Jessica Atreides" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">Mapes, bring a stimulant.</data>
    </edge>
    <edge source="Mapes" target="ENTITY" id="0">
      <data key="d12">PERSON</data>
      <data key="d13">0.9</data>
      <data key="d14">Mapes returned with a steaming cup in her hands</data>
    </edge>
    <edge source="Mapes" target="mewling sound" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Another grey blob lay stretched on the floor a few paces away, and he saw at  once this was the source of the noise. The shape crawled toward him with painful  slowness, gasping, mumbling.</data>
    </edge>
    <edge source="Mapes" target="Leto Atreides" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">It was Mapes, the Fremen housekeeper</data>
    </edge>
    <edge source="Shadout" target="Duncan's report" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Hawat speaks highly of her on the basis of Duncan's report.</data>
    </edge>
    <edge source="my Lord" target="Lady Jessica" id="0">
      <data key="d12">LOVES</data>
      <data key="d13">0.8</data>
      <data key="d14">Ah-h-h-h, my Jessica, would that we were somewhere else, anywhere away from this terrible place -alone, the two of us, without a care.</data>
    </edge>
    <edge source="my Lord" target="officers' mess at the field" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">I'll eat in the officers' mess at the field</data>
    </edge>
    <edge source="Harkonnen bravos" target="Fremen" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">Six Harkonnen bravos, shielded and fully armed, had trapped three Fremen youths</data>
    </edge>
    <edge source="Harkonnen bravos" target="Windsack" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">behind the Shield Wall near the village of Windsack</data>
    </edge>
    <edge source="the Landsraad" target="planetologist" id="0">
      <data key="d12">INSTALLED</data>
      <data key="d13">0.9</data>
      <data key="d14">this planetologist the Emperor and the Landsraad installed as Judge of the Change</data>
    </edge>
    <edge source="the Landsraad" target="riots" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Historians estimate the riots took eighty million lives. That works out to about six thousand for each world then in the Landsraad League.</data>
    </edge>
    <edge source="Albe" target="painting of Leto's father" id="0">
      <data key="d12">CREATED</data>
      <data key="d13">0.9</data>
      <data key="d14">It had been done by the famed artist, Albe, during the Old Duke's middle years.</data>
    </edge>
    <edge source="crysknife" target="Arrakis" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">the fabled crysknife of Arrakis, the blade that had never been taken off the planet</data>
    </edge>
    <edge source="palm trees" target="front of the house" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">A line of twenty palm trees grew there, the ground beneath them swept clean, barren.</data>
    </edge>
    <edge source="house shield" target="between her and the people" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Jessica detected a faint shimmering in the air between her and the people--a house shield--</data>
    </edge>
    <edge source="hunter-seeker" target="book" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.7</data>
      <data key="d14">Paul recognized it at once--a common assassination weapon that every child of royal blood learned about at an early age.</data>
    </edge>
    <edge source="Count Hasimir Fenring" target="message" id="0">
      <data key="d12">CREATED</data>
      <data key="d13">0.9</data>
      <data key="d14">My kindest wishes, MARGOT LADY FENRING</data>
    </edge>
    <edge source="Count Hasimir Fenring" target="my father" id="0">
      <data key="d12">FRIENDS_WITH</data>
      <data key="d13">0.9</data>
      <data key="d14">My father had only one real friend, I think. That was Count Hasimir Fenring</data>
    </edge>
    <edge source="Count Hasimir Fenring" target="Imperium" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">one of the deadliest fighters in the Imperium</data>
    </edge>
    <edge source="Count Hasimir Fenring" target="Padishah Emperor" id="0">
      <data key="d12">FRIENDS_WITH</data>
      <data key="d13">0.9</data>
      <data key="d14">The closest anyone ever came to casual camaraderie with the Padishah Emperor was the relationship offered by Count Hasimir Fenring, a companion from childhood.</data>
    </edge>
    <edge source="Count Hasimir Fenring" target="Emperor Shaddam Corrino IV" id="0">
      <data key="d12">FRIENDS_WITH</data>
      <data key="d13">0.9</data>
      <data key="d14">All accounts agree that Fenring was the closest friend Shaddam IV possessed.</data>
    </edge>
    <edge source="Count Hasimir Fenring" target="Emperor Shaddam Corrino IV" id="1">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">The Imperial chores carried out by Count Fenring included that of Imperial Agent on Arrakis during the Harkonnen regime there and later Siridar-Absentia of Caladan.</data>
    </edge>
    <edge source="Count Hasimir Fenring" target="Imperial House" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">A distaff cousin of House Corrino</data>
    </edge>
    <edge source="Count Hasimir Fenring" target="Salusa Secundus" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">He joined Shaddam IV in retirement on Salusa Secundus.</data>
    </edge>
    <edge source="Count" target="Lady" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">The Count married his Lady.</data>
    </edge>
    <edge source="Count" target="arena gathering" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">It's time to go to the arena.</data>
    </edge>
    <edge source="Count" target="Count's lady" id="0">
      <data key="d12">LEADS</data>
      <data key="d13">0.9</data>
      <data key="d14">the Count's lady come through the guards beyond to join the party in the golden box</data>
    </edge>
    <edge source="Count" target="Emperor" id="0">
      <data key="d12">FRIENDS_WITH</data>
      <data key="d13">0.9</data>
      <data key="d14">We have been friends, Majesty.</data>
    </edge>
    <edge source="Harkonnen agents" target="Harkonnen" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">A Harkonnen agent in the crew</data>
    </edge>
    <edge source="Harkonnen agents" target="smugglers' base" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">flew the machine to a smugglers' base, hoping to sell it there.</data>
    </edge>
    <edge source="Thufir" target="Duke" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">"How many men can you let Hawat have?" the Duke asked.</data>
    </edge>
    <edge source="Thufir" target="Duke" id="1">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">A move worthy of your grandsire, my Lord.</data>
    </edge>
    <edge source="Thufir" target="Duke's crew" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">I think first we'd better learn if Thufir has anything to add to his report on the Fremen," the Duke said. "Thufir?"</data>
    </edge>
    <edge source="Thufir" target="Duke Leto" id="0">
      <data key="d12">LOVES</data>
      <data key="d13">0.8</data>
      <data key="d14">You and I, Thufir, of all those who love the Duke, are most ideally situated to destroy the other's place.</data>
    </edge>
    <edge source="Thufir" target="Lady Jessica" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">"I don't trust your Bene Gesserit motives," he said.</data>
    </edge>
    <edge source="Thufir" target="Jessica Atreides" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">You may go now, Thufir.</data>
    </edge>
    <edge source="Thufir" target="Jessica Atreides" id="1">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">he would never forget this moment nor lose this sense of supreme admiration for the Lady Jessica.</data>
    </edge>
    <edge source="Thufir" target="Duke's father" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">The Old Duke had turned his back on the horns, cape thrown flamboyantly over one arm, while cheers rained down from the stands.</data>
    </edge>
    <edge source="Thufir" target="moment" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">Paul thought then of prescient glimpses into the possibilities of this moment -- and one time-line where Thufir carried a poisoned needle which the Emperor commanded he use against "this upstart Duke."</data>
    </edge>
    <edge source="Thufir" target="time-line" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">Paul thought then of prescient glimpses into the possibilities of this moment -- and one time-line where Thufir carried a poisoned needle which the Emperor commanded he use against "this upstart Duke."</data>
    </edge>
    <edge source="Guild Heighliner" target="EVENT" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">"The Guild Heighliner that brought us is going on about its business"</data>
    </edge>
    <edge source="shuttle" target="EVENT" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">"The field commandant will hold the shuttle here until dawn on a pretext."</data>
    </edge>
    <edge source="spice hunters" target="old regime" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">"But the shuttle also will carry some of the spice hunters from the old regime."</data>
    </edge>
    <edge source="Judge of the Change" target="EVENT" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">"the Judge of the Change is allowing it."</data>
    </edge>
    <edge source="Judge of the Change" target="EVENT" id="1">
      <data key="d12">EVENT</data>
      <data key="d13">0.9</data>
      <data key="d14">JUDGE OF THE CHANGE: an official appointed by the Landsraad High Council and the Emperor to monitor a change of fief, a kanly negotiation, or formal battle in a War of Assassins.</data>
    </edge>
    <edge source="Judge of the Change" target="Imperial inventory" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Imperial inventory audited by the Judge of the Change</data>
    </edge>
    <edge source="Arrakeen landing field" target="Arrakis" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Over the exit of the Arrakeen landing field, crudely carved as though with a poor instrument, there was an inscription that Muad'Dib was to repeat many times. He saw it that first night on Arrakis</data>
    </edge>
    <edge source="Liet" target="sietch communities" id="0">
      <data key="d12">LEADS</data>
      <data key="d13">0.8</data>
      <data key="d14">All seem to give their allegiance to someone called Liet.</data>
    </edge>
    <edge source="Liet" target="local deity" id="0">
      <data key="d12">MAY_BE</data>
      <data key="d13">0.7</data>
      <data key="d14">There are things to suggest this Liet may be a local deity.</data>
    </edge>
    <edge source="Liet" target="two masters" id="0">
      <data key="d12">SERVES</data>
      <data key="d13">0.9</data>
      <data key="d14">Liet serves two masters.</data>
    </edge>
    <edge source="Liet" target="advance bases" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">"The answer to that question," Hawat said, "is invariably: 'Liet knows.' "</data>
    </edge>
    <edge source="Liet" target="Paul Atreides" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.8</data>
      <data key="d14">that is in Liet's hands. Liet has not said.</data>
    </edge>
    <edge source="Liet" target="all Fremen" id="0">
      <data key="d12">LEADS</data>
      <data key="d13">0.9</data>
      <data key="d14">But only my brother, Liet, speaks for all Fremen.</data>
    </edge>
    <edge source="Liet" target="Stilgar" id="0">
      <data key="d12">LEADS</data>
      <data key="d13">0.9</data>
      <data key="d14">It's Liet's command," Stilgar said.</data>
    </edge>
    <edge source="Liet" target="House Harkonnen" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">another victim of the Harkonnens.</data>
    </edge>
    <edge source="Liet" target="Fremen" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"It's true then--Liet is dead."</data>
    </edge>
    <edge source="Liet" target="Kynes" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Liet was the Fremen name of the planetologist.</data>
    </edge>
    <edge source="Liet" target="Chakobsa way" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">What Liet taught us, we cannot pause an instant in that. Liet who is dead must not be forgotten. It's the Chakobsa way.</data>
    </edge>
    <edge source="smuggler caravan" target="sietch" id="0">
      <data key="d12">LEFT</data>
      <data key="d13">0.9</data>
      <data key="d14">A smuggler caravan left this sietch while Idaho was there, carrying a heavy load of spice.</data>
    </edge>
    <edge source="Old Maria" target="museum" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">'Old Maria,' it belongs in a museum</data>
    </edge>
    <edge source="Imperial ecologists" target="first team" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.7</data>
      <data key="d14">There's one dragline outfit that came in with the first team of Imperial ecologists</data>
    </edge>
    <edge source="Harkonnen mercenaries" target="Fremen" id="0">
      <data key="d12">DISGUISED_AS</data>
      <data key="d13">0.9</data>
      <data key="d14">We've taken a force of Harkonnen mercenaries disguised as Fremen.</data>
    </edge>
    <edge source="knife" target="Crysknife" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"Crysknife?" someone asked.</data>
    </edge>
    <edge source="Crysknife" target="teeth taken from dead sandworms" id="0">
      <data key="d12">CREATED</data>
      <data key="d13">0.9</data>
      <data key="d14">It is manufactured in two forms from teeth taken from dead sandworms</data>
    </edge>
    <edge source="Stilgar" target="sietch" id="0">
      <data key="d12">LEADS</data>
      <data key="d13">0.9</data>
      <data key="d14">"This is Stilgar, chief of the sietch I visited, leader of those who warned us of the false band," Idaho said.</data>
    </edge>
    <edge source="Stilgar" target="sietch" id="1">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Tonight we must leave this sietch that has sheltered us for so long and go south into the desert," Stilgar said.</data>
    </edge>
    <edge source="Stilgar" target="meeting" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">The Fremen looked at Idaho, said: "You measured well in my sietch, Duncan Idaho.</data>
    </edge>
    <edge source="Stilgar" target="House Harkonnen" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">I am one who does not pay the fai, the water tribute, to the Harkonnens</data>
    </edge>
    <edge source="Stilgar" target="Paul Atreides" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">"I know you, Stilgar," Paul said.</data>
    </edge>
    <edge source="Stilgar" target="Paul Atreides" id="1">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.7</data>
      <data key="d14">You ask after the Lisan al-Gaib.</data>
    </edge>
    <edge source="Stilgar" target="Paul Atreides" id="2">
      <data key="d12">FRIENDS_WITH</data>
      <data key="d13">0.9</data>
      <data key="d14">"I am your friend, Stilgar," Paul said.</data>
    </edge>
    <edge source="Stilgar" target="Paul Atreides" id="3">
      <data key="d12">LEADS</data>
      <data key="d13">0.9</data>
      <data key="d14">Stilgar turned away, led them down through the rocks, a twisting and turning path into a shadowed cleft that admitted them to the low entrance of a cave.</data>
    </edge>
    <edge source="Stilgar" target="Paul Atreides" id="4">
      <data key="d12">LOYAL_TO</data>
      <data key="d13">0.9</data>
      <data key="d14">In one blurred motion, Stilgar had his crysknife out and pointed over the heads of the throng. "Long live Duke Paul-Muad'Dib!" he shouted.</data>
    </edge>
    <edge source="Stilgar" target="Paul Atreides" id="5">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">It'll begin with Stilgar as Governor on Arrakis</data>
    </edge>
    <edge source="Stilgar" target="Duncan Idaho" id="0">
      <data key="d12">FRIENDS_WITH</data>
      <data key="d13">0.8</data>
      <data key="d14">You took away with you my father's man, Duncan Idaho--an exchange of friends.</data>
    </edge>
    <edge source="Stilgar" target="tribe" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.8</data>
      <data key="d14">"My duty is the strength of the tribe," Stilgar said.</data>
    </edge>
    <edge source="Stilgar" target="tribe" id="1">
      <data key="d12">LEADS</data>
      <data key="d13">0.9</data>
      <data key="d14">"My duty is the strength of the tribe," Stilgar said.</data>
    </edge>
    <edge source="Stilgar" target="Council" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">I was with my father in Council when you came for the water of your friend.</data>
    </edge>
    <edge source="Stilgar" target="Jamis" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">"I will not tell you again, Jamis, to be quiet," Stilgar said.</data>
    </edge>
    <edge source="Stilgar" target="Jamis" id="1">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">Stilgar faced Jamis. "Are you determined to press this fight against a child, Jamis?" His voice was low, venomous.</data>
    </edge>
    <edge source="Stilgar" target="Jamis" id="2">
      <data key="d12">LEADS</data>
      <data key="d13">0.7</data>
      <data key="d14">I've preserved him this long because he's useful in a fight as such</data>
    </edge>
    <edge source="Stilgar" target="Jamis" id="3">
      <data key="d12">FRIENDS_WITH</data>
      <data key="d13">0.9</data>
      <data key="d14">"I was a friend of Jamis," he said.</data>
    </edge>
    <edge source="Stilgar" target="conversation" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">"We cannot stay out here all night arguing," said the voice from the rocks.</data>
    </edge>
    <edge source="Stilgar" target="Lady Jessica" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.8</data>
      <data key="d14">They will concentrate on my mother and that Stilgar fellow. She can handle him.</data>
    </edge>
    <edge source="Stilgar" target="Lady Jessica" id="1">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">He returned his attention to Jessica, spoke with an apologetic tone</data>
    </edge>
    <edge source="Stilgar" target="Duke" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.8</data>
      <data key="d14">All I know now is that you came here with that stupid Duke who . . . Aiee-e-e! Woman! I care not if you kill me! He was honorable and brave, but it was stupid to put himself in the way of the Harkonnen fist!</data>
    </edge>
    <edge source="Stilgar" target="his people" id="0">
      <data key="d12">LEADS</data>
      <data key="d13">0.9</data>
      <data key="d14">As leader of my people, I've put them in bond to my word.</data>
    </edge>
    <edge source="Stilgar" target="weirding way" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">Teach us this weirding way and you have sanctuary with us as long as you wish.</data>
    </edge>
    <edge source="Stilgar" target="my people" id="0">
      <data key="d12">LEADS</data>
      <data key="d13">0.9</data>
      <data key="d14">As leader of my people, I've put them in bond to my word.</data>
    </edge>
    <edge source="Stilgar" target="Chani Kynes" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">"But, Stil, he can't be far from--" "I said leave him be, Chani!"</data>
    </edge>
    <edge source="Stilgar" target="Chani Kynes" id="1">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">And Paul saw the look of unrest in Chani's glance, the way she looked from Stilgar, who was her uncle, to Paul-Muad'Dib, who was her mate.</data>
    </edge>
    <edge source="Stilgar" target="Sietch Tabr" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">There had been a place called "Sietch Tabr" on the chart and beside it the notation: "Stilgar."</data>
    </edge>
    <edge source="Stilgar" target="Sietch Tabr" id="1">
      <data key="d12">LEADS</data>
      <data key="d13">0.9</data>
      <data key="d14">Their destination was Sietch Tabr--Stilgar's sietch.</data>
    </edge>
    <edge source="Stilgar" target="his men" id="0">
      <data key="d12">LEADS</data>
      <data key="d13">0.9</data>
      <data key="d14">Stilgar touched two of his men. "See to it."</data>
    </edge>
    <edge source="Stilgar" target="Fremen" id="0">
      <data key="d12">LEADS</data>
      <data key="d13">0.9</data>
      <data key="d14">Jessica fell into step beside Stilgar, counting heads. There were forty Fremen--she and Paul made it forty-two.</data>
    </edge>
    <edge source="Stilgar" target="Fremen" id="1">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">Beside Paul, Stilgar stirred, looked at him questioningly.</data>
    </edge>
    <edge source="Stilgar" target="Cave of the Ridges" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.7</data>
      <data key="d14">We must be at Cave of the Ridges before dawn.</data>
    </edge>
    <edge source="Stilgar" target="the troop" id="0">
      <data key="d12">LEADS</data>
      <data key="d13">0.8</data>
      <data key="d14">The troop spread out through shadows.</data>
    </edge>
    <edge source="Stilgar" target="the troop" id="1">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.7</data>
      <data key="d14">I think of your worth to the troop.</data>
    </edge>
    <edge source="Stilgar" target="free traders" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">We've been out overlong arranging to deliver our spice quota to the free traders</data>
    </edge>
    <edge source="Stilgar" target="leadership" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">What is important for a leader is that which makes him a leader.</data>
    </edge>
    <edge source="Stilgar" target="people" id="0">
      <data key="d12">LEADS</data>
      <data key="d13">0.9</data>
      <data key="d14">A leader, you see, is one of the things that distinguishes a mob from a people.</data>
    </edge>
    <edge source="Stilgar" target="her" id="0">
      <data key="d12">FRIENDS_WITH</data>
      <data key="d13">0.8</data>
      <data key="d14">I should like friendship with you . . . and trust.</data>
    </edge>
    <edge source="Stilgar" target="adab" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">She stretched out an arm from her robe, seeing Stilgar's eyes go wide.</data>
    </edge>
    <edge source="Stilgar" target="Sayyadina" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">Stilgar bowed to her. "Sayyadina," he said.</data>
    </edge>
    <edge source="Stilgar" target="tahaddi-challenge" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"Hold!" Stilgar called out. "The lad doesn't know our rule."</data>
    </edge>
    <edge source="Stilgar" target="EVENT" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Stilgar pressed through to Jessica's side, returning from the cave depths where the body of Jamis had been taken.</data>
    </edge>
    <edge source="Stilgar" target="troop" id="0">
      <data key="d12">LEADS</data>
      <data key="d13">0.9</data>
      <data key="d14">Stilgar nodded, tugging at his beard</data>
    </edge>
    <edge source="Stilgar" target="troop" id="1">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">"Because he governs this troop by his own intelligence and not just by rules."</data>
    </edge>
    <edge source="Stilgar" target="Ichwan Bedwine" id="0">
      <data key="d12">LEADS</data>
      <data key="d13">0.8</data>
      <data key="d14">His face hardened, and he spoke with command in his voice.</data>
    </edge>
    <edge source="Stilgar" target="Farok" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">"I know your need, Farok," Stilgar said.</data>
    </edge>
    <edge source="Stilgar" target="passage" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Stilgar had said were the signals of his watchmen.</data>
    </edge>
    <edge source="Stilgar" target="Shai-hulud" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Jamis has been called by Him, by Shai-hulud, who has ordained the phases for the moons that daily wane and--in the end--appear as bent and withered twigs.</data>
    </edge>
    <edge source="Stilgar" target="glowglobe" id="0">
      <data key="d12">OWNS</data>
      <data key="d13">0.9</data>
      <data key="d14">the glowglobe in Stilgar's hands</data>
    </edge>
    <edge source="Stilgar" target="water pool" id="0">
      <data key="d12">OWNS</data>
      <data key="d13">0.9</data>
      <data key="d14">"We have more than thirty-eight million decaliters here," he said. "Walled off from the little makers, hidden and preserved."</data>
    </edge>
    <edge source="Stilgar" target="Bi-lal kaifa" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"Bi-lal kaifa," intoned the troop.</data>
    </edge>
    <edge source="Stilgar" target="Arrakis" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">"We shall make a homeworld of Arrakis--with melting lenses at the poles, with lakes in the temperate zones, and only the deep desert for the maker and his spice."</data>
    </edge>
    <edge source="Stilgar" target="Muad'Dib, the Man" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Stilgar's preface to "Muad'Dib, the Man"</data>
    </edge>
    <edge source="Stilgar" target="Stilgar's troop" id="0">
      <data key="d12">LEADS</data>
      <data key="d13">0.9</data>
      <data key="d14">Stilgar's troop returning to the sietch</data>
    </edge>
    <edge source="Stilgar" target="Harah" id="0">
      <data key="d12">COMMANDS</data>
      <data key="d13">0.9</data>
      <data key="d14">Be silent," Stilgar commanded.</data>
    </edge>
    <edge source="Stilgar" target="ceremony" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Stilgar said the ceremony was held</data>
    </edge>
    <edge source="Stilgar" target="Paul's memory" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.7</data>
      <data key="d14">"You must ride the sand in the light of day that Shai-hulud shall see and know you have no fear," Stilgar had said.</data>
    </edge>
    <edge source="Stilgar" target="Shishakli" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">"Shishakli has your hooks," Stilgar said.</data>
    </edge>
    <edge source="Stilgar" target="good dune" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">This was a good dune Stilgar had chosen</data>
    </edge>
    <edge source="Stilgar" target="Council of Leaders" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.7</data>
      <data key="d14">Paul realized the man was seeing this moment through the memory of how he had risen to command of the Tabr sietch and to leadership of the Council of Leaders now that Liet-Kynes was dead.</data>
    </edge>
    <edge source="Stilgar" target="Tabr sietch" id="0">
      <data key="d12">LEADS</data>
      <data key="d13">0.9</data>
      <data key="d14">"The one who led Tabr sietch before me," Stilgar said</data>
    </edge>
    <edge source="Stilgar" target="Korba" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">Stilgar signaled for his companion to pass the bundle to Gurney</data>
    </edge>
    <edge source="Stilgar" target="Gurney Halleck" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">"There're few who haven't heard the name of Gurney Halleck," he said, and released his grip.</data>
    </edge>
    <edge source="Stilgar" target="Paul's plan" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.7</data>
      <data key="d14">We must not lose that man, Jessica thought. Paul's plan must work.</data>
    </edge>
    <edge source="Stilgar" target="leaders" id="0">
      <data key="d12">SENT_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">"These are the ones Stilgar sent for earlier when it was thought . . ."</data>
    </edge>
    <edge source="Stilgar" target="Muad'Dib" id="0">
      <data key="d12">FRIENDS_WITH</data>
      <data key="d13">0.8</data>
      <data key="d14">"Spoken like a true Fremen," Stilgar said, and he marked the cold smile that his words brought to Muad'Dib's lips.</data>
    </edge>
    <edge source="Stilgar" target="Muad'Dib" id="1">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">"Spoken like a true Fremen," Stilgar said, and he marked the cold smile that his words brought to Muad'Dib's lips.</data>
    </edge>
    <edge source="Turok" target="passage" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Turok was the name of our dead friend.</data>
    </edge>
    <edge source="Pardee" target="Harkonnen underground" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">We've good reason to believe Pardee was top man in the Harkonnen underground here.</data>
    </edge>
    <edge source="woman" target="children" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">At a chalkboard against the far wall stood a woman in a yellow wraparound, a projecto-stylus in one hand.</data>
    </edge>
    <edge source="woman" target="Paul Atreides" id="0">
      <data key="d12">HATES</data>
      <data key="d13">0.9</data>
      <data key="d14">What a poisonous hate she must've had for the Atreides</data>
    </edge>
    <edge source="Fremen prophecy" target="Fremen saying" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Fremen Kitab al-Ibar: "The weight of a kindly God is a fearful thing. Did  not God give us the burning sun (Al-Lat)? Did not God give us the Mothers of  Moisture (Reverend Mothers)? Did not God give us Shaitan (Iblis, Satan)? From  Shaitan did we not get the hurtfulness of speed?" (This is the source of the Fremen saying: "Speed comes from Shaitan."</data>
    </edge>
    <edge source="Great Houses" target="Convention" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.7</data>
      <data key="d14">dependent upon the Convention and the dictum familia of the Great Houses</data>
    </edge>
    <edge source="Great Houses" target="Baron" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.7</data>
      <data key="d14">Not with the other Great Houses waiting up there, aching for any excuse to gain from this upset on Arrakis.</data>
    </edge>
    <edge source="Great Houses" target="space over Arrakis" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"There's a massed armada of the Great Houses in space over Arrakis right now,"</data>
    </edge>
    <edge source="Great Houses" target="Great Convention" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">the Guild, the Great Houses, and the Imperium</data>
    </edge>
    <edge source="my father" target="my mother" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">All of us spied on my father as a matter of self-protection.</data>
    </edge>
    <edge source="my father" target="my sisters" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">All of us spied on my father as a matter of self-protection.</data>
    </edge>
    <edge source="my father" target="I" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">All of us spied on my father as a matter of self-protection.</data>
    </edge>
    <edge source="Atreides guard" target="Paul Atreides" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">An Atreides guard stood beside it with bared sword and the faint air-distortion of a shield around him.</data>
    </edge>
    <edge source="Fremen guard" target="Doctor Kynes" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">The planetologist raised a hand, signaled for his Fremen guard to fall back.</data>
    </edge>
    <edge source="tall man" target="Paul Atreides" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">Behind them came a tall man, hawk-faced, dark of skin and hair. He wore a jubba cloak with Atreides crest at the breast</data>
    </edge>
    <edge source="village" target="Harkonnen defensive sector" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">It was a key village, home of artisans and technicians, maintenance center for an entire Harkonnen defensive sector</data>
    </edge>
    <edge source="Shield Wall" target="passage" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">the southern rim of the Shield Wall</data>
    </edge>
    <edge source="worms" target="spice" id="0">
      <data key="d12">CREATED</data>
      <data key="d13">0.7</data>
      <data key="d14">"It was lines of movement that gave us the first clue to the relationship between worms and spice," his father said.</data>
    </edge>
    <edge source="worm" target="sand" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">The worm is now beneath the crawler</data>
    </edge>
    <edge source="Lingar Bewt" target="House Harkonnen" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">recalling Hawat's memorandum: ". . . and this water-shipper is a man to watch--Lingar Bewt, remember the name. The Harkonnens used him</data>
    </edge>
    <edge source="Lingar Bewt" target="Duke" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.8</data>
      <data key="d14">It had taken bravery to challenge him in his own ducal castle, especially since they now had Bewt's signature over a contract of allegiance.</data>
    </edge>
    <edge source="Lingar Bewt" target="water facilities" id="0">
      <data key="d12">OWNS</data>
      <data key="d13">0.7</data>
      <data key="d14">Water was, indeed, power here. If water facilities were mined, for instance, ready to be destroyed at a signal . . . The man looked capable of such a thing.</data>
    </edge>
    <edge source="Lingar Bewt" target="water" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">She glanced at Lingar Bewt. The water magnate was scowling, concentrating on his dinner.</data>
    </edge>
    <edge source="Lingar Bewt" target="banker's statement" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">The banker picked up his water flagon, gestured with it at Bewt.</data>
    </edge>
    <edge source="Bewt" target="water facilities" id="0">
      <data key="d12">OWNS</data>
      <data key="d13">0.9</data>
      <data key="d14">The man looked capable of such a thing. Destruction of water facilities might well destroy Arrakis. That could well have been the club this Bewt held over the Harkonnens.</data>
    </edge>
    <edge source="Bewt" target="Arrakis" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"Impossible on Arrakis," he said.</data>
    </edge>
    <edge source="Bewt" target="water" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Master Bewt is an expert on water</data>
    </edge>
    <edge source="Guild Bank" target="conversation" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">The Guild Bank representative had fallen into conversation with the watershipper</data>
    </edge>
    <edge source="Guild Bank" target="Carthag" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">the Guild Bank has been sacked</data>
    </edge>
    <edge source="Esmar Tuek" target="Smugglers" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">The smuggler's called Tuek, Esmar Tuek. He's a power among his kind.</data>
    </edge>
    <edge source="stillsuit manufacturer" target="dinner" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">the dinner got under way. The stillsuit manufacturer complimented Jessica on her chef and wine.</data>
    </edge>
    <edge source="Guild Bank representative" target="dinner" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">The Guild Bank representative looked across at Kynes.</data>
    </edge>
    <edge source="Guild Bank representative" target="Guild" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">that Guild Bank representative</data>
    </edge>
    <edge source="Guild Bank representative" target="Great House" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.8</data>
      <data key="d14">Does this mean the Guild itself has taken sides against House Atreides?</data>
    </edge>
    <edge source="Guild Bank representative" target="Water Peddlers Union" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">they call me Soo-Soo because I'm financial adviser to the Water Peddlers Union</data>
    </edge>
    <edge source="factory crawler" target="the dry beach at the foot of the ridge" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Gently it glided down to the dry beach at the foot of the ridge.</data>
    </edge>
    <edge source="Soo-Soo" target="water-sellers' cry" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Because of the water-sellers' cry--'Soo-Soo Sook!'</data>
    </edge>
    <edge source="Tuek" target="smuggler" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">It was the smuggler, Tuek</data>
    </edge>
    <edge source="Tuek" target="smuggler" id="1">
      <data key="d12">LEADS</data>
      <data key="d13">0.9</data>
      <data key="d14">It was the smuggler, Tuek, head thrown back laughing with complete abandon.</data>
    </edge>
    <edge source="Tuek" target="service passage" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">saw that it was a human figure, a  man face down on the stone. Leto turned him over with a foot, knife poised, bent  close in the dim light to see the face. It was the smuggler, Tuek</data>
    </edge>
    <edge source="Tuek" target="Tuek's father" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">He saw the family resemblance in the smuggler now--the father's heavy, over-hanging eyebrows and rock planes of cheeks and nose.</data>
    </edge>
    <edge source="Tuek" target="House Harkonnen" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">The Fremen are a few ragged bands that we use as spice-hunters."   "But they can kill Harkonnens."</data>
    </edge>
    <edge source="Tuek" target="Gurney Halleck" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">Tuek said. He frowned, watching the play of muscles along Halleck's jaw</data>
    </edge>
    <edge source="Tuek" target="Arrakis" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">"Arrakis is our enemy."</data>
    </edge>
    <edge source="Tuek" target="off-shipments of spice" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">I've some off-shipments of spice to see to first.</data>
    </edge>
    <edge source="stillsuit manufacturer's daughter" target="Gurney Halleck" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">Halleck stirred, spoke as though to no one in particular, directing his words over the heads of the guests across from him: "In our society, people shouldn't be quick to take offense. It's frequently suicidal." He looked at the stillsuit manufacturer's daughter beside him.</data>
    </edge>
    <edge source="Jamis" target="Songs of Muad'Dib" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Dirge for Jamis on the Funeral Plain, from "Songs of Muad'Dib" by the Princess Irulan</data>
    </edge>
    <edge source="Jamis" target="ceremony" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Only the man called Jamis seemed to stand aloof from the ceremony</data>
    </edge>
    <edge source="Jamis" target="combat" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"I choose the combat," Jamis growled.</data>
    </edge>
    <edge source="Jamis" target="combat" id="1">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"They're recovering Jamis' water," Chani said, and her thin voice came out nasal past the nose plugs. "It's the rule. The flesh belongs to the person, but his water belongs to the tribe . . . except in the combat."</data>
    </edge>
    <edge source="Jamis" target="Stilgar" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">You'll not buy us off with water," Jamis growled. "Nor will you anger me against yourself, Stilgar.</data>
    </edge>
    <edge source="Jamis" target="Stilgar" id="1">
      <data key="d12">FRIENDS_WITH</data>
      <data key="d13">0.9</data>
      <data key="d14">"We are friends of Jamis," Stilgar said.</data>
    </edge>
    <edge source="Jamis" target="Paul Atreides" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">"I'll sheath my knife in your blood," Jamis snarled.</data>
    </edge>
    <edge source="Jamis" target="Paul Atreides" id="1">
      <data key="d12">FRIENDS_WITH</data>
      <data key="d13">0.9</data>
      <data key="d14">"I was a friend of Jamis," Paul whispered.</data>
    </edge>
    <edge source="Jamis" target="EVENT" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Jamis stepped into the ring</data>
    </edge>
    <edge source="Jamis" target="EVENT" id="1">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"When the hawk plane stooped upon us at Hole-in-the-Rock, it was Jamis pulled me to safety."</data>
    </edge>
    <edge source="Jamis" target="tahaddi-challenge" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"There can be no yielding in the tahaddi-challenge. Death is the test of it."</data>
    </edge>
    <edge source="Jamis" target="Ichwan Bedwine" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">Jamis was our companion and brother of the Ichwan Bedwine.</data>
    </edge>
    <edge source="Jamis" target="gray-bearded man" id="0">
      <data key="d12">FRIENDS_WITH</data>
      <data key="d13">0.9</data>
      <data key="d14">"I was a friend of Jamis," he said.</data>
    </edge>
    <edge source="Jamis" target="mother" id="0">
      <data key="d12">FRIENDS_WITH</data>
      <data key="d13">0.9</data>
      <data key="d14">"I was a friend of Jamis," she said.</data>
    </edge>
    <edge source="Jamis" target="Unnamed man" id="0">
      <data key="d12">FRIENDS_WITH</data>
      <data key="d13">0.9</data>
      <data key="d14">"I was a friend of Jamis," he said.</data>
    </edge>
    <edge source="Jamis" target="troop" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Jamis' way of telling us he's satisfied.</data>
    </edge>
    <edge source="Jamis" target="Geoff's boy" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">He made no separation between Geoff's boy, my firstborn, and his own true son. They were equal in his eyes.</data>
    </edge>
    <edge source="Jamis" target="his own true son" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">He made no separation between Geoff's boy, my firstborn, and his own true son. They were equal in his eyes.</data>
    </edge>
    <edge source="Jamis" target="children" id="0">
      <data key="d12">LOVES</data>
      <data key="d13">0.8</data>
      <data key="d14">He was a good man, Jamis, but quick to anger. A good provider, Jamis, and a wonder with the children.</data>
    </edge>
    <edge source="Songs of Muad'Dib" target="Emperor's daughter" id="0">
      <data key="d12">CREATED</data>
      <data key="d13">0.9</data>
      <data key="d14">-from "Songs of Muad'Dib" by the Princess Irulan</data>
    </edge>
    <edge source="Truthsayer" target="suite" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.7</data>
      <data key="d14">the old Truthsayer standing like a black shadow with her hood pulled about her face</data>
    </edge>
    <edge source="Scarface" target="Lady Jessica" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">"Me, I wouldn't like the thought of facing that Truthsayer after this night's work," Scarface said.</data>
    </edge>
    <edge source="Scarface" target="Paul Atreides" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.8</data>
      <data key="d14">He turned to look at the pilot.</data>
    </edge>
    <edge source="House Harkonnen soldiers" target="Fremen" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">The Harkonnen troopers had left him here without water or stillsuit, thinking a worm would get him if the desert didn't.</data>
    </edge>
    <edge source="House Harkonnen soldiers" target="Kynes" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">The Harkonnen troopers had left him here without water or stillsuit, thinking a worm would get him if the desert didn't.</data>
    </edge>
    <edge source="Czigo" target="Kinet" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">He nudged the litter-bearer. "Yee-up," the litter-bearer said. He returned to the litter, took Jessica's shoulders. "C'mon, Kinet. You can go along if you wants to make sure what happens." "It is nice of you to invite me, Czigo," Scarface said.</data>
    </edge>
    <edge source="Czigo" target="Kinet" id="1">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.7</data>
      <data key="d14">"Stop that!" Kinet ordered. "Ah, shut your trap," Czigo said.</data>
    </edge>
    <edge source="Czigo" target="Paul Atreides" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.8</data>
      <data key="d14">Now for the cub," he said and leaned toward Paul.</data>
    </edge>
    <edge source="Czigo" target="Lady Jessica" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.8</data>
      <data key="d14">"You're trying to trick me," Czigo muttered.</data>
    </edge>
    <edge source="Kinet" target="Czigo" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.8</data>
      <data key="d14">Scarface, the deaf one they called Kinet, took his place in front. The litter-bearer, the one they called Czigo, came around and took the other front seat.</data>
    </edge>
    <edge source="Kinet" target="Lady Jessica" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.8</data>
      <data key="d14">Kinet swiveled his seat. Jessica saw the glint of starlight on a lasgun in his hand.</data>
    </edge>
    <edge source="pilot" target="Baron" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.8</data>
      <data key="d14">The Baron wants no witnesses.</data>
    </edge>
    <edge source="Umman Kudu" target="Baron" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">Umman Kudu, the captain of the Baron's personal guard.</data>
    </edge>
    <edge source="Duke's men" target="suicide raid" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">but that suicide raid by the Duke's men</data>
    </edge>
    <edge source="guard captain" target="Baron" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">that stupid guard captain! He'd said he scoped everyone before bringing them into the Baron's presence!</data>
    </edge>
    <edge source="Iakin Nefud" target="Baron" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">"My Lord knows I'll devote myself entirely to his safety."</data>
    </edge>
    <edge source="Iakin Nefud" target="Baron" id="1">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">Again, Nefud nodded.</data>
    </edge>
    <edge source="Iakin Nefud" target="guard" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">Nefud. Iakin Nefud. Guard corporal.</data>
    </edge>
    <edge source="Iakin Nefud" target="Baron Vladimir Harkonnen" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">"They are dead, Baron," said Iakin Nefud, the guard captain.</data>
    </edge>
    <edge source="Iakin Nefud" target="men" id="0">
      <data key="d12">LEADS</data>
      <data key="d13">0.9</data>
      <data key="d14">Nefud signaled men to assist him, led them out the door.</data>
    </edge>
    <edge source="Old Duke Atreides" target="Duke Leto" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">the oil painting of the Old Duke Atreides, the late Duke Leto's father.</data>
    </edge>
    <edge source="Guildsmen" target="passage" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Even the Guildsmen.</data>
    </edge>
    <edge source="Guildsmen" target="Guild" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">They wore the Guild gray, unadorned</data>
    </edge>
    <edge source="His mother" target="Paul Atreides" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">"Paul!" His mother was beside him, holding his hands, her face a gray blob peering at him.</data>
    </edge>
    <edge source="His mother" target="Paul Atreides" id="1">
      <data key="d12">CREATED</data>
      <data key="d13">0.9</data>
      <data key="d14">"I gave birth to you."</data>
    </edge>
    <edge source="unknown mother" target="Bene Gesserit Sisterhood" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">The Bene Gesserit who bore me and gave me to the Sisters</data>
    </edge>
    <edge source="Tsimpo" target="Carthag" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Tsimpo, a garrison village, buffer outpost for the former capital city, Carthag</data>
    </edge>
    <edge source="Duke's main base" target="Arrakeen" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Duke's main base at Arrakeen</data>
    </edge>
    <edge source="Imperial Sardaukar" target="attack" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">there were Imperial Sardaukar among the attackers</data>
    </edge>
    <edge source="Arkie" target="Hawat's men" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">Arkie was one of--</data>
    </edge>
    <edge source="Imperial Ecological Testing Stations" target="planet" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.7</data>
      <data key="d14">This is one of the Imperial Ecological Testing Stations my father wanted as advance bases</data>
    </edge>
    <edge source="Dr. Yueh" target="betrayer" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Doctor Yueh, his true betrayer</data>
    </edge>
    <edge source="Bene Gesserit" target="Paul Atreides" id="0">
      <data key="d12">HATES</data>
      <data key="d13">0.9</data>
      <data key="d14">What a poisonous hate she must've had for the Atreides, he thought.</data>
    </edge>
    <edge source="Bene Gesserit" target="EVENT" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">Even the old Bene Gesserit Truthsayer drew back as the child passed and made a warding sign in her direction.</data>
    </edge>
    <edge source="Vladimir Harkonnen" target="Paul Atreides" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">We know how we overwhelmed the Atreides.</data>
    </edge>
    <edge source="Vladimir Harkonnen" target="Hawat" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">Hawat knows, too.</data>
    </edge>
    <edge source="Vladimir Harkonnen" target="wealth" id="0">
      <data key="d12">LOVES</data>
      <data key="d13">0.9</data>
      <data key="d14">We did it with wealth.</data>
    </edge>
    <edge source="Vladimir Harkonnen" target="woo Hawat" id="0">
      <data key="d12">PLANS_TO</data>
      <data key="d13">0.9</data>
      <data key="d14">We will woo Hawat," the Baron said.</data>
    </edge>
    <edge source="Vladimir Harkonnen" target="hide him from the Sardaukar" id="0">
      <data key="d12">PLANS_TO</data>
      <data key="d13">0.9</data>
      <data key="d14">We will hide him from the Sardaukar.</data>
    </edge>
    <edge source="Vladimir Harkonnen" target="hold in reserve the withdrawal of the antidote for the poison" id="0">
      <data key="d12">PLANS_TO</data>
      <data key="d13">0.9</data>
      <data key="d14">And we will hold in reserve . . . the withdrawal of the antidote for the poison.</data>
    </edge>
    <edge source="Vladimir Harkonnen" target="destroy the Mentat" id="0">
      <data key="d12">PLANS_TO</data>
      <data key="d13">0.9</data>
      <data key="d14">If they suspect anything at all it's that I wish to destroy the Mentat.</data>
    </edge>
    <edge source="Vladimir Harkonnen" target="Rabban" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">The Baron reached beneath a drapery beside his suspensor bed, pressed a button to summon his older nephew, Rabban.</data>
    </edge>
    <edge source="Vladimir Harkonnen" target="the woman and the boy" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.8</data>
      <data key="d14">The woman and the boy were dead.</data>
    </edge>
    <edge source="Vladimir Harkonnen" target="Arrakis" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">The Siridar-Baron died on Arrakis during the Revolt.</data>
    </edge>
    <edge source="Vladimir Harkonnen" target="Abulurd Harkonnen" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">Vladimir Harkonnen is the direct-line male descendant of the Bashar Abulurd Harkonnen</data>
    </edge>
    <edge source="Rabban" target="Arrakis" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.8</data>
      <data key="d14">Oh, how he'll be hated here on Arrakis!</data>
    </edge>
    <edge source="Rabban" target="Arrakis" id="1">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">That's why I summoned you here to Arrakis.</data>
    </edge>
    <edge source="Rabban" target="Baron" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">He knew within certain limits how far the old Baron would go against family.</data>
    </edge>
    <edge source="Rabban" target="Baron" id="1">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">Rabban said. "Could I--" "I'm removing them," the Baron said.</data>
    </edge>
    <edge source="Rabban" target="Baron" id="2">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">"As the Emperor wishes it," Rabban said.</data>
    </edge>
    <edge source="Rabban" target="Lankiveil" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">The Count Rabban of Lankiveil?</data>
    </edge>
    <edge source="Rabban" target="Fremen" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">Rabban killed six thousand of them last year alone!</data>
    </edge>
    <edge source="Rabban" target="Muad'Dib" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">"Rabban has sent cautious overtures about a truce. His messengers have been returned without their water."</data>
    </edge>
    <edge source="Rabban" target="battles" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"Is there news of battles?" She held her face expressionless that Jessica might not see the betrayal -- that this was a question about Paul Muad'Dib. "New victories," Jessica said. "Rabban has sent cautious overtures about a truce."</data>
    </edge>
    <edge source="Rabban" target="Vladimir Harkonnen" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">Glossu Rabban, Count of Lankiveil, was the eldest nephew of Vladimir Harkonnen</data>
    </edge>
    <edge source="Rabban" target="Feyd-Rautha" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">Glossu Rabban and Feyd-Rautha Rabban</data>
    </edge>
    <edge source="Staban Tuek" target="Esmar Tuek" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">"I am Staban Tuek, son of Esmar Tuek," the smuggler said.</data>
    </edge>
    <edge source="Drisq" target="Tuek" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">Consult my quartermaster," Tuek said. "Drisq is his name.</data>
    </edge>
    <edge source="Mattai" target="Gurney Halleck" id="0">
      <data key="d12">FRIENDS_WITH</data>
      <data key="d13">0.8</data>
      <data key="d14">Mattai wants a song to ease his going, sir. He says you'll know the one . . . he's asked it of you often enough.</data>
    </edge>
    <edge source="my mother" target="my sisters" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">All of us spied on my father as a matter of self-protection.</data>
    </edge>
    <edge source="my mother" target="I" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">All of us spied on my father as a matter of self-protection.</data>
    </edge>
    <edge source="my sisters" target="I" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">All of us spied on my father as a matter of self-protection.</data>
    </edge>
    <edge source="Liet-Kynes" target="passage" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">he remembered Liet-Kynes betraying a veiled reference to some association between worm and spice.</data>
    </edge>
    <edge source="Liet-Kynes" target="His Imperial Majesty" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">"I am His Imperial Majesty's Planetologist," he whispered</data>
    </edge>
    <edge source="Liet-Kynes" target="Fremen" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">a full Fremen</data>
    </edge>
    <edge source="Liet-Kynes" target="Arrakis" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">planetary ecologist for Arrakis</data>
    </edge>
    <edge source="Liet-Kynes" target="Emperor" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">Liet-Kynes, the Emperor's planetary ecologist</data>
    </edge>
    <edge source="Liet-Kynes" target="planet" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">the Emperor's planetary ecologist, the man who had gone native</data>
    </edge>
    <edge source="Liet-Kynes" target="dream" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">except for a dream with which Liet-Kynes had infused them before his death.</data>
    </edge>
    <edge source="Liet-Kynes" target="House Harkonnen" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">who had killed more than a hundred Harkonnens</data>
    </edge>
    <edge source="Liet-Kynes" target="cave-in at Plaster Basin" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Kynes-the-Umma was killed in the cave-in at Plaster Basin</data>
    </edge>
    <edge source="Stil" target="Fremen" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.7</data>
      <data key="d14">"Make it quick, Stil. Get their water and let's be on our way.</data>
    </edge>
    <edge source="The Pillars of the Universe" target="Arrakeen mystical fusion" id="0">
      <data key="d12">CREATED</data>
      <data key="d13">0.7</data>
      <data key="d14">This Fremen religious adaptation, then, is the source of what we now recognize as "The Pillars of the Universe," whose Qizara Tafwid are among us all with signs and proofs and prophecy. They bring us the Arrakeen mystical fusion</data>
    </edge>
    <edge source="The Old Man's Hymn" target="The Pillars of the Universe" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Who has not heard and been deeply moved by "The Old Man's Hymn"?</data>
    </edge>
    <edge source="Chani Kynes" target="Liet" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">"I am Chani, daughter of Liet."</data>
    </edge>
    <edge source="Chani Kynes" target="Paul Atreides" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">Chani touched Paul's arm.</data>
    </edge>
    <edge source="Chani Kynes" target="Paul Atreides" id="1">
      <data key="d12">FRIENDS_WITH</data>
      <data key="d13">0.8</data>
      <data key="d14">the elfin-faced Chani whispering in his ear as she nodded toward Jamis</data>
    </edge>
    <edge source="Chani Kynes" target="Paul Atreides" id="2">
      <data key="d12">LOVES</data>
      <data key="d13">0.9</data>
      <data key="d14">"I see us giving love to each other in a time of quiet between storms. It's what we were meant to do."</data>
    </edge>
    <edge source="Chani Kynes" target="Paul Atreides" id="3">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">But Chani had produced an Atreides son, and Jessica had found herself unable to reject the child with the mother.</data>
    </edge>
    <edge source="Chani Kynes" target="military company" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">They travel as a military company--even the girl, Chani.</data>
    </edge>
    <edge source="Chani Kynes" target="ceremony" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Chani whispered</data>
    </edge>
    <edge source="Chani Kynes" target="EVENT" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">And there were Chani's words of instruction still in the front of his consciousness: "Jamis turns to the right with his knife after a parry.</data>
    </edge>
    <edge source="Chani Kynes" target="EVENT" id="1">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Chani's taking the catalyst from my body to change the poison in that sack</data>
    </edge>
    <edge source="Chani Kynes" target="weighing of the water" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"Chani showed me . . . because I'm supposed to see it and give my . . . permission for the weighing of the water."</data>
    </edge>
    <edge source="Chani Kynes" target="Shah-Nama" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">It is written in the Shah-Nama that water was the first of all things created.</data>
    </edge>
    <edge source="Chani Kynes" target="Lady Jessica" id="0">
      <data key="d12">FRIENDS_WITH</data>
      <data key="d13">0.8</data>
      <data key="d14">Chani glided back to Jessica's side, took her hand.</data>
    </edge>
    <edge source="Chani Kynes" target="Lady Jessica" id="1">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">Chani glided back to Jessica's side, took her hand.</data>
    </edge>
    <edge source="Chani Kynes" target="Lady Jessica" id="2">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">My mother, Jessica thought. Yes, she has the right to call me that in the formal greeting. She has given me a grandson.</data>
    </edge>
    <edge source="Chani Kynes" target="Jamis" id="0">
      <data key="d12">FRIENDS_WITH</data>
      <data key="d13">0.8</data>
      <data key="d14">by the heartbeats jan-jan-jan of our friend . . . Jamis.</data>
    </edge>
    <edge source="Chani Kynes" target="Stilgar" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">Chani turned a startled glance on Stilgar.</data>
    </edge>
    <edge source="Chani Kynes" target="the passage" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">heard Chani's voice hissing</data>
    </edge>
    <edge source="Chani Kynes" target="Reverend Mother" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.8</data>
      <data key="d14">Chani helped the old woman to her feet. So this is their Reverend Mother, Jessica thought.</data>
    </edge>
    <edge source="Chani Kynes" target="Sayyadina" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Chani, daughter of Liet, will be consecrated in the Sayyadina at this time.</data>
    </edge>
    <edge source="Chani Kynes" target="hajra" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Chani has returned from her hajra-Chani has seen the waters.</data>
    </edge>
    <edge source="Chani Kynes" target="waters" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Chani has returned from her hajra-Chani has seen the waters.</data>
    </edge>
    <edge source="Chani Kynes" target="ritual" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Chani said. She began unfastening a coiled spout fixed to the top of the sloshing sack.</data>
    </edge>
    <edge source="Chani Kynes" target="Water of Life" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Chani lifted the spout toward Jessica, said: "Here is the Water of Life, the water that is greater than water--Kan, the water that frees the soul.</data>
    </edge>
    <edge source="Chani Kynes" target="Liet-Kynes" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.8</data>
      <data key="d14">seeing the traces of Liet-Kynes there as yet unfixed by time.</data>
    </edge>
    <edge source="Chani Kynes" target="rite of joining" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">gestured to the watersack now being held above her by Chani.</data>
    </edge>
    <edge source="Chani Kynes" target="Fremen" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">walking between the Fremen guards</data>
    </edge>
    <edge source="Chani Kynes" target="Paul Muad'Dib" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">Chani joined him outside the tent, hugging her elbows, looking up at him from the corners of her eyes the way she did when she studied his mood.</data>
    </edge>
    <edge source="Chani Kynes" target="Paul Muad'Dib" id="1">
      <data key="d12">LOVES</data>
      <data key="d13">0.9</data>
      <data key="d14">"I see a child . . . in my arms. It's our child, yours and mine."</data>
    </edge>
    <edge source="Chani Kynes" target="her father" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">"We have each lost a father to the Harkonnens."</data>
    </edge>
    <edge source="Chani Kynes" target="Book Three THE PROPHET" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Book Three  THE PROPHET</data>
    </edge>
    <edge source="Chani Kynes" target="unknown" id="0">
      <data key="d12">LOVES</data>
      <data key="d13">0.9</data>
      <data key="d14">"Always," she said, and kissed his cheek.</data>
    </edge>
    <edge source="Chani Kynes" target="Leto II" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">safe with their son, Leto II</data>
    </edge>
    <edge source="Chani Kynes" target="south" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Yet Chani was deep in the south</data>
    </edge>
    <edge source="Chani Kynes" target="killed someone" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Chani had just killed someone.</data>
    </edge>
    <edge source="Chani Kynes" target="Paul's memory" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Paul remembered telling himself: You always know when they're carrying a  body.</data>
    </edge>
    <edge source="Chani Kynes" target="combat" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"I dispatched one who came to challenge you in single combat, Usul."</data>
    </edge>
    <edge source="Chani Kynes" target="Harah" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.7</data>
      <data key="d14">But perhaps I should've left him for Harah.</data>
    </edge>
    <edge source="Chani Kynes" target="Harah" id="1">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">"I left him with Alia in the care of Harah."</data>
    </edge>
    <edge source="Chani Kynes" target="Leto Atreides" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">It had been the day of the circumcision ceremony for little Leto.</data>
    </edge>
    <edge source="Chani Kynes" target="him" id="0">
      <data key="d12">LOVES</data>
      <data key="d13">0.9</data>
      <data key="d14">Chani turned toward him in the growing dawnlight. Her eyes bored into him. "It's a thing to be discussed another time, beloved."</data>
    </edge>
    <edge source="Chani Kynes" target="Gurney Halleck" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">"Chani," Paul said, "this is Gurney Halleck. You've heard me speak of him."</data>
    </edge>
    <edge source="Chani Kynes" target="Muad'Dib" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">the mate of Muad'Dib, the mother of his firstborn</data>
    </edge>
    <edge source="Chani Kynes" target="Alia" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">He told me before that I must remain in the south with little Leto and Alia.</data>
    </edge>
    <edge source="Chani Kynes" target="jealousy" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"There was jealousy when it was learned that I'd been summoned north."</data>
    </edge>
    <edge source="Sayyadina" target="special place of honor" id="0">
      <data key="d12">LEADS</data>
      <data key="d13">0.9</data>
      <data key="d14">the Sayyadina, when they are not the formal leaders, hold a special place of honor.</data>
    </edge>
    <edge source="Sayyadina" target="strength of God" id="0">
      <data key="d12">TEACHES</data>
      <data key="d13">0.9</data>
      <data key="d14">They teach. They maintain the strength of God here.</data>
    </edge>
    <edge source="Sayyadina" target="Bene Gesserit Sisterhood" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">Sayyadina to rogue peoples who've been so heavily imprinted with our Bene Gesserit soothsay they even call their chief priestesses Reverend Mothers.</data>
    </edge>
    <edge source="Sayyadina" target="Reverend Mothers" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">And she saw the thread of the past carried by Sayyadina after Sayyadina--first by word of mouth, hidden in the sand chanteys, then refined through their own Reverend Mothers with the discovery of the poison drug on Rossak . . .</data>
    </edge>
    <edge source="al-Lat" target="book of examples" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">He reads to al-Lat, the sun whom he defied and subjugated.</data>
    </edge>
    <edge source="Sadus" target="Trial" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">He reads to the Sadus of the Trial</data>
    </edge>
    <edge source="Paul Muad'Dib" target="Chani Kynes" id="0">
      <data key="d12">LOVES</data>
      <data key="d13">0.9</data>
      <data key="d14">A profound compassion for her swept through him. He pulled her against him, stroked her head. "Chani, Chani, don't fear."</data>
    </edge>
    <edge source="Paul Muad'Dib" target="Chani Kynes" id="1">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">Chani joined him outside the tent, hugging her elbows, looking up at him from the corners of her eyes the way she did when she studied his mood.</data>
    </edge>
    <edge source="Paul Muad'Dib" target="Leto Atreides" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">"Does our Leto yet hold my mother in his palm?"</data>
    </edge>
    <edge source="Paul Muad'Dib" target="razzia" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">The young men are banding for a razzia.</data>
    </edge>
    <edge source="Paul Muad'Dib" target="Stilgar" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.8</data>
      <data key="d14">They say they will force him to call out Stilgar and assume command of the tribes.</data>
    </edge>
    <edge source="Paul Muad'Dib" target="Stilgar" id="1">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">He looked at her as he spoke to Stilgar.</data>
    </edge>
    <edge source="Paul Muad'Dib" target="sandrider" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"Very good, Paul Muad'Dib. With plenty of practice, you may yet become a sandrider."</data>
    </edge>
    <edge source="Paul Muad'Dib" target="Fremen" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"And I am a Fremen born this day here in the Habbanya erg."</data>
    </edge>
    <edge source="Paul Muad'Dib" target="Fedaykin" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"The Fedaykin have raided with me," Paul said.</data>
    </edge>
    <edge source="Paul Muad'Dib" target="ceremonies" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">But Paul Muad'Dib has held himself aloof from these ceremonies</data>
    </edge>
    <edge source="Farok" target="Paul Atreides" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">the narrow bearded face of the one called Farok turned toward Paul</data>
    </edge>
    <edge source="Farok" target="Fremen" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">Paul saw the Fremen throwing back their hoods, removing nose plugs, breathing deeply. Someone sighed. Paul looked for Chani, found that she had left his side. He was hemmed in by a press of robed bodies. Someone jostled him, said, "Excuse me, Usul. What a crush! It's always this way." On his left, the narrow bearded face of the one called Farok turned toward Paul.</data>
    </edge>
    <edge source="God" target="Arrakis" id="0">
      <data key="d12">CREATED</data>
      <data key="d13">0.9</data>
      <data key="d14">God created Arrakis to train the faithful.</data>
    </edge>
    <edge source="Margot Fenring" target="Giedi Prime" id="0">
      <data key="d12">VISITED</data>
      <data key="d13">0.9</data>
      <data key="d14">Visiting observers from the Imperial Court-a Count and Lady Fenring--were on the Harkonnen homeworld of Giedi Prime for the event</data>
    </edge>
    <edge source="Margot Fenring" target="Baron's speech" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"The Count and Lady Fenring of whom I've spoken."</data>
    </edge>
    <edge source="Margot Fenring" target="Feyd-Rautha's thoughts" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">He stared at the Lady Fenring. She was golden-haired and willowy, her perfection of figure clothed in a flowing gown of ecru--simple fitness of form without ornament.</data>
    </edge>
    <edge source="Margot Fenring" target="Baron" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">"Not at all," Lady Fenring said.</data>
    </edge>
    <edge source="bull" target="Old Duke Atreides" id="0">
      <data key="d12">KILLED</data>
      <data key="d13">0.9</data>
      <data key="d14">the head of the bull that had killed him.</data>
    </edge>
    <edge source="gladiator" target="gladiator fight" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">The appearance of the gladiator as he emerged told the trained eye much it needed to know.</data>
    </edge>
    <edge source="Duke Leto's fighting men" target="gladiator fight" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">It's one of Duke Leto's fighting men we took on Arrakis! Feyd-Rautha thought.</data>
    </edge>
    <edge source="slave" target="gladiator fight" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Out charged a tall, muscular man with shaved head and darkly pitted eyes.</data>
    </edge>
    <edge source="na-Baron" target="poisons" id="0">
      <data key="d12">OWNS</data>
      <data key="d13">0.9</data>
      <data key="d14">The na-Baron never gave quick death; he delighted in demonstrating rare poisons</data>
    </edge>
    <edge source="Harah" target="Jamis" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">"This bested my Jamis?" she demanded.</data>
    </edge>
    <edge source="Harah" target="Paul Atreides" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">She looked at Paul.</data>
    </edge>
    <edge source="Harah" target="factory" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">I work in the factory in season.</data>
    </edge>
    <edge source="Harah" target="Liet" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.8</data>
      <data key="d14">What Liet taught us, we cannot pause an instant in that.</data>
    </edge>
    <edge source="Harah" target="Paul Muad'Dib" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.8</data>
      <data key="d14">"Your yali is ready for you, Usul."</data>
    </edge>
    <edge source="Harah" target="Paul Muad'Dib" id="1">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">the special training they receive as the children of Usul</data>
    </edge>
    <edge source="Harah" target="Paul Muad'Dib" id="2">
      <data key="d12">LOVES</data>
      <data key="d13">0.7</data>
      <data key="d14">"Perhaps you think, as well, that I regret not being the chosen of Usul, that I am jealous of Chani?"</data>
    </edge>
    <edge source="Harah" target="passage" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">thought it was Harah returning with food</data>
    </edge>
    <edge source="Harah" target="fight in the sietch corridor" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Harah, Jamis' wife, had  intruded on him once to say there'd been a fight in the sietch corridor.</data>
    </edge>
    <edge source="Harah" target="Paul's menage" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">The voice from outside the hangings at her door was that of Harah, the other woman in Paul's menage</data>
    </edge>
    <edge source="Harah" target="Alia" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">Harah scowled at the child. "Don't try to insult me, child. I know my place."</data>
    </edge>
    <edge source="Harah" target="Alia" id="1">
      <data key="d12">FRIENDS_WITH</data>
      <data key="d13">0.8</data>
      <data key="d14">Why do you think I accept her insults? I know there's no malice in them.</data>
    </edge>
    <edge source="Harah" target="Alia" id="2">
      <data key="d12">LOVES</data>
      <data key="d13">0.9</data>
      <data key="d14">it was obvious she loved Alia as though this were her own child</data>
    </edge>
    <edge source="Harah" target="Alia" id="3">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">Don't be sad about it, Harah," Alia said.</data>
    </edge>
    <edge source="Harah" target="Jessica's son's household" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">I respect the fact that you're a member of my son's household," Jessica said.</data>
    </edge>
    <edge source="Harah" target="son's household" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">I respect the fact that you're a member of my son's household</data>
    </edge>
    <edge source="Harah" target="Lady Jessica" id="0">
      <data key="d12">FRIENDS_WITH</data>
      <data key="d13">0.8</data>
      <data key="d14">they did need Harah. The tribe would understand Harah -- both her words and her emotions</data>
    </edge>
    <edge source="Harah" target="Lady Jessica" id="1">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.7</data>
      <data key="d14">my family sat in their pool courtyard," Harah said</data>
    </edge>
    <edge source="plastics shop" target="large, bright chamber" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">men and women working with stand-mounted machinery in a large, bright chamber</data>
    </edge>
    <edge source="Kaleff" target="Geoff" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">Kaleff, the elder of the two, was ten, and the natural son of Geoff.</data>
    </edge>
    <edge source="Orlop" target="Jamis" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">Orlop, the younger, was eight, the natural son of Jamis.</data>
    </edge>
    <edge source="the people of Misr" target="Nilotic al-Ourouba" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Since our Sunni ancestors fled from Nilotic al-Ourouba, we have known flight and death.</data>
    </edge>
    <edge source="Water of Life" target="liquid exhalation of a dying sandworm" id="0">
      <data key="d12">CREATED</data>
      <data key="d13">0.9</data>
      <data key="d14">But Jessica's attention was focused on the revelation of the Water of Life, seeing its source: the liquid exhalation of a dying sandworm, a maker.</data>
    </edge>
    <edge source="Water of Life" target="Collected Legends of Arrakis" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">-"Collected Legends of Arrakis" by the Princess Irulan</data>
    </edge>
    <edge source="Water of Life" target="Reverend Mother" id="0">
      <data key="d12">CREATED</data>
      <data key="d13">0.9</data>
      <data key="d14">WATER OF LIFE: an "illuminating" poison (see Reverend Mother)</data>
    </edge>
    <edge source="Water of Life" target="sandworm" id="0">
      <data key="d12">CREATED</data>
      <data key="d13">0.9</data>
      <data key="d14">that liquid exhalation of a sandworm</data>
    </edge>
    <edge source="Reverend Mothers" target="place" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">the place the Reverend Mothers are so reluctant to mention--the place where only a Kwisatz Haderach may look.</data>
    </edge>
    <edge source="Reverend Mothers" target="discovery of the poison drug on Rossak" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">then refined through their own Reverend Mothers with the discovery of the poison drug on Rossak . . .</data>
    </edge>
    <edge source="Poritrin" target="slave raids" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">ceremony that mourned the slave raids of Poritrin</data>
    </edge>
    <edge source="Poritrin" target="Epsilon Alangue" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">PORITRIN: third planet of Epsilon Alangue</data>
    </edge>
    <edge source="Bela Tegeuse" target="slave raids" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">ceremony that mourned the slave raids of Poritrin, Bela Tegeuse</data>
    </edge>
    <edge source="Alia" target="Leto Atreides" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">"It's Alia he holds as well," she said.</data>
    </edge>
    <edge source="Alia" target="scripture" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">They quoted the scripture: 'Suffer not a witch to live among us.'</data>
    </edge>
    <edge source="Alia" target="celebration" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">her daughter, Alia, would be at the celebration</data>
    </edge>
    <edge source="Alia" target="Lady Jessica" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">Seeing her daughter, Jessica</data>
    </edge>
    <edge source="Alia" target="Paul Atreides" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">Alia's resemblance to Paul</data>
    </edge>
    <edge source="Alia" target="Harah" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">"My brother's ghanima is annoyed with me," Alia said in her half-lisp.</data>
    </edge>
    <edge source="Alia" target="Harah" id="1">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">Alia is like my own flesh because she's sister to one who is like my brother</data>
    </edge>
    <edge source="Alia" target="Harah" id="2">
      <data key="d12">LOVES</data>
      <data key="d13">0.9</data>
      <data key="d14">What other baby's first words to her nurse were: 'I love you, Harah'?</data>
    </edge>
    <edge source="Alia" target="Subiay's child being born" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"I hid behind the hangings and watched Subiay's child being born," Alia said.</data>
    </edge>
    <edge source="Alia" target="Bene Gesserit Sisterhood" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">"Those are the Bene Gesserit training," Jessica said.</data>
    </edge>
    <edge source="Alia" target="EVENT" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.7</data>
      <data key="d14">One day I woke up," Alia said. "It was like waking from sleep except that I could not remember going to sleep. I was in a warm, dark place. And I was frightened.</data>
    </edge>
    <edge source="Alia" target="Reverend Mother" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">After all, there's cause for happiness here: I'm a Reverend Mother.</data>
    </edge>
    <edge source="Alia" target="Tharthar" id="0">
      <data key="d12">FRIENDS_WITH</data>
      <data key="d13">0.7</data>
      <data key="d14">Alia freed her hand from her mother's, said: "I will go with Tharthar</data>
    </edge>
    <edge source="Alia" target="Duke Leto" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">"I am Alia, daughter of Duke Leto and the Lady Jessica, sister of Duke Paul-Muad'Dib," the child said.</data>
    </edge>
    <edge source="Alia" target="Jessica Atreides" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">"I am Alia, daughter of Duke Leto and the Lady Jessica, sister of Duke Paul-Muad'Dib," the child said.</data>
    </edge>
    <edge source="Alia" target="Baron" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">You've met the Atreides gom jabbar.</data>
    </edge>
    <edge source="Alia" target="Baron" id="1">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">"I've killed our grandfather, the demented old Baron."</data>
    </edge>
    <edge source="Alia" target="her brother" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">"My brother knows I'm here," Alia said.</data>
    </edge>
    <edge source="Alia" target="Padishah Emperor" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"Child, can you truly project your thoughts into the mind of another?"</data>
    </edge>
    <edge source="Alia" target="the old woman" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"Kill her," the old woman muttered, and clutched the back of the throne for support. "Kill her!"</data>
    </edge>
    <edge source="Alia" target="Muad'Dib" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">My brother comes now," Alia said.</data>
    </edge>
    <edge source="Alia" target="Grandfather" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">I'm sorry, Grandfather, Alia said.</data>
    </edge>
    <edge source="Alia" target="Fremen" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">as befitted her Fremen training</data>
    </edge>
    <edge source="Alia" target="killing enemy wounded" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
