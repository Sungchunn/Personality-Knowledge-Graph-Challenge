      <data key="d14">-from "Muad'Dib: Family Commentaries" by the Princess Irulan</data>
    </edge>
    <edge source="Emperor's daughter" target="Collected Sayings of Muad'Dib" id="0">
      <data key="d12">CREATED</data>
      <data key="d13">0.9</data>
      <data key="d14">"Collected Sayings of Muad'Dib" by the Princess Irulan</data>
    </edge>
    <edge source="Emperor's daughter" target="Padishah Emperor" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">My father, the Padishah Emperor, took me by the hand</data>
    </edge>
    <edge source="Emperor's daughter" target="Songs of Muad'Dib" id="0">
      <data key="d12">CREATED</data>
      <data key="d13">0.9</data>
