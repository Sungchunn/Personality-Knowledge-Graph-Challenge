    <edge source="Muad'Dib" target="Arrakis" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Arrakis, the planet known as Dune, is forever his place.</data>
    </edge>
    <edge source="Muad'Dib" target="Arrakis" id="1">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">They've a new prophet or religious leader of some kind among the Fremen, the Baron said. They call him Muad'Dib.</data>
    </edge>
    <edge source="Muad'Dib" target="Caladan" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">he was born on Caladan and lived his first fifteen years there.</data>
    </edge>
    <edge source="Muad'Dib" target="House Harkonnen" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">To attempt an understanding of Muad'Dib without understanding his mortal enemies, the Harkonnens</data>
    </edge>
    <edge source="Muad'Dib" target="Duke" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.8</data>
      <data key="d14">Muad'Dib rode through the streets of Arrakeen with his family</data>
    </edge>
    <edge source="Muad'Dib" target="EVENT" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">Muad'Dib rode through the streets of Arrakeen</data>
    </edge>
    <edge source="Muad'Dib" target="prophecy" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">recalled the legends and the prophecy and they ventured to shout: "Mahdi!"</data>
    </edge>
    <edge source="Muad'Dib" target="Padishah Emperor" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.7</data>
      <data key="d14">his line and Muad'Dib's shared common ancestry</data>
    </edge>
    <edge source="Muad'Dib" target="Emperor's daughter" id="0">
      <data key="d12">CREATED</data>
      <data key="d13">0.9</data>
      <data key="d14">-from "Muad'Dib: Conversations" by the Princess Irulan</data>
    </edge>
    <edge source="Muad'Dib" target="passage" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">-from "The Wisdom of Muad'Dib" by the Princess Irulan</data>
    </edge>
    <edge source="Muad'Dib" target="A Time of Reflection" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Muad'Dib tells us in "A Time of Reflection"</data>
    </edge>
    <edge source="Muad'Dib" target="Muad'Dib, the Man" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Muad'Dib, the Man</data>
    </edge>
    <edge source="Muad'Dib" target="Fremen" id="0">
      <data key="d12">LEADS</data>
      <data key="d13">0.9</data>
      <data key="d14">They've a new prophet or religious leader of some kind among the Fremen, the Baron said. They call him Muad'Dib.</data>
    </edge>
    <edge source="Muad'Dib" target="Hawat's thoughts" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">this Muad'Dib.</data>
    </edge>
    <edge source="Muad'Dib" target="Secret Message to the Landsraad" id="0">
      <data key="d12">CREATED</data>
      <data key="d13">0.9</data>
      <data key="d14">Muad'Dib's Secret Message to the Landsraad</data>
    </edge>
    <edge source="Muad'Dib" target="captive" id="0">
      <data key="d12">LOVES</data>
      <data key="d13">0.8</data>
      <data key="d14">Though we deem the captive dead, yet does she live. For her seed is my seed and her voice is my voice.</data>
    </edge>
    <edge source="Muad'Dib" target="conversation" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"But this Muad'Dib cannot know, either."</data>
    </edge>
    <edge source="Muad'Dib" target="his enemies" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">Muad'Dib who ordered battle drums made from his enemies' skins</data>
    </edge>
    <edge source="Muad'Dib" target="Appendix II: The Religion of Dune" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Appendix II: The Religion of Dune

Before the coming of Muad'Dib</data>
    </edge>
    <edge source="Muad'Dib" target="The Pillars of the Universe" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Muad'Dib's own commentaries in "The Pillars of the Universe"</data>
    </edge>
    <edge source="Muad'Dib" target="O.C. Bible" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Muad'Dib: "Law and duty are one; so be it. But remember these limitations -Thus are you never fully self-conscious. Thus do you remain immersed in the communal tau. Thus are you always less than an individual." O.C. Bible: Identical wording.</data>
    </edge>
    <edge source="Muad'Dib" target="C.E.T. Commentaries" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Muad'Dib: "Religion often partakes of the myth of progress that shields us from the terrors of an uncertain future." C.E.T. Commentaries: Identical wording.</data>
    </edge>
    <edge source="Muad'Dib" target="Fremen prophecy" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Muad'Dib: "Kindness is the beginning of cruelty."   Fremen Kitab al-Ibar: "The weight of a kindly God is a fearful thing.</data>
    </edge>
    <edge source="Muad'Dib" target="Koneywell" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Muad'Dib's arrival is called "religiously timely" by Koneywell</data>
    </edge>
    <edge source="Muad'Dib" target="Paul Atreides" id="0">
      <data key="d12">PERSON</data>
      <data key="d13">0.9</data>
      <data key="d14">Muad'Dib, born Paul Atreides</data>
    </edge>
    <edge source="Muad'Dib" target="KULL WAHAD!" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">It is said of Muad'Dib that once he watched a desert hawk chick emerge from its shell and whispered: "Kull wahad!"</data>
    </edge>
    <edge source="Muad'Dib" target="spice" id="0">
      <data key="d12">CLAIMED</data>
      <data key="d13">0.9</data>
      <data key="d14">Muad'Dib claimed the spice as a key to his prophetic powers</data>
    </edge>
    <edge source="Arrakis" target="Empire" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.7</data>
      <data key="d14">"It had the stamp of Imperial handicraft about it."</data>
    </edge>
    <edge source="Arrakis" target="planet" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"Is it really that terrible, this planet of Arrakis?"</data>
    </edge>
    <edge source="Arrakis" target="storms" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">I've been studying about the storms on Arrakis.</data>
    </edge>
    <edge source="Arrakis" target="wasteland" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">the wilderness that is empty, the wasteland where nothing lives except the spice and the sandworms.</data>
    </edge>
    <edge source="Arrakis" target="northern latitudes" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"It was taken in the northern latitudes."</data>
    </edge>
    <edge source="Arrakis" target="known universe" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.7</data>
      <data key="d14">The wisdom of seeding the known universe with a prophecy pattern for the protection of B.G. personnel has long been appreciated</data>
    </edge>
    <edge source="Arrakis" target="polar ice" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.7</data>
      <data key="d14">There's polar ice.</data>
    </edge>
    <edge source="Arrakis" target="universe" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Arrakis, the one source in the universe of melange</data>
    </edge>
    <edge source="Arrakis" target="filmbook" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">the filmbook Yueh had shown him--"Arrakis: His Imperial Majesty's Desert Botanical Testing Station."</data>
    </edge>
    <edge source="Arrakis" target="special climate" id="0">
      <data key="d12">LOCATION</data>
      <data key="d13">0.8</data>
      <data key="d14">That would make sense on Arrakis where even the driest of off-planet growing things had to be irrigated.</data>
    </edge>
    <edge source="Arrakis" target="southwest" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.7</data>
      <data key="d14">She turned to the tall reach of filter glass, stared out to the southwest where the sun of Arrakis was sinking</data>
    </edge>
    <edge source="Arrakis" target="Desert Botanical Testing Station" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">there were more than two hundred of these advance bases built here on Arrakis during the Desert Botanical Testing Station period.</data>
    </edge>
    <edge source="Arrakis" target="flower fields" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">he saw great puddles of red blooms and, running through them, an articulate tread of violet . . . like giant footsteps.</data>
    </edge>
    <edge source="Arrakis" target="desert" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">Here, we must scrabble for desert power.</data>
    </edge>
    <edge source="Arrakis" target="Shield Wall" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.7</data>
      <data key="d14">"Right now, I believe we're coming to the edge of the Shield Wall."</data>
    </edge>
    <edge source="Arrakis" target="water" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">It came to Jessica that the banker had said: "I, too, control that ultimate source of power on Arrakis--water."</data>
    </edge>
    <edge source="Arrakis" target="southern regions" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">Very little's known of the deep desert. And almost nothing of the southern regions.</data>
    </edge>
    <edge source="Arrakis" target="unknown" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.7</data>
      <data key="d14">"Arrakis is an unknown!"</data>
    </edge>
    <edge source="Arrakis" target="The Collected Sayings of Muad'Dib" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Arrakis teaches the attitude of the knife--chopping off what's incomplete and saying: "Now, it's complete because it's ended here."  -from "Collected Sayings of, Muad'Dib" by the Princess Irulan</data>
    </edge>
    <edge source="Arrakis" target="Piter" id="0">
      <data key="d12">HATES</data>
      <data key="d13">0.7</data>
      <data key="d14">First, though, he must make the people of Arrakis hate him.</data>
    </edge>
    <edge source="Arrakis" target="LOCATION" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.7</data>
      <data key="d14">sunrise here on Arrakis</data>
    </edge>
    <edge source="Arrakis" target="LOCATION" id="1">
      <data key="d12">LOCATION</data>
      <data key="d13">0.9</data>
      <data key="d14">here on Arrakis</data>
    </edge>
    <edge source="Arrakis" target="spice" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">The spice," he said, "It's in everything here--the air, the soil, the food.</data>
    </edge>
    <edge source="Arrakis" target="Great House" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">transport the spice for House Atreides</data>
    </edge>
    <edge source="Arrakis" target="Arrakeen" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">We know little of what happens in Arrakeen,</data>
    </edge>
    <edge source="Arrakis" target="Imperium" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.7</data>
      <data key="d14">The Emperor will not risk having the Imperium shattered by total war</data>
    </edge>
    <edge source="Arrakis" target="Houses Minor" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.7</data>
      <data key="d14">If one of them should get off Arrakis with an unpleasant story about what happened here, I'd be most displeased.</data>
    </edge>
    <edge source="Arrakis" target="House Minor" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">You must take immediate measures to hold a hostage from each House Minor," the Baron said. "As far as anyone off Arrakis must learn, this was straightforward House-to-House battle.</data>
    </edge>
    <edge source="Arrakis" target="spice desert" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">This is spice desert</data>
    </edge>
    <edge source="Arrakis" target="biscuit-colored landscape of rocks and sand" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">the sun of Arrakis appeared to leap over the horizon</data>
    </edge>
    <edge source="Arrakis" target="Liet" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">We change it . . . slowly but with certainty . . . to make it fit for human life.</data>
    </edge>
    <edge source="Arrakis" target="suspicions about Salusa Secundus" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">how Arrakis figures in your suspicions about Salusa Secundus.</data>
    </edge>
    <edge source="Arrakis" target="Fremen" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">Arrakis is a fierce planet</data>
    </edge>
    <edge source="Arrakis" target="EVENT" id="0">
      <data key="d12">LOCATION</data>
      <data key="d13">0.7</data>
      <data key="d14">this would be a day of extreme heat and dryness even for Arrakis.</data>
    </edge>
    <edge source="Arrakis" target="Rabban Harkonnen" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Arrakis from the  Harkonnen governor</data>
    </edge>
    <edge source="Arrakis" target="Guild agents" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Arrakis is crawling with Guild agents.</data>
    </edge>
    <edge source="Arrakis" target="space" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.7</data>
      <data key="d14">"the years of waiting we've added before Arrakis can bloom."</data>
    </edge>
    <edge source="Arrakis" target="Paul's legions" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.7</data>
      <data key="d14">His legions would rage out from Arrakis even without him.</data>
    </edge>
    <edge source="Arrakis" target="barren land" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">The effect of Arrakis on the mind of the newcomer usually is that of overpowering barren land.</data>
    </edge>
    <edge source="Arrakis" target="70-degree lines, north and south" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">in the wide belt contained by the 70-degree lines, north and south</data>
    </edge>
    <edge source="Arrakis" target="polar caps" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.7</data>
      <data key="d14">The polar caps (disregarding the false sense of water security they gave the pyons) held far too small an amount for his project</data>
    </edge>
    <edge source="Arrakis" target="sand" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">sand of Arrakis is mostly a product of worm digestion</data>
    </edge>
    <edge source="Arrakis" target="Canopus" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">ARRAKIS: the planet known as Dune; third planet of Canopus</data>
    </edge>
    <edge source="Arrakis" target="First Moon" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">FIRST MOON: the major satellite of Arrakis, first to rise in the night; notable for a distinct human fist pattern on its surface.</data>
    </edge>
    <edge source="Arrakis" target="sandworm" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">sandworm of Arrakis</data>
    </edge>
    <edge source="Arrakis" target="melange" id="0">
      <data key="d12">OWNS</data>
      <data key="d13">0.9</data>
      <data key="d14">Arrakis is the unique source</data>
    </edge>
    <edge source="Arrakis" target="SINK" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">a habitable lowland area on Arrakis surrounded by high ground that protects it from the prevailing storms.</data>
    </edge>
    <edge source="Arrakis" target="Tidal Dust Basin" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">TIDAL DUST BASIN: any of the extensive depressions in the surface of Arrakis</data>
    </edge>
    <edge source="Caladan" target="Paul's homeworld" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">My homeworld's Caladan.</data>
    </edge>
    <edge source="Caladan" target="latitudes" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.7</data>
      <data key="d14">It was still early afternoon here, and in these latitudes the sky looked black and cold -- so much darker than the warm blue of Caladan.</data>
    </edge>
    <edge source="Caladan" target="EVENT" id="0">
      <data key="d12">LOCATION</data>
      <data key="d13">0.7</data>
      <data key="d14">Once, on Caladan, I saw the body of a drowned fisherman recovered.</data>
    </edge>
    <edge source="Caladan" target="home" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"Caladan was their home"</data>
    </edge>
    <edge source="Caladan" target="LOCATION" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.7</data>
      <data key="d14">shell-blue sky of Caladan</data>
    </edge>
    <edge source="Caladan" target="LOCATION" id="1">
      <data key="d12">LOCATION</data>
      <data key="d13">0.9</data>
      <data key="d14">our Central Avenue on Caladan</data>
    </edge>
    <edge source="Caladan" target="vision" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">a prescient vision he had experienced on Caladan.</data>
    </edge>
    <edge source="Caladan" target="a tall fountain enclosing a curve of sky" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">the waters of Caladan--a tall fountain enclosing a curve of sky</data>
    </edge>
    <edge source="Caladan" target="paradise world" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">We came from Caladan--a paradise world for our form of fife.</data>
    </edge>
    <edge source="Caladan" target="moonlit waves" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.7</data>
      <data key="d14">moonlit waves on Caladan</data>
    </edge>
    <edge source="Caladan" target="open skies" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.7</data>
      <data key="d14">beneath the open skies of Caladan</data>
    </edge>
    <edge source="Caladan" target="Delta Pavonis" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">CALADAN: third planet of Delta Pavonis</data>
    </edge>
    <edge source="Paul Atreides" target="Lady Jessica" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">1.0</data>
      <data key="d14">Jessica repeated the words to Paul.</data>
    </edge>
    <edge source="Paul Atreides" target="Lady Jessica" id="1">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">"My mother's told me."</data>
    </edge>
    <edge source="Paul Atreides" target="Lady Jessica" id="2">
      <data key="d12">LOVES</data>
      <data key="d13">0.8</data>
      <data key="d14">You and the spice," Paul said.</data>
    </edge>
    <edge source="Paul Atreides" target="Lady Jessica" id="3">
      <data key="d12">LEADS</data>
      <data key="d13">0.9</data>
      <data key="d14">"Enough." She nodded for him to lead the way.</data>
    </edge>
    <edge source="Paul Atreides" target="Lady Jessica" id="4">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">My mother is my enemy.</data>
    </edge>
    <edge source="Paul Atreides" target="Duke Leto" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">mother of the ducal heir</data>
    </edge>
    <edge source="Paul Atreides" target="dream" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Paul fell asleep to dream of an Arrakeen cavern</data>
    </edge>
    <edge source="Paul Atreides" target="dream" id="1">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">I dreamed a cavern . . . and water . . . and a girl there -- very skinny with big eyes.</data>
    </edge>
    <edge source="Paul Atreides" target="his mother" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">The hall door opened and his mother peered in</data>
    </edge>
    <edge source="Paul Atreides" target="his mother" id="1">
      <data key="d12">LOVES</data>
      <data key="d13">0.7</data>
      <data key="d14">His mother had showed it to him, explaining how it had been taken from a Harkonnen courier.</data>
    </edge>
    <edge source="Paul Atreides" target="dreams" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">You must tell her about your dreams</data>
    </edge>
    <edge source="Paul Atreides" target="dreams" id="1">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">"I must ask the other questions about these dreams of his."</data>
    </edge>
    <edge source="Paul Atreides" target="Duke" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">As the Duke's son you'll never want for it</data>
    </edge>
    <edge source="Paul Atreides" target="Duke" id="1">
      <data key="d12">TRAINED_BY</data>
      <data key="d13">0.9</data>
      <data key="d14">it would've succeeded were it not for the training given me by you</data>
    </edge>
    <edge source="Paul Atreides" target="Duke" id="2">
      <data key="d12">KNOWS</data>
      <data key="d13">0.7</data>
      <data key="d14">Paul glimpsed what looked like a thin tube before the veil settled into place.</data>
    </edge>
    <edge source="Paul Atreides" target="Duke" id="3">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.8</data>
      <data key="d14">Halleck asked. The Duke nodded. "I'll fly my own 'thopter. Kynes can sit up front with me to direct me. You and Paul take the rear seats."</data>
    </edge>
    <edge source="Paul Atreides" target="Duke" id="4">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"That sand must be dangerous if you fly into it," Paul said.</data>
    </edge>
    <edge source="Paul Atreides" target="Duke" id="5">
      <data key="d12">LEADS</data>
      <data key="d13">0.9</data>
      <data key="d14">Hiding like a child when I'm now the Duke, Paul thought.</data>
    </edge>
    <edge source="Paul Atreides" target="Duke" id="6">
      <data key="d12">LOVES</data>
      <data key="d13">0.8</data>
      <data key="d14">I dedicate this blade to the cause of my Duke and the death of his enemies for as long as our blood shall flow," Paul said.</data>
    </edge>
    <edge source="Paul Atreides" target="Jessica Atreides" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">Is this how you obey your mother?</data>
    </edge>
    <edge source="Paul Atreides" target="duke" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">you dare suggest a duke's son is an animal?</data>
    </edge>
    <edge source="Paul Atreides" target="mother" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">How did you trick my mother into leaving me alone with you?</data>
    </edge>
    <edge source="Paul Atreides" target="test" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Your mother survived this test. Now it's your turn.</data>
    </edge>
    <edge source="Paul Atreides" target="Bene Gesserit rite" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">the Litany against Fear as his mother had taught him out of the Bene Gesserit rite.</data>
    </edge>
    <edge source="Paul Atreides" target="Litany against Fear" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">the Litany against Fear as his mother had taught him</data>
    </edge>
    <edge source="Paul Atreides" target="gom jabbar" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Withdraw your hand and the gom jabbar takes you.</data>
    </edge>
    <edge source="Paul Atreides" target="gom jabbar" id="1">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">She leaned back, withdrawing the gom jabbar from the side of his neck.</data>
    </edge>
    <edge source="Paul Atreides" target="pain by nerve induction" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"Pain by nerve induction," she said.</data>
    </edge>
    <edge source="Paul Atreides" target="Butlerian Jihad" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Paul quoted. "Right out of the Butlerian Jihad</data>
    </edge>
    <edge source="Paul Atreides" target="O.C. Bible" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Paul quoted. "Right out of the Butlerian Jihad and the Orange Catholic Bible</data>
    </edge>
    <edge source="Paul Atreides" target="Meditation Chamber" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Paul waited in the adjoining soundproofed Meditation Chamber.</data>
    </edge>
    <edge source="Paul Atreides" target="Reverend Mother" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">Wariness veiled his eyes when he glanced at the Reverend Mother, but this time he nodded to her, the nod one gives an equal.</data>
    </edge>
    <edge source="Paul Atreides" target="Reverend Mother" id="1">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.8</data>
      <data key="d14">She's an out-freyn Sayyadina, mother to this lad.</data>
    </edge>
    <edge source="Paul Atreides" target="Caladan" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">I talk to her and tell her about you, about seeing the Reverend Mother on Caladan.</data>
    </edge>
    <edge source="Paul Atreides" target="Caladan" id="1">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">experienced it in a fragment of prescient dream on faraway Caladan</data>
    </edge>
    <edge source="Paul Atreides" target="Caladan" id="2">
      <data key="d12">BIRTHWORLD</data>
      <data key="d13">0.9</data>
      <data key="d14">birthworld of Paul-Muad'Dib</data>
    </edge>
    <edge source="Paul Atreides" target="poem" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">And I say I'll tell her a poem.</data>
    </edge>
    <edge source="Paul Atreides" target="his father" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">You talk as though my father were dead.</data>
    </edge>
    <edge source="Paul Atreides" target="family of Paul's father" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">Did my father send you up to test me?</data>
    </edge>
    <edge source="Paul Atreides" target="sun" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.8</data>
      <data key="d14">the sun your enemy</data>
    </edge>
    <edge source="Paul Atreides" target="moons" id="0">
      <data key="d12">FRIENDS_WITH</data>
      <data key="d13">0.8</data>
      <data key="d14">the moons will be your friends</data>
    </edge>
    <edge source="Paul Atreides" target="kings" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">descendant of kings</data>
    </edge>
    <edge source="Paul Atreides" target="Mother" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.8</data>
      <data key="d14">he'd already been warned -- by you, by Mother</data>
    </edge>
    <edge source="Paul Atreides" target="Hawat" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">"Thufir," Paul said, "will Arrakis be as bad as she said?"</data>
    </edge>
    <edge source="Paul Atreides" target="Hawat" id="1">
      <data key="d12">TRAINED_BY</data>
      <data key="d13">0.9</data>
      <data key="d14">it would've succeeded were it not for the training given me by you and many others--including Hawat.</data>
    </edge>
    <edge source="Paul Atreides" target="Hawat" id="2">
      <data key="d12">FRIENDS_WITH</data>
      <data key="d13">0.9</data>
      <data key="d14">"Is there pain, old friend?" Paul asked.</data>
    </edge>
    <edge source="Paul Atreides" target="conversation with old woman" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">She asked me to tell her what it is to rule," Paul said.</data>
    </edge>
    <edge source="Paul Atreides" target="Duncan Idaho" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">The traitor doctor had sent them directly into the hands of Duncan Idaho.</data>
    </edge>
    <edge source="Paul Atreides" target="Duncan Idaho" id="1">
      <data key="d12">FRIENDS_WITH</data>
      <data key="d13">0.9</data>
      <data key="d14">"Idaho saved us the night of the raid," Paul said, distracted by the parting with Chani.</data>
    </edge>
    <edge source="Paul Atreides" target="Gurney Halleck" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">"Well, Gurney Halleck," Paul called, "are you the new weapons master?"</data>
    </edge>
    <edge source="Paul Atreides" target="Gurney Halleck" id="1">
      <data key="d12">FRIENDS_WITH</data>
      <data key="d13">0.9</data>
      <data key="d14">Of all his father's men, he liked Gurney Halleck best, knew the man's moods and deviltry, his humors, and thought of him more as a friend than as a hired sword.</data>
    </edge>
    <edge source="Paul Atreides" target="Gurney Halleck" id="2">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.7</data>
      <data key="d14">Is this betrayal? Paul wondered.</data>
    </edge>
    <edge source="Paul Atreides" target="Gurney Halleck" id="3">
      <data key="d12">LEADS</data>
      <data key="d13">0.9</data>
      <data key="d14">Paul leaped to the ledge with Gurney right behind him, led the way into the passage.</data>
    </edge>
    <edge source="Paul Atreides" target="Gurney Halleck" id="4">
      <data key="d12">LOVES</data>
      <data key="d13">0.9</data>
      <data key="d14">I swear this to you by the love I hold for you</data>
    </edge>
    <edge source="Paul Atreides" target="Gurney Halleck" id="5">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.8</data>
      <data key="d14">"Gurney, have an escort bring my mother and Chani," Paul said.</data>
    </edge>
    <edge source="Paul Atreides" target="Salusa Secundus" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"My father has told me of Salusa Secundus," Paul said.</data>
    </edge>
    <edge source="Paul Atreides" target="Salusa Secundus" id="1">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">You shall have a throne on Salusa Secundus</data>
    </edge>
    <edge source="Paul Atreides" target="Arrakis" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Next time we meet it'll be on the soil of your new world.</data>
    </edge>
    <edge source="Paul Atreides" target="Arrakis" id="1">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">The Space above Arrakis is filled with the ships of the Guild.</data>
    </edge>
    <edge source="Paul Atreides" target="Arrakis" id="2">
      <data key="d12">LEADS</data>
      <data key="d13">0.9</data>
      <data key="d14">Stilgar acknowledges me Duke of Arrakis</data>
    </edge>
    <edge source="Paul Atreides" target="Arrakis" id="3">
      <data key="d12">LOVES</data>
      <data key="d13">0.7</data>
      <data key="d14">hailed the young Paul as a prophet, "the voice from the outer world."</data>
    </edge>
    <edge source="Paul Atreides" target="Mentat" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">"Thufir! "Paul called. Hawat turned, standing in the open doorway.</data>
    </edge>
    <edge source="Paul Atreides" target="Mentat" id="1">
      <data key="d12">FRIENDS_WITH</data>
      <data key="d13">0.8</data>
      <data key="d14">"Thufir, old friend," Paul said</data>
    </edge>
    <edge source="Paul Atreides" target="fight" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"Then, let's fight!"</data>
    </edge>
    <edge source="Paul Atreides" target="training fight" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Paul activated his shield, parried and countered.</data>
    </edge>
    <edge source="Paul Atreides" target="workout" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">deliciously relaxed after the workout with Gurney Halleck</data>
    </edge>
    <edge source="Paul Atreides" target="crossing to Arrakis" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.7</data>
      <data key="d14">lessons during the crossing to Arrakis</data>
    </edge>
    <edge source="Paul Atreides" target="study more about the sandworms" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"I'd like to study more about the sandworms."</data>
    </edge>
    <edge source="Paul Atreides" target="conical projection chart of the northern Arrakeen latitudes" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Paul glanced down at a conical projection chart of the northern Arrakeen latitudes spread on the table.</data>
    </edge>
    <edge source="Paul Atreides" target="book" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Paul wet his lips with his tongue, read: "Think you of the fact that a deaf person cannot hear.</data>
    </edge>
    <edge source="Paul Atreides" target="book" id="1">
      <data key="d12">OWNS</data>
      <data key="d13">0.9</data>
      <data key="d14">Paul looked down at the tiny book in his palm</data>
    </edge>
    <edge source="Paul Atreides" target="Yueh" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">Paul broke off, stared at him. Yueh closed his eyes, fought to regain composure.</data>
    </edge>
    <edge source="Paul Atreides" target="Mentat training" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">You see, you may have Mentat capabilities.</data>
    </edge>
    <edge source="Paul Atreides" target="lessons" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Someplace around the house taking his lessons with Yueh.</data>
    </edge>
    <edge source="Paul Atreides" target="her" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.8</data>
      <data key="d14">He was glad that Paul favored her.</data>
    </edge>
    <edge source="Paul Atreides" target="her" id="1">
      <data key="d12">KNOWS</data>
      <data key="d13">0.8</data>
      <data key="d14">She knows I'll dig for her.</data>
    </edge>
    <edge source="Paul Atreides" target="her" id="2">
      <data key="d12">LOVES</data>
      <data key="d13">0.7</data>
      <data key="d14">He dug faster, freed her shoulders. She was limp beneath his hands, but he detected a slow heartbeat.</data>
    </edge>
    <edge source="Paul Atreides" target="strategy conference" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">I want him to attend our strategy conference.</data>
    </edge>
    <edge source="Paul Atreides" target="Harkonnen" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">an Atreides had a Harkonnen banished for cowardice</data>
    </edge>
    <edge source="Paul Atreides" target="Harkonnen" id="1">
      <data key="d12">HATES</data>
      <data key="d13">0.9</data>
      <data key="d14">Now Harkonnen shall kill Harkonnen</data>
    </edge>
    <edge source="Paul Atreides" target="Wellington Yueh" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">It had been easy to palm Dr. Yueh's sleeping tablet, to pretend to swallow it.</data>
    </edge>
    <edge source="Paul Atreides" target="the house" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">And I will stay in the house where it's safe.</data>
    </edge>
    <edge source="Paul Atreides" target="threat" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Paul held himself in near catatonic immobility, knowing he had only his wits to meet this threat.</data>
    </edge>
    <edge source="Paul Atreides" target="grab it" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">I must try to grab it, he thought.</data>
    </edge>
    <edge source="Paul Atreides" target="shout for Yueh" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.7</data>
      <data key="d14">I could shout for Yueh, but it would take him the instant the door opened.</data>
    </edge>
    <edge source="Paul Atreides" target="gripping the deadly thing" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Paul's right hand shot out and down, gripping the deadly thing.</data>
    </edge>
    <edge source="Paul Atreides" target="father" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">"Your father has sent for you," she said.</data>
    </edge>
    <edge source="Paul Atreides" target="father" id="1">
      <data key="d12">LOVES</data>
      <data key="d13">0.9</data>
      <data key="d14">I loved my father, Paul thought, and knew this for truth.</data>
    </edge>
    <edge source="Paul Atreides" target="Mapes" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.8</data>
      <data key="d14">Paul's eyes came up, met the open stare of total blue from the Shadout Mapes.</data>
    </edge>
    <edge source="Paul Atreides" target="hunter-seeker incident" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"I've caught a hunter-seeker in the house and they're to spread out and find the operator."</data>
    </edge>
    <edge source="Paul Atreides" target="hunter-seeker" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"Hunterseeker. Caught it in my room and smashed its nose, but I want to be sure. Water should short it out."</data>
    </edge>
    <edge source="Paul Atreides" target="House Harkonnen" id="0">
      <data key="d12">HATES</data>
      <data key="d13">0.9</data>
      <data key="d14">"And I can assure you he hates the Harkonnens as bitterly as we do."</data>
    </edge>
    <edge source="Paul Atreides" target="House Harkonnen" id="1">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">Our immediate concern is our family atomics. We must get them before the Harkonnens can search them out.</data>
    </edge>
    <edge source="Paul Atreides" target="House Harkonnen" id="2">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">And, mother mine, there's a thing you don't know and should--we are Harkonnens.</data>
    </edge>
    <edge source="Paul Atreides" target="Leto Atreides" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">Paul looked back at the white wall behind his father</data>
    </edge>
    <edge source="Paul Atreides" target="Thufir" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">Paul held himself apart from the humor, his attention focused on the projection and the question that filled his mind. He pointed to the image on the table, said: "Thufir, are there sandworms big enough to swallow that whole?"</data>
    </edge>
    <edge source="Paul Atreides" target="reports" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Leto repeated the stories Paul had brought</data>
    </edge>
    <edge source="Paul Atreides" target="Fremen prophecy" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">They directed the term at the young master.</data>
    </edge>
    <edge source="Paul Atreides" target="Fremen" id="0">
      <data key="d12">LEADS</data>
      <data key="d13">0.9</data>
      <data key="d14">the old men who listened to him now in council and followed his plans</data>
    </edge>
    <edge source="Paul Atreides" target="Fremen" id="1">
      <data key="d12">KNOWS</data>
      <data key="d13">0.8</data>
      <data key="d14">Fremen! Paul thought.</data>
    </edge>
    <edge source="Paul Atreides" target="Fremen" id="2">
      <data key="d12">FRIENDS_WITH</data>
      <data key="d13">0.7</data>
      <data key="d14">Friends of one of the others</data>
    </edge>
    <edge source="Paul Atreides" target="Fremen" id="3">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">Paul saw the Fremen throwing back their hoods, removing nose plugs, breathing deeply.</data>
    </edge>
    <edge source="Paul Atreides" target="Fremen" id="4">
      <data key="d12">LOVES</data>
      <data key="d13">0.8</data>
      <data key="d14">the religious relationship between himself and the Fremen</data>
    </edge>
    <edge source="Paul Atreides" target="Collected Sayings of Muad'Dib" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"There is probably no more terrible instant of enlightenment than the one in which you discover your father is a man--with human flesh." -from "Collected Sayings of Muad'Dib" by the Princess Irulan</data>
    </edge>
    <edge source="Paul Atreides" target="inheritance" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">This is your inheritance, Paul.</data>
    </edge>
    <edge source="Paul Atreides" target="guerrilla training" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">I must order new emphasis on guerrilla training for you.</data>
    </edge>
    <edge source="Paul Atreides" target="filmclip" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">That filmclip there--they call you 'Mahdi'--'Lisan al-Gaib'</data>
    </edge>
    <edge source="Paul Atreides" target="EVENT" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Paul warned. He pulled back on the wing brakes</data>
    </edge>
    <edge source="Paul Atreides" target="EVENT" id="1">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Paul saw the pursed lips as the man spoke.</data>
    </edge>
    <edge source="Paul Atreides" target="Kynes" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">"Are there any plants down there?" Paul asked. "Some," Kynes said.</data>
    </edge>
    <edge source="Paul Atreides" target="Kynes" id="1">
      <data key="d12">LOVES</data>
      <data key="d13">0.9</data>
      <data key="d14">I would give my life for you</data>
    </edge>
    <edge source="Paul Atreides" target="Kynes" id="2">
      <data key="d12">LEADS</data>
      <data key="d13">0.8</data>
      <data key="d14">but to a man, to a superior</data>
    </edge>
    <edge source="Paul Atreides" target="Worm" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">It reminded Paul of the way a big fish disturbed the water when swimming just under the surface.</data>
    </edge>
    <edge source="Paul Atreides" target="factory" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.7</data>
      <data key="d14">Paul, looking out at the factory</data>
    </edge>
    <edge source="Paul Atreides" target="crowded into a corner" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Paul, crowded into a corner by sweating men, smelled the perspiration of fear</data>
    </edge>
    <edge source="Paul Atreides" target="Great Hall" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">There was Paul in the corner surrounded by a fawning group of the younger Arrakeen richece</data>
    </edge>
    <edge source="Paul Atreides" target="House Troop" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">aloof among them, three officers of the House Troop</data>
    </edge>
    <edge source="Paul Atreides" target="dinner" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Paul, seated near his father, was studying the reactions around him.</data>
    </edge>
    <edge source="Paul Atreides" target="forces" id="0">
      <data key="d12">LEADS</data>
      <data key="d13">0.9</data>
      <data key="d14">Both man and machine were turned over to our forces.</data>
    </edge>
    <edge source="Paul Atreides" target="peace and prosperity" id="0">
      <data key="d12">LOVES</data>
      <data key="d13">0.8</data>
      <data key="d14">The people have such hopes the Atreides will bring peace and prosperity.</data>
    </edge>
    <edge source="Paul Atreides" target="training" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">I've seen it come out in Paul.</data>
    </edge>
    <edge source="Paul Atreides" target="training" id="1">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">I began training in these ways earlier than you did</data>
    </edge>
    <edge source="Paul Atreides" target="Bene Gesserit Sisterhood" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">The mind-calming Bene Gesserit regimen his mother had taught him kept him poised, ready to expand any opportunity.</data>
    </edge>
    <edge source="Paul Atreides" target="House Harkonnen soldiers" id="0">
      <data key="d12">CAPTURED_BY</data>
      <data key="d13">0.9</data>
      <data key="d14">The litter tipped slightly as the Harkonnen troopers maneuvered it through a doorway into starlit night.</data>
    </edge>
    <edge source="Paul Atreides" target="Czigo" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">The tip struck the soft part of Czigo's abdomen just below the sternum, slammed upward with terrible force over the liver and through the diaphragm to crush the right ventricle of the man's heart.</data>
    </edge>
    <edge source="Paul Atreides" target="ordeal with the Reverend Mother Gaius Helen Mohiam" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">The sense of terrible purpose he'd first experienced in his ordeal with the Reverend Mother Gaius Helen Mohiam pervaded him.</data>
    </edge>
    <edge source="Paul Atreides" target="Sardaukar" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">"They're using Sardaukar," Jessica said. "We must wait until the Sardaukar have been withdrawn." "They think us caught between the desert and the Sardaukar," Paul said. "They intend that there be no Atreides survivors--total extermination.</data>
    </edge>
    <edge source="Paul Atreides" target="Sardaukar" id="1">
      <data key="d12">LEADS</data>
      <data key="d13">0.9</data>
      <data key="d14">"Our pet Sardaukar have been released near Old Gap low on the rim and are on their way to their master.</data>
    </edge>
    <edge source="Paul Atreides" target="embryo" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.8</data>
      <data key="d14">She rested her hand on her abdomen, awareness focused on the embryo there.</data>
    </edge>
    <edge source="Paul Atreides" target="Guild" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">"We know the Guild wants a prohibitive price for weather satellites."</data>
    </edge>
    <edge source="Paul Atreides" target="Guild" id="1">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.8</data>
      <data key="d14">"What stays the Guild's hand?" Jessica whispered. "They're searching for me," Paul said.</data>
    </edge>
    <edge source="Paul Atreides" target="The Friendly Desert" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.7</data>
      <data key="d14">Paul lifted the paracompass from the pack, returned it, said: "Think of all these special-application Fremen machines. They show unrivaled sophistication. Admit it. The culture that made these things betrays depths no one suspected."</data>
    </edge>
    <edge source="Paul Atreides" target="His mother" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">"Paul!" His mother was beside him, holding his hands, her face a gray blob peering at him.</data>
    </edge>
    <edge source="Paul Atreides" target="Missionaria Protectiva" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">where your Missionaria Protectiva has bought us a bolt hole.</data>
    </edge>
    <edge source="Paul Atreides" target="Alia Atreides" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">you'll bear my sister: St. Alia of the Knife</data>
    </edge>
    <edge source="Paul Atreides" target="Kwisatz Haderach" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">I am the Kwisatz Haderach</data>
    </edge>
    <edge source="Paul Atreides" target="Baron" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.8</data>
      <data key="d14">in one he confronted an evil old Baron and said: "Hello, Grandfather."</data>
    </edge>
    <edge source="Paul Atreides" target="Baron" id="1">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">I've killed our grandfather, the demented old Baron.</data>
    </edge>
    <edge source="Paul Atreides" target="fanatic legions" id="0">
      <data key="d12">LEADS</data>
      <data key="d13">0.8</data>
      <data key="d14">a fire spreading across the universe with the Atreides green and black banner waving at the head of fanatic legions drunk on spice liquor.</data>
    </edge>
    <edge source="Paul Atreides" target="Muad'Dib" id="0">
      <data key="d12">KNOWN_AS</data>
      <data key="d13">0.9</data>
      <data key="d14">They'll call me . . . Muad'Dib, 'The One Who Points the Way.'</data>
    </edge>
    <edge source="Paul Atreides" target="Muad'Dib" id="1">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">his line and Muad'Dib's shared common ancestry</data>
    </edge>
    <edge source="Paul Atreides" target="Muad'Dib" id="2">
      <data key="d12">PERSON</data>
      <data key="d13">0.9</data>
      <data key="d14">"Is that the name you wish, Muad'Dib?" Stilgar asked.</data>
    </edge>
    <edge source="Paul Atreides" target="Muad'Dib" id="3">
      <data key="d12">LEADS</data>
      <data key="d13">0.9</data>
      <data key="d14">the number of challengers testing the new blade of Muad'Dib did drop dramatically.</data>
    </edge>
    <edge source="Paul Atreides" target="Muad'Dib" id="4">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">from "Muad'Dib: The Ninety-Nine Wonders of the Universe" by Princess Irulan</data>
    </edge>
    <edge source="Paul Atreides" target="Muad'Dib" id="5">
      <data key="d12">LOVES</data>
      <data key="d13">0.7</data>
      <data key="d14">"Muad'Dib," the man said.</data>
    </edge>
    <edge source="Paul Atreides" target="Muad'Dib" id="6">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">"As you command, Muad'Dib."</data>
    </edge>
    <edge source="Paul Atreides" target="the very substance of this planet" id="0">
      <data key="d12">HATES</data>
      <data key="d13">0.8</data>
      <data key="d14">a sudden rage against the very substance of this planet which had helped kill his father set him trembling</data>
    </edge>
    <edge source="Paul Atreides" target="Arrakeen existence" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">he thought that here he truly began an Arrakeen existence</data>
    </edge>
    <edge source="Paul Atreides" target="desert" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.7</data>
      <data key="d14">Paul crouched at the sphincter, his stillsuit hood adjusted for the open desert</data>
    </edge>
    <edge source="Paul Atreides" target="ornithopter" id="0">
      <data key="d12">OWNS</data>
      <data key="d13">0.9</data>
      <data key="d14">an Atreides 'thopter</data>
    </edge>
    <edge source="Paul Atreides" target="explosion" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">They sprawled together in the sand as the roar of an explosion thundered over them.</data>
    </edge>
    <edge source="Paul Atreides" target="dukedom" id="0">
      <data key="d12">LEADS</data>
      <data key="d13">0.9</data>
      <data key="d14">the boy who had taken on the mantle of manhood, masking grief, suppressing all except the position that now must be assumed--the dukedom.</data>
    </edge>
    <edge source="Paul Atreides" target="dukedom" id="1">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.8</data>
      <data key="d14">the dukedom still existed and solely because of this youth</data>
    </edge>
    <edge source="Paul Atreides" target="Imperium" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">I'm a soldier of the Imperium</data>
    </edge>
    <edge source="Paul Atreides" target="Padishah Emperor" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">I will give the Padishah Emperor reasons to fear</data>
    </edge>
    <edge source="Paul Atreides" target="Emperor" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">I am an embarrassment to the Emperor</data>
    </edge>
    <edge source="Paul Atreides" target="Emperor" id="1">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">As the hidden import of Paul's words grew in the Emperor's mind, he glared across the room at Paul.</data>
    </edge>
    <edge source="Paul Atreides" target="plan" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">This is a desperate gamble you propose</data>
    </edge>
    <edge source="Paul Atreides" target="them" id="0">
      <data key="d12">HATES</data>
      <data key="d13">0.8</data>
      <data key="d14">"I'll take full payment for them all one day," Paul said.</data>
    </edge>
    <edge source="Paul Atreides" target="Bene Gesserit axiom" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">"If you rely only on your eyes, your other senses weaken." It was a Bene Gesserit axiom.</data>
    </edge>
    <edge source="Paul Atreides" target="storm" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Paul stubbed the wings, banked hard left into the deceptively slow boiling of the storm wall</data>
    </edge>
    <edge source="Paul Atreides" target="worms" id="0">
      <data key="d12">FRIENDS_WITH</data>
      <data key="d13">0.8</data>
      <data key="d14">"Our friends, the worms," he corrected her.</data>
    </edge>
    <edge source="Paul Atreides" target="Kitab al-Ibar" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">quoted from the Kitab al-Ibar</data>
    </edge>
    <edge source="Paul Atreides" target="vision" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">shaken by the remembered high relief imagery of a prescient vision he had experienced on Caladan.</data>
    </edge>
    <edge source="Paul Atreides" target="Fremen desert" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">"The Fremen desert," Paul whispered.</data>
    </edge>
    <edge source="Paul Atreides" target="Fremkit manual" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">probing the mysterious allusions to thumpers and maker hooks in the Fremkit manual</data>
    </edge>
    <edge source="Paul Atreides" target="Bene Gesserit way" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">In the Bene Gesserit way she had taught him, Paul stilled the savage beating of his heart</data>
    </edge>
    <edge source="Paul Atreides" target="bindu suspension" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Bindu suspension, he told himself.</data>
    </edge>
    <edge source="Paul Atreides" target="spice liquor" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Paul reached the spice patch, shoveled a mound of it into a fold of his robe, returned to the fissure.</data>
    </edge>
    <edge source="Paul Atreides" target="digging" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Paul directed the foam barrier, Jessica dug with her hands, hurling the sand down the slope.</data>
    </edge>
    <edge source="Paul Atreides" target="tenting" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">Paul said. "I'll put up the tent,"</data>
    </edge>
    <edge source="Paul Atreides" target="fissure" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">In a few minutes they stood on the floor of the fissure holding the pack between them.</data>
    </edge>
    <edge source="Paul Atreides" target="witch" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.8</data>
      <data key="d14">he was lost with his mother in a desert storm.</data>
    </edge>
    <edge source="Paul Atreides" target="Fremen walk the sand" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">"This is how Fremen walk the sand."</data>
    </edge>
    <edge source="Paul Atreides" target="Fremen place" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">"This must be a Fremen place," Paul said.</data>
    </edge>
    <edge source="Paul Atreides" target="Stilgar" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">I know you, Stilgar</data>
    </edge>
    <edge source="Paul Atreides" target="Stilgar" id="1">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.8</data>
      <data key="d14">They will concentrate on my mother and that Stilgar fellow. She can handle him.</data>
    </edge>
    <edge source="Paul Atreides" target="Stilgar" id="2">
      <data key="d12">FRIENDS_WITH</data>
      <data key="d13">0.9</data>
      <data key="d14">"Will you touch hands with my friend Gurney Halleck, Stilgar?" Paul asked.</data>
    </edge>
    <edge source="Paul Atreides" target="Stilgar" id="3">
      <data key="d12">LEADS</data>
      <data key="d13">0.9</data>
      <data key="d14">"Kneel, Stilgar." Stilgar dropped to his knees on the ledge.</data>
    </edge>
    <edge source="Paul Atreides" target="Council" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">I was with my father in Council when you came for the water of your friend.</data>
    </edge>
    <edge source="Paul Atreides" target="Council" id="1">
      <data key="d12">LEADS</data>
      <data key="d13">0.9</data>
      <data key="d14">"Muad'Dib, leaders are beginning to arrive for the Council."</data>
    </edge>
    <edge source="Paul Atreides" target="Istislah" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.7</data>
      <data key="d14">It is the rule, Istislah, in the general interest.</data>
    </edge>
    <edge source="Paul Atreides" target="us" id="0">
      <data key="d12">LEADS</data>
      <data key="d13">0.8</data>
      <data key="d14">If you are the Bene Gesserit of the legend whose son will lead us to paradise</data>
    </edge>
    <edge source="Paul Atreides" target="weirding way" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Even your cub knows the weirding way.</data>
    </edge>
    <edge source="Paul Atreides" target="Chani Kynes" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">Chani touched Paul's arm.</data>
    </edge>
    <edge source="Paul Atreides" target="Chani Kynes" id="1">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">"I am the mother of thy firstborn," she agreed.</data>
    </edge>
    <edge source="Paul Atreides" target="Chani Kynes" id="2">
      <data key="d12">FRIENDS_WITH</data>
      <data key="d13">0.8</data>
      <data key="d14">Chani's father put heavy obligation on me.</data>
    </edge>
    <edge source="Paul Atreides" target="Chani Kynes" id="3">
      <data key="d12">LOVES</data>
      <data key="d13">0.9</data>
      <data key="d14">"I see us giving love to each other in a time of quiet between storms. It's what we were meant to do."</data>
    </edge>
    <edge source="Paul Atreides" target="Chani Kynes" id="4">
      <data key="d12">LEADS</data>
      <data key="d13">0.8</data>
      <data key="d14">And we control it, Gurney.</data>
    </edge>
    <edge source="Paul Atreides" target="Sietch Tabr" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Their destination was Sietch Tabr--Stilgar's sietch.</data>
    </edge>
    <edge source="Paul Atreides" target="Sietch Tabr" id="1">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">We of Sietch Tabr may use it</data>
    </edge>
    <edge source="Paul Atreides" target="ceremony" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Slowly, he arose, made his way to Chani's side. Stilgar stepped back to make room for him, took the baliset gently from his hand.</data>
    </edge>
    <edge source="Paul Atreides" target="Jamis" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">Jamis, the man Paul bested!</data>
    </edge>
    <edge source="Paul Atreides" target="Jamis" id="1">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">Jamis fights with either hand.</data>
    </edge>
    <edge source="Paul Atreides" target="Jamis" id="2">
      <data key="d12">FRIENDS_WITH</data>
      <data key="d13">0.9</data>
      <data key="d14">"I was a friend of Jamis," Paul whispered.</data>
    </edge>
    <edge source="Paul Atreides" target="single combat" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">He's talking of single combat with Paul!</data>
    </edge>
    <edge source="Paul Atreides" target="tahaddi-challenge" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"There can be no yielding in the tahaddi-challenge. Death is the test of it."</data>
    </edge>
    <edge source="Paul Atreides" target="tahaddi ring" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">this was no soft offworlder in the tahaddi ring</data>
    </edge>
    <edge source="Paul Atreides" target="Paul Muad'Dib" id="0">
      <data key="d12">PERSON</data>
      <data key="d13">0.9</data>
      <data key="d14">"You shall be known among us as Usul, the base of the pillar.</data>
    </edge>
    <edge source="Paul Atreides" target="Paul Muad'Dib" id="1">
      <data key="d12">LOVES</data>
      <data key="d13">0.7</data>
      <data key="d14">"Your yali is ready for you, Usul."</data>
    </edge>
    <edge source="Paul Atreides" target="Ichwan Bedwine" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">"Now, you are of the Ichwan Bedwine, our brother."</data>
    </edge>
    <edge source="Paul Atreides" target="combat" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"Combat water belongs to the winner," Chani said.</data>
    </edge>
    <edge source="Paul Atreides" target="funeral ceremony" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">The funeral ceremony resumed.</data>
    </edge>
    <edge source="Paul Atreides" target="water" id="0">
      <data key="d12">OWNS</data>
      <data key="d13">0.9</data>
      <data key="d14">To Paul-Muad'Dib goes this portion," Chani said. "May he guard it for the tribe, preserving it against careless loss.</data>
    </edge>
    <edge source="Paul Atreides" target="courtship ritual" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">watercounters offered to a woman--courtship ritual.</data>
    </edge>
    <edge source="Paul Atreides" target="unborn sister" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">his own terrible purpose, and he knew that no small thing could deflect the juggernaut. It was gathering weight and momentum. If he died this instant, the thing would go on through his mother and his unborn sister.</data>
    </edge>
    <edge source="Paul Atreides" target="fanatic hordes" id="0">
      <data key="d12">LEADS</data>
      <data key="d13">0.8</data>
      <data key="d14">the fanatic hordes cut their gory path across the universe in his name</data>
    </edge>
    <edge source="Paul Atreides" target="wild legions" id="0">
      <data key="d12">LEADS</data>
      <data key="d13">0.8</data>
      <data key="d14">Wild legions would charge into battle screaming their war cry: "Muad'Dib!"</data>
    </edge>
    <edge source="Paul Atreides" target="wild jihad" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.7</data>
      <data key="d14">the wild jihad still loomed ahead of him</data>
    </edge>
    <edge source="Paul Atreides" target="singing" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">listening as Paul's voice lifted in a sweet boy tenor with the baliset tinkling and strumming beneath it</data>
    </edge>
    <edge source="Paul Atreides" target="song" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">This was a song of a friend of mine," Paul said.</data>
    </edge>
    <edge source="Paul Atreides" target="Atreides code" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"with the Atreides code to guide him, for example."</data>
    </edge>
    <edge source="Paul Atreides" target="Farok" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">the narrow bearded face of the one called Farok turned toward Paul</data>
    </edge>
    <edge source="Paul Atreides" target="tahaddi al-burhan" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">he invoked the tahaddi al-burhan</data>
    </edge>
    <edge source="Paul Atreides" target="legend" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">The legend again, Paul thought.</data>
    </edge>
    <edge source="Paul Atreides" target="Jamis' woman" id="0">
      <data key="d12">RESPONSIBILITY_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">Usul, it's our way that you've now the responsibility for Jamis' woman here</data>
    </edge>
    <edge source="Paul Atreides" target="Jamis' two sons" id="0">
      <data key="d12">RESPONSIBILITY_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">and for his two sons</data>
    </edge>
    <edge source="Paul Atreides" target="Jamis' yali" id="0">
      <data key="d12">OWNS</data>
      <data key="d13">0.9</data>
      <data key="d14">His yali . . . his quarters, are yours.</data>
    </edge>
    <edge source="Paul Atreides" target="Jamis' coffee service" id="0">
      <data key="d12">OWNS</data>
      <data key="d13">0.9</data>
      <data key="d14">His coffee service is yours</data>
    </edge>
    <edge source="Paul Atreides" target="Harah" id="0">
      <data key="d12">ACCEPTS_AS_SERVANT</data>
      <data key="d13">0.9</data>
      <data key="d14">I accept her as servant</data>
    </edge>
    <edge source="Paul Atreides" target="Harah" id="1">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">He faced Harah, pitched his voice with tone and tremolo to accent her fear and awe, said: "Show me my quarters, Harah!"</data>
    </edge>
    <edge source="Paul Atreides" target="Harah" id="2">
      <data key="d12">LOVES</data>
      <data key="d13">0.7</data>
      <data key="d14">"As long as I live you'll have a place with me," he said.</data>
    </edge>
    <edge source="Paul Atreides" target="sietch" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">Paul listened, hearing the voices grow dimmer behind as he moved deeper into the sietch with Harah.</data>
    </edge>
    <edge source="Paul Atreides" target="A Manual of Muad'Dib" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">description from "A Manual of Muad'Dib" by the Princess Irulan</data>
    </edge>
    <edge source="Paul Atreides" target="decision" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">"Do you wish him to share in your decision?"</data>
    </edge>
    <edge source="Paul Atreides" target="Kaleff" id="0">
      <data key="d12">GUARDIAN_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">telling him they wore no green because they accepted him as guardian-father.</data>
    </edge>
    <edge source="Paul Atreides" target="Orlop" id="0">
      <data key="d12">GUARDIAN_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">telling him they wore no green because they accepted him as guardian-father.</data>
    </edge>
    <edge source="Paul Atreides" target="council" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">What is happening? I thought I was being summoned to council.</data>
    </edge>
    <edge source="Paul Atreides" target="rite" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Stilgar said: "Drink it, lad. You delay the rite."</data>
    </edge>
    <edge source="Paul Atreides" target="Book Three THE PROPHET" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Book Three  THE PROPHET</data>
    </edge>
    <edge source="Paul Atreides" target="The Collected Sayings of Muad'Dib" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">-from "The Collected Sayings of Muad'Dib" by the Princess Irulan</data>
    </edge>
    <edge source="Paul Atreides" target="razzia" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">I was on razzia, Paul recalled. We went raiding to recover the water of our  dead in Arrakeen.</data>
    </edge>
    <edge source="Paul Atreides" target="razzia" id="1">
      <data key="d12">LEADS</data>
      <data key="d13">0.9</data>
      <data key="d14">lead a razzia against the Harkonnens</data>
    </edge>
    <edge source="Paul Atreides" target="the shrine of my father's skull" id="0">
      <data key="d12">CREATED</data>
      <data key="d13">0.9</data>
      <data key="d14">I  enshrined the skull of my father in a Fremen rock mound overlooking Harg Pass.</data>
    </edge>
    <edge source="Paul Atreides" target="Alia" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">I see the way you watch me when I'm with your sister.</data>
    </edge>
    <edge source="Paul Atreides" target="Alia" id="1">
      <data key="d12">KNOWS</data>
      <data key="d13">0.8</data>
      <data key="d14">The rapport was not as tender, not as sharing, not as encompassing as it had been with Alia</data>
    </edge>
    <edge source="Paul Atreides" target="hiereg" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">He knew suddenly that he was in a hiereg, a desert camp.</data>
    </edge>
    <edge source="Paul Atreides" target="training trips and raids" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Oh, he'd gone up with the others for training trips and raids</data>
    </edge>
    <edge source="Paul Atreides" target="Fedaykin" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">Paul listened, recognizing that these were the words that also began the death chant of his Fedaykin, the words the death commandos recited as they buried themselves into battle.</data>
    </edge>
    <edge source="Paul Atreides" target="Fedaykin" id="1">
      <data key="d12">LEADS</data>
      <data key="d13">0.9</data>
      <data key="d14">"The Fedaykin have raided with me," Paul said. "They'll raid with me again until no Harkonnen breathes Arrakeen air."</data>
    </edge>
    <edge source="Paul Atreides" target="Fedaykin" id="2">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">Paul gestured to a Fedaykin lieutenant</data>
    </edge>
    <edge source="Paul Atreides" target="Jihad" id="0">
      <data key="d12">LEADS</data>
      <data key="d13">0.8</data>
      <data key="d14">fought against the coming of the jihad</data>
    </edge>
    <edge source="Paul Atreides" target="Chronicles" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.7</data>
      <data key="d14">observe the rite that it may be reported truly in the Chronicles.</data>
    </edge>
    <edge source="Paul Atreides" target="Shishakli" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">One robed figure remained in Paul's path: Shishakli, a squad leader of the Fedaykin</data>
    </edge>
    <edge source="Paul Atreides" target="men" id="0">
      <data key="d12">LEADS</data>
      <data key="d13">0.8</data>
      <data key="d14">Go, Usul, and ride the maker, travel the sand as a leader of men.</data>
    </edge>
    <edge source="Paul Atreides" target="sandrider" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">I am a sandrider, Paul told himself.</data>
    </edge>
    <edge source="Paul Atreides" target="twentythumper journey" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">Once he was past this test, Paul knew, he was qualified to make the twentythumper journey into the southland</data>
    </edge>
    <edge source="Paul Atreides" target="sandrider test" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">Paul will be undergoing his sandrider test at any moment now.</data>
    </edge>
    <edge source="Paul Atreides" target="new weapons" id="0">
      <data key="d12">CREATED</data>
      <data key="d13">0.9</data>
      <data key="d14">the new weapons Paul had given them</data>
    </edge>
    <edge source="Paul Atreides" target="testing" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">This was the true instant of the testing</data>
    </edge>
    <edge source="Paul Atreides" target="worm" id="0">
      <data key="d12">LOVES</data>
      <data key="d13">0.7</data>
      <data key="d14">Come up, you lovely monster, he thought.</data>
    </edge>
    <edge source="Paul Atreides" target="Council of Leaders" id="0">
      <data key="d12">LEADS</data>
      <data key="d13">0.8</data>
      <data key="d14">Paul realized the man was seeing this moment through the memory of how he had risen to command of the Tabr sietch and to leadership of the Council of Leaders now that Liet-Kynes was dead.</data>
    </edge>
    <edge source="Paul Atreides" target="Tabr sietch" id="0">
      <data key="d12">LEADS</data>
      <data key="d13">0.8</data>
      <data key="d14">Paul realized the man was seeing this moment through the memory of how he had risen to command of the Tabr sietch and to leadership of the Council of Leaders now that Liet-Kynes was dead.</data>
    </edge>
    <edge source="Paul Atreides" target="Old Duke Atreides" id="0">
      <data key="d12">LEADS</data>
      <data key="d13">0.9</data>
      <data key="d14">you are Paul-Muad'Dib, the Atreides Duke</data>
    </edge>
    <edge source="Paul Atreides" target="Duke Paulus Atreides" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.7</data>
      <data key="d14">a hardness in the expression that reminded Gurney of the Old Duke, Paul's grandfather.</data>
    </edge>
    <edge source="Paul Atreides" target="smuggler crew" id="0">
      <data key="d12">LEADS</data>
      <data key="d13">0.8</data>
      <data key="d14">Paul's ordering the smuggler crew disarmed until they could be questioned.</data>
    </edge>
    <edge source="Paul Atreides" target="Duke of Arrakis" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">This is the rightful Duke of Arrakis. Do as he commands.</data>
    </edge>
    <edge source="Paul Atreides" target="desert power" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"You heard my father speak of desert power," Paul said.</data>
    </edge>
    <edge source="Paul Atreides" target="Rabban" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">"Our enemy is exactly where I want him to be," Paul said.</data>
    </edge>
    <edge source="Paul Atreides" target="will-o'-the-sand" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"You're the will-o'-the-sand?"</data>
    </edge>
    <edge source="Paul Atreides" target="stories" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Gurney recalled the stories told of Muad'Dib, the Lisan al-Gaib</data>
    </edge>
    <edge source="Paul Atreides" target="Great House" id="0">
      <data key="d12">LEADS</data>
      <data key="d13">0.9</data>
      <data key="d14">"I am House Atreides."</data>
    </edge>
    <edge source="Paul Atreides" target="Great House" id="1">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">"Your own emperor bestowed Arrakis on House Atreides. I am House Atreides."</data>
    </edge>
    <edge source="Paul Atreides" target="battle" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Paul stepped out to the lip of the ledge. Only three of the Sardaukar remained. Bloody rag mounds of Sardaukar and Fremen lay in a twisted pattern across the chamber.</data>
    </edge>
    <edge source="Paul Atreides" target="Korba" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">Paul glanced to one of his Fedaykin lieutenants, said: "Korba, how came they to have weapons?"</data>
    </edge>
    <edge source="Paul Atreides" target="war" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.7</data>
      <data key="d14">The war is not there.</data>
    </edge>
    <edge source="Paul Atreides" target="people" id="0">
      <data key="d12">LEADS</data>
      <data key="d13">0.9</data>
      <data key="d14">the religious ferment around Paul's leadership</data>
    </edge>
    <edge source="Paul Atreides" target="practice floor" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Many of you have been with me on the practice floor</data>
    </edge>
    <edge source="Paul Atreides" target="troops" id="0">
      <data key="d12">LEADS</data>
      <data key="d13">0.9</data>
      <data key="d14">"I swore never to wear it again until I was ready to lead my troops over all of Arrakis and claim it as my rightful fief."</data>
    </edge>
    <edge source="Paul Atreides" target="Rite of investiture" id="0">
      <data key="d12">CREATED</data>
      <data key="d13">0.9</data>
      <data key="d14">Repeat after me, Stilgar," Paul said, and he called up the words of investiture as he had heard his own father use them.</data>
    </edge>
    <edge source="Paul Atreides" target="Council Gathering" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">I want sandwalkers out this night and cielagos sent to summon a Council Gathering.</data>
    </edge>
    <edge source="Paul Atreides" target="desert woman" id="0">
      <data key="d12">LOVES</data>
      <data key="d13">0.8</data>
      <data key="d14">Your desert woman, marry her if that's your wish</data>
    </edge>
    <edge source="Paul Atreides" target="cavern" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Paul pressed past the man toward the depths of the cavern</data>
    </edge>
    <edge source="Paul Atreides" target="Desert War" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">And it came to pass in the third year of the Desert War that Paul-Muad'Dib lay alone in the Cave of Birds</data>
    </edge>
    <edge source="Paul Atreides" target="Collected Legends of Arrakis" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">-"Collected Legends of Arrakis" by the Princess Irulan</data>
    </edge>
    <edge source="Paul Atreides" target="sacred trance" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">They believe Paul is in a sacred trance</data>
    </edge>
    <edge source="Paul Atreides" target="Water of Life" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"It was only one drop, but I converted it," Paul said. "I changed the Water of Life."</data>
    </edge>
    <edge source="Paul Atreides" target="Old Reverend Mother" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.8</data>
      <data key="d14">The rapport was not as tender, not as sharing, not as encompassing as it had been with Alia and with the Old Reverend Mother in the cavern</data>
    </edge>
    <edge source="Paul Atreides" target="Bene Gesserit dream" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">He was the fact out of the Bene Gesserit dream</data>
    </edge>
    <edge source="Paul Atreides" target="future events" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">Chani was touched by some of the prescience that haunted Paul, and she knew a thing-yet-to-be as though it already had occurred.</data>
    </edge>
    <edge source="Paul Atreides" target="story" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Otheym would speak of what he had seen and heard. Others would spread the story until it was a fire over the land.</data>
    </edge>
    <edge source="Paul Atreides" target="Otheym" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">Paul gestured to a Fedaykin lieutenant, said: "Otheym</data>
    </edge>
    <edge source="Paul Atreides" target="city people" id="0">
      <data key="d12">LEADS</data>
      <data key="d13">0.8</data>
      <data key="d14">That's why we use them as shock troops.</data>
    </edge>
    <edge source="Paul Atreides" target="signalmen" id="0">
      <data key="d12">LEADS</data>
      <data key="d13">0.9</data>
      <data key="d14">Paul crouched over the signalmen.</data>
    </edge>
    <edge source="Paul Atreides" target="The Shield Wall is breached" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"The Shield Wall is breached, Muad'Dib!" he shouted.</data>
    </edge>
    <edge source="Paul Atreides" target="son of Muad'Dib" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">son of Muad'Dib</data>
    </edge>
    <edge source="Paul Atreides" target="son" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">My son is dead</data>
    </edge>
    <edge source="Paul Atreides" target="Arrakeen governor's mansion" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">It was to the Arrakeen governor's mansion, the old Residency the Atreides had first occupied on Dune, that they escorted Paul-Muad'Dib on the evening of his victory.</data>
    </edge>
    <edge source="Paul Atreides" target="Feyd-Rautha" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">"Kanly!" Feyd-Rautha shouted. He pressed against the barrier lance. "Your father named this vendetta, Atreides."</data>
    </edge>
    <edge source="Paul Atreides" target="Feyd-Rautha" id="1">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">"Shall we fight, cousin?" Paul asked.</data>
    </edge>
    <edge source="Paul Atreides" target="Irulan" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">Without being told it, Paul knew her -- Princess Royal, Bene Gesserit -- trained, a face that time vision had shown him in many aspects: Irulan.</data>
    </edge>
    <edge source="Paul Atreides" target="Convention" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.7</data>
      <data key="d14">"You have violated the Convention, used atomics against --"</data>
    </edge>
    <edge source="Paul Atreides" target="argument" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.7</data>
      <data key="d14">I grow tired of this argument.</data>
    </edge>
    <edge source="Paul Atreides" target="Reverend Mother Mohiam" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">"Reverend Mother Gaius Helen Mohiam," Paul said.</data>
    </edge>
    <edge source="Paul Atreides" target="Reverend Mother Mohiam" id="1">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.8</data>
      <data key="d14">Paul stilled a cold, piercing anger, said: "You've never had the right or cause to forgive my mother anything!"</data>
    </edge>
    <edge source="Paul Atreides" target="old woman" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">Paul glared at the old woman. "For your part in all this I could gladly have you strangled," he said.</data>
    </edge>
    <edge source="Paul Atreides" target="old woman" id="1">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">"You mustn't speak of these things!" the old woman hissed.</data>
    </edge>
    <edge source="Paul Atreides" target="Princess Irulan Corrino" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.8</data>
      <data key="d14">"You've already admitted who I am," Paul said. "Royal kinsman, you said.</data>
    </edge>
    <edge source="Paul Atreides" target="unborn jihad" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">Here was the unborn jihad, he knew.</data>
    </edge>
    <edge source="Paul Atreides" target="storm nexus" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.7</data>
      <data key="d14">the storm nexus that now focused on this moment place.</data>
    </edge>
    <edge source="Paul Atreides" target="race consciousness" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.7</data>
      <data key="d14">Here was the race consciousness that he had known once as his own terrible purpose.</data>
    </edge>
    <edge source="Paul Atreides" target="his legions" id="0">
      <data key="d12">LEADS</data>
      <data key="d13">0.9</data>
      <data key="d14">His legions would rage out from Arrakis even without him. They needed only the legend he already had become.</data>
    </edge>
    <edge source="Paul Atreides" target="the legend" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">They needed only the legend he already had become.</data>
    </edge>
    <edge source="Paul Atreides" target="kanly ritual" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"Is the Atreides ready?" Feyd-Rautha called, using the words of the ancient kanly ritual.</data>
    </edge>
    <edge source="Paul Atreides" target="forces of victory" id="0">
      <data key="d12">LEADS</data>
      <data key="d13">0.9</data>
      <data key="d14">a man who'd this day led the forces of victory against Sardaukar legions.</data>
    </edge>
    <edge source="Paul Atreides" target="duel" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Again, they circled, probing.</data>
    </edge>
    <edge source="Paul Atreides" target="Emperor's daughter" id="0">
      <data key="d12">LOVES</data>
      <data key="d13">0.7</data>
      <data key="d14">Your daughter wed to me and the way opened for an Atreides to sit on the throne.</data>
    </edge>
    <edge source="Paul Atreides" target="Count" id="0">
      <data key="d12">LOVES</data>
      <data key="d13">0.7</data>
      <data key="d14">A deep compassion for the Count flowed through Paul</data>
    </edge>
    <edge source="Paul Atreides" target="jihad" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">She glimpsed the jihad and said: "You cannot loose these people upon the universe!"</data>
    </edge>
    <edge source="Paul Atreides" target="princess" id="0">
      <data key="d12">MARRIED_TO</data>
      <data key="d13">0.9</data>
      <data key="d14">That woman over there will be my wife and you but a concubine because this is a political thing</data>
    </edge>
    <edge source="Paul Atreides" target="princess" id="1">
      <data key="d12">HATES</data>
      <data key="d13">0.8</data>
      <data key="d14">Yet that princess shall have no more of me than my name. No child of mine nor touch nor softness of glance, nor instant of desire.</data>
    </edge>
    <edge source="Paul Atreides" target="Bomoko's Legacy" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">he quoted word for word from "Bomoko's Legacy"</data>
    </edge>
    <edge source="Paul Atreides" target="Bomoko's Legacy" id="1">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">he quoted word for word from "Bomoko's Legacy"</data>
    </edge>
    <edge source="Paul Atreides" target="Fremen mythology" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">The Fremen said of Muad'Dib that he was like Abu Zide</data>
    </edge>
    <edge source="Paul Atreides" target="prescient visions" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Paul Atreides showed ability to predict the future. He was known to have had prescient visions</data>
    </edge>
    <edge source="Paul Atreides" target="House Atreides" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">killing Paul's father and most of the Atreides troops</data>
    </edge>
    <edge source="Paul Atreides" target="Reverend Mother Ramallo" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">he was accompanied by a new Reverend Mother of the Sayyadina Rite "who is the woman who bore him."</data>
    </edge>
    <edge source="Lady Jessica" target="Paul Atreides" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">the ancient pile of stone that had served the Atreides family as home for twenty-six generations</data>
    </edge>
    <edge source="Lady Jessica" target="Paul Atreides" id="1">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">1.0</data>
      <data key="d14">Jessica repeated the words to Paul.</data>
    </edge>
    <edge source="Lady Jessica" target="Paul Atreides" id="2">
      <data key="d12">TRAINING</data>
      <data key="d13">0.9</data>
      <data key="d14">"You've been training him in the Way -- I've seen the signs of it."</data>
    </edge>
    <edge source="Lady Jessica" target="Paul Atreides" id="3">
      <data key="d12">LOVES</data>
      <data key="d13">0.8</data>
      <data key="d14">Jessica smiled, feeling her fears retreat.</data>
    </edge>
    <edge source="Lady Jessica" target="Paul Atreides" id="4">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">Paul may require a wakeshot.</data>
    </edge>
    <edge source="Lady Jessica" target="Paul Atreides" id="5">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.7</data>
      <data key="d14">You ask after the Lisan al-Gaib.</data>
    </edge>
    <edge source="Lady Jessica" target="Bene Gesserit Sisterhood" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">a Bene Gesserit Lady</data>
    </edge>
    <edge source="Lady Jessica" target="Bene Gesserit Sisterhood" id="1">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Your mother knows that either she's of Bene Gesserit descent or her stock was acceptable in itself.</data>
    </edge>
    <edge source="Lady Jessica" target="Duke Leto" id="0">
      <data key="d12">LOVES</data>
      <data key="d13">0.9</data>
      <data key="d14">a duke's concubine</data>
    </edge>
    <edge source="Lady Jessica" target="Duke Leto" id="1">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">I am the Duke's only . . . companion, the mother of his heir-designate.</data>
    </edge>
    <edge source="Lady Jessica" target="Reverend Mother Mohiam" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Damn that Jessica! the Reverend Mother thought.</data>
    </edge>
    <edge source="Lady Jessica" target="Reverend Mother" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">The Lady Jessica was my serving wench, lad, for fourteen years at school.</data>
    </edge>
    <edge source="Lady Jessica" target="Reverend Mother" id="1">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">"What you did, Jessica, and why you did it -- we both know."</data>
    </edge>
    <edge source="Lady Jessica" target="Reverend Mother" id="2">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">The coming of the Reverend Mother to free you.</data>
    </edge>
    <edge source="Lady Jessica" target="Reverend Mother" id="3">
      <data key="d12">BECAME</data>
      <data key="d13">0.9</data>
      <data key="d14">I am now a Reverend Mother, Jessica realized.</data>
    </edge>
    <edge source="Lady Jessica" target="old woman" id="0">
      <data key="d12">HATES</data>
      <data key="d13">0.9</data>
      <data key="d14">"I both love and hate you," Jessica said.</data>
    </edge>
    <edge source="Lady Jessica" target="old woman" id="1">
      <data key="d12">LOVES</data>
      <data key="d13">0.9</data>
      <data key="d14">"I both love and hate you," Jessica said.</data>
    </edge>
    <edge source="Lady Jessica" target="Duke" id="0">
      <data key="d12">LOVES</data>
      <data key="d13">0.9</data>
      <data key="d14">I was my Duke's only woman. I accepted his life and his values</data>
    </edge>
    <edge source="Lady Jessica" target="Duke" id="1">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">I am the Duke's secretary</data>
    </edge>
    <edge source="Lady Jessica" target="Duke" id="2">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">"My first loyalty is to the Duke."</data>
    </edge>
    <edge source="Lady Jessica" target="Duke" id="3">
      <data key="d12">KNOWS</data>
      <data key="d13">0.8</data>
      <data key="d14">you came here with that stupid Duke</data>
    </edge>
    <edge source="Lady Jessica" target="her son" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">"And your son will pay with you."</data>
    </edge>
    <edge source="Lady Jessica" target="her son" id="1">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">sitting at table with her son and her Duke and their guests</data>
    </edge>
    <edge source="Lady Jessica" target="Kwisatz Haderach" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Don't you want to hear what the Reverend Mother can tell you about the Kwisatz Haderach? Jessica asked.</data>
    </edge>
    <edge source="Lady Jessica" target="Mapes" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">Ever the practical one, this Mapes, Jessica thought.</data>
    </edge>
    <edge source="Lady Jessica" target="crysknife" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">"It's a crysknife," she said.</data>
    </edge>
    <edge source="Lady Jessica" target="crysknife" id="1">
      <data key="d12">OWNS</data>
      <data key="d13">0.9</data>
      <data key="d14">It's yours, a tooth of shai-hulud, for as long as you live.</data>
    </edge>
    <edge source="Lady Jessica" target="Great Mother" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.8</data>
      <data key="d14">Did you think that I, knowing the mysteries of the Great Mother, would not know the Maker?</data>
    </edge>
    <edge source="Lady Jessica" target="Bene Gesserit's need" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">the protective legends implanted in these people against the day of a Bene Gesserit's need. Well, that day had come.</data>
    </edge>
    <edge source="Lady Jessica" target="Arrakis" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">The uncleansed who have seen a crysknife may not leave Arrakis alive.</data>
    </edge>
    <edge source="Lady Jessica" target="Arrakis" id="1">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Jessica turned her attention to Bewt. "Impossible?" "Impossible on Arrakis," he said.</data>
    </edge>
    <edge source="Lady Jessica" target="Arrakis" id="2">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">Jessica imagined herself leaving the rigors of Arrakis</data>
    </edge>
    <edge source="Lady Jessica" target="Missionaria Protectiva" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">That was a specific catchphrase from the Missionaria Protectiva's stock of incantations</data>
    </edge>
    <edge source="Lady Jessica" target="Missionaria Protectiva" id="1">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">And not all the preparations of the Missionaria Protectiva nor Hawat's suspicious inspection of this castellated pile of rocks could dispel the feeling.</data>
    </edge>
    <edge source="Lady Jessica" target="Missionaria Protectiva" id="2">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">She knew the cant of the Missionaria Protectiva</data>
    </edge>
    <edge source="Lady Jessica" target="Wellington Yueh" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">"Good afternoon. Dr. Yueh," she said.</data>
    </edge>
    <edge source="Lady Jessica" target="Wellington Yueh" id="1">
      <data key="d12">LOVES</data>
      <data key="d13">0.8</data>
      <data key="d14">A deep affection for him came over her.</data>
    </edge>
    <edge source="Lady Jessica" target="Wellington Yueh" id="2">
      <data key="d12">FRIENDS_WITH</data>
      <data key="d13">0.9</data>
      <data key="d14">You're . . . my friend.</data>
    </edge>
    <edge source="Lady Jessica" target="Caladan" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">"So barren after Caladan."</data>
    </edge>
    <edge source="Lady Jessica" target="Caladan" id="1">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"We brought both from Caladan," she said.</data>
    </edge>
    <edge source="Lady Jessica" target="Yueh" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">Yueh said. "I can take care of this." Jessica shook her head.</data>
    </edge>
    <edge source="Lady Jessica" target="House Harkonnen" id="0">
      <data key="d12">HATES</data>
      <data key="d13">0.9</data>
      <data key="d14">Even my Duke's voice doesn't carry that weight of venom when he uses the hated name.</data>
    </edge>
    <edge source="Lady Jessica" target="House Harkonnen" id="1">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"Run, Paul!" Jessica shouted. "It's Harkonnens!"</data>
    </edge>
    <edge source="Lady Jessica" target="House Harkonnen" id="2">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">And, mother mine, there's a thing you don't know and should--we are Harkonnens.</data>
    </edge>
    <edge source="Lady Jessica" target="wet-planet conservatory" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"A wet-planet conservatory," she breathed:</data>
    </edge>
    <edge source="Lady Jessica" target="filter glass" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Then: Filter glass!</data>
    </edge>
    <edge source="Lady Jessica" target="Duke Leto Atreides" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">"My father must learn of this at once," he said.</data>
    </edge>
    <edge source="Lady Jessica" target="Duke Leto Atreides" id="1">
      <data key="d12">LOVES</data>
      <data key="d13">0.7</data>
      <data key="d14">Thought of Gurney disturbed her with its memories of an easier past -- days of love and beauty with Paul's father.</data>
    </edge>
    <edge source="Lady Jessica" target="Leto Atreides" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">As Leto approached Jessica's group</data>
    </edge>
    <edge source="Lady Jessica" target="Leto Atreides" id="1">
      <data key="d12">LOVES</data>
      <data key="d13">0.9</data>
      <data key="d14">never walked here with her beloved Leto</data>
    </edge>
    <edge source="Lady Jessica" target="Leto Atreides" id="2">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">Jessica saw that Leto was enjoying this.</data>
    </edge>
    <edge source="Lady Jessica" target="dinner" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">The custom here is for host and hostess to follow their guests to table," She said, and smiled</data>
    </edge>
    <edge source="Lady Jessica" target="Esmar Tuek" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">The smuggler's called Tuek, Esmar Tuek. He's a power among his kind. They all know him here.</data>
    </edge>
    <edge source="Lady Jessica" target="passage" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Jessica, looking down the length of the table, saw a faint trembling at the corners of Leto's mouth, noted the dark flush of anger on his cheeks.</data>
    </edge>
    <edge source="Lady Jessica" target="chef" id="0">
      <data key="d12">OWNS</data>
      <data key="d13">0.9</data>
      <data key="d14">The stillsuit manufacturer complimented Jessica on her chef and wine.</data>
    </edge>
    <edge source="Lady Jessica" target="wine" id="0">
      <data key="d12">OWNS</data>
      <data key="d13">0.9</data>
      <data key="d14">The stillsuit manufacturer complimented Jessica on her chef and wine.</data>
    </edge>
    <edge source="Lady Jessica" target="her Duke" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">sitting at table with her son and her Duke and their guests</data>
    </edge>
    <edge source="Lady Jessica" target="Guild Bank representative" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">hearing that Guild Bank representative</data>
    </edge>
    <edge source="Lady Jessica" target="Duncan Idaho" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">Jessica marked them--the smuggler, the stillsuit manufacturer's daughter, Duncan Idaho, the woman with the mysterious escort service.</data>
    </edge>
    <edge source="Lady Jessica" target="Leto's message" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Jessica stared down at her plate, thinking of the coded part of Leto's message</data>
    </edge>
    <edge source="Lady Jessica" target="ENTITY" id="0">
      <data key="d12">PERSON</data>
      <data key="d13">0.9</data>
      <data key="d14">Jessica's attention. She turned, saw Yueh crossing to them</data>
    </edge>
    <edge source="Lady Jessica" target="Hawat" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">"Hawat!" she snapped. "I want Thufir Hawat brought to me immediately!"</data>
    </edge>
    <edge source="Lady Jessica" target="Thufir" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">"You poor fool, Thufir!" she raged.</data>
    </edge>
    <edge source="Lady Jessica" target="premonition" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">Jessica awoke in the dark, feeling premonition in the stillness around her.</data>
    </edge>
    <edge source="Lady Jessica" target="REVEREND MOTHER" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">Jessica thought. Who? Ah-h-h, the Reverend Mother Gaius Helen, of course!</data>
    </edge>
    <edge source="Lady Jessica" target="Czigo" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.8</data>
      <data key="d14">Czigo turned, said: "Ah-h-h, look." He reached out for Jessica's skirt.</data>
    </edge>
    <edge source="Lady Jessica" target="Kinet" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.7</data>
      <data key="d14">Kinet put a hand on the pilot's arm. "Look, Czigo, no need to . . . "</data>
    </edge>
    <edge source="Lady Jessica" target="Yueh's house sign" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Yueh's house sign is scrawled on the ceiling of this cabin.</data>
    </edge>
    <edge source="Lady Jessica" target="Sardaukar" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">"They're using Sardaukar," Jessica said. "We must wait until the Sardaukar have been withdrawn."</data>
    </edge>
    <edge source="Lady Jessica" target="stillsuit" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">She felt the slick-soft skin of the stillsuit against her body</data>
    </edge>
    <edge source="Lady Jessica" target="The Friendly Desert" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.7</data>
      <data key="d14">Hesitating, still worried by the harshness in his voice, Jessica returned to the book, studied an illustrated constellation from the Arrakeen sky: "Muad'Dib: The Mouse," and noted that the tail pointed north.</data>
    </edge>
    <edge source="Lady Jessica" target="Bene Gesserit dream" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">a broodmare preserving an important bloodline for the Bene Gesserit Plan.</data>
    </edge>
    <edge source="Lady Jessica" target="Baron" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">"You're the Baron's own daughter," he said, and watched the way she pressed her hands to her mouth.</data>
    </edge>
    <edge source="Lady Jessica" target="Alia Atreides" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">you'll bear my sister: St. Alia of the Knife</data>
    </edge>
    <edge source="Lady Jessica" target="unknown mother" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.8</data>
      <data key="d14">My unknown mother, Jessica thought</data>
    </edge>
    <edge source="Lady Jessica" target="Harkonnen" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.7</data>
      <data key="d14">Was she glad to rid herself of a Harkonnen child?</data>
    </edge>
    <edge source="Lady Jessica" target="EVENT" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Jessica leaped off the 'thopter and ran</data>
    </edge>
    <edge source="Lady Jessica" target="EVENT" id="1">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Jessica nodded, walked to the fissure's mouth where she could get a sweep of the desert, and swung her binoculars to the left.</data>
    </edge>
    <edge source="Lady Jessica" target="explosion" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">They sprawled together in the sand as the roar of an explosion thundered over them.</data>
    </edge>
    <edge source="Lady Jessica" target="Kynes" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">"We're most grateful for your help, Doctor Kynes," she said.</data>
    </edge>
    <edge source="Lady Jessica" target="storm" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Through Jessica's mind flashed all the warnings about such storms</data>
    </edge>
    <edge source="Lady Jessica" target="digging" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Paul directed the foam barrier, Jessica dug with her hands, hurling the sand down the slope.</data>
    </edge>
    <edge source="Lady Jessica" target="tenting" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">Jessica found the spare binoculars in the pack beside the tent, moved up beside Paul.</data>
    </edge>
    <edge source="Lady Jessica" target="fissure" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">In a few minutes they stood on the floor of the fissure holding the pack between them.</data>
    </edge>
    <edge source="Lady Jessica" target="his father" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.7</data>
      <data key="d14">something about his stance reminded her of his father.</data>
    </edge>
    <edge source="Lady Jessica" target="Fremen walk the sand" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">Jessica studied his progress for ten steps, followed, imitating him.</data>
    </edge>
    <edge source="Lady Jessica" target="Fremen place" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">"There would have to be people for this many plants to survive," she agreed.</data>
    </edge>
    <edge source="Lady Jessica" target="boy" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">"I am the mother of this boy," Jessica said.</data>
    </edge>
    <edge source="Lady Jessica" target="Stilgar" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">Now, tell that man of yours behind the bush over there to stop trying to bring his weapon to bear on me</data>
    </edge>
    <edge source="Lady Jessica" target="Stilgar" id="1">
      <data key="d12">BESTED</data>
      <data key="d13">0.9</data>
      <data key="d14">Have I compromised your leadership by besting you, Stilgar?</data>
    </edge>
    <edge source="Lady Jessica" target="weirding way" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">You mastered an armed Fremen. This is a weapon no search could expose.</data>
    </edge>
    <edge source="Lady Jessica" target="Sietch Tabr" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Their destination was Sietch Tabr--Stilgar's sietch.</data>
    </edge>
    <edge source="Lady Jessica" target="Fremen" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">the Lady Jessica who was now a Reverend Mother of the Fremen</data>
    </edge>
    <edge source="Lady Jessica" target="his people" id="0">
      <data key="d12">BESTED</data>
      <data key="d13">0.9</data>
      <data key="d14">When you bested me, you bested us all.</data>
    </edge>
    <edge source="Lady Jessica" target="duke" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">You will keep in mind that I was a duke's lady</data>
    </edge>
    <edge source="Lady Jessica" target="unborn daughter" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">And what of the unborn daughter she had carried these few weeks?</data>
    </edge>
    <edge source="Lady Jessica" target="Stilgar's troop" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">her own unconscious assessment on personal security within Stilgar's troop</data>
    </edge>
    <edge source="Lady Jessica" target="gom jabbar" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.7</data>
      <data key="d14">"His mother says he's been through the gom jabbar."</data>
    </edge>
    <edge source="Lady Jessica" target="Sayyadina" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"Then we accept your blessing, Sayyadina."</data>
    </edge>
    <edge source="Lady Jessica" target="Sayyadina" id="1">
      <data key="d12">PERSON</data>
      <data key="d13">0.9</data>
      <data key="d14">She was indeed Sayyadina.</data>
    </edge>
    <edge source="Lady Jessica" target="Jamis" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">"You will answer to me then," Jessica said, and she pitched her voice in a twisting tone with a little whine in it and a catch at the end.</data>
    </edge>
    <edge source="Lady Jessica" target="tahaddi-challenge" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Jessica saw Paul swallow hard.</data>
    </edge>
    <edge source="Lady Jessica" target="funeral ceremony for Jamis" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">The funeral ceremony for Jamis was beginning.</data>
    </edge>
    <edge source="Lady Jessica" target="funeral ceremony" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Jessica, hearing the voices, felt the depth of the experience, realized what terrible inhibitions there must be against shedding tears.</data>
    </edge>
    <edge source="Lady Jessica" target="ritual" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Jessica looked back at the Reverend Mother Ramallo.</data>
    </edge>
    <edge source="Lady Jessica" target="Chakobsa" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.7</data>
      <data key="d14">She had recognized fragments of the ritual, identified the shards of Chakobsa</data>
    </edge>
    <edge source="Lady Jessica" target="Bhotani-jib" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.7</data>
      <data key="d14">identified the shards of Chakobsa and Bhotani-jib in the words</data>
    </edge>
    <edge source="Lady Jessica" target="unborn sister" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">his own terrible purpose, and he knew that no small thing could deflect the juggernaut. It was gathering weight and momentum. If he died this instant, the thing would go on through his mother and his unborn sister.</data>
    </edge>
    <edge source="Lady Jessica" target="Chani Kynes" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">Chani lifted the spout toward Jessica, said: "Here is the Water of Life, the water that is greater than water--Kan, the water that frees the soul.</data>
    </edge>
    <edge source="Lady Jessica" target="Chani Kynes" id="1">
      <data key="d12">LOVES</data>
      <data key="d13">0.9</data>
      <data key="d14">I love Chani, Jessica thought</data>
    </edge>
    <edge source="Lady Jessica" target="Chani Kynes" id="2">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">My mother, Jessica thought. Yes, she has the right to call me that in the formal greeting. She has given me a grandson.</data>
    </edge>
    <edge source="Lady Jessica" target="rite" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Jessica of the Weirding, has consented to enter the rite at this time.</data>
    </edge>
    <edge source="Lady Jessica" target="Ceremony of the Seed" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Jessica, feeling the ceremony close around her with a current that swept her beyond all turning back, glanced once at Paul's question filled face, then prepared herself for the ordeal.</data>
    </edge>
    <edge source="Lady Jessica" target="daughter" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">Be thankful it's a daughter you carry.</data>
    </edge>
    <edge source="Lady Jessica" target="rite of joining" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">I'm within a rite of joining.</data>
    </edge>
    <edge source="Lady Jessica" target="rite of joining" id="1">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">Jessica opened her eyes, gestured to the watersack now being held above her by Chani.</data>
    </edge>
    <edge source="Lady Jessica" target="Fremen culture" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Still, the corridor remained, revealing to Jessica that the Fremen culture was far older than she had suspected.</data>
    </edge>
    <edge source="Lady Jessica" target="religious relationship between Paul and the Fremen" id="0">
      <data key="d12">HATES</data>
      <data key="d13">0.8</data>
      <data key="d14">Jessica was fearful of the religious relationship between himself and the Fremen, Paul knew. She didn't like the fact that people of both sietch and graben referred to Muad'Dib as Him.</data>
    </edge>
    <edge source="Lady Jessica" target="Bene Gesserit proverb" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">She had quoted a Bene Gesserit proverb to him</data>
    </edge>
    <edge source="Lady Jessica" target="Alia" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">I see the way you watch me when I'm with your sister.</data>
    </edge>
    <edge source="Lady Jessica" target="Alia" id="1">
      <data key="d12">FRIENDS_WITH</data>
      <data key="d13">0.7</data>
      <data key="d14">"Blood ran cold at the scream of friends," Jessica said.</data>
    </edge>
    <edge source="Lady Jessica" target="resting chamber" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Jessica sat in her resting chamber, catching a moment of quiet between the night's classes.</data>
    </edge>
    <edge source="Lady Jessica" target="anonymous drink" id="0">
      <data key="d12">LOVES</data>
      <data key="d13">0.8</data>
      <data key="d14">Respect and love had sent the gift</data>
    </edge>
    <edge source="Lady Jessica" target="her son's household" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">In the formal manner that befitted a member of her son's household, Jessica said: "Subakh ul kuhar, Harah."</data>
    </edge>
    <edge source="Lady Jessica" target="Harah" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.8</data>
      <data key="d14">Harah said. "It's the people and the way they mutter. I feel danger in it. They say your daughter's a demon</data>
    </edge>
    <edge source="Lady Jessica" target="son's household" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">I respect the fact that you're a member of my son's household</data>
    </edge>
    <edge source="Lady Jessica" target="ceremony of the seed" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">It was the ceremony of the seed, when you changed the Water of Life, Reverend Mother, when Alia was yet unborn within you.</data>
    </edge>
    <edge source="Lady Jessica" target="Ramadhan and April on Bela Tegeuse" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">When the sound had dimmed sufficiently, Jessica began the ritual, the sadness in her voice: "It was Ramadhan and April on Bela Tegeuse."</data>
    </edge>
    <edge source="Lady Jessica" target="raiders" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">"The raiders came through the mushtamal, rushing at us with their knives dripping red from the lives of our men," Jessica said.</data>
    </edge>
    <edge source="Lady Jessica" target="cavern assembly" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">The crowd in the cavern assembly chamber radiated that pack feeling Jessica had sensed the day Paul killed Jamis.</data>
    </edge>
    <edge source="Lady Jessica" target="troop leaders" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">Stilgar and all the other troop leaders ask her advice in almost every major decision.</data>
    </edge>
    <edge source="Lady Jessica" target="Coanua sietch" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"I hear a gift of cloth has been sent from Coanua sietch," Jessica said.</data>
    </edge>
    <edge source="Lady Jessica" target="battles" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"Is there news of battles?"</data>
    </edge>
    <edge source="Lady Jessica" target="victories" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"New victories," Jessica said.</data>
    </edge>
    <edge source="Lady Jessica" target="oases" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"I wish we were in the south," Jessica said. "The oases were so beautiful when we left."</data>
    </edge>
    <edge source="Lady Jessica" target="lieutenants" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"I signed it thus in the presence of his lieutenants," Jessica said.</data>
    </edge>
    <edge source="Lady Jessica" target="The message" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">The message was signed Muad'Dib.</data>
    </edge>
    <edge source="Lady Jessica" target="Gurney Halleck" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">"The old companion, Halleck," Chani asked, "is it possible he's a traitor?" "Not Gurney," Jessica said.</data>
    </edge>
    <edge source="Lady Jessica" target="Paul Muad'Dib" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">Jessica nodded to herself, remembering her son's ambivalent feelings toward the spice drug</data>
    </edge>
    <edge source="Lady Jessica" target="Count Fenring" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">Jessica looked, recognizing the face from her Duke's dossiers. "Count Fenring," she said.</data>
    </edge>
    <edge source="Lady Jessica" target="Appendix I: The Ecology of Dune" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">A bitter laugh escaped Jessica.</data>
    </edge>
    <edge source="Lady Jessica" target="Vladimir Harkonnen" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">A natural daughter (Bene Gesserit reference) of the Siridar-Baron Vladimir Harkonnen.</data>
    </edge>
    <edge source="Bene Gesserit Sisterhood" target="Dune" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">This every sister of the Bene Gesserit knows.</data>
    </edge>
    <edge source="Bene Gesserit Sisterhood" target="Lady Jessica" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">Your mother's told you about our ways of observing. I see the signs of her teaching in you.</data>
    </edge>
    <edge source="Bene Gesserit Sisterhood" target="schools" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"Bene Gesserit schools?" She nodded.</data>
    </edge>
    <edge source="Bene Gesserit Sisterhood" target="schools" id="1">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.7</data>
      <data key="d14">I'm not fooled by what your schools tell the public: you exist only to serve.</data>
    </edge>
    <edge source="Bene Gesserit Sisterhood" target="Politics" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"Politics," he said.</data>
    </edge>
    <edge source="Bene Gesserit Sisterhood" target="Missionaria Protectiva" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">a Bene Gesserit of the Missionaria Protectiva</data>
    </edge>
    <edge source="Bene Gesserit Sisterhood" target="Missionaria Protectiva" id="1">
      <data key="d12">CREATED</data>
      <data key="d13">0.9</data>
      <data key="d14">Certainly, this is the time in which they consolidated their hold upon the sorceresses, explored the subtle narcotics, developed pranabindu training and conceived the Missionaria Protectiva, that black arm of superstition.</data>
    </edge>
    <edge source="Bene Gesserit Sisterhood" target="Missionaria Protectiva" id="2">
      <data key="d12">OWNS</data>
      <data key="d13">0.9</data>
      <data key="d14">MISSIONARIA PROTECTIVA: the arm of the Bene Gesserit order</data>
    </edge>
    <edge source="Bene Gesserit Sisterhood" target="basis of this speed" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.8</data>
      <data key="d14">The Bene Gesserit, of course, know the basis of this speed.</data>
    </edge>
    <edge source="Bene Gesserit Sisterhood" target="she" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">You've glimpsed the fist within the Bene Gesserit glove</data>
    </edge>
    <edge source="Bene Gesserit Sisterhood" target="serve" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">We truly exist only to serve.</data>
    </edge>
    <edge source="Bene Gesserit Sisterhood" target="passage" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Bene Gesserit ain't all highborn</data>
    </edge>
    <edge source="Bene Gesserit Sisterhood" target="key to our future" id="0">
      <data key="d12">HOLDS</data>
      <data key="d13">0.9</data>
      <data key="d14">It is said that a Bene Gesserit and her offspring hold the key to our future</data>
    </edge>
    <edge source="Bene Gesserit Sisterhood" target="adab" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Nothing in all the Bene Gesserit training carried such a signal of recognition. It could be only the adab</data>
    </edge>
    <edge source="Bene Gesserit Sisterhood" target="saying" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"There's a Bene Gesserit saying," she said.</data>
    </edge>
    <edge source="Bene Gesserit Sisterhood" target="scheme of selective breeding" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">the Bene Gesserit with their scheme of selective breeding</data>
    </edge>
    <edge source="Bene Gesserit Sisterhood" target="Reverend Mother Mohiam" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">Observe her, comrades! This is a Bene Gesserit Reverend Mother, patient in a patient cause.</data>
    </edge>
    <edge source="Bene Gesserit Sisterhood" target="Appendix II: The Religion of Dune" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">The Bene Gesserit, who privately denied they were a religious order</data>
    </edge>
    <edge source="Bene Gesserit Sisterhood" target="ecumenical meetings" id="0">
      <data key="d12">ENCOURAGED</data>
      <data key="d13">0.8</data>
      <data key="d14">and by the Bene Gesserit who were banding the sorceresses</data>
    </edge>
    <edge source="Bene Gesserit Sisterhood" target="Landsraad" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">The major dams against anarchy in these times were the embryo Guild, the Bene Gesserit and the Landsraad, which continued its 2,000-year record of meeting in spite of the severest obstacles.</data>
    </edge>
    <edge source="Bene Gesserit Sisterhood" target="Litany against Fear" id="0">
      <data key="d12">CREATED</data>
      <data key="d13">0.9</data>
      <data key="d14">But it is also the period that saw the composing of the Litany against Fear and the assembly of the Azhar Book, that bibliographic marvel that preserves the great secrets of the most ancient faiths.</data>
    </edge>
    <edge source="Bene Gesserit Sisterhood" target="Azhar Book" id="0">
      <data key="d12">CREATED</data>
      <data key="d13">0.9</data>
      <data key="d14">But it is also the period that saw the composing of the Litany against Fear and the assembly of the Azhar Book, that bibliographic marvel that preserves the great secrets of the most ancient faiths.</data>
    </edge>
    <edge source="Bene Gesserit Sisterhood" target="Fremen" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">As the Bene Gesserit taught for centuries, long before they ran afoul of the Fremen</data>
    </edge>
    <edge source="Bene Gesserit Sisterhood" target="centuries" id="0">
      <data key="d12">OPERATED_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">the Bene Gesserit operated for centuries</data>
    </edge>
    <edge source="Bene Gesserit Sisterhood" target="semimystic school" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">the Bene Gesserit operated for centuries behind the blind of a semimystic school</data>
    </edge>
    <edge source="Bene Gesserit Sisterhood" target="Kwisatz Haderach" id="0">
      <data key="d12">CREATED</data>
      <data key="d13">0.9</data>
      <data key="d14">The Bene Gesserit program had as its target the breeding of a person they labeled "Kwisatz Haderach"</data>
    </edge>
    <edge source="Bene Gesserit Sisterhood" target="Kwisatz Haderach" id="1">
      <data key="d12">SEEKING</data>
      <data key="d13">0.9</data>
      <data key="d14">This is the label applied by the Bene Gesserit to the unknown for which they sought a genetic solution: a male Bene Gesserit whose organic mental powers would bridge space and time.</data>
    </edge>
    <edge source="Bene Gesserit Sisterhood" target="Guild could not interfere directly with the vital spice source" id="0">
      <data key="d12">AWARE_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">A few of the Bene Gesserit had long been aware that the Guild could not interfere directly with the vital spice source</data>
    </edge>
    <edge source="Bene Gesserit Sisterhood" target="Butlerian Jihad" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">BENE GESSERIT: the ancient school of mental and physical training established primarily for female students after the Butlerian Jihad destroyed the so-called "thinking machines" and robots.</data>
    </edge>
    <edge source="Bene Gesserit Sisterhood" target="Mating Index" id="0">
      <data key="d12">OWNS</data>
      <data key="d13">0.9</data>
      <data key="d14">MATING INDEX: the Bene Gesserit master record of its human breeding program</data>
    </edge>
    <edge source="Bene Gesserit Sisterhood" target="Mother School" id="0">
      <data key="d12">ORGANIZATION</data>
      <data key="d13">0.9</data>
      <data key="d14">Mother School of the Bene Gesserit</data>
    </edge>
    <edge source="Emperor Shaddam Corrino IV" target="Dune" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">born in the 57th year of the Padishah Emperor, Shaddam IV.</data>
    </edge>
    <edge source="Emperor Shaddam Corrino IV" target="CHOAM profits" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">He's very jealous of his CHOAM profits, m'Lord.</data>
    </edge>
    <edge source="Emperor Shaddam Corrino IV" target="Imperial House" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">SHADDAM IV (10,134-10,202) The Padishah Emperor, 81st of his line (House Corrino)</data>
    </edge>
    <edge source="Emperor Shaddam Corrino IV" target="Irulan" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">His eldest daughter, Irulan.</data>
    </edge>
    <edge source="Emperor Shaddam Corrino IV" target="Chalice" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">He had five daughters (Irulan, Chalice, Wensicia, Josifa, and Rugi)</data>
    </edge>
    <edge source="Emperor Shaddam Corrino IV" target="Wensicia" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">He had five daughters (Irulan, Chalice, Wensicia, Josifa, and Rugi)</data>
    </edge>
    <edge source="Emperor Shaddam Corrino IV" target="Josifa" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">He had five daughters (Irulan, Chalice, Wensicia, Josifa, and Rugi)</data>
    </edge>
    <edge source="Emperor Shaddam Corrino IV" target="Rugi" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">He had five daughters (Irulan, Chalice, Wensicia, Josifa, and Rugi)</data>
    </edge>
    <edge source="Emperor Shaddam Corrino IV" target="Anirul" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">His wife, Anirul, a Bene Gesserit of Hidden Rank, died in 10,176.</data>
    </edge>
    <edge source="Duke Leto" target="House Atreides" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">an apparent victory for the Duke Leto</data>
    </edge>
    <edge source="Duke Leto" target="Great Houses of the Landsraad" id="0">
      <data key="d12">POPULAR_AMONG</data>
      <data key="d13">0.9</data>
      <data key="d14">the Duke Leto was popular among the Great Houses of the Landsraad</data>
    </edge>
    <edge source="Duke Leto" target="House Harkonnen" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">It will take more than a trap to catch the Duke Leto.</data>
    </edge>
    <edge source="Duke Leto" target="his son" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">this is the Duke Leto, and this one's his son</data>
    </edge>
    <edge source="Duke Leto" target="Lady Jessica" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">The voice was Duke Leto's. She whirled, saw him striding from the arched passage to the dining hall.</data>
    </edge>
    <edge source="Duke Leto" target="Emperor" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.8</data>
      <data key="d14">He had become such a savage, driving person since the decision to bow to the Emperor's command.</data>
    </edge>
    <edge source="Duke Leto" target="Caladan" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">We did not live this way on Caladan.</data>
    </edge>
    <edge source="Duke Leto" target="water riots" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">There were water riots when it was learned how many people the Duke was adding to the population</data>
    </edge>
    <edge source="Duke Leto" target="the father" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">That's the man shaped by the father.</data>
    </edge>
    <edge source="Duke Leto" target="Harkonnen agents" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">Light signals could only mean that messages were being sent between his enemies--between Harkonnen agents.</data>
    </edge>
    <edge source="Duke Leto" target="Arrakis" id="0">
      <data key="d12">LEADS</data>
      <data key="d13">0.9</data>
      <data key="d14">"It is said that the Duke Leto Atreides rules with the consent of the governed," the Fremen said.</data>
    </edge>
    <edge source="Duke Leto" target="Arrakis" id="1">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">It's one of Duke Leto's fighting men we took on Arrakis!</data>
    </edge>
    <edge source="Duke Leto" target="EVENT" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"You be the Duke Leto, I warrant," he said.</data>
    </edge>
    <edge source="Duke Leto" target="Duke's ship" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">let the Duke fly his ship</data>
    </edge>
    <edge source="Duke Leto" target="his escort" id="0">
      <data key="d12">LEADS</data>
      <data key="d13">0.9</data>
      <data key="d14">His escort came down from circling stations, took up positions above and on both sides.</data>
    </edge>
    <edge source="Duke Leto" target="Shield Wall" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">The Duke brought his craft around toward the Shield Wall.</data>
    </edge>
    <edge source="Duke Leto" target="one we hate above all others" id="0">
      <data key="d12">HATES</data>
      <data key="d13">0.8</data>
      <data key="d14">one we hate above all others died with him.</data>
    </edge>
    <edge source="Duke Leto" target="Paul Atreides" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">Duke Leto's death</data>
    </edge>
    <edge source="Duke Leto" target="Baron" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.8</data>
      <data key="d14">Even the Duke Leto, a cousin on the distaff side, never knew for sure.</data>
    </edge>
    <edge source="Mentat" target="Duke Leto" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">Thufir Hawat, his father's Master of Assassins</data>
    </edge>
    <edge source="Mentat" target="Muad'Dib" id="0">
      <data key="d12">FRIENDS_WITH</data>
      <data key="d13">0.8</data>
      <data key="d14">There was Thufir Hawat, the old Mentat Master of Assassins, who struck fear even into the heart of the Padishah Emperor.</data>
    </edge>
    <edge source="Mentat" target="Paul Atreides" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">Hawat cleared his throat. Paul remained bent over his studies.</data>
    </edge>
    <edge source="Mentat" target="Paul Atreides" id="1">
      <data key="d12">SERVES</data>
      <data key="d13">0.9</data>
      <data key="d14">"I serve the . . . Lisan al-Gaib," Hawat said.</data>
    </edge>
    <edge source="Mentat" target="Paul Atreides" id="2">
      <data key="d12">PLEDGED_TO</data>
      <data key="d13">0.9</data>
      <data key="d14">"I've pledged myself to this."</data>
    </edge>
    <edge source="Mentat" target="Duke Paulus Atreides" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">where it had been slashed once in the service of the Old Duke</data>
    </edge>
    <edge source="Mentat" target="Reverend Mother" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">"Did you meet the Reverend Mother?"</data>
    </edge>
    <edge source="Mentat" target="guards" id="0">
      <data key="d12">LEADS</data>
      <data key="d13">0.9</data>
      <data key="d14">Those guards outside are his men</data>
    </edge>
    <edge source="Mentat" target="cargo handlers" id="0">
      <data key="d12">LEADS</data>
      <data key="d13">0.9</data>
      <data key="d14">The cargo handlers are his men</data>
    </edge>
    <edge source="Mentat" target="death and deceit" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Where Thufir Hawat goes, death and deceit follow</data>
    </edge>
    <edge source="Mentat" target="Leto Atreides" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">Thufir Hawat strode through it looking older and more leathery than ever. He paced down the length of the table, stopped at attention facing Leto.</data>
    </edge>
    <edge source="Mentat" target="Duke" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">I can speak for my Duke.</data>
    </edge>
    <edge source="Mentat" target="Fremen" id="0">
      <data key="d12">FRIENDS_WITH</data>
      <data key="d13">0.8</data>
      <data key="d14">Peace, friend," the Fremen cautioned.</data>
    </edge>
    <edge source="Mentat" target="Fremen" id="1">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">"You are Thufir Hawat," the man said matter-of-factly.</data>
    </edge>
    <edge source="Mentat" target="vendetta" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">The vendetta I'll handle myself.</data>
    </edge>
    <edge source="Mentat" target="vendetta" id="1">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.7</data>
      <data key="d14">The vendetta I'll handle myself.</data>
    </edge>
    <edge source="Mentat" target="House Harkonnen" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">We both fight Harkonnens," Hawat said.</data>
    </edge>
    <edge source="Mentat" target="House Harkonnen" id="1">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">Thufir Hawat's with 'em, m'Lord. I had no chance to see him alone, but he used our old hand signs to say he's been working with the Harkonnens</data>
    </edge>
    <edge source="Mentat" target="bond of water" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"The bond of water," Hawat said.</data>
    </edge>
    <edge source="Mentat" target="Jessica Atreides" id="0">
      <data key="d12">HATES</data>
      <data key="d13">0.9</data>
      <data key="d14">He has spoken only enough, m'Lord, to reveal his belief that the Lady Jessica was his betrayer.</data>
    </edge>
    <edge source="Mentat" target="Baron" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">Thufir Hawat, is not dead but in your employ.</data>
    </edge>
    <edge source="Mentat" target="The Sayings of Muad'Dib" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.7</data>
      <data key="d14">-from "The Sayings of Muad'Dib" by the Princess Irulan</data>
    </edge>
    <edge source="Mentat" target="Baron Vladimir Harkonnen" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">"You may speak plainly with me, Hawat," the Baron rumbled.</data>
    </edge>
    <edge source="Mentat" target="Arrakis" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Thufir Hawat beside him</data>
    </edge>
    <edge source="Mentat" target="passage" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">a face and figure emerged -Thufir Hawat, the seamed old features with darkly stained lips, the hunched shoulders, the look of fragile age about him.</data>
    </edge>
    <edge source="Mentat" target="Paul's family" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">in payment for your years of service to my family</data>
    </edge>
    <edge source="Mentat" target="skills" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"Your own Thufir Hawat taught me some of my skills," Feyd-Rautha said.</data>
    </edge>
    <edge source="House Harkonnen" target="House Atreides" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">their mortal enemies, the Harkonnens</data>
    </edge>
    <edge source="House Harkonnen" target="House Atreides" id="1">
      <data key="d12">LEAVES</data>
      <data key="d13">0.9</data>
      <data key="d14">the Harkonnens were leaving to be replaced by the House of Atreides</data>
    </edge>
    <edge source="House Harkonnen" target="Arrakis" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">the Harkonnens, had been on Arrakis eighty years</data>
    </edge>
    <edge source="House Harkonnen" target="Arrakis" id="1">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">The Harkonnens sealed off many sources of information about Arrakis.</data>
    </edge>
    <edge source="House Harkonnen" target="Imperial House" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.8</data>
      <data key="d14">since House Harkonnen is being used to do the Imperial dirty work</data>
    </edge>
    <edge source="House Harkonnen" target="CHOAM" id="0">
      <data key="d12">OWNS</data>
      <data key="d13">0.9</data>
      <data key="d14">we'll have an irrevocable directorship in the CHOAM Company.</data>
    </edge>
    <edge source="House Harkonnen" target="subfief on Arrakis" id="0">
      <data key="d12">WILL_HAVE</data>
      <data key="d13">0.9</data>
      <data key="d14">House Harkonnen will have a subfief on Arrakis within a Standard year.</data>
    </edge>
    <edge source="House Harkonnen" target="Paul Atreides" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">The Harkonnens have been stockpiling for more than twenty years. They mean spice production to fail and you to be blamed.</data>
    </edge>
    <edge source="House Harkonnen" target="melange" id="0">
      <data key="d12">STOCKPILING</data>
      <data key="d13">0.9</data>
      <data key="d14">Knowing that the Harkonnens stockpile melange</data>
    </edge>
    <edge source="House Harkonnen" target="Fremen" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">The Harkonnens sneered at the Fremen, hunted them for sport</data>
    </edge>
    <edge source="House Harkonnen" target="this place" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.7</data>
      <data key="d14">"They've known only the Harkonnens."</data>
    </edge>
    <edge source="House Harkonnen" target="passage" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">They've known only the Harkonnens.</data>
    </edge>
    <edge source="House Harkonnen" target="Duke" id="0">
      <data key="d12">HATES</data>
      <data key="d13">0.9</data>
      <data key="d14">Even my Duke's voice doesn't carry that weight of venom when he uses the hated name.</data>
    </edge>
    <edge source="House Harkonnen" target="Duke" id="1">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">The Harkonnens won't rest until they're dead or my Duke destroyed.</data>
    </edge>
    <edge source="House Harkonnen" target="spice" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">and not all of those things are directly involved with the spice.</data>
    </edge>
    <edge source="House Harkonnen" target="Lady Jessica" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">"It's the Harkonnens, of course. We shall have to destroy them."</data>
    </edge>
    <edge source="House Harkonnen" target="Sire" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.8</data>
      <data key="d14">"The fact that they're leaving suggests they're not part of the Harkonnen machine."</data>
    </edge>
    <edge source="House Harkonnen" target="Leto Atreides" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">Let the Harkonnens fight that!</data>
    </edge>
    <edge source="House Harkonnen" target="ten billion Solaris" id="0">
      <data key="d12">OWNS</data>
      <data key="d13">0.9</data>
      <data key="d14">The Harkonnens took ten billion Solaris out of here</data>
    </edge>
    <edge source="House Harkonnen" target="Old Maria" id="0">
      <data key="d12">OWNS</data>
      <data key="d13">0.9</data>
      <data key="d14">"If that's the one they call 'Old Maria,' it belongs in a museum," an aide said. "I think the Harkonnens kept it as a punishment job, a threat hanging over their workers' heads.</data>
    </edge>
    <edge source="House Harkonnen" target="shields" id="0">
      <data key="d12">USES</data>
      <data key="d13">0.9</data>
      <data key="d14">The Harkonnens certainly used plenty of shields here</data>
    </edge>
    <edge source="House Harkonnen" target="CHOAM percentage" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.7</data>
      <data key="d14">including the CHOAM percentage and military costs</data>
    </edge>
    <edge source="House Harkonnen" target="Harkonnen methods" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Unless my Lord wishes to adopt Harkonnen methods.</data>
    </edge>
    <edge source="House Harkonnen" target="Kynes" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.8</data>
      <data key="d14">There was a poise to them totally unlike the Harkonnens.</data>
    </edge>
    <edge source="House Harkonnen" target="spice investigation" id="0">
      <data key="d12">HATES</data>
      <data key="d13">0.9</data>
      <data key="d14">The Harkonnens discouraged investigation of the spice</data>
    </edge>
    <edge source="House Harkonnen" target="shipment of lasguns" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">The Harkonnens tried to get in a shipment of lasguns.</data>
    </edge>
    <edge source="House Harkonnen" target="Thufir" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.7</data>
      <data key="d14">"Isn't it more reasonable to suppose the Harkonnens have planted this suspicion to pit the two of us against each other?"</data>
    </edge>
    <edge source="House Harkonnen" target="Sardaukar" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.8</data>
      <data key="d14">That one legion was perfectly capable of turning on the Harkonnens and overcoming them.</data>
    </edge>
    <edge source="House Harkonnen" target="Guild passage for more than two thousand fighting ships" id="0">
      <data key="d12">OWNS</data>
      <data key="d13">0.9</data>
      <data key="d14">But they had the price of Guild passage for more than two thousand fighting ships</data>
    </edge>
    <edge source="House Harkonnen" target="area" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.7</data>
      <data key="d14">The Harkonnens will have a covering force over this area</data>
    </edge>
    <edge source="House Harkonnen" target="organization" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.8</data>
      <data key="d14">Eighty years under the Harkonnens taught them to be thorough.</data>
    </edge>
    <edge source="House Harkonnen" target="Tuek" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.8</data>
      <data key="d14">A grim smile touched Tuek's mouth. "But it's about the only trust I give them."</data>
    </edge>
    <edge source="House Harkonnen" target="Dune" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">The Harkonnens have returned to Dune in force</data>
    </edge>
    <edge source="House Harkonnen" target="Chani Kynes" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">"We have each lost a father to the Harkonnens."</data>
    </edge>
    <edge source="House Harkonnen" target="ultimate weapon" id="0">
      <data key="d12">OWNS</data>
      <data key="d13">0.7</data>
      <data key="d14">had Rabban unwittingly given House Harkonnen its ultimate weapon?</data>
    </edge>
    <edge source="House Atreides" target="Arrakis" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Now the Harkonnens were leaving to be replaced by the House of Atreides in fief-complete</data>
    </edge>
    <edge source="House Atreides" target="Arrakis" id="1">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"I indicate that House Atreides will go to Arrakis."</data>
    </edge>
    <edge source="Wellington Yueh" target="Paul Atreides" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">Dr. Yueh, his teacher</data>
    </edge>
    <edge source="Wellington Yueh" target="end of all the Atreides" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Dr. Yueh will move against him soon, and that'll be the end of all the Atreides.</data>
    </edge>
    <edge source="Wellington Yueh" target="Baron" id="0">
      <data key="d12">AGENT_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">The obvious suspect is Dr. Yueh, who is indeed our agent.</data>
    </edge>
    <edge source="Wellington Yueh" target="Baron" id="1">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.7</data>
      <data key="d14">You've given us the Duke, I hear. My half of the bargain, m'Lord.</data>
    </edge>
    <edge source="Wellington Yueh" target="Suk School" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">our doctor is a Suk School graduate</data>
    </edge>
    <edge source="Wellington Yueh" target="Imperial Conditioning" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">with Imperial Conditioning</data>
    </edge>
    <edge source="Wellington Yueh" target="conversation with old woman" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">And I said that's what Dr. Yueh calls the Mystery of Life.</data>
    </edge>
    <edge source="Wellington Yueh" target="Mystery of Life" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">that's what Dr. Yueh calls the Mystery of Life.</data>
    </edge>
    <edge source="Wellington Yueh" target="A Child's History of Muad'Dib" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"Yueh! Yueh! Yueh!" goes the refrain. "A million deaths were not enough for Yueh!" -from "A Child's History of Muad'Dib" by the Princess Irulan</data>
    </edge>
    <edge source="Wellington Yueh" target="House Harkonnen" id="0">
      <data key="d12">HATES</data>
      <data key="d13">0.9</data>
      <data key="d14">I didn't know you had personal reasons to hate them, Wellington.</data>
    </edge>
    <edge source="Wellington Yueh" target="House Harkonnen" id="1">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">his wife was a Bene Gesserit slain by the Harkonnens</data>
    </edge>
    <edge source="Wellington Yueh" target="Wanna" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">You didn't know that my wife, my Wanna . . .</data>
    </edge>
    <edge source="Wellington Yueh" target="Baron Vladimir Harkonnen" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">"You've given us the Duke, I hear." "My half of the bargain, m'Lord."</data>
    </edge>
    <edge source="Fremen" target="Arrakis" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">the planet sheltered people who lived at the desert edge without caid or bashar to command them: will-o'-the-sand people called Fremen</data>
    </edge>
    <edge source="Fremen" target="House Harkonnen" id="0">
      <data key="d12">HATES</data>
      <data key="d13">0.9</data>
      <data key="d14">they hate Harkonnens with a bloody passion.</data>
    </edge>
    <edge source="Fremen" target="House Harkonnen" id="1">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">We both fight Harkonnens," Hawat said.</data>
    </edge>
    <edge source="Fremen" target="composing poems to their knives" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">They compose poems to their knives.</data>
    </edge>
    <edge source="Fremen" target="saying: 'Polish comes from the cities; wisdom from the desert.'" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">They have a saying: 'Polish comes from the cities; wisdom from the desert.'</data>
    </edge>
    <edge source="Fremen" target="poems to their knives" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"They compose poems to their knives."</data>
    </edge>
    <edge source="Fremen" target="violent and dangerous" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"Even Fremen children are violent and dangerous."</data>
    </edge>
    <edge source="Fremen" target="potential of a corps" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">We have there the potential of a corps as strong and deadly as the Sardaukar</data>
    </edge>
    <edge source="Fremen" target="Harkonnen" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">Hawat tells me the Fremen were a deep thorn in the Harkonnen side</data>
    </edge>
    <edge source="Fremen" target="central wastelands" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">knots of Fremen. If anything could buy a future for the Atreides line, the Fremen just might do it.</data>
    </edge>
    <edge source="Fremen" target="Duke's crew" id="0">
      <data key="d12">ALLIES_WITH</data>
      <data key="d13">0.85</data>
      <data key="d14">the Fremen appear more and more to be the allies we need</data>
    </edge>
    <edge source="Fremen" target="stillsuits" id="0">
      <data key="d12">CREATED</data>
      <data key="d13">0.9</data>
      <data key="d14">They've sent us a gift--stillsuits of their own manufacture</data>
    </edge>
    <edge source="Fremen" target="maps" id="0">
      <data key="d12">CREATED</data>
      <data key="d13">0.9</data>
      <data key="d14">maps of certain desert areas surrounding strongpoints the Harkonnens left behind</data>
    </edge>
    <edge source="Fremen" target="jewelry" id="0">
      <data key="d12">CREATED</data>
      <data key="d13">0.9</data>
      <data key="d14">They've also sent some incidental things-jewelry for the Lady Jessica</data>
    </edge>
    <edge source="Fremen" target="spice liquor" id="0">
      <data key="d12">CREATED</data>
      <data key="d13">0.9</data>
      <data key="d14">spice liquor, candy, medicinals</data>
    </edge>
    <edge source="Fremen" target="candy" id="0">
      <data key="d12">CREATED</data>
      <data key="d13">0.9</data>
      <data key="d14">spice liquor, candy, medicinals</data>
    </edge>
    <edge source="Fremen" target="medicinals" id="0">
      <data key="d12">CREATED</data>
      <data key="d13">0.9</data>
      <data key="d14">spice liquor, candy, medicinals</data>
    </edge>
    <edge source="Fremen" target="attack" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">The Fremen themselves sent us a courier to warn of the false band. In the attack, however, we found the Harkonnens had waylaid the Fremen courier--badly wounded him.</data>
    </edge>
    <edge source="Fremen" target="Sardaukar" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">"And Sardaukar."</data>
    </edge>
    <edge source="Fremen" target="Kynes" id="0">
      <data key="d12">DEFER_TO</data>
      <data key="d13">0.9</data>
      <data key="d14">And the Fremen defer to him.</data>
    </edge>
    <edge source="Fremen" target="Kynes" id="1">
      <data key="d12">KNOWS</data>
      <data key="d13">0.8</data>
      <data key="d14">The Fremen now knew what he meant by an open-end prediction to five hundred years.</data>
    </edge>
    <edge source="Fremen" target="raid on Giedi Prime" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">perhaps some of the Fremen would enjoy a trip off planet. A raid on Giedi Prime</data>
    </edge>
    <edge source="Fremen" target="Dune" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"Any Dune man who values his skin wears a Fremen suit."</data>
    </edge>
    <edge source="Fremen" target="southern latitudes" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">It's said the Fremen travel there, that they go anywhere and have hunted out soaks and sip-wells even in the southern latitudes.</data>
    </edge>
    <edge source="Fremen" target="Guild" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.8</data>
      <data key="d14">"The Fremen! They're paying the Guild for privacy, paying in a coin that's freely available to anyone with desert power--spice."</data>
    </edge>
    <edge source="Fremen" target="Paul Atreides" id="0">
      <data key="d12">GIVES_SANCTUARY_TO</data>
      <data key="d13">0.9</data>
      <data key="d14">the Fremen will give us sanctuary</data>
    </edge>
    <edge source="Fremen" target="desert" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"This has the feeling of a Fremen place," he said.</data>
    </edge>
    <edge source="Fremen" target="Mentat" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.8</data>
      <data key="d14">I have seen you fight Harkonnens. You are good.</data>
    </edge>
    <edge source="Fremen" target="Mentat" id="1">
      <data key="d12">CAPTURED</data>
      <data key="d13">0.9</data>
      <data key="d14">It is said this Fremen force already had captured the Duke's redoubtable Thufir Hawat.</data>
    </edge>
    <edge source="Fremen" target="Liet" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">Liet wishes it.</data>
    </edge>
    <edge source="Fremen" target="Stilgar" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">where Stilgar can study it for Liet</data>
    </edge>
    <edge source="Fremen" target="captured Sardaukar" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"You . . . captured Sardaukar?"</data>
    </edge>
    <edge source="Fremen" target="bond of water" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"The bond of water! It's a sign!"</data>
    </edge>
    <edge source="Fremen" target="Arrakeen" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.7</data>
      <data key="d14">a couple of the men left wives in Arrakeen</data>
    </edge>
    <edge source="Fremen" target="EVENT" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">the Fremen hissed</data>
    </edge>
    <edge source="Fremen" target="EVENT" id="1">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">The Sardaukar approached the waiting group of Fremen in an enclosing halfcircle.</data>
    </edge>
    <edge source="Fremen" target="ambush" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">a Fremen band ambushed a Sardaukar force somewhere southeast of here and wiped it out.</data>
    </edge>
    <edge source="Fremen" target="Fremkit manual" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">probing the mysterious allusions to thumpers and maker hooks in the Fremkit manual</data>
    </edge>
    <edge source="Fremen" target="Sietch Tabr" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Their destination was Sietch Tabr--Stilgar's sietch.</data>
    </edge>
    <edge source="Fremen" target="Cave of the Ridges" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">With, Shai-hulud's favor, we'll reach Cave of the Ridges before dawn.</data>
    </edge>
    <edge source="Fremen" target="riding on the back of a giant worm" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Fremen riding on the back of a giant worm</data>
    </edge>
    <edge source="Fremen" target="book of examples" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">I see a . . . Fremen with the book of examples</data>
    </edge>
    <edge source="Fremen" target="ritual" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">She saw how the Fremen slowed while passing the honeycomb lattice</data>
    </edge>
    <edge source="Fremen" target="water pool" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.7</data>
      <data key="d14">the shadowy line of Fremen, saw Stilgar with Paul standing beside him and the watermasters emptying their load into the pool</data>
    </edge>
    <edge source="Fremen" target="stories" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Paul recalled the stories of the Fremen</data>
    </edge>
    <edge source="Fremen" target="Poritrin" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">There had been Fremen on Poritrin, she saw, a people grown soft with an easy planet, fair game for Imperial raiders to harvest and plant human colonies on Bela Tegeuse and Salusa Secundus.</data>
    </edge>
    <edge source="Fremen" target="Bela Tegeuse" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">There had been Fremen on Poritrin, she saw, a people grown soft with an easy planet, fair game for Imperial raiders to harvest and plant human colonies on Bela Tegeuse and Salusa Secundus.</data>
    </edge>
    <edge source="Fremen" target="Salusa Secundus" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">There had been Fremen on Poritrin, she saw, a people grown soft with an easy planet, fair game for Imperial raiders to harvest and plant human colonies on Bela Tegeuse and Salusa Secundus.</data>
    </edge>
    <edge source="Fremen" target="Muad'Dib" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">the Fremen and their Muad'Dib</data>
    </edge>
    <edge source="Fremen" target="wild crusade" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">the sleeping giant Fremen poised for their wild crusade across the universe</data>
    </edge>
    <edge source="Fremen" target="troop" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.7</data>
      <data key="d14">The Fremen knew this rule instinctively.</data>
    </edge>
    <edge source="Fremen" target="Hajj" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">They denied us the Hajj," Stilgar said</data>
    </edge>
    <edge source="Fremen" target="sietch caverns" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">paradox in the Fremen way of life: how well they lived in these sietch caverns</data>
    </edge>
    <edge source="Fremen" target="south" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.7</data>
      <data key="d14">This was still Fremen country.</data>
    </edge>
    <edge source="Fremen" target="taking of a worm" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Gurney saw the taking of a worm -- the daring leap of the first hookman, the turning of the creature, the way an entire band of men went up the scaly, glistening curve of the worm's side.</data>
    </edge>
    <edge source="Fremen" target="Cave of Birds" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"We've a cave here -- Cave of Birds."</data>
    </edge>
    <edge source="Fremen" target="Emperor" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.8</data>
      <data key="d14">that Fremen rabble won't attack while I'm here with five legions of Sardaukar.</data>
    </edge>
    <edge source="Fremen" target="Imperial Corps of Sardaukar" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">troops of Fremen riding to the attack</data>
    </edge>
    <edge source="Fremen" target="onslaught" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Fremen riding to the attack</data>
    </edge>
    <edge source="Fremen" target="Station personnel" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">Fremen began to appear among the Station personnel</data>
    </edge>
    <edge source="Fremen" target="Biological Testing Stations" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Fremen began to appear among the Station personnel</data>
    </edge>
    <edge source="Fremen" target="Fremen folk stories" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">This had been ascribed to a fictional "sandtrout" in Fremen folk stories.</data>
    </edge>
    <edge source="Fremen" target="shai-hulud" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">as the Fremen had long known from drowning the rare "stunted worm" of the Minor Erg</data>
    </edge>
    <edge source="Fremen" target="plantation areas" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Downwind sides of old dunes provided the first plantation areas. The Fremen aimed first for a cycle of poverty grass</data>
    </edge>
    <edge source="Fremen" target="dream of cycling vast areas of Arrakis through a prairie phase into forest cover" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">the Fremen with their new ecological literacy and their dream of cycling vast areas of Arrakis through a prairie phase into forest cover</data>
    </edge>
    <edge source="Fremen" target="Appendix II: The Religion of Dune" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Appendix II: The Religion of Dune

Before the coming of Muad'Dib, the Fremen of Arrakis</data>
    </edge>
    <edge source="Fremen" target="tribe" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">his water belongs to the tribe</data>
    </edge>
    <edge source="Fremen" target="Crysknife" id="0">
      <data key="d12">OWNS</data>
      <data key="d13">0.9</data>
      <data key="d14">the sacred knife of the Fremen on Arrakis</data>
    </edge>
    <edge source="Fremen" target="Zensunni Wanderers" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">FREMEN: the free tribes of Arrakis, dwellers in the desert, remnants of the Zensunni Wanderers.</data>
    </edge>
    <edge source="Fremen" target="Imperium" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.8</data>
      <data key="d14">"Sand Pirates" according to the Imperial Dictionary.</data>
    </edge>
    <edge source="Fremen" target="LA, LA, LA" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Fremen cry of grief</data>
    </edge>
    <edge source="Fremen" target="Fremen prophecy" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">In Fremen messianic legends, an off-world prophet.</data>
    </edge>
    <edge source="Fremen" target="MAHDI" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">in the Fremen messianic legend, "The One Who Will Lead Us to Paradise."</data>
    </edge>
    <edge source="Fremen" target="cave warren" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">the term came by general usage to designate any cave warren inhabited by one of their tribal communities.</data>
    </edge>
    <edge source="his mother" target="Bene Gesserit Sisterhood" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">she had trained him in the Bene Gesserit Way</data>
    </edge>
    <edge source="his mother" target="Bene Gesserit Sisterhood" id="1">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">She was my teacher at the Bene Gesserit school</data>
    </edge>
    <edge source="his mother" target="House Harkonnen soldiers" id="0">
      <data key="d12">CAPTURED_BY</data>
      <data key="d13">0.9</data>
      <data key="d14">He wondered who could've captured her.</data>
    </edge>
    <edge source="Reverend Mother" target="Emperor" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">she's the Emperor's Truthsayer</data>
    </edge>
    <edge source="Reverend Mother" target="Lady Jessica" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">The Lady Jessica was my serving wench, lad, for fourteen years at school.</data>
    </edge>
    <edge source="Reverend Mother" target="Lady Jessica" id="1">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.7</data>
      <data key="d14">"You're as dear to me as any of my own daughters, but I cannot let that interfere with duty."</data>
    </edge>
    <edge source="Reverend Mother" target="Butlerian Jihad" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">" 'Thou shalt not make a machine in the likeness of a man's mind,' " Paul quoted. "Right out of the Butlerian Jihad and the Orange Catholic Bible," she said.</data>
    </edge>
    <edge source="Reverend Mother" target="O.C. Bible" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">" 'Thou shalt not make a machine in the likeness of a man's mind,' " Paul quoted. "Right out of the Butlerian Jihad and the Orange Catholic Bible," she said.</data>
    </edge>
    <edge source="Reverend Mother" target="Bene Gesserit Sisterhood" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">The original Bene Gesserit school was directed by those who saw the need of a thread of continuity in human affairs.</data>
    </edge>
    <edge source="Reverend Mother" target="Bene Gesserit Sisterhood" id="1">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">The old woman stared at Paul, then: "Young man, as a Proctor of the Bene Gesserit,</data>
    </edge>
    <edge source="Reverend Mother" target="Kwisatz Haderach" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"You say maybe I'm the . . . Kwisatz Haderach."</data>
    </edge>
    <edge source="Reverend Mother" target="seeking the Kwisatz Haderach" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">I seek the Kwisatz Haderach, the male who truly can become one of us.</data>
    </edge>
    <edge source="Reverend Mother" target="Paul Atreides" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">She fell silent and Paul saw that she wanted him to speak.</data>
    </edge>
    <edge source="Reverend Mother" target="ordeal" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">thinking back to the day a week ago and the ordeal with the Reverend Mother.</data>
    </edge>
    <edge source="Reverend Mother" target="Imperium" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.7</data>
      <data key="d14">That Truthsayer witch from the Imperium</data>
    </edge>
    <edge source="Reverend Mother" target="warnings about Arrakis" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.7</data>
      <data key="d14">Did the Reverend Mother warn you?</data>
    </edge>
    <edge source="Reverend Mother" target="passage" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">not thinking about it out of fear or because of warnings such as that of the old Reverend Mother</data>
    </edge>
    <edge source="Reverend Mother" target="Sayyadina" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">"The Sayyadina," he said. "Our Reverend Mother is old."</data>
    </edge>
    <edge source="Reverend Mother" target="Mapes" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"The Shadout Mapes was right to pity you."</data>
    </edge>
    <edge source="Reverend Mother" target="the people of Misr" id="0">
      <data key="d12">LEADS</data>
      <data key="d13">0.9</data>
      <data key="d14">"We are the people of Misr," the old woman rasped.</data>
    </edge>
    <edge source="Reverend Mother" target="Ceremony of the Seed" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"I, the Reverend Mother Ramallo, whose voice speaks as a multitude, say this to you," the old woman said.</data>
    </edge>
    <edge source="Reverend Mother" target="ritual" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Jessica looked back at the Reverend Mother Ramallo.</data>
    </edge>
    <edge source="Reverend Mother" target="EVENT" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">She saw the old Reverend Mother Ramallo being brought to sit beside her on the carpeted ledge.</data>
    </edge>
    <edge source="Reverend Mother" target="Bene Gesserit's need" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">a subliminal training projector at the Bene Gesserit school</data>
    </edge>
    <edge source="Reverend Mother" target="rite of joining" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">I have met the Reverend Mother Ramallo," Jessica said. "She is gone, but she remains. Let her memory be honored in the rite.</data>
    </edge>
    <edge source="Reverend Mother" target="Alia" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">Some of the women banded to appeal to the Reverend Mother. They demanded she exorcise the demon in her daughter.</data>
    </edge>
    <edge source="Reverend Mother" target="Alia" id="1">
      <data key="d12">HATES</data>
      <data key="d13">0.9</data>
      <data key="d14">"That child is an abomination!" the old woman said.</data>
    </edge>
    <edge source="Reverend Mother" target="law" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">She recited the law and sent the women away abashed.</data>
    </edge>
    <edge source="Reverend Mother" target="Collected Legends of Arrakis" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">-"Collected Legends of Arrakis" by the Princess Irulan</data>
    </edge>
    <edge source="Reverend Mother" target="Jessica Atreides" id="0">
      <data key="d12">HATES</data>
      <data key="d13">0.9</data>
      <data key="d14">"Her mother deserves a punishment greater than anything in history. Death!"</data>
    </edge>
    <edge source="Reverend Mother" target="Padishah Emperor" id="0">
      <data key="d12">COMMANDS</data>
      <data key="d13">0.9</data>
      <data key="d14">"Summon Count Fenring from his quarters," the Reverend Mother said. The Padishah Emperor nodded, waved for one of his aides to obey that command.</data>
    </edge>
    <edge source="Emperor" target="Empire" id="0">
      <data key="d12">LEADS</data>
      <data key="d13">0.9</data>
      <data key="d14">the Emperor orders it</data>
    </edge>
    <edge source="Emperor" target="smuggling operations on Arrakis" id="0">
      <data key="d12">INTERESTED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">indicating the Emperor's interest in smuggling operations on Arrakis</data>
    </edge>
    <edge source="Emperor" target="his friends" id="0">
      <data key="d12">FRIENDS_WITH</data>
      <data key="d13">0.9</data>
      <data key="d14">The Emperor and his friends now command fifty-nine point six-five per cent of the CHOAM directorship's votes.</data>
    </edge>
    <edge source="Emperor" target="Paul Atreides" id="0">
      <data key="d12">ORDERS</data>
      <data key="d13">0.9</data>
      <data key="d14">Because the Emperor ordered it.</data>
    </edge>
    <edge source="Emperor" target="Paul Atreides" id="1">
      <data key="d12">CALLS</data>
      <data key="d13">0.9</data>
      <data key="d14">Only the Emperor calls the Atreides the Red Duke.</data>
    </edge>
    <edge source="Emperor" target="Duke Leto Atreides" id="0">
      <data key="d12">LEADS</data>
      <data key="d13">0.8</data>
      <data key="d14">the Emperor's private note to his "Noble Duke"</data>
    </edge>
    <edge source="Emperor" target="barbarians" id="0">
      <data key="d12">HATES</data>
      <data key="d13">0.8</data>
      <data key="d14">the disdainful allusions to veiled men and women: " . . . but what else is one to expect of barbarians</data>
    </edge>
    <edge source="Emperor" target="Harkonnen" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.7</data>
      <data key="d14">The Emperor will put a Harkonnen back in power here</data>
    </edge>
    <edge source="Emperor" target="Fremen" id="0">
      <data key="d12">HATES</data>
      <data key="d13">0.8</data>
      <data key="d14">They needed practice in killing . . . and they hate to see a task left undone.</data>
    </edge>
    <edge source="Emperor" target="rid him of the troublesome Duke" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">I rid him of the troublesome Duke.</data>
    </edge>
    <edge source="Emperor" target="Count" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">the Emperor's errand boy</data>
    </edge>
    <edge source="Emperor" target="Count" id="1">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">The Emperor hissed. The Count focused on Paul</data>
    </edge>
    <edge source="Emperor" target="prison planet" id="0">
      <data key="d12">OWNS</data>
      <data key="d13">0.9</data>
      <data key="d14">the Emperor is in a ferment about some association between Arrakis and his mysterious prison planet.</data>
    </edge>
    <edge source="Emperor" target="oppression" id="0">
      <data key="d12">PRACTICES</data>
      <data key="d13">0.9</data>
      <data key="d14">the Emperor practices every form of oppression there</data>
    </edge>
    <edge source="Emperor" target="Salusa Secundus" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">curiosity about Salusa Secundus is . . . ah . . . " Hawat put a bony finger to his lips. ". . . discouraged."</data>
    </edge>
    <edge source="Emperor" target="Sardaukar" id="0">
      <data key="d12">CREATED</data>
      <data key="d13">0.9</data>
      <data key="d14">you've never wondered where the Emperor gets his Sardaukar?</data>
    </edge>
    <edge source="Emperor" target="Sardaukar" id="1">
      <data key="d12">LEADS</data>
      <data key="d13">0.9</data>
      <data key="d14">"while I'm here with five legions of Sardaukar."</data>
    </edge>
    <edge source="Emperor" target="EVENT" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"If the Emperor recognized my claim, he'll signal by restoring the Atreides flag to Arrakis.</data>
    </edge>
    <edge source="Emperor" target="Sardaukar uniform" id="0">
      <data key="d12">WEARS</data>
      <data key="d13">0.9</data>
      <data key="d14">The Emperor stood poised, waiting -- a slim, elegant figure in a gray Sardaukar uniform with silver and gold trim.</data>
    </edge>
    <edge source="Emperor" target="Burseg's ebon helmet" id="0">
      <data key="d12">WEARS</data>
      <data key="d13">0.9</data>
      <data key="d14">most of that hair was concealed by a Burseg's ebon helmet with the Imperial crest in gold upon its crown.</data>
    </edge>
    <edge source="Emperor" target="Reverend Mother" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">"Now, Reverend Mother," the Emperor chided</data>
    </edge>
    <edge source="Emperor" target="Reverend Mother" id="1">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.8</data>
      <data key="d14">The old Reverend Mother, her composure regained, forced her way to the Emperor's side, leaned close to his ear and whispered.</data>
    </edge>
    <edge source="Emperor" target="selamlik" id="0">
      <data key="d12">OWNS</data>
      <data key="d13">0.8</data>
      <data key="d14">And the Baron waited, glancing left and right at the metal walls of the selamlik, thinking of the monstrous fanmetal tent around him.</data>
    </edge>
    <edge source="Emperor" target="Baron" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">the Emperor said. He knows something, the Baron thought.</data>
    </edge>
    <edge source="Emperor" target="Muad'Dib" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.8</data>
      <data key="d14">Do you have any idea who this Muad'Dib could be?" the Emperor asked.</data>
    </edge>
    <edge source="Emperor" target="Muad'Dib" id="1">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.8</data>
      <data key="d14">Even an Emperor may tremble before Muad'Dib</data>
    </edge>
    <edge source="Emperor" target="Arrakis" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Tell me, my dear Baron, have you investigated the southern polar regions of Arrakis?</data>
    </edge>
    <edge source="Emperor" target="Alia" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.8</data>
      <data key="d14">It is not wise to go against my desires," the Emperor said.</data>
    </edge>
    <edge source="Emperor" target="madmen" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.8</data>
      <data key="d14">These madmen are attacking under cover of the storm.</data>
    </edge>
    <edge source="Emperor" target="Sardaukar officers" id="0">
      <data key="d12">LEADS</data>
      <data key="d13">0.8</data>
      <data key="d14">The Emperor whirled, motioned his people into an emergency door that swung open in the ship's side behind the throne. He flashed a hand signal to a Sardaukar officer leaping through the dust haze.</data>
    </edge>
    <edge source="Emperor" target="Imperial Corps of Sardaukar" id="0">
      <data key="d12">LEADS</data>
      <data key="d13">0.9</data>
      <data key="d14">The Emperor ordered.</data>
    </edge>
    <edge source="Emperor" target="oldest daughter" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">seeing his oldest daughter with the flush of exertion on her cheeks</data>
    </edge>
    <edge source="Emperor" target="Great Houses" id="0">
      <data key="d12">LEADS</data>
      <data key="d13">0.8</data>
      <data key="d14">"There's a massed armada of the Great Houses in space over Arrakis right now," the Emperor said.</data>
    </edge>
    <edge source="Emperor" target="Princess Irulan Corrino" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">The Princess Royal put a hand on her father's arm.</data>
    </edge>
    <edge source="Emperor" target="Irulan" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">"But here's a man fit to be your son," she said.</data>
    </edge>
    <edge source="Emperor" target="Imperial company" id="0">
      <data key="d12">LEADS</data>
      <data key="d13">0.9</data>
      <data key="d14">"Anyone accepted into the Imperial company is a member of my entourage."</data>
    </edge>
    <edge source="Emperor" target="Feyd-Rautha" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">The Emperor was studying Feyd-Rautha</data>
    </edge>
    <edge source="Emperor" target="Count Fenring" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">The Emperor turned, looked at Count Fenring. The Count met his stare -- gray eyes against green.</data>
    </edge>
    <edge source="Emperor" target="throne" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">I sit on the throne!</data>
    </edge>
    <edge source="Emperor" target="PERSON" id="0">
      <data key="d12">PERSON</data>
      <data key="d13">0.9</data>
      <data key="d14">an official appointed by the Landsraad High Council and the Emperor</data>
    </edge>
    <edge source="Reverend Mother Mohiam" target="Bene Gesserit Sisterhood" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">a mission that required personal attention from a Bene Gesserit-with-theSight.</data>
    </edge>
    <edge source="Reverend Mother Mohiam" target="Bene Gesserit Sisterhood" id="1">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">Observe her, comrades! This is a Bene Gesserit Reverend Mother, patient in a patient cause.</data>
    </edge>
    <edge source="Reverend Mother Mohiam" target="REVEREND MOTHER" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Even the Padishah Emperor's Truthsayer couldn't evade that responsibility</data>
    </edge>
    <edge source="Reverend Mother Mohiam" target="Bene Gesserit's need" id="0">
      <data key="d12">LEADS</data>
      <data key="d13">0.9</data>
      <data key="d14">Reverend Mother Gaius Helen Mohiam, Proctor Superior of the Bene Gesserit school</data>
    </edge>
    <edge source="Reverend Mother Mohiam" target="Ceremony of the Seed" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">She carried the same aura of power that he remembered from the Reverend Mother Gaius Helen Mohiam who had tested him with agony in the way of the gom jabbar.</data>
    </edge>
    <edge source="Reverend Mother Mohiam" target="Emperor" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">The presence of the Reverend Mother Gaius Helen Mohiam, the Emperor's Truthsayer, betrayed the importance of this audience.</data>
    </edge>
    <edge source="Reverend Mother Mohiam" target="Paul Atreides" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.8</data>
      <data key="d14">Paul stilled a cold, piercing anger, said: "You've never had the right or cause to forgive my mother anything!"</data>
    </edge>
    <edge source="Reverend Mother Mohiam" target="Paul's words" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.7</data>
      <data key="d14">The old Truthsayer, the Reverend Mother Gaius Helen Mohiam, had her own view of the hidden meaning in Paul's words now.</data>
    </edge>
    <edge source="Reverend Mother Mohiam" target="tested Paul's humanity" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Reverend Mother Gaius Helen Mohiam, Bene Gesserit Proctor who tested Paul's humanity</data>
    </edge>
    <edge source="REVEREND MOTHER" target="mother" id="0">
      <data key="d12">FRIENDS_WITH</data>
      <data key="d13">0.7</data>
      <data key="d14">There's also a Bene Gesserit Reverend Mother who says she's a friend of your mother</data>
    </edge>
    <edge source="REVEREND MOTHER" target="Bene Gesserit Sisterhood" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">REVEREND MOTHER: originally, a proctor of the Bene Gesserit</data>
    </edge>
    <edge source="Atreides family" target="farmlands" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">the green farmlands of the Atreides family holding</data>
    </edge>
    <edge source="Duke" target="Paul Atreides" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">the Duke and his family</data>
    </edge>
    <edge source="Duke" target="Paul Atreides" id="1">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">Paul and Halleck were crowded together, looking in the same direction, and Paul noted that their escort, caught by the sudden maneuver, had surged ahead, but now was curving back.</data>
    </edge>
    <edge source="Duke" target="Paul Atreides" id="2">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.8</data>
      <data key="d14">the burnished reflections of the Atreides silver</data>
    </edge>
    <edge source="Duke" target="Paul Atreides" id="3">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">The planetologist broke off as an uniformed Atreides trooper hurried in through the service door, was passed by the guard and rushed to the Duke's side.</data>
    </edge>
    <edge source="Duke" target="Paul Atreides" id="4">
      <data key="d12">LEADS</data>
      <data key="d13">0.9</data>
      <data key="d14">As long as enmity continues between Atreides and Harkonnen</data>
    </edge>
    <edge source="Duke" target="Arrakeen" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">At Arrakeen," Piter said, "the Duke and his family will occupy the Residency</data>
    </edge>
    <edge source="Duke" target="CHOAM" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.8</data>
      <data key="d14">By giving me Arrakis, His Majesty is forced to give us a CHOAM directorship</data>
    </edge>
    <edge source="Duke" target="Landsraad" id="0">
      <data key="d12">LEADS</data>
      <data key="d13">0.8</data>
      <data key="d14">Think of the Landsraad Houses that look to me for a certain amount of leadership -- their unofficial spokesman.</data>
    </edge>
    <edge source="Duke" target="Arrakis" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.8</data>
      <data key="d14">walk into Arrakis, knowing the trap is there</data>
    </edge>
    <edge source="Duke" target="Arrakis" id="1">
      <data key="d12">HATES</data>
      <data key="d13">0.9</data>
      <data key="d14">he could not bring himself to call this dry wasteland of Arrakis his home, and he doubted he ever would.</data>
    </edge>
    <edge source="Duke" target="Arrakis" id="2">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">There's greater possibility for us here on Arrakis</data>
    </edge>
    <edge source="Duke" target="Arrakis" id="3">
      <data key="d12">LEADS</data>
      <data key="d13">0.9</data>
      <data key="d14">The people must learn how well I govern them.</data>
    </edge>
    <edge source="Duke" target="Arrakis" id="4">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">holding the conservatory plants in trust for Arrakis</data>
    </edge>
    <edge source="Duke" target="Lady Jessica" id="0">
      <data key="d12">LOVES</data>
      <data key="d13">0.9</data>
      <data key="d14">There was no doubt how the Duke felt about his concubine. One had only to watch him as he followed her with his eyes.</data>
    </edge>
    <edge source="Duke" target="Caladan" id="0">
      <data key="d12">LOVES</data>
      <data key="d13">0.9</data>
      <data key="d14">The longing for Caladan was a sudden pain in his breast.</data>
    </edge>
    <edge source="Duke" target="Caladan" id="1">
      <data key="d12">LEADS</data>
      <data key="d13">0.9</data>
      <data key="d14">"Our supremacy on Caladan," the Duke said, "depended on sea and air power.</data>
    </edge>
    <edge source="Duke" target="Gurney Halleck" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">The Duke glanced at the darkness out the windows, looked back at Halleck.</data>
    </edge>
    <edge source="Duke" target="Gurney Halleck" id="1">
      <data key="d12">LEADS</data>
      <data key="d13">0.9</data>
      <data key="d14">This lets the men know their Duke is concerned for their safety</data>
    </edge>
    <edge source="Duke" target="Gurney Halleck" id="2">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.7</data>
      <data key="d14">Not a bit of it, Sire.</data>
    </edge>
    <edge source="Duke" target="coming encounter" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">to prepare his face for the coming encounter.</data>
    </edge>
    <edge source="Duke" target="Imperium" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.8</data>
      <data key="d14">our civilization appears to've fallen so deeply into the habit of invasion that we cannot even obey a simple order of the Imperium</data>
    </edge>
    <edge source="Duke" target="contact romantic businessmen" id="0">
      <data key="d12">HAS_PLAN</data>
      <data key="d13">0.9</data>
      <data key="d14">The Duke looked at Halleck. "Gurney, I want you to head a delegation, an embassy if you will, to contact these romantic businessmen.</data>
    </edge>
    <edge source="Duke" target="planetary base" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">"We're working for a solid and permanent planetary base," the Duke said.</data>
    </edge>
    <edge source="Duke" target="Fremen" id="0">
      <data key="d12">LEADS</data>
      <data key="d13">0.9</data>
      <data key="d14">"We'll have to move fast with the Fremen. I'd like five full battalions of Fremen troops before the first CHOAM audit."</data>
    </edge>
    <edge source="Duke" target="Harkonnen" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">We're presently in a war of assassins</data>
    </edge>
    <edge source="Duke" target="strategy staff" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">You can see this is strategy staff.</data>
    </edge>
    <edge source="Duke" target="Leto Atreides" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">the Duke said. "If the other Fremen match him, we'll serve each other well," Leto said.</data>
    </edge>
    <edge source="Duke" target="Hawat" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">"Are you going to discuss the traitor possibility with Hawat?" Paul asked.</data>
    </edge>
    <edge source="Duke" target="Mentat" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">The Duke found Thufir Hawat alone in the corner room</data>
    </edge>
    <edge source="Duke" target="Imperial" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.7</data>
      <data key="d14">the Imperial and Harkonnen stockpiles of spice attract my attention</data>
    </edge>
    <edge source="Duke" target="House Harkonnen" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">The Harkonnens have hindered and hounded and hunted me for the last time, he thought.</data>
    </edge>
    <edge source="Duke" target="woman" id="0">
      <data key="d12">LOVES</data>
      <data key="d13">0.9</data>
      <data key="d14">The woman has opened her heart to me.</data>
    </edge>
    <edge source="Duke" target="Great Houses" id="0">
      <data key="d12">LEADS</data>
      <data key="d13">0.8</data>
      <data key="d14">The melancholy degeneration of the Great Houses has afflicted me at last</data>
    </edge>
    <edge source="Duke" target="mother" id="0">
      <data key="d12">LOVES</data>
      <data key="d13">0.7</data>
      <data key="d14">I should wed your mother, make her my Duchess</data>
    </edge>
    <edge source="Duke" target="propaganda corps" id="0">
      <data key="d12">LEADS</data>
      <data key="d13">0.9</data>
      <data key="d14">My propaganda corps is one of the finest</data>
    </edge>
    <edge source="Duke" target="factory" id="0">
      <data key="d12">OWNS</data>
      <data key="d13">0.8</data>
      <data key="d14">Did you know we're using spice residue as raw material and already have our own factory to manufacture filmbase?</data>
    </edge>
    <edge source="Duke" target="statecraft" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.8</data>
      <data key="d14">"Power and fear," he said. "The tools of statecraft.</data>
    </edge>
    <edge source="Duke" target="my father" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">the political necessities that made them enemies</data>
    </edge>
    <edge source="Duke" target="Kynes" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">"I understand we have you to thank for our stillsuits and these cloaks," the Duke said.</data>
    </edge>
    <edge source="Duke" target="Kynes" id="1">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.7</data>
      <data key="d14">A good man but he'll have to learn to address us properly, the Duke thought.</data>
    </edge>
    <edge source="Duke" target="flight" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">He climbed in, fastened his safety harness, checked controls and instruments.</data>
    </edge>
    <edge source="Duke" target="flight" id="1">
      <data key="d12">LEADS</data>
      <data key="d13">0.9</data>
      <data key="d14">The Duke banked into his air cover, the other craft taking up their guard positions as they headed southeast.</data>
    </edge>
    <edge source="Duke" target="change of government" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"When you report to the Emperor on the change of government here, will you say we observed the rules?" Leto asked.</data>
    </edge>
    <edge source="Duke" target="Escort Gemma" id="0">
      <data key="d12">LEADS</data>
      <data key="d13">0.9</data>
      <data key="d14">The Duke reached down, brought up a microphone from the instrument panel, thumbed it to life, said: "Leader to Escort Gemma."</data>
    </edge>
    <edge source="Duke" target="EVENT" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"Ah-h, the worms," the Duke said.</data>
    </edge>
    <edge source="Duke" target="EVENT" id="1">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">The ship bucked as its tail pods whispered to silence. Stub wings elongated, cupped the air. The craft became a full 'thopter as the Duke banked it, holding the wings to a gentle beat, pointing with his left hand off to the east beyond the factory crawler.</data>
    </edge>
    <edge source="Duke" target="workers" id="0">
      <data key="d12">LEADS</data>
      <data key="d13">0.7</data>
      <data key="d14">"All our workers will be wearing them before long."</data>
    </edge>
    <edge source="Duke" target="Delta Ajax niner" id="0">
      <data key="d12">LEADS</data>
      <data key="d13">0.9</data>
      <data key="d14">This is a command from your Duke!</data>
    </edge>
    <edge source="Duke" target="command frequency" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">The Duke took the microphone, punched for his command frequency</data>
    </edge>
    <edge source="Duke" target="working frequency" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">He keyed back to the working frequency</data>
    </edge>
    <edge source="Duke" target="men" id="0">
      <data key="d12">LEADS</data>
      <data key="d13">0.9</data>
      <data key="d14">The Duke hung the microphone on the panel, swung out onto the wing step, shouted: "Two men each into your spotters."</data>
    </edge>
    <edge source="Duke" target="escort" id="0">
      <data key="d12">LEADS</data>
      <data key="d13">0.9</data>
      <data key="d14">The Duke nodded, watched the last of his escort take off.</data>
    </edge>
    <edge source="Duke" target="dinner" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">a house trooper in uniform of a footman cleared his throat behind Leto, said: "Dinner is served, my Lord."</data>
    </edge>
    <edge source="Duke" target="poison-snooper" id="0">
      <data key="d12">OWNS</data>
      <data key="d13">0.8</data>
      <data key="d14">the mechanism of the poison-snooper had been concealed</data>
    </edge>
    <edge source="Duke" target="doorway" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Pausing in the doorway to inspect the arrangements, the Duke</data>
    </edge>
    <edge source="Duke" target="custom" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">"I know the custom!" he barked.</data>
    </edge>
    <edge source="Duke" target="Great Hall" id="0">
      <data key="d12">LEADS</data>
      <data key="d13">0.8</data>
      <data key="d14">He whirled, strode back down the passage to the Great Hall.</data>
    </edge>
    <edge source="Duke" target="House Troop" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.8</data>
      <data key="d14">aloof among them, three officers of the House Troop</data>
    </edge>
    <edge source="Duke" target="House Troop" id="1">
      <data key="d12">LEADS</data>
      <data key="d13">0.8</data>
      <data key="d14">aloof among them, three officers of the House Troop</data>
    </edge>
    <edge source="Duke" target="factory crawler" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"The loss of that factory crawler hit him more deeply than it should have."</data>
    </edge>
    <edge source="Duke" target="carry-all" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"The blasted carry-all disappeared."</data>
    </edge>
    <edge source="Duke" target="house guard" id="0">
      <data key="d12">LEADS</data>
      <data key="d13">0.9</data>
      <data key="d14">but I must ask that no one leave until our house guard says it's safe.</data>
    </edge>
    <edge source="Duke" target="kanly" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">The Duke has sworn kanly.</data>
    </edge>
    <edge source="Duke" target="drugged" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"I believe the good Duke is drugged," Piter said.</data>
    </edge>
    <edge source="Duke" target="Atreides raid on Giedi Prime" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">the Emperor, at least, had not learned of the Atreides raid on Giedi Prime</data>
    </edge>
    <edge source="Duke" target="destruction of the Harkonnen spice stores" id="0">
      <data key="d12">CREATED</data>
      <data key="d13">0.8</data>
      <data key="d14">the destruction of the Harkonnen spice stores there</data>
    </edge>
    <edge source="Duke" target="his son" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">Have you word of my Duke or his son?</data>
    </edge>
    <edge source="Duke" target="House-to-House battle" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">The Duke was offered the usual quarter and exile, but he died in an unfortunate accident before he could accept.</data>
    </edge>
    <edge source="Jessica Atreides" target="old woman" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.8</data>
      <data key="d14">The Lady Jessica was my serving wench, lad, for fourteen years at school.</data>
    </edge>
    <edge source="Jessica Atreides" target="Paul Atreides" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">That witch-mother of his is giving him the deep training</data>
    </edge>
    <edge source="Jessica Atreides" target="Bene Gesserit Sisterhood" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">the Lady Jessica, who guided her son in the Bene Gesserit Way</data>
    </edge>
    <edge source="Jessica Atreides" target="Bene Gesserit Sisterhood" id="1">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">To one with the Bene Gesserit training, the voice screamed: Killer!</data>
    </edge>
    <edge source="Jessica Atreides" target="Analysis: The Arrakeen Crisis" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">it is generally accepted now that the Lady Jessica's latent abilities were grossly underestimated. -from "Analysis: The Arrakeen Crisis" by the Princess Irulan</data>
    </edge>
    <edge source="Jessica Atreides" target="Muad'Dib: Family Commentaries" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">-from "Muad'Dib: Family Commentaries" by the Princess Irulan</data>
    </edge>
    <edge source="Jessica Atreides" target="message" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">TO THE LADY JESSICA-May this place give you as much pleasure as it has given me.</data>
    </edge>
    <edge source="Jessica Atreides" target="Leto Atreides" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.8</data>
      <data key="d14">She's been with me for sixteen years!</data>
    </edge>
    <edge source="Jessica Atreides" target="Great Hall" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">In the Great Hall, the Lady Jessica was the center of a mixed group standing in front of the fireplace.</data>
    </edge>
    <edge source="Jessica Atreides" target="Great Hall" id="1">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">In the Great Hall, the Lady Jessica was the center of a mixed group standing in front of the fireplace.</data>
    </edge>
    <edge source="Jessica Atreides" target="dinner party" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">He escorted one of the young ladies home from the dinner, my Lady.</data>
    </edge>
    <edge source="Jessica Atreides" target="Duke Leto" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">The Duke could be destroyed as quickly by his friends as by his enemies," she said.</data>
    </edge>
    <edge source="Jessica Atreides" target="Hawat" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">There was no doubt in his mind who had betrayed them--the Lady Jessica</data>
    </edge>
    <edge source="Jessica Atreides" target="suspicions" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">feed his suspicions against the Lady Jessica</data>
    </edge>
    <edge source="Jessica Atreides" target="Summa" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">an excerpt from the Summa prepared by her own agents at the request of the Lady Jessica immediately after the Arrakis Affair</data>
    </edge>
    <edge source="Jessica Atreides" target="Baron Vladimir Harkonnen" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">Lady Jessica, was a natural daughter of the Baron Vladimir Harkonnen</data>
    </edge>
    <edge source="old woman" target="Jessica Atreides" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">The Lady Jessica was my serving wench, lad, for fourteen years at school.</data>
    </edge>
    <edge source="old woman" target="gom jabbar" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Withdraw the hand and I'll touch your neck with my gom jabbar</data>
    </edge>
    <edge source="old woman" target="pain by nerve induction" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"Pain by nerve induction," she said.</data>
    </edge>
    <edge source="gom jabbar" target="Paul Atreides" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">I hold at your neck the gom jabbar," she said. "The gom jabbar, the highhanded enemy.</data>
    </edge>
    <edge source="mother" target="Bene Gesserit Sisterhood" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">they had heard she was a Bene Gesserit</data>
    </edge>
    <edge source="Butlerian Jihad" target="Ancient Teachings" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">and finally, the Butlerian Jihad</data>
    </edge>
    <edge source="O.C. Bible" target="worlds" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">the O.C. Bible spread out through the worlds</data>
    </edge>
    <edge source="O.C. Bible" target="Azhar Book" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">O.C. Bible: "Any sin can be ascribed, at least in part, to a natural bad  tendency that is an extenuating circumstance acceptable to God." (The Azhar Book  traces this to the ancient Semitic Tawra.)</data>
    </edge>
    <edge source="Spacing Guild" target="schools" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">the Bene Gesserit and the Spacing Guild. The Guild, so we think, emphasizes almost pure mathematics.</data>
    </edge>
    <edge source="Spacing Guild" target="ecumenical meetings" id="0">
      <data key="d12">ENCOURAGED</data>
      <data key="d13">0.8</data>
      <data key="d14">It was a move encouraged by the Spacing Guild</data>
    </edge>
    <edge source="Spacing Guild" target="Bene Gesserit Sisterhood" id="0">
      <data key="d12">MADE_OVERTURES_TO</data>
      <data key="d13">0.9</data>
      <data key="d14">the Spacing Guild made overtures to the Bene Gesserit</data>
    </edge>
    <edge source="Spacing Guild" target="spice drug of Arrakis" id="0">
      <data key="d12">USES</data>
      <data key="d13">0.9</data>
      <data key="d14">its navigators, who use the spice drug of Arrakis</data>
    </edge>
    <edge source="Kwisatz Haderach" target="place" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">the place where only a Kwisatz Haderach may look.</data>
    </edge>
    <edge source="Kwisatz Haderach" target="Summa" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">an excerpt from the Summa prepared by her own agents at the request of the Lady Jessica immediately after the Arrakis Affair</data>
    </edge>
    <edge source="Baron Vladimir Harkonnen" target="Piter" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">"Come in, Piter."</data>
    </edge>
    <edge source="Baron Vladimir Harkonnen" target="Corps of Sardaukar" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">You'd enjoy seeing the Corps of Sardaukar pillage through my cities and sack this castle.</data>
    </edge>
    <edge source="Baron Vladimir Harkonnen" target="Feyd-Rautha" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">Uncle, do I have to stay?</data>
    </edge>
    <edge source="Baron Vladimir Harkonnen" target="Jessica Atreides" id="0">
      <data key="d12">PROMISED</data>
      <data key="d13">0.9</data>
      <data key="d14">You promised me the Lady Jessica. You promised her to me.</data>
    </edge>
    <edge source="Baron Vladimir Harkonnen" target="Barony" id="0">
      <data key="d12">LEADS</data>
      <data key="d13">0.9</data>
      <data key="d14">He aspires to rule my Barony, yet he cannot rule himself.</data>
    </edge>
    <edge source="Baron Vladimir Harkonnen" target="Leto Atreides" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.8</data>
      <data key="d14">The guns nibbled at the caves where the Duke's fighting men had retreated for a last-ditch stand.</data>
    </edge>
    <edge source="Baron Vladimir Harkonnen" target="Arrakeen" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">The Baron Vladimir Harkonnen stood at a viewport of the grounded lighter he was using as a command post. Out the port he saw the flame-lighted night of Arrakeen.</data>
    </edge>
    <edge source="Baron Vladimir Harkonnen" target="his fighting men" id="0">
      <data key="d12">LEADS</data>
      <data key="d13">0.8</data>
      <data key="d14">He pictured his fighting men as bees routing the rabbits.</data>
    </edge>
    <edge source="Baron Vladimir Harkonnen" target="Wellington Yueh" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">"Ah-h-h, Dr. Yueh." "M'Lord Harkonnen."</data>
    </edge>
    <edge source="Baron Vladimir Harkonnen" target="Duke" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">"You've given us the Duke, I hear."</data>
    </edge>
    <edge source="Baron Vladimir Harkonnen" target="Wanna" id="0">
      <data key="d12">LOVES</data>
      <data key="d13">0.7</data>
      <data key="d14">"You promised to deliver my Wanna from her agony."</data>
    </edge>
    <edge source="Baron Vladimir Harkonnen" target="Arrakis" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">the space frigate he had grounded on Arrakis</data>
    </edge>
    <edge source="Baron Vladimir Harkonnen" target="space frigate" id="0">
      <data key="d12">OWNS</data>
      <data key="d13">0.9</data>
      <data key="d14">the space frigate he had grounded on Arrakis</data>
    </edge>
    <edge source="Baron Vladimir Harkonnen" target="Iakin Nefud" id="0">
      <data key="d12">LEADS</data>
      <data key="d13">0.9</data>
      <data key="d14">"They are dead, Baron," said Iakin Nefud, the guard captain.</data>
    </edge>
    <edge source="Baron Vladimir Harkonnen" target="unknown" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.7</data>
      <data key="d14">The Baron Vladimir Harkonnen raged down the corridor from his private apartments, flitting through patches of late afternoon sunlight that poured down from high windows.</data>
    </edge>
    <edge source="Baron Vladimir Harkonnen" target="Mentat" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">"You may speak plainly with me, Hawat," the Baron rumbled.</data>
    </edge>
    <edge source="Baron Vladimir Harkonnen" target="private conference room" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">the red walls of this private conference room</data>
    </edge>
    <edge source="Baron Vladimir Harkonnen" target="Emperor" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.7</data>
      <data key="d14">the Emperor is in a ferment about some association between Arrakis and his mysterious prison planet.</data>
    </edge>
    <edge source="Baron Vladimir Harkonnen" target="Imperial audience chamber" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">The Baron Vladimir Harkonnen stood with eyes downcast in the Imperial audience chamber</data>
    </edge>
    <edge source="Baron Vladimir Harkonnen" target="Imperial Corps of Sardaukar" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.8</data>
      <data key="d14">the troop of House Sardaukar drawn up around the walls</data>
    </edge>
    <edge source="Piter" target="Baron" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">The Baron stared across the room at his Mental assassin</data>
    </edge>
    <edge source="Piter" target="Baron" id="1">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">"Truth without fear surprises the Baron," Piter said.</data>
    </edge>
    <edge source="Piter" target="Baron Vladimir Harkonnen" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">You'd like to see that, wouldn't you, Piter?" the Baron asked.</data>
    </edge>
    <edge source="Piter" target="Arrakeen" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.7</data>
      <data key="d14">He might've come directly from the Arrakeen labor pool.</data>
    </edge>
    <edge source="Piter" target="Leto Atreides" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.8</data>
      <data key="d14">"Piter de Vries," the Duke said. "A man of devilish cunning, my Lord," Hawat said.</data>
    </edge>
    <edge source="Piter" target="Mentat-Assassin" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">Piter de Vries, the Mentat-Assassin.</data>
    </edge>
    <edge source="Piter" target="Mentat" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">How could the Baron have made such an animal out of a Mentat?</data>
    </edge>
    <edge source="Piter" target="duchy" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">I will take the duchy</data>
    </edge>
    <edge source="Piter" target="Truthsayer" id="0">
      <data key="d12">FEARS</data>
      <data key="d13">0.8</data>
      <data key="d14">Jessica thought: He, too, fears the Truthsayer.</data>
    </edge>
    <edge source="Piter" target="Lady Jessica" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">Piter shrugged, turned, and went through the doorway. He hesitated there, and Jessica thought he might turn back for a last look at her, but he went out without turning.</data>
    </edge>
    <edge source="Piter" target="Wellington Yueh" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">The knife in his hand glistened like a claw as it flashed into Yueh's back.</data>
    </edge>
    <edge source="Piter" target="residual poison" id="0">
      <data key="d12">CREATED</data>
      <data key="d13">0.9</data>
      <data key="d14">the residual poison developed by the late Piter de Vries.</data>
    </edge>
    <edge source="Piter" target="Residual Poison" id="0">
      <data key="d12">CREATED</data>
      <data key="d13">0.9</data>
      <data key="d14">RESIDUAL POISON: an innovation attributed to the Mentat Piter de Vries</data>
    </edge>
    <edge source="Baron" target="Piter" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">"Observe closely, Piter, and you, too, FeydRautha, my darling"</data>
    </edge>
    <edge source="Baron" target="Piter" id="1">
      <data key="d12">HATES</data>
      <data key="d13">0.9</data>
      <data key="d14">I must do away with that one soon. He has almost outlived his usefulness.</data>
    </edge>
    <edge source="Baron" target="Piter" id="2">
      <data key="d12">LEADS</data>
      <data key="d13">0.9</data>
      <data key="d14">"I give you an order, Mentat. Perform one of your various functions."</data>
    </edge>
    <edge source="Baron" target="Piter" id="3">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">Damn that Piter!</data>
    </edge>
    <edge source="Baron" target="Feyd-Rautha Harkonnen" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">"Observe closely, Piter, and you, too, FeydRautha, my darling"</data>
    </edge>
    <edge source="Baron" target="Feyd-Rautha Harkonnen" id="1">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">"it is not necessary to confuse my nephew."</data>
    </edge>
    <edge source="Baron" target="Duke" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">The Duke must believe he's gaining a measure of security.</data>
    </edge>
    <edge source="Baron" target="Duke" id="1">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">the Duke will know, too. He knows now.</data>
    </edge>
    <edge source="Baron" target="Leto Atreides" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">"I have ofttimes met your treachery and this all men know."</data>
    </edge>
    <edge source="Baron" target="Feyd-Rautha" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">"Feyd," the Baron said. "I told you to listen and learn when I invited you in here. Are you learning?" "Yes, Uncle."</data>
    </edge>
    <edge source="Baron" target="Feyd-Rautha" id="1">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">"You see how I trust you, Feyd," the Baron said.</data>
    </edge>
    <edge source="Baron" target="Feyd-Rautha" id="2">
      <data key="d12">LOVES</data>
      <data key="d13">0.8</data>
      <data key="d14">A lovely boy, the Baron thought.</data>
    </edge>
    <edge source="Baron" target="Feyd-Rautha" id="3">
      <data key="d12">LEADS</data>
      <data key="d13">0.9</data>
      <data key="d14">At the Baron's elbow walked Feyd-Rautha.</data>
    </edge>
    <edge source="Baron" target="Feyd-Rautha" id="4">
      <data key="d12">HATES</data>
      <data key="d13">0.8</data>
      <data key="d14">"You do not consider Feyd-Rautha a danger to my person?"</data>
    </edge>
    <edge source="Baron" target="Feyd-Rautha" id="5">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.8</data>
      <data key="d14">You will cease these foolish attempts on my life.</data>
    </edge>
    <edge source="Baron" target="Feyd-Rautha" id="6">
      <data key="d12">PREPARING</data>
      <data key="d13">0.8</data>
      <data key="d14">I'm preparing another to take over Arrakis for me.</data>
    </edge>
    <edge source="Baron" target="Duke Leto" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">For myself, I can feel pity toward the poor Duke Leto. Dr. Yueh will move against him soon, and that'll be the end of all the Atreides.</data>
    </edge>
    <edge source="Baron" target="Paul Atreides" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">Dr. Yueh will move against him soon, and that'll be the end of all the Atreides.</data>
    </edge>
    <edge source="Baron" target="Paul Atreides" id="1">
      <data key="d12">DESTROYED</data>
      <data key="d13">0.9</data>
      <data key="d14">the Baron has destroyed the Atreides</data>
    </edge>
    <edge source="Baron" target="Paul Atreides" id="2">
      <data key="d12">HATES</data>
      <data key="d13">0.9</data>
      <data key="d14">Something like the hate I hold for this Baron.</data>
    </edge>
    <edge source="Baron" target="Emperor" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">Already you have the Emperor's eyes on you, Baron.</data>
    </edge>
    <edge source="Baron" target="Emperor" id="1">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">"As the Emperor wishes it," Rabban said. "As the Emperor wishes it."</data>
    </edge>
    <edge source="Baron" target="Emperor" id="2">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">The Emperor knows a certain amount of killing has always been an arm of business.</data>
    </edge>
    <edge source="Baron" target="Giedi Prime" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">One day the Emperor will send a legion or two of his Sardaukar down here onto Giedi Prime</data>
    </edge>
    <edge source="Baron" target="Barony" id="0">
      <data key="d12">OWNS</data>
      <data key="d13">0.9</data>
      <data key="d14">He aspires to rule my Barony, yet he cannot rule himself.</data>
    </edge>
    <edge source="Baron" target="witch mother" id="0">
      <data key="d12">HATES</data>
      <data key="d13">0.9</data>
      <data key="d14">with that witch mother training him. Accursed woman!</data>
    </edge>
    <edge source="Baron" target="Jessica Atreides" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">with that witch mother training him. Accursed woman!</data>
    </edge>
    <edge source="Baron" target="Jessica Atreides" id="1">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">However, I'm aware of your abilities.</data>
    </edge>
    <edge source="Baron" target="dispensation of that fief" id="0">
      <data key="d12">WILL_HAVE</data>
      <data key="d13">0.9</data>
      <data key="d14">Your uncle will have dispensation of that fief.</data>
    </edge>
    <edge source="Baron" target="Arrakis" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">He'll not permit you to untie her gag until you're off Arrakis.</data>
    </edge>
    <edge source="Baron" target="Arrakis" id="1">
      <data key="d12">OWNS</data>
      <data key="d13">0.8</data>
      <data key="d14">When last you ruled this place, I held you in strong rein.</data>
    </edge>
    <edge source="Baron" target="Arrakis" id="2">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Tell me, my dear Baron, have you investigated the southern polar regions of Arrakis?</data>
    </edge>
    <edge source="Baron" target="note" id="0">
      <data key="d12">CREATED</data>
      <data key="d13">0.9</data>
      <data key="d14">The note was under the Baron's own seal and I've authenticated the seal.</data>
    </edge>
    <edge source="Baron" target="Imperium" id="0">
      <data key="d12">LEADS</data>
      <data key="d13">0.7</data>
      <data key="d14">This woman and exile from the Imperium, or the Duchy of Atreides on Arrakis to rule as you see fit in my name.</data>
    </edge>
    <edge source="Baron" target="Imperium" id="1">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">For I direct his attention where I want it -- against the Imperium.</data>
    </edge>
    <edge source="Baron" target="Lady Jessica" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.8</data>
      <data key="d14">I hold no rancor toward you. It's a necessity.</data>
    </edge>
    <edge source="Baron" target="Lady Jessica" id="1">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">You're the Baron's own daughter</data>
    </edge>
    <edge source="Baron" target="guard" id="0">
      <data key="d12">LEADS</data>
      <data key="d13">0.9</data>
      <data key="d14">The guard I send you will take your orders</data>
    </edge>
    <edge source="Baron" target="REVEREND MOTHER" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.8</data>
      <data key="d14">It's as the Reverend Mother warned--too potent an adversary.</data>
    </edge>
    <edge source="Baron" target="Truthsayer" id="0">
      <data key="d12">FEARS</data>
      <data key="d13">0.8</data>
      <data key="d14">He fears the questioning of a Truthsayer, Jessica thought.</data>
    </edge>
    <edge source="Baron" target="House Harkonnen soldiers" id="0">
      <data key="d12">LEADS</data>
      <data key="d13">0.8</data>
      <data key="d14">The Baron he told me to make sure what happened to them two</data>
    </edge>
    <edge source="Baron" target="passage" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">reviewing the Baron's words</data>
    </edge>
    <edge source="Baron" target="Harkonnen" id="0">
      <data key="d12">LEADS</data>
      <data key="d13">0.9</data>
      <data key="d14">I must spend my own Harkonnen blood</data>
    </edge>
    <edge source="Baron" target="Wellington Yueh" id="0">
      <data key="d12">HATES</data>
      <data key="d13">0.8</data>
      <data key="d14">First, where is the traitor who gave me the Duke? the Baron asked. I must give the traitor his reward.</data>
    </edge>
    <edge source="Baron" target="traitor" id="0">
      <data key="d12">CREATED</data>
      <data key="d13">0.9</data>
      <data key="d14">Not even a traitor I created.</data>
    </edge>
    <edge source="Baron" target="woman and boy" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.8</data>
      <data key="d14">"What of the woman and the boy, Piter?" the Baron asked.</data>
    </edge>
    <edge source="Baron" target="Duke's men" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.8</data>
      <data key="d14">"One of the Duke's men obviously escaped in it, m'Lord. Killed our pilot and escaped."</data>
    </edge>
    <edge source="Baron" target="Hawat" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">Hawat will be given both food and drink," the Baron said.</data>
    </edge>
    <edge source="Baron" target="Hawat" id="1">
      <data key="d12">SAVED</data>
      <data key="d13">0.9</data>
      <data key="d14">I was the one who saved Hawat from the wreckage of Arrakis.</data>
    </edge>
    <edge source="Baron" target="Hawat" id="2">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">It would've worked, too, if Hawat hadn't warned me.</data>
    </edge>
    <edge source="Baron" target="Hawat" id="3">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">I'm setting Thufir Hawat to watch over you.</data>
    </edge>
    <edge source="Baron" target="Gurney Halleck" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.7</data>
      <data key="d14">And the fate of Hawat, Halleck, and Idaho remained an unknown.</data>
    </edge>
    <edge source="Baron" target="Duncan Idaho" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.7</data>
      <data key="d14">And the fate of Hawat, Halleck, and Idaho remained an unknown.</data>
    </edge>
    <edge source="Baron" target="doctor" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.8</data>
      <data key="d14">You killed the doctor too soon</data>
    </edge>
    <edge source="Baron" target="planet" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.7</data>
      <data key="d14">I've lived for a time on this planet, cher cousin.</data>
    </edge>
    <edge source="Baron" target="Umman Kudu" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">The Baron saw Umman Kudu, the guard captain, appear in the doorway</data>
    </edge>
    <edge source="Baron" target="EVENT" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">The Baron stood with his back against his private door, his own bolt hole behind the table. He had slammed it on a room full of dead men.</data>
    </edge>
    <edge source="Baron" target="EVENT" id="1">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"the Baron said."</data>
    </edge>
    <edge source="Baron" target="guards" id="0">
      <data key="d12">LEADS</data>
      <data key="d13">0.9</data>
      <data key="d14">He turned, was enveloped by guards as he stepped into the private exit from the box.</data>
    </edge>
    <edge source="Baron" target="Iakin Nefud" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">The Baron stared at the approaching man, recalling the name: Nefud. Iakin Nefud.</data>
    </edge>
    <edge source="Baron" target="Iakin Nefud" id="1">
      <data key="d12">LEADS</data>
      <data key="d13">0.9</data>
      <data key="d14">Do as your master has ordered</data>
    </edge>
    <edge source="Baron" target="Sardaukar" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.7</data>
      <data key="d14">The Sardaukar officers filled him with unease.</data>
    </edge>
    <edge source="Baron" target="Sardaukar" id="1">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.7</data>
      <data key="d14">The Sardaukar will want an observer with you during any . . . questioning.</data>
    </edge>
    <edge source="Baron" target="Harkonnen spice stores" id="0">
      <data key="d12">OWNS</data>
      <data key="d13">0.9</data>
      <data key="d14">the destruction of the Harkonnen spice stores there.</data>
    </edge>
    <edge source="Baron" target="young fellow" id="0">
      <data key="d12">OWNS</data>
      <data key="d13">0.9</data>
      <data key="d14">Bring me that young fellow we bought on Gamont</data>
    </edge>
    <edge source="Baron" target="Kynes" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">The man must die," the Baron rumbled. "He tried to help my enemies.</data>
    </edge>
    <edge source="Baron" target="Bene Gesserit" id="0">
      <data key="d12">HATES</data>
      <data key="d13">0.9</data>
      <data key="d14">It was all the doing of that Bene Gesserit witch.</data>
    </edge>
    <edge source="Baron" target="Rabban" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">My dear Rabban," the Baron said.</data>
    </edge>
    <edge source="Baron" target="Rabban" id="1">
      <data key="d12">HATES</data>
      <data key="d13">0.8</data>
      <data key="d14">Oh, how he'll be hated here on Arrakis!</data>
    </edge>
    <edge source="Baron" target="Rabban" id="2">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">Rabban stared at his uncle, suddenly frightened by the sound of those words. But the Baron smiled.</data>
    </edge>
    <edge source="Baron" target="Rabban" id="3">
      <data key="d12">LEADS</data>
      <data key="d13">0.9</data>
      <data key="d14">I give you different instructions about Arrakis this time, Nephew.</data>
    </edge>
    <edge source="Baron" target="House Harkonnen" id="0">
      <data key="d12">LEADS</data>
      <data key="d13">0.9</data>
      <data key="d14">the tool that House Harkonnen requires to gain the throne.</data>
    </edge>
    <edge source="Baron" target="Yueh" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">Doctor Yueh was a traitor. He gave me the Duke.</data>
    </edge>
    <edge source="Baron" target="CHOAM" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">My CHOAM Company directorship will bear the closest scrutiny</data>
    </edge>
    <edge source="Baron" target="Guild" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.7</data>
      <data key="d14">we bore the entire brunt of it. We even paid for transport of the Sardaukar.</data>
    </edge>
    <edge source="Baron" target="organization" id="0">
      <data key="d12">LEADS</data>
      <data key="d13">0.8</data>
      <data key="d14">you will assemble what remains of organization here</data>
    </edge>
    <edge source="Baron" target="spice" id="0">
      <data key="d12">OWNS</data>
      <data key="d13">0.9</data>
      <data key="d14">I've quite a stockpile of private stuff</data>
    </edge>
    <edge source="Baron" target="blue-walled keep" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">In the Baron's blue-walled keep</data>
    </edge>
    <edge source="Baron" target="Feyd-Rautha's thoughts" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">And he thought: Mark him well, Feyd! A killer with the manners of a rabbit--this is the most dangerous kind.</data>
    </edge>
    <edge source="Baron" target="Bene Gesserit Sisterhood" id="0">
      <data key="d12">HATES</data>
      <data key="d13">0.9</data>
      <data key="d14">Bene Gesserit! the Baron thought. The universe would be better rid of them all!</data>
    </edge>
    <edge source="Baron" target="Count Fenring" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">Perhaps we could have our little talk now, Count Fenring.</data>
    </edge>
    <edge source="Baron" target="Margot Fenring" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">And the Baron thought; Let us see now how the Emperors errand boy gets across whatever message he carries without ever being so crass as to speak it right out.</data>
    </edge>
    <edge source="Baron" target="Count" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.8</data>
      <data key="d14">He's deliberately trying to arouse my anger, the Baron thought.</data>
    </edge>
    <edge source="Baron" target="Count" id="1">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">casting covert glances at the Count beside him</data>
    </edge>
    <edge source="Baron" target="Arrakis as a prison planet" id="0">
      <data key="d12">CONSIDERS</data>
      <data key="d13">0.9</data>
      <data key="d14">it's reaching the point where I'm considering another solution to the Arrakeen problem</data>
    </edge>
    <edge source="Baron" target="Fenring" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">You must understand, Fenring, I was without a Mentat.</data>
    </edge>
    <edge source="Baron" target="Mentat" id="0">
      <data key="d12">OWNS</data>
      <data key="d13">0.9</data>
      <data key="d14">I've never been without a Mentat.</data>
    </edge>
    <edge source="Baron" target="Mentat" id="1">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.8</data>
      <data key="d14">I've sat across from many rulers of Great Houses, but never seen a more gross and dangerous pig than this one, Thufir Hawat told himself.</data>
    </edge>
    <edge source="Baron" target="Mentat" id="2">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">"First, you will tell me where you've sent your minion, Thufir Hawat."</data>
    </edge>
    <edge source="Baron" target="rid him of the troublesome Duke" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">I rid him of the troublesome Duke.</data>
    </edge>
    <edge source="Baron" target="arena gathering" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">It's time to go to the arena.</data>
    </edge>
    <edge source="Baron" target="arena gathering" id="1">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">A bell began a slow tolling somewhere in the keep--twenty-minute warning for the arena gathering.</data>
    </edge>
    <edge source="Baron" target="process verbal" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Process verbal!</data>
    </edge>
    <edge source="Baron" target="Count's lady" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.8</data>
      <data key="d14">the Count and his lady, both of whom were staring down at him</data>
    </edge>
    <edge source="Baron" target="slavemaster" id="0">
      <data key="d12">HATES</data>
      <data key="d13">0.9</data>
      <data key="d14">I'll have the slavemaster dead over a slow fire this night</data>
    </edge>
    <edge source="Baron" target="people" id="0">
      <data key="d12">LEADS</data>
      <data key="d13">0.8</data>
      <data key="d14">The Baron spoke wearily. "I shall have to order a fete. You cannot send people home like this, their energies unspent.</data>
    </edge>
    <edge source="Baron" target="apartments" id="0">
      <data key="d12">OWNS</data>
      <data key="d13">0.9</data>
      <data key="d14">scurried out the door and down the hall toward the Baron's apartments.</data>
    </edge>
    <edge source="Baron" target="Baron's apartments" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">They came into the Baron's apartments through the reception salon to the bedchamber.</data>
    </edge>
    <edge source="Baron" target="slave-gladiator" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">That slave-gladiator almost took you, didn't he?</data>
    </edge>
    <edge source="Baron" target="reports" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">And you certainly must've understood my reports from our agents.</data>
    </edge>
    <edge source="Baron" target="meeting in his great hall" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">he thought back to the meeting in his great hall.</data>
    </edge>
    <edge source="Baron" target="natives" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.8</data>
      <data key="d14">you can kill off the natives, wipe them out entirely</data>
    </edge>
    <edge source="Baron" target="summons" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"I came at your summons, Majesty."</data>
    </edge>
    <edge source="Baron" target="Muad'Dib" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.8</data>
      <data key="d14">attempt infiltrating the camp of the Fremen fanatic, this Muad'Dib.</data>
    </edge>
    <edge source="Baron" target="Muad'Dib" id="1">
      <data key="d12">KNOWS</data>
      <data key="d13">0.8</data>
      <data key="d14">"Do you have any idea who this Muad'Dib could be?" the Emperor asked. "One of the Umma, surely," the Baron said.</data>
    </edge>
    <edge source="Baron" target="Fremen" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">His people scream his name as they leap into battle. The women throw their babies at us and hurl themselves onto our knives to open a wedge for their men to attack us.</data>
    </edge>
    <edge source="Baron" target="Alia" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">I have her, Majesty! the Baron shouted. Shall I dispatch her noweeeeeeeeeeeh!</data>
    </edge>
    <edge source="Leto Atreides" target="Baron" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">'Your offer of a meeting is refused. I have ofttimes met your treachery and this all men know.'</data>
    </edge>
    <edge source="Leto Atreides" target="Arrakis" id="0">
      <data key="d12">LEADS</data>
      <data key="d13">0.9</data>
      <data key="d14">'Duke Leto of Arrakis.'</data>
    </edge>
    <edge source="Leto Atreides" target="Arrakis" id="1">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">There'll be no rest on Arrakis</data>
    </edge>
    <edge source="Leto Atreides" target="Arrakis" id="2">
      <data key="d12">PERSON</data>
      <data key="d13">0.9</data>
      <data key="d14">We make it here on Arrakis--win or die, Do you regret casting your lot with us, sir?</data>
    </edge>
    <edge source="Leto Atreides" target="Bene Gesserit lady" id="0">
      <data key="d12">LOVES</data>
      <data key="d13">0.9</data>
      <data key="d14">his abiding love for his Bene Gesserit lady</data>
    </edge>
    <edge source="Leto Atreides" target="Muad'Dib" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">Muad'Dib's father</data>
    </edge>
    <edge source="Leto Atreides" target="Paul Atreides" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">Paul watched his father enter the training room</data>
    </edge>
    <edge source="Leto Atreides" target="Paul Atreides" id="1">
      <data key="d12">LEADS</data>
      <data key="d13">0.9</data>
      <data key="d14">her lost Duke that he would accept a large sum offered for his support in a questionable venture--because money maintained power for the Atreides.</data>
    </edge>
    <edge source="Leto Atreides" target="crossing to Arrakis" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">I must use every opportunity to rest during the crossing to Arrakis</data>
    </edge>
    <edge source="Leto Atreides" target="Muad'Dib, Family Commentaries" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">-from "Muad'Dib, Family Commentaries" by the Princess Irulan</data>
    </edge>
    <edge source="Leto Atreides" target="Arrakeen" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.8</data>
      <data key="d14">Leto had been wise to choose this place for his seat of government.</data>
    </edge>
    <edge source="Leto Atreides" target="Arrakeen" id="1">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">The Duke Leto Atreides leaned against a parapet of the landing control tower outside Arrakeen.</data>
    </edge>
    <edge source="Leto Atreides" target="painting of Leto's father" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">faced the painting of Leto's father.</data>
    </edge>
    <edge source="Leto Atreides" target="royal blood" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">Leto is a cousin of the royal blood</data>
    </edge>
    <edge source="Leto Atreides" target="the rooms" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Leto's right--these rooms are nicer than the ones in the other sections of the house.</data>
    </edge>
    <edge source="Leto Atreides" target="frigates" id="0">
      <data key="d12">OWNS</data>
      <data key="d13">0.9</data>
      <data key="d14">five of his own frigates were posted around the rim like monolithic sentries.</data>
    </edge>
    <edge source="Leto Atreides" target="possession of this planet" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"Our Sublime Padishah Emperor has charged me to take possession of this planet and end all dispute."</data>
    </edge>
    <edge source="Leto Atreides" target="Harkonnen" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.8</data>
      <data key="d14">and were Harkonnen creatures almost to a man.</data>
    </edge>
    <edge source="Leto Atreides" target="Muad'Dib: Family Commentaries" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">-from "Muad'Dib: Family Commentaries" by the Princess Irulan</data>
    </edge>
    <edge source="Leto Atreides" target="Duke" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">Leto spoke impatiently</data>
    </edge>
    <edge source="Leto Atreides" target="staff conference" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">having been brought to the ducal command post to participate in his father's first full staff conference.</data>
    </edge>
    <edge source="Leto Atreides" target="Gurney Halleck" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">Halleck asked</data>
    </edge>
    <edge source="Leto Atreides" target="Hawat" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">The Duke turned to Hawat</data>
    </edge>
    <edge source="Leto Atreides" target="consent of the governed" id="0">
      <data key="d12">RULES_WITH</data>
      <data key="d13">0.9</data>
      <data key="d14">It is said that the Duke Leto Atreides rules with the consent of the governed</data>
    </edge>
    <edge source="Leto Atreides" target="Fremen" id="0">
      <data key="d12">RESPECTS</data>
      <data key="d13">0.9</data>
      <data key="d14">Sir, I honor and respect the personal dignity of any man who respects my dignity.</data>
    </edge>
    <edge source="Leto Atreides" target="Sire" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">"We've much to do, Sire," Halleck said.</data>
    </edge>
    <edge source="Leto Atreides" target="Jessica Atreides" id="0">
      <data key="d12">LOVES</data>
      <data key="d13">0.8</data>
      <data key="d14">I know my woman.</data>
    </edge>
    <edge source="Leto Atreides" target="House Harkonnen" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">Because the Harkonnens think to trick me by making me distrust your mother.</data>
    </edge>
    <edge source="Leto Atreides" target="mother" id="0">
      <data key="d12">LOVES</data>
      <data key="d13">0.8</data>
      <data key="d14">They don't know that I'd sooner distrust myself.</data>
    </edge>
    <edge source="Leto Atreides" target="mother" id="1">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.7</data>
      <data key="d14">They don't know that I'd sooner distrust myself.</data>
    </edge>
    <edge source="Leto Atreides" target="Padishah Emperor" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.8</data>
      <data key="d14">my father secretly wished the Duke had been his son, and disliked the political necessities that made them enemies.</data>
    </edge>
    <edge source="Leto Atreides" target="Kynes" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">"We are indebted to you, Dr. Kynes," Leto said.</data>
    </edge>
    <edge source="Leto Atreides" target="Emperor" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.8</data>
      <data key="d14">you report to the Emperor on the change of government here</data>
    </edge>
    <edge source="Leto Atreides" target="fief" id="0">
      <data key="d12">LEADS</data>
      <data key="d13">0.8</data>
      <data key="d14">this is now my fief</data>
    </edge>
    <edge source="Leto Atreides" target="Spotter credit" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"Spotter credit to the Duke Leto Atreides. The Duke Leto Atreides. Over."</data>
    </edge>
    <edge source="Leto Atreides" target="worm warning" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"Tell them who had first sight of that worm," Halleck said. The Duke nodded.</data>
    </edge>
    <edge source="Leto Atreides" target="Lady Jessica" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">As Leto approached Jessica's group</data>
    </edge>
    <edge source="Leto Atreides" target="Lady Jessica" id="1">
      <data key="d12">LOVES</data>
      <data key="d13">0.9</data>
      <data key="d14">He wanted you to know he always trusted you completely, always loved you and cherished you.</data>
    </edge>
    <edge source="Leto Atreides" target="Lady Jessica" id="2">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">Should I waken Jessica? he wondered.</data>
    </edge>
    <edge source="Leto Atreides" target="dinner" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">The custom here is for host and hostess to follow their guests to table," She said, and smiled</data>
    </edge>
    <edge source="Leto Atreides" target="Mentat" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">Leto, watching the guests file past, recalled what Thufir Hawat had said when informed of the affair</data>
    </edge>
    <edge source="Leto Atreides" target="house troopers" id="0">
      <data key="d12">LEADS</data>
      <data key="d13">0.9</data>
      <data key="d14">He gave a hand signal, and the house troopers in footman uniform around the table stepped back, standing at attention.</data>
    </edge>
    <edge source="Leto Atreides" target="passage" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Leto lifted his water flagon, held it aloft where the suspensor, lights shot beams of reflection off it.</data>
    </edge>
    <edge source="Leto Atreides" target="his house" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Leto stood in the foyer of his house</data>
    </edge>
    <edge source="Leto Atreides" target="Duncan Idaho" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">Blast and damn that Duncan Idaho!</data>
    </edge>
    <edge source="Leto Atreides" target="Great Hall" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">gh the  Great Hall and down the passages toward the family wing.</data>
    </edge>
    <edge source="Leto Atreides" target="service passage" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Softly, the Duke moved down the service passage</data>
    </edge>
    <edge source="Leto Atreides" target="Mapes" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">darted down the passage, crouched beside the crawling figure. It was Mapes, the Fremen housekeeper</data>
    </edge>
    <edge source="Leto Atreides" target="Baron Vladimir Harkonnen" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.8</data>
      <data key="d14">You will get close to the Baron before you die.</data>
    </edge>
    <edge source="Leto Atreides" target="A Child's History of Muad'Dib" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">the Princess Irulan: "Introduction to A Child's History of Muad'Dib"</data>
    </edge>
    <edge source="Leto Atreides" target="death" id="0">
      <data key="d12">EVENT</data>
      <data key="d13">0.9</data>
      <data key="d14">the instant the Duke Leto Atreides died a meteor streaked across the skies above his ancestral palace on Caladan.</data>
    </edge>
    <edge source="Leto Atreides" target="Piter" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.7</data>
      <data key="d14">A silky voice, that one. That was Piter. "So I see, Piter." A rumbling basso: the Baron.</data>
    </edge>
    <edge source="Leto Atreides" target="Paul Muad'Dib" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">"Does our Leto yet hold my mother in his palm?"</data>
    </edge>
    <edge source="Leto Atreides" target="Alia" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">"It's Alia he holds as well," she said.</data>
    </edge>
    <edge source="Feyd-Rautha" target="Baron Vladimir Harkonnen" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">Uncle, do I have to stay?</data>
    </edge>
    <edge source="Feyd-Rautha" target="Baron" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">"Listen to my nephew," the Baron said.</data>
    </edge>
    <edge source="Feyd-Rautha" target="Baron" id="1">
      <data key="d12">LOVES</data>
      <data key="d13">0.7</data>
      <data key="d14">Then--they will welcome my darling Feyd-Rautha as a savior.</data>
    </edge>
    <edge source="Feyd-Rautha" target="Baron" id="2">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.8</data>
      <data key="d14">The Baron scowled, seeing the way Feyd-Rautha turned to him.</data>
    </edge>
    <edge source="Feyd-Rautha" target="Baron" id="3">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">Feyd-Rautha had his own spy system focused on the Baron.</data>
    </edge>
    <edge source="Feyd-Rautha" target="Baron" id="4">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">Feyd has beaten the slavemaster at cheops.</data>
    </edge>
    <edge source="Feyd-Rautha" target="A Child's History of Muad'Dib" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">-from "A Child's History of Muad'Dib" by the Princess Irulan</data>
    </edge>
    <edge source="Feyd-Rautha" target="family games" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">On his seventeenth birthday, Feyd-Rautha Harkonnen killed his one hundredth slave-gladiator in the family games.</data>
    </edge>
    <edge source="Feyd-Rautha" target="Harkonnen" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">Feyd-Rautha Harkonnen</data>
    </edge>
    <edge source="Feyd-Rautha" target="Harkonnen" id="1">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.7</data>
      <data key="d14">"He could walk unarmed and unshielded through the poorest quarters of Harko tonight," the Baron said.</data>
    </edge>
    <edge source="Feyd-Rautha" target="Giedi Prime" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">the Harkonnen homeworld of Giedi Prime</data>
    </edge>
    <edge source="Feyd-Rautha" target="Vladimir Harkonnen" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.8</data>
      <data key="d14">At the Baron's elbow walked Feyd-Rautha.</data>
    </edge>
    <edge source="Feyd-Rautha" target="Vladimir Harkonnen" id="1">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">Title passed briefly to the na-Baron, Feyd-Rautha Harkonnen.</data>
    </edge>
    <edge source="Feyd-Rautha" target="Baron's speech" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">The Baron stopped in front of them, took Feyd-Rautha's arm in a possessive grip, said, "My nephew, the na-Baron, Feyd-Rautha Harkonnen."</data>
    </edge>
    <edge source="Feyd-Rautha" target="arena" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">I understand he's to appear in the arena today</data>
    </edge>
    <edge source="Feyd-Rautha" target="Margot Fenring" id="0">
      <data key="d12">LOVES</data>
      <data key="d13">0.7</data>
      <data key="d14">By the houris of the Imperial hareem, she's a lovely one! Feyd-Rautha thought</data>
    </edge>
    <edge source="Feyd-Rautha" target="Margot Fenring" id="1">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">Feyd-Rautha turned his attention back to the Lady Fenring</data>
    </edge>
    <edge source="Feyd-Rautha" target="Margot Fenring" id="2">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.8</data>
      <data key="d14">The greeting cheer lifted from the family galleries, and Feyd-Rautha paused to accept it, looking up and scanning the faces--seeing his cousines and cousins, the demibrothers, the concubines and out-freyn relations.</data>
    </edge>
    <edge source="Feyd-Rautha" target="Count Fenring" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">He nodded to Count Fenring</data>
    </edge>
    <edge source="Feyd-Rautha" target="Count" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.8</data>
      <data key="d14">The greeting cheer lifted from the family galleries, and Feyd-Rautha paused to accept it, looking up and scanning the faces--seeing his cousines and cousins, the demibrothers, the concubines and out-freyn relations.</data>
    </edge>
    <edge source="Feyd-Rautha" target="troupe" id="0">
      <data key="d12">LEADS</data>
      <data key="d13">0.9</data>
      <data key="d14">Feyd-Rautha led his troupe across the arena for obeisance at the foot of his uncle's box.</data>
    </edge>
    <edge source="Feyd-Rautha" target="Mentat" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">"Your own Thufir Hawat taught me some of my skills," Feyd-Rautha said.</data>
    </edge>
    <edge source="Feyd-Rautha" target="gladiator fight" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Feyd-Rautha focused all his awareness on the door. This first moment was the critical one.</data>
    </edge>
    <edge source="Feyd-Rautha" target="Duke Leto's fighting men" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.8</data>
      <data key="d14">It's one of Duke Leto's fighting men we took on Arrakis! Feyd-Rautha thought.</data>
    </edge>
    <edge source="Feyd-Rautha" target="Hawat" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.8</data>
      <data key="d14">And he wondered if Hawat had another plan for this arena</data>
    </edge>
    <edge source="Feyd-Rautha" target="gladiator" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">Hai, Harkonnen! the slave called. Are you prepared to die?</data>
    </edge>
    <edge source="Feyd-Rautha" target="fight" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">There could be no interference with this fight.</data>
    </edge>
    <edge source="Feyd-Rautha" target="slave" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">This slave should have been partly crippled by drug-induced terror.</data>
    </edge>
    <edge source="Feyd-Rautha" target="na-Baron" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">You'll get a true chance to kill the na-Baron.</data>
    </edge>
    <edge source="Feyd-Rautha" target="uncle" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.7</data>
      <data key="d14">He knew now what his uncle was experiencing</data>
    </edge>
    <edge source="Feyd-Rautha" target="uncle" id="1">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">Hypno-ligation of that Feyd-Rautha's psyche and his child in my womb--then we go. "That uncle," he said.</data>
    </edge>
    <edge source="Feyd-Rautha" target="show" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">I'll give them a show such as they've never had before</data>
    </edge>
    <edge source="Feyd-Rautha" target="cheers" id="0">
      <data key="d12">LOVES</data>
      <data key="d13">0.7</data>
      <data key="d14">They cheer me now, Feyd-Rautha thought</data>
    </edge>
    <edge source="Feyd-Rautha" target="family" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.8</data>
      <data key="d14">I am their enemy: let them think of me as they see me now.</data>
    </edge>
    <edge source="Feyd-Rautha" target="family" id="1">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.8</data>
      <data key="d14">Now, let my dear family watch, Feyd-Rautha thought.</data>
    </edge>
    <edge source="Feyd-Rautha" target="fete" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"In your honor, Feyd!" the Baron called down.</data>
    </edge>
    <edge source="Feyd-Rautha" target="nephew" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">"He's pretty fierce," she said, "but the nephew could well grow to be worse."</data>
    </edge>
    <edge source="Feyd-Rautha" target="slave quarters" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"Feyd-Rautha's in the slave quarters, my Lord."</data>
    </edge>
    <edge source="Feyd-Rautha" target="cheops" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"I've been playing cheops with the slavemaster," Feyd-Rautha said</data>
    </edge>
    <edge source="Feyd-Rautha" target="Arrakis" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Your Feyd-Rautha can go to Arrakis as their savior.</data>
    </edge>
    <edge source="Feyd-Rautha" target="House Harkonnen" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">Feyd-Rautha Harkonnen is with them.</data>
    </edge>
    <edge source="Feyd-Rautha" target="Paul Atreides" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">"Why prolong the inevitable? You but keep me from exercising my rights over this ball of dirt."</data>
    </edge>
    <edge source="Feyd-Rautha" target="Imperial company" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">"Anyone accepted into the Imperial company is a member of my entourage."</data>
    </edge>
    <edge source="Feyd-Rautha" target="Emperor's entourage" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">"If Feyd-Rautha Harkonnen . . . of my entourage . . . so wishes," he said, "I relieve him of all restraint and give him freedom to choose his own course in this."</data>
    </edge>
    <edge source="Feyd-Rautha" target="kanly ritual" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"Is the Atreides ready?" Feyd-Rautha called, using the words of the ancient kanly ritual.</data>
    </edge>
    <edge source="Feyd-Rautha" target="duel" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Again, they circled, probing.</data>
    </edge>
    <edge source="Feyd-Rautha" target="Abulurd" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">were legal sons of the Siridar-Baron's youngest demibrother, Abulurd</data>
    </edge>
    <edge source="Sardaukar" target="Emperor" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">One day the Emperor will send a legion or two of his Sardaukar down here onto Giedi Prime</data>
    </edge>
    <edge source="Sardaukar" target="Emperor" id="1">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">I hide nothing from my Emperor.</data>
    </edge>
    <edge source="Sardaukar" target="end to the Baron Vladimir Harkonnen" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">One day the Emperor will send a legion or two of his Sardaukar down here onto Giedi Prime and that'll be an end to the Baron Vladimir Harkonnen.</data>
    </edge>
    <edge source="Sardaukar" target="Harkonnen" id="0">
      <data key="d12">DISGUISED_AS</data>
      <data key="d13">0.9</data>
      <data key="d14">Disguised in Harkonnen livery, no doubt," the Duke said.</data>
    </edge>
    <edge source="Sardaukar" target="Harkonnen" id="1">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">Those were Sardaukar in Harkonnen uniform</data>
    </edge>
    <edge source="Sardaukar" target="Imperial Corps" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">the military forces of the Landsraad Great Houses on one side, the Sardaukar and their supporting levies on the other</data>
    </edge>
    <edge source="Sardaukar" target="House Harkonnen" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"They'll be here with Sardaukar disguised as Harkonnens at the first opportunity."</data>
    </edge>
    <edge source="Sardaukar" target="Duke" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">"Is this the Duke?" "This is the Duke."</data>
    </edge>
    <edge source="Sardaukar" target="Duke" id="1">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.8</data>
      <data key="d14">The Sardaukar spurned the Duke with his toe.</data>
    </edge>
    <edge source="Sardaukar" target="Old Duke Atreides" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">My men brought you the Atreides Duke before I could discuss his fate with you.</data>
    </edge>
    <edge source="Sardaukar" target="Paul Atreides" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">Watch out for Sardaukar in Atreides uniforms</data>
    </edge>
    <edge source="Sardaukar" target="Imperial" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">the soldierfanatics and the Imperial treachery they represented</data>
    </edge>
    <edge source="Sardaukar" target="Fremen" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">Sardaukar at every gun</data>
    </edge>
    <edge source="Sardaukar" target="Fremen" id="1">
      <data key="d12">HATES</data>
      <data key="d13">0.8</data>
      <data key="d14">They needed practice in killing . . . and they hate to see a task left undone.</data>
    </edge>
    <edge source="Sardaukar" target="EVENT" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">the hard competence of Sardaukar</data>
    </edge>
    <edge source="Sardaukar" target="EVENT" id="1">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">The Sardaukar approached the waiting group of Fremen in an enclosing halfcircle.</data>
    </edge>
    <edge source="Sardaukar" target="Arrakis" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">The Sardaukar on Arrakis</data>
    </edge>
    <edge source="Sardaukar" target="Arrakis" id="1">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">the Sardaukar raging off their planet to spread pogrom on Arrakis</data>
    </edge>
    <edge source="Sardaukar" target="subjugation of this Fremen nest" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">there were Sardaukar with our forces in the subjugation of this Fremen nest.</data>
    </edge>
    <edge source="Sardaukar" target="Mentat" id="0">
      <data key="d12">HAS</data>
      <data key="d13">0.9</data>
      <data key="d14">The Sardaukar have . . . two persons in custody who might be of interest to you. They've caught the Duke's Master of Assassins.</data>
    </edge>
    <edge source="Sardaukar" target="House-to-House battle" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">The Sardaukar had no part in it, you understand?</data>
    </edge>
    <edge source="Sardaukar" target="battle with your Fremen scum" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Sardaukar commanders could be found who'd confess they acted without orders because they wanted a battle with your Fremen scum</data>
    </edge>
    <edge source="Sardaukar" target="us" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.8</data>
      <data key="d14">The Sardaukar hunt us</data>
    </edge>
    <edge source="Sardaukar" target="exploits" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">The stories you hear about the exploits of the Sardaukar, they're not rumors, are they?</data>
    </edge>
    <edge source="Sardaukar" target="killed twenty thousand" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">You say the Sardaukar accounted for another twenty thousand</data>
    </edge>
    <edge source="Sardaukar" target="Salusa Secundus" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">The recruits come to believe in time that such a place as Salusa Secundus is justified because it produced them -- the elite.</data>
    </edge>
    <edge source="Sardaukar" target="Great House" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.8</data>
      <data key="d14">The commonest Sardaukar trooper lives a life, in many respects, as exalted as that of any member of a Great House.</data>
    </edge>
    <edge source="Sardaukar" target="Padishah Emperor" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">the temporary lodging place for five legions of Sardaukar and His Imperial Majesty, the Padishah Emperor Shaddam IV</data>
    </edge>
    <edge source="Sardaukar" target="city people" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">They grabbed some city women for their sport, decorated their battle standards with the heads of the men who objected.</data>
    </edge>
    <edge source="Giedi Prime" target="Ophiuchi B (36)" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">GIEDI PRIME: the planet of Ophiuchi B (36)</data>
    </edge>
    <edge source="Giedi Prime" target="House Harkonnen" id="0">
      <data key="d12">HOMEWORLD_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">homeworld of House Harkonnen</data>
    </edge>
    <edge source="Giedi Prime" target="Inkvine" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">INKVINE: a creeping plant native to Giedi Prime</data>
    </edge>
    <edge source="Arrakeen" target="Arrakis" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">No planet of this system grew trees to make such beams -- unless the beams were imitation wood.</data>
    </edge>
    <edge source="Arrakeen" target="Broken Land" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.7</data>
      <data key="d14">a cheap and brassy place some two hundred kilometers northeast across the Broken Land.</data>
    </edge>
    <edge source="Arrakeen" target="great house" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">In the dining hall of the Arrakeen great house</data>
    </edge>
    <edge source="Arrakeen" target="LOCATION" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">some two hundred kilometers southeast of Arrakeen</data>
    </edge>
    <edge source="Great House" target="Arrakis" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">House Atreides will go to Arrakis</data>
    </edge>
    <edge source="Great House" target="spice" id="0">
      <data key="d12">OWNS</data>
      <data key="d13">0.9</data>
      <data key="d14">transport the spice for House Atreides</data>
    </edge>
    <edge source="Count Fenring" target="Residency" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">the Residency, lately the home of Count and Lady Fenring</data>
    </edge>
    <edge source="Count Fenring" target="Ambassador to the Smugglers" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">He calls Count Fenring Ambassador to the Smugglers</data>
    </edge>
    <edge source="Count Fenring" target="Giedi Prime" id="0">
      <data key="d12">VISITED</data>
      <data key="d13">0.9</data>
      <data key="d14">Visiting observers from the Imperial Court-a Count and Lady Fenring--were on the Harkonnen homeworld of Giedi Prime for the event</data>
    </edge>
    <edge source="Count Fenring" target="Baron" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">Ah-h-h, here comes the Baron," the Count said.</data>
    </edge>
    <edge source="Count Fenring" target="his lady" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">Count Fenring and his lady</data>
    </edge>
    <edge source="Count Fenring" target="Baron's speech" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"I told my nephew of the great esteem our Emperor holds for you. Count Fenring," the Baron said.</data>
    </edge>
    <edge source="Count Fenring" target="Feyd-Rautha's thoughts" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">The young man focused his attention on the Count: a small man, weak-looking. The face was weaselish with overlarge dark eyes.</data>
    </edge>
    <edge source="Count Fenring" target="Margot Fenring" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">The Count spoke to his lady: "Um-m-m-m-ah-h-h-hm-m-m, you mm-m will ah-h-h excuse us, my dear?"</data>
    </edge>
    <edge source="Count Fenring" target="Houses Minor" id="0">
      <data key="d12">LEADS</data>
      <data key="d13">0.9</data>
      <data key="d14">"The Houses Minor wait for you to lead them," the Count said, nodding toward the people they approached.</data>
    </edge>
    <edge source="Count Fenring" target="Imperial Court" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">the Fenrings, the observers from the Imperial Court</data>
    </edge>
    <edge source="Count Fenring" target="lady" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">Count Fenring faced his lady, spoke again in their personal humming-code tongue</data>
    </edge>
    <edge source="Count Fenring" target="lady" id="1">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">Count Fenring faced his lady</data>
    </edge>
    <edge source="Count Fenring" target="Baron's nephew's birthday" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">At my nephew's birthday several years ago," the Baron said. "This Imperial popinjay. Count Fenring, came as official observer</data>
    </edge>
    <edge source="Count Fenring" target="business arrangement between the Emperor and Baron" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Count Fenring, came as official observer and to . . . ah, conclude a business arrangement between the Emperor and myself.</data>
    </edge>
    <edge source="Count Fenring" target="Emperor" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">The Emperor's errand boy, Paul thought.</data>
    </edge>
    <edge source="Count Fenring" target="Emperor" id="1">
      <data key="d12">FRIENDS_WITH</data>
      <data key="d13">0.8</data>
      <data key="d14">The thought lay there clearly between them, their association so long that understanding could be achieved with a glance.</data>
    </edge>
    <edge source="Count Fenring" target="Paul Atreides" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.7</data>
      <data key="d14">Slowly, Fenring moved his head, a prolonged turning until he faced Paul.</data>
    </edge>
    <edge source="Count Fenring" target="Imperial Agent on Arrakis" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Count Fenring included that of Imperial Agent on Arrakis during the Harkonnen regime</data>
    </edge>
    <edge source="Count Fenring" target="Siridar-Absentia of Caladan" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">later Siridar-Absentia of Caladan</data>
    </edge>
    <edge source="Count Fenring" target="Emperor Shaddam Corrino IV" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">He joined Shaddam IV in retirement on Salusa Secundus</data>
    </edge>
    <edge source="Guild" target="Imperial" id="0">
      <data key="d12">OUTSIDE_CONTROL_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">As long as the Guild remains effectively outside Imperial control</data>
    </edge>
    <edge source="Guild" target="monopoly on interstellar transport" id="0">
      <data key="d12">OWNS</data>
      <data key="d13">0.9</data>
      <data key="d14">the Guild with its damnable monopoly on interstellar transport.</data>
    </edge>
    <edge source="Guild" target="Heighliner" id="0">
      <data key="d12">OWNS</data>
      <data key="d13">0.9</data>
      <data key="d14">We'll be riding a Heighliner because it's a long trip.</data>
    </edge>
    <edge source="Guild" target="House Harkonnen" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.8</data>
      <data key="d14">There could be Harkonnen ships right alongside us and we'd have nothing to fear from them.</data>
    </edge>
    <edge source="Guild" target="Leto Atreides" id="0">
      <data key="d12">ORGANIZATION</data>
      <data key="d13">0.9</data>
      <data key="d14">The Guild agent wasn't really negotiating with us.</data>
    </edge>
    <edge source="Guild" target="Arrakis" id="0">
      <data key="d12">ORGANIZATION</data>
      <data key="d13">0.9</data>
      <data key="d14">The Guild agent wasn't really negotiating with us.</data>
    </edge>
    <edge source="Guild" target="Arrakis" id="1">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">The Guild will strand on Arrakis any force that lands without permission.</data>
    </edge>
    <edge source="Guild" target="passage" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">The Guild--there' d be a way for us, my strangeness accepted as a familiar thing of high value, always with an assured supply of the nownecessary spice.</data>
    </edge>
    <edge source="Guild" target="probing raids" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">the Guild for probing raids</data>
    </edge>
    <edge source="Guild" target="monopoly on space" id="0">
      <data key="d12">OWNS</data>
      <data key="d13">0.9</data>
      <data key="d14">The damnable Guild monopoly on space</data>
    </edge>
    <edge source="Guild" target="free traders" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.8</data>
      <data key="d14">for the cursed Guild . . . may their faces be forever black.</data>
    </edge>
    <edge source="Guild" target="Stilgar" id="0">
      <data key="d12">BRIBED_BY</data>
      <data key="d13">0.9</data>
      <data key="d14">We bribe the Guild with a monstrous payment in spice</data>
    </edge>
    <edge source="Guild" target="plotting" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">the Guild conniving and plotting</data>
    </edge>
    <edge source="Guild" target="tales" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">The Guild itself caused this by spreading tales about what we do here</data>
    </edge>
    <edge source="Guild" target="embargo against Arrakis" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">threatening an embargo against Arrakis.</data>
    </edge>
    <edge source="Guild" target="Guild navigators" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">"Guild navigators, both of you, eh?" "Yes!"</data>
    </edge>
    <edge source="Guild" target="Guildsman" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">the taller Guildsman said</data>
    </edge>
    <edge source="Guild" target="monopoly" id="0">
      <data key="d12">OWNS</data>
      <data key="d13">0.9</data>
      <data key="d14">before the Guild monopoly</data>
    </edge>
    <edge source="Guild" target="Landsraad" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">The major dams against anarchy in these times were the embryo Guild, the Bene Gesserit and the Landsraad, which continued its 2,000-year record of meeting in spite of the severest obstacles.</data>
    </edge>
    <edge source="Guild" target="Landsraad" id="1">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">The Guild's part appears clear: they gave free transport for all Landsraad and C.E.T. business.</data>
    </edge>
    <edge source="Guild" target="Great Convention" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">the Guild, the Great Houses, and the Imperium</data>
    </edge>
    <edge source="Guild" target="Great Convention" id="1">
      <data key="d12">LEADS</data>
      <data key="d13">0.9</data>
      <data key="d14">The Guild was the second mental-physical training school</data>
    </edge>
    <edge source="Guild" target="monopoly on space travel and transport and upon international banking" id="0">
      <data key="d12">OWNS</data>
      <data key="d13">0.9</data>
      <data key="d14">The Guild monopoly on space travel and transport and upon international banking</data>
    </edge>
    <edge source="Guild" target="Spacing Guild" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">SPACING GUILD: see Guild.</data>
    </edge>
    <edge source="Guild" target="Tupile" id="0">
      <data key="d12">MAINTAINS</data>
      <data key="d13">0.9</data>
      <data key="d14">Location(s) known only to the Guild and maintained inviolate under the Guild Peace</data>
    </edge>
    <edge source="Hawat" target="Jessica Atreides" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">Hawat's mind will be so filled with this prospect it'll impair his function as a Mentat. He may even try to kill her.</data>
    </edge>
    <edge source="Hawat" target="Paul Atreides" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">Hawat pulled up a chair across from Paul</data>
    </edge>
    <edge source="Hawat" target="Paul Atreides" id="1">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">a tall man in Atreides uniform with a Hawat insignia on his cap</data>
    </edge>
    <edge source="Hawat" target="Paul Atreides" id="2">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">aware that the old man had served three generations of Atreides.</data>
    </edge>
    <edge source="Hawat" target="Paul Atreides" id="3">
      <data key="d12">LOYAL_TO</data>
      <data key="d13">0.9</data>
      <data key="d14">You're going to say Hawat's completely loyal to the Atreides.</data>
    </edge>
    <edge source="Hawat" target="test Paul" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">Did my father send you up to test me?</data>
    </edge>
    <edge source="Hawat" target="Duke Leto Atreides" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">I tell you only as your father's helper.</data>
    </edge>
    <edge source="Hawat" target="Arrakis" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Hawat stood up. "I leave today for Arrakis.</data>
    </edge>
    <edge source="Hawat" target="Duke" id="0">
      <data key="d12">AGREES_WITH</data>
      <data key="d13">0.9</data>
      <data key="d14">Hawat agrees, Son. It's true.</data>
    </edge>
    <edge source="Hawat" target="Duke" id="1">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">Hawat told me that house was secure!</data>
    </edge>
    <edge source="Hawat" target="Duke" id="2">
      <data key="d12">FRIENDS_WITH</data>
      <data key="d13">0.8</data>
      <data key="d14">This is the man of honor who deserves every bit of my loyalty and service</data>
    </edge>
    <edge source="Hawat" target="Duke" id="3">
      <data key="d12">LOYAL_TO</data>
      <data key="d13">0.9</data>
      <data key="d14">your loyalty to the Duke is all that guarantees your safety with me.</data>
    </edge>
    <edge source="Hawat" target="My Lord" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">Hawat already has our own poison snooper over the dining table</data>
    </edge>
    <edge source="Hawat" target="my Lord" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">Hawat's men have been over it in depth.</data>
    </edge>
    <edge source="Hawat" target="Harkonnen bravos" id="0">
      <data key="d12">BUSY_WITH</data>
      <data key="d13">0.9</data>
      <data key="d14">The good Thufir is even busier than I am. You know this planet's infested with Harkonnen intrigues.</data>
    </edge>
    <edge source="Hawat" target="passage" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Hawat's suspicious inspection of this castellated pile of rocks could dispel the feeling.</data>
    </edge>
    <edge source="Hawat" target="advance agents" id="0">
      <data key="d12">LEADS</data>
      <data key="d13">0.9</data>
      <data key="d14">Hawat sent advance agents in here by the battalion.</data>
    </edge>
    <edge source="Hawat" target="this place" id="0">
      <data key="d12">CERTIFIED</data>
      <data key="d13">0.9</data>
      <data key="d14">Hawat certified this place, Jessica thought.</data>
    </edge>
    <edge source="Hawat" target="personal mark" id="0">
      <data key="d12">OWNS</data>
      <data key="d13">0.9</data>
      <data key="d14">The prop carried Hawat's personal mark.</data>
    </edge>
    <edge source="Hawat" target="Hawat's men" id="0">
      <data key="d12">LEADS</data>
      <data key="d13">0.9</data>
      <data key="d14">Hawat's men advanced, angry looks on their faces.</data>
    </edge>
    <edge source="Hawat" target="Lady Jessica" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">"Sorry, my Lady. We messed him up catching him. He died."</data>
    </edge>
    <edge source="Hawat" target="Sire" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">"Hawat has an agent there waiting to take them."</data>
    </edge>
    <edge source="Hawat" target="House Harkonnen" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.7</data>
      <data key="d14">"Hawat believes there could be some bad ones planted in the group, but he sees assassins in every shadow."</data>
    </edge>
    <edge source="Hawat" target="House Harkonnen" id="1">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">But Hawat is now a Harkonnen captive.</data>
    </edge>
    <edge source="Hawat" target="Leto Atreides" id="0">
      <data key="d12">FRIENDS_WITH</data>
      <data key="d13">0.8</data>
      <data key="d14">"I know who my true friends are, Thufir," the Duke said.</data>
    </edge>
    <edge source="Hawat" target="Leto Atreides" id="1">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">Hawat said. He gestured for an aide to pass him a folder, opened the folder on the table in front of him.</data>
    </edge>
    <edge source="Hawat" target="Leto Atreides" id="2">
      <data key="d12">PERSON</data>
      <data key="d13">0.9</data>
      <data key="d14">Hawat said. He gestured for an aide to pass him a folder, opened the folder on the table in front of him.</data>
    </edge>
    <edge source="Hawat" target="Leto Atreides" id="3">
      <data key="d12">LOYAL_TO</data>
      <data key="d13">0.9</data>
      <data key="d14">This is the man of honor who deserves every bit of my loyalty and service.</data>
    </edge>
    <edge source="Hawat" target="Idaho's report" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">According to Idaho's report," Hawat said</data>
    </edge>
    <edge source="Hawat" target="EVENT" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Hawat gestured to his aide at the projector.</data>
    </edge>
    <edge source="Hawat" target="Mentat semitrance" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">He closed his eyes in Mentat semitrance</data>
    </edge>
    <edge source="Hawat" target="Duncan Idaho" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">Duncan was clear on one thing: those bases or the idea of them hold some deep significance for the Fremen.</data>
    </edge>
    <edge source="Hawat" target="city" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"Hawat's in the city, my Lady."</data>
    </edge>
    <edge source="Hawat" target="High College" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">"He's conditioned by the High College. That I know for certain."</data>
    </edge>
    <edge source="Hawat" target="she" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.8</data>
      <data key="d14">I know you, Thufir.</data>
    </edge>
    <edge source="Hawat" target="Fremen" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">the Fremen beside Hawat</data>
    </edge>
    <edge source="Hawat" target="Fremen" id="1">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">"We've joined these people."</data>
    </edge>
    <edge source="Hawat" target="Tsimpo" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">He had been at Tsimpo, a garrison village</data>
    </edge>
    <edge source="Hawat" target="attack" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">when the reports of attack began arriving</data>
    </edge>
    <edge source="Hawat" target="his men" id="0">
      <data key="d12">LEADS</data>
      <data key="d13">0.9</data>
      <data key="d14">Hawat glanced back at the huddle of his men</data>
    </edge>
    <edge source="Hawat" target="Sardaukar" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">Those damnable Sardaukar!</data>
    </edge>
    <edge source="Hawat" target="High Council of the Landsraad" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">before the High Council of the Landsraad where justice might be done</data>
    </edge>
    <edge source="Hawat" target="The ways of Arrakis" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">"The ways of Arrakis don't come easily," Hawat said.</data>
    </edge>
    <edge source="Hawat" target="tribe of Atreides" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">The tribe of Atreides.</data>
    </edge>
    <edge source="Hawat" target="tribe" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.8</data>
      <data key="d14">We've joined these people.</data>
    </edge>
    <edge source="Hawat" target="fight" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"We will fight in the time of fighting," the man said.</data>
    </edge>
    <edge source="Hawat" target="Arrakeen" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.7</data>
      <data key="d14">"And they'll help us get to Arrakeen?"</data>
    </edge>
    <edge source="Hawat" target="LOCATION" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">the Fremen beside Hawat said.</data>
    </edge>
    <edge source="Hawat" target="Fremen companion" id="0">
      <data key="d12">FRIENDS_WITH</data>
      <data key="d13">0.8</data>
      <data key="d14">Hawat's Fremen companion</data>
    </edge>
    <edge source="Hawat" target="questioning" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">I wish to question both Hawat and this Kynes at the same time</data>
    </edge>
    <edge source="Hawat" target="arena" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">And he wondered if Hawat had another plan for this arena</data>
    </edge>
    <edge source="Hawat" target="slave grapevine" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">The slave grapevine had carried Hawat's message to this one</data>
    </edge>
    <edge source="Hawat" target="Baron" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.8</data>
      <data key="d14">I demanded earlier that the Baron eliminate Hawat.</data>
    </edge>
    <edge source="Hawat" target="Baron" id="1">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">He sets Hawat over me!</data>
    </edge>
    <edge source="Hawat" target="Baron" id="2">
      <data key="d12">HATES</data>
      <data key="d13">0.9</data>
      <data key="d14">His hate for me is a casual thing now.</data>
    </edge>
    <edge source="Hawat" target="Baron" id="3">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">Hawat snapped.</data>
    </edge>
    <edge source="Hawat" target="plan" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.7</data>
      <data key="d14">If that's Hawat's plan.</data>
    </edge>
    <edge source="Hawat" target="Feyd-Rautha" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.8</data>
      <data key="d14">"I've learned much from Hawat," Feyd-Rautha agreed,</data>
    </edge>
    <edge source="Hawat" target="Emperor" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">"He thinks he uses us to wreak his revenge upon the Emperor."</data>
    </edge>
    <edge source="Imperial House" target="Salusa Secundus" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Where did House Corrino originate? Were there people on Salusa Secundus before the Emperor sent his first contingents of prisoners there?</data>
    </edge>
    <edge source="CHOAM" target="Imperium" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">CHOAM was the key to wealth, each noble House dipping from the company's coffers whatever it could under the power of the directorships.</data>
    </edge>
    <edge source="CHOAM" target="passage" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">CHOAM," Jessica muttered. "I suppose it's already decided how they'll redivide the spoils of Arrakis.</data>
    </edge>
    <edge source="CHOAM" target="path of the flood" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"CHOAM," Jessica muttered.</data>
    </edge>
    <edge source="CHOAM" target="spice" id="0">
      <data key="d12">CONTROLS</data>
      <data key="d13">0.9</data>
      <data key="d14">CHOAM controls the spice</data>
    </edge>
    <edge source="CHOAM" target="EVENT" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"There's a subtle piece of business," Paul said. "The CHOAM Company flag."</data>
    </edge>
    <edge source="CHOAM" target="Arrakis nonsense" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Nor the CHOAM Company profits pouring down this rat hole?</data>
    </edge>
    <edge source="CHOAM" target="Emperor" id="0">
      <data key="d12">OWNED_BY</data>
      <data key="d13">0.9</data>
      <data key="d14">The Emperor's entire CHOAM Company holdings as dowry</data>
    </edge>
    <edge source="CHOAM" target="Emperor" id="1">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">CHOAM: acronym for Combine Honnete Ober Advancer Mercantiles -- the universal development corporation controlled by the Emperor</data>
    </edge>
    <edge source="CHOAM" target="Great Houses" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">CHOAM: acronym for Combine Honnete Ober Advancer Mercantiles -- the universal development corporation controlled by the Emperor and Great Houses</data>
    </edge>
    <edge source="CHOAM" target="Guild" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">CHOAM: acronym for Combine Honnete Ober Advancer Mercantiles -- the universal development corporation controlled by the Emperor and Great Houses with the Guild</data>
    </edge>
    <edge source="CHOAM" target="Bene Gesserit Sisterhood" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">CHOAM: acronym for Combine Honnete Ober Advancer Mercantiles -- the universal development corporation controlled by the Emperor and Great Houses with the Guild and Bene Gesserit as silent partners.</data>
    </edge>
    <edge source="Imperium" target="Great Convention" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">the Guild, the Great Houses, and the Imperium</data>
    </edge>
    <edge source="Kynes" target="His Majesty" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">that path is blocked by one of His Majesty's agents -- the planetary ecologist. You may remember him -- Kynes.</data>
    </edge>
    <edge source="Kynes" target="Imperial" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">this Kynes is an Imperial servant.</data>
    </edge>
    <edge source="Kynes" target="advance bases" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">"this Judge of the Change," Leto said, "the Imperial ecologist--Kynes . . . Wouldn't he know where those bases are?"</data>
    </edge>
    <edge source="Kynes" target="Imperium" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">This Kynes has arbiter authority from the Imperium.</data>
    </edge>
    <edge source="Kynes" target="Imperium" id="1">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">His Majesty supports my work</data>
    </edge>
    <edge source="Kynes" target="Gurney Halleck" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">With the two, garbed like them for the desert, came a man Kynes recognized-Gurney Halleck.</data>
    </edge>
    <edge source="Kynes" target="Gurney Halleck" id="1">
      <data key="d12">HATES</data>
      <data key="d13">0.8</data>
      <data key="d14">Kynes took a deep breath to still his resentment against Halleck</data>
    </edge>
    <edge source="Kynes" target="Gurney Halleck" id="2">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Halleck had pointed Kynes out to Paul from an upper window of the administration building: "The man standing there with the Fremen escort--the one moving now toward the ornithopter."</data>
    </edge>
    <edge source="Kynes" target="Duke" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">"I hope they fit well, my Lord," Kynes said. "They're of Fremen make and as near as possible the dimensions given me by your man Halleck here."</data>
    </edge>
    <edge source="Kynes" target="Duke" id="1">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">And the Duke, behind them, had said: "Scientist type."</data>
    </edge>
    <edge source="Kynes" target="Duke" id="2">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">Kynes knelt, examined the leg seals.</data>
    </edge>
    <edge source="Kynes" target="Duke" id="3">
      <data key="d12">LIKES</data>
      <data key="d13">0.9</data>
      <data key="d14">Kynes admitted to himself: I like this Duke.</data>
    </edge>
    <edge source="Kynes" target="Duncan Idaho" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">I will have Stilgar send Idaho's head to this Duke, Kynes told himself.</data>
    </edge>
    <edge source="Kynes" target="Imperial Planetologist" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">I am in His Majesty's service, the Imperial Planetologist.</data>
    </edge>
    <edge source="Kynes" target="sietch" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">I am accepted in both sietch and village, young Master.</data>
    </edge>
    <edge source="Kynes" target="village" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">I am accepted in both sietch and village, young Master.</data>
    </edge>
    <edge source="Kynes" target="Fremen escort" id="0">
      <data key="d12">LEADS</data>
      <data key="d13">0.9</data>
      <data key="d14">The Fremen escort Kynes had left in the shade of the administration building</data>
    </edge>
    <edge source="Kynes" target="Fremen escort" id="1">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">Kynes had come with a Fremen escort</data>
    </edge>
    <edge source="Kynes" target="Fremen" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">the man was Fremen.</data>
    </edge>
    <edge source="Kynes" target="Fremen" id="1">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">You've associated so long with Fremen that you've lost all sensibilities</data>
    </edge>
    <edge source="Kynes" target="Fremen" id="2">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"Kynes promised their help."</data>
    </edge>
    <edge source="Kynes" target="Fremen" id="3">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">Kynes set his newly trained Fremen limnologists to work</data>
    </edge>
    <edge source="Kynes" target="suit" id="0">
      <data key="d12">EXPLAINS</data>
      <data key="d13">0.9</data>
      <data key="d14">"Certainly," Kynes said. He felt up under the robe for the shoulder seals, speaking as he examined the suit.</data>
    </edge>
    <edge source="Kynes" target="Paul Atreides" id="0">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">Kynes turned to Paul.</data>
    </edge>
    <edge source="Kynes" target="Paul Atreides" id="1">
      <data key="d12">SIDES_WITH</data>
      <data key="d13">0.9</data>
      <data key="d14">He has told us he sides with Paul.</data>
    </edge>
    <edge source="Kynes" target="flight" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Kynes fastened his harness, focused on the padded comfort of the aircraft</data>
    </edge>
    <edge source="Kynes" target="legend" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.7</data>
      <data key="d14">And Kynes rubbed his cheek, thinking of the legend: "He shall know your ways as though born to them."</data>
    </edge>
    <edge source="Kynes" target="sietch factory" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">"Someday I may show you a sietch factory," Kynes said.</data>
    </edge>
    <edge source="Kynes" target="change of government" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"When you report to the Emperor on the change of government here, will you say we observed the rules?" Leto asked.</data>
    </edge>
    <edge source="Kynes" target="propaganda" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"I've seen the propaganda you've flooded into sietch and village," Kynes said.</data>
    </edge>
    <edge source="Kynes" target="worms" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"You may see one today," Kynes said. "Wherever there is spice, there are worms."</data>
    </edge>
    <edge source="Kynes" target="eagle" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"That's likely an eagle," Kynes said.</data>
    </edge>
    <edge source="Kynes" target="second zone" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"Men have walked out of the second zone several times."</data>
    </edge>
    <edge source="Kynes" target="EVENT" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Kynes said.</data>
    </edge>
    <edge source="Kynes" target="EVENT" id="1">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Then Kynes was beside Paul and they threw their weight against the door.</data>
    </edge>
    <edge source="Kynes" target="Arrakis" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"Arrakis is tough on equipment."</data>
    </edge>
    <edge source="Kynes" target="Arrakis" id="1">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">No man arrived on Arrakis without a full dossier finding its way into the Fremen strongholds.</data>
    </edge>
    <edge source="Kynes" target="Worm" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"Worm," Kynes said. "Big one."</data>
    </edge>
    <edge source="Kynes" target="Spotter Control" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.8</data>
      <data key="d14">"This is Spotter Control. Sighting confirmed. Stand by for contact fix."</data>
    </edge>
    <edge source="Kynes" target="worm" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"I hear the worm, but I can't see it," Kynes said.</data>
    </edge>
    <edge source="Kynes" target="Imperial Civil Servant" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">Kynes, noting that the planetologist wore an old-style dark brown uniform with epaulets of the Imperial Civil Servant</data>
    </edge>
    <edge source="Kynes" target="tramping around with mobs of Fremen" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Ah, Dr. Kynes," the water-shipper said. "You've come in from tramping around with your mobs of Fremen.</data>
    </edge>
    <edge source="Kynes" target="Lady Jessica" id="0">
      <data key="d12">LOVES</data>
      <data key="d13">0.7</data>
      <data key="d14">He appeared transfigured--like a man in love . . . or caught in a religious trance.</data>
    </edge>
    <edge source="Kynes" target="Lady Jessica" id="1">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">Kynes moved around Paul, held a chair for Jessica.</data>
    </edge>
    <edge source="Kynes" target="dinner" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Kynes, though, caught her attention most sharply.</data>
    </edge>
    <edge source="Kynes" target="passage" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"There's Kynes," she said.</data>
    </edge>
    <edge source="Kynes" target="Judge of the Change" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">And you, as Judge of the Change, do you challenge this?</data>
    </edge>
    <edge source="Kynes" target="Tuek" id="0">
      <data key="d12">FRIENDS_WITH</data>
      <data key="d13">0.85</data>
      <data key="d14">There existed an accord of some sort between Kynes and Tuek.</data>
    </edge>
    <edge source="Kynes" target="banker" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.8</data>
      <data key="d14">Kynes would have killed him without hesitating, she thought.</data>
    </edge>
    <edge source="Kynes" target="banker" id="1">
      <data key="d12">KNOWS</data>
      <data key="d13">0.9</data>
      <data key="d14">Kynes spoke to the banker: "Isn't another apology in order?"</data>
    </edge>
    <edge source="Kynes" target="Great House" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">It's rare to find members of a Great House aware of planetological problems," Kynes said.</data>
    </edge>
    <edge source="Kynes" target="Tansley Effect" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">build up the Tansley Effect</data>
    </edge>
    <edge source="Kynes" target="water" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Water overshadows the other problems</data>
    </edge>
    <edge source="Kynes" target="prophecies" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"He dreams with the Fremen--of prophecies and messiahs."</data>
    </edge>
    <edge source="Kynes" target="messiahs" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"He dreams with the Fremen--of prophecies and messiahs."</data>
    </edge>
    <edge source="Kynes" target="people" id="0">
      <data key="d12">LEADS</data>
      <data key="d13">0.9</data>
      <data key="d14">Where Kynes leads, people follow, Jessica thought.</data>
    </edge>
    <edge source="Kynes" target="song" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.7</data>
      <data key="d14">but I suspect it was an imaginative invention made solely for purposes of a song.</data>
    </edge>
    <edge source="Kynes" target="Shamir" id="0">
      <data key="d12">LEADS</data>
      <data key="d13">0.9</data>
      <data key="d14">He nodded to one of his men. "Spice coffee in my quarters, Shamir."</data>
    </edge>
    <edge source="Kynes" target="man" id="0">
      <data key="d12">LEADS</data>
      <data key="d13">0.9</data>
      <data key="d14">"At once, Liet," the man said.</data>
    </edge>
    <edge source="Kynes" target="plan" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Kynes said: "Arrakis has its own plan that we--"</data>
    </edge>
    <edge source="Kynes" target="Harkonnen" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">We lived under the Harkonnens for eighty years</data>
    </edge>
    <edge source="Kynes" target="storm" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">There's a storm across the desert tonight. Your only hope is to run for that storm, dive into the top of it, ride with it. My people have done this in stealing 'thopters.</data>
    </edge>
    <edge source="Kynes" target="guerrilla" id="0">
      <data key="d12">LEADS</data>
      <data key="d13">0.9</data>
      <data key="d14">He did what any good guerrilla leader would</data>
    </edge>
    <edge source="Kynes" target="suspicious circumstances" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">Idaho joined this Kynes under mysterious circumstances . . . I might even say suspicious circumstances.</data>
    </edge>
    <edge source="Kynes" target="double game" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.7</data>
      <data key="d14">The Imperial lackey, this Kynes," the Baron said. "He was playing a double game, eh?</data>
    </edge>
    <edge source="Kynes" target="report" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Is there more to this . . . report? "The Imperial Planetologist, Kynes, is involved, m'Lord.</data>
    </edge>
    <edge source="Kynes" target="questioning" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">I wish to question both Hawat and this Kynes at the same time</data>
    </edge>
    <edge source="Kynes" target="Emperor" id="0">
      <data key="d12">WORKS_FOR</data>
      <data key="d13">0.9</data>
      <data key="d14">He's the Emperor's man, m'Lord.</data>
    </edge>
    <edge source="Kynes" target="his father" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">It was the voice of his father who had been planetologist here before him-his father long dead, killed in the cave-in at Plaster Basin.</data>
    </edge>
    <edge source="Kynes" target="spice desert" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">This is spice desert, he thought.</data>
    </edge>
    <edge source="Kynes" target="Father" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">"Please stop lecturing me, Father," Kynes whispered.</data>
    </edge>
    <edge source="Kynes" target="sending messages to sietch villages" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">The messages already have been sent to my sietch villages</data>
    </edge>
    <edge source="Kynes" target="LOCATION" id="0">
      <data key="d12">LOVES</data>
      <data key="d13">0.8</data>
      <data key="d14">And I am a desert creature, Kynes thought. You see me, Father? I am a desert creature.</data>
    </edge>
    <edge source="Kynes" target="The Collected Sayings of Muad'Dib" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"Private Reflections on Muad'Dib" by the Princess Irulan</data>
    </edge>
    <edge source="Kynes" target="House Harkonnen" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">The Harkonnens were killing Fremen. They were destroying the tools with which he intended to remake a planet!</data>
    </edge>
    <edge source="Kynes" target="Imperial chores" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Kynes returned to his Imperial chores</data>
    </edge>
    <edge source="Kynes" target="Biological Testing Stations" id="0">
      <data key="d12">LEADS</data>
      <data key="d13">0.9</data>
      <data key="d14">directing the Biological Testing Stations</data>
    </edge>
    <edge source="Kynes" target="talk about secret windtraps" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Kynes said, and went on talking about secret windtraps</data>
    </edge>
    <edge source="Kynes" target="umma" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">He was one of the umma, the brotherhood of prophets</data>
    </edge>
    <edge source="Kynes" target="small-unit experiments" id="0">
      <data key="d12">LEADS</data>
      <data key="d13">0.9</data>
      <data key="d14">He set up small-unit experiments with regular interchange of data</data>
    </edge>
    <edge source="Kynes" target="charts" id="0">
      <data key="d12">CREATED</data>
      <data key="d13">0.9</data>
      <data key="d14">Charts were developed on the long drifts of weather</data>
    </edge>
    <edge source="Kynes" target="salt pan" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Then Kynes saw the salt pan.</data>
    </edge>
    <edge source="Kynes" target="terraform life" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.8</data>
      <data key="d14">The addition of sulfur and fixed nitrogen converted the barren zone to a rich plant bed for terraform life.</data>
    </edge>
    <edge source="Kynes" target="planetary formulae" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Kynes went back to his planetary formulae.</data>
    </edge>
    <edge source="Kynes" target="palmaries" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Kynes went down to the palmaries himself</data>
    </edge>
    <edge source="Alia Atreides" target="Muad'Dib, Family Commentaries" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">-from "Muad'Dib, Family Commentaries" by the Princess Irulan</data>
    </edge>
    <edge source="Alia Atreides" target="Lady Jessica" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">and you'll bear my sister: St. Alia of the Knife.</data>
    </edge>
    <edge source="Alia Atreides" target="Paul Atreides" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">Alia-the-Strange-One, his sister</data>
    </edge>
    <edge source="Alia Atreides" target="twenty-thumper trip into the south" id="0">
      <data key="d12">PARTICIPATES_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Alia-the-Strange-One, his sister, had gone  there with his mother and with Chani -- a twenty-thumper trip into the south</data>
    </edge>
    <edge source="Alia Atreides" target="Duke Leto-Atreides" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">Legal daughter of Duke Leto-Atreides and his formal concubine, Lady Jessica.</data>
    </edge>
    <edge source="Alia Atreides" target="Jessica Atreides" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">Legal daughter of Duke Leto-Atreides and his formal concubine, Lady Jessica.</data>
    </edge>
    <edge source="Alia Atreides" target="Arrakis" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">Lady Alia was born on Arrakis</data>
    </edge>
