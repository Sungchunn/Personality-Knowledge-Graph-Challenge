      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">C.E.T. Commentaries: Identical wording. (The Azhar Book traces this statement to the first century religious writer, Neshou; through a paraphrase.)</data>
    </edge>
    <edge source="Reverend Mother Ramallo" target="Bene Gesserit Sisterhood" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">Records available to the Bene Gesserit stated in plain terms that the Fremen legends of the Prophet contained these words: "He shall be born of a Bene Gesserit witch."</data>
    </edge>
    <edge source="Anirul" target="Bene Gesserit Sisterhood" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">His wife, Anirul, a Bene Gesserit of Hidden Rank</data>
    </edge>
    <edge source="Duke Leto-Atreides" target="Great House" id="0">
      <data key="d12">MEMBER_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">House Atreides ruled Caladan as a siridar-fief for twenty generations</data>
    </edge>
    <edge source="Duke Leto-Atreides" target="Paul Muad'Dib" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">He is known chiefly as the father of Duke Paul Muad'Dib</data>
    </edge>
    <edge source="Duke Leto-Atreides" target="Vladimir Harkonnen" id="0">
      <data key="d12">ENEMY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">His death is attributed to the treachery of a Suk doctor, and is an act laid to the Siridar-Baron, Vladimir Harkonnen.</data>
    </edge>
    <edge source="Abulurd" target="Vladimir Harkonnen" id="0">
      <data key="d12">FAMILY_OF</data>
      <data key="d13">0.9</data>
      <data key="d14">Abulurd renounced the Harkonnen name and all rights to the title</data>
    </edge>
    <edge source="BARADYE PISTOL" target="Arrakis" id="0">
      <data key="d12">CREATED</data>
      <data key="d13">0.9</data>
      <data key="d14">BARADYE PISTOL: a static-charge dust gun developed on Arrakis</data>
    </edge>
    <edge source="Theta Shalish" target="Music Planet" id="0">
      <data key="d12">LOCATED_IN</data>
      <data key="d13">0.9</data>
