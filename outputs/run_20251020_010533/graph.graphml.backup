      <data key="d13">0.9</data>
      <data key="d14">-from "Conversations with Muad'Dib" by the Princess Irulan</data>
    </edge>
    <edge source="Emperor's daughter" target="In My Father's House" id="0">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"In My Father's House" by the Princess Irulan</data>
    </edge>
    <edge source="Emperor's daughter" target="The Collected Sayings of Muad'Dib" id="0">
      <data key="d12">CREATED</data>
      <data key="d13">0.9</data>
      <data key="d14">"Private Reflections on Muad'Dib" by the Princess Irulan</data>
    </edge>
    <edge source="Emperor's daughter" target="The Collected Sayings of Muad'Dib" id="1">
      <data key="d12">MENTIONED_IN</data>
      <data key="d13">0.9</data>
      <data key="d14">"Private Reflections on Muad'Dib" by the Princess Irulan</data>
    </edge>
