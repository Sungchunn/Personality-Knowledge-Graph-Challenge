8ab4f8", "opacity": 0.9400000000000001}, "dashes": false, "from": "Reverend Mother", "label": "MENTIONED_IN", "smooth": {"type": "cubicBezier"}, "title": "\n        \u003cdiv style=\u0027font-family: Inter, sans-serif; max-width: 300px;\u0027\u003e\n            \u003cdiv style=\u0027font-size: 16px; font-weight: 600; margin-bottom: 4px; color: #8ab4f8;\u0027\u003e\n                MENTIONED_IN\n            \u003c/div\u003e\n            \u003cdiv style=\u0027font-size: 12px; color: #9aa0a6; margin-bottom: 8px;\u0027\u003e\n                Reverend Mother \u2192 passage\n            \u003c/div\u003e\n            \u003cdiv style=\u0027font-size: 11px; color: #e8eaed; margin-bottom: 8px;\u0027\u003e\n                Confidence: \u003cspan style=\u0027color: #8ab4f8;\u0027\u003e0.90\u003c/span\u003e\n            \u003c/div\u003e\n        \n            \u003cdiv style=\u0027padding-top: 8px; border-top: 1px solid #3c4043;\u0027\u003e\n                \u003cdiv style=\u0027font-size: 10px; color: #9aa0a6; margin-bottom: 4px;\u0027\u003eEvidence:\u003c/div\u003e\n                \u003cdiv style=\u0027font-size: 11px; color: #e8eaed; font-style: italic;\u0027\u003e\n                    \"not thinking about it out of fear or because of warnings such as that of the old Reverend Mother\"\n                \u003c/div\u003e\n            \u003c/div\u003e\n            \u003c/div\u003e", "to": "passage", "width": 3.65}, {"arrows": {"to": {"enabled": true, "scaleFactor": 0.5}}, "color": {"color": "#8ab4f8", "opacity": 0.9400000000000001}, "dashes": false, "from": "Reverend Mother", "label": "MEMBER_OF", "smooth": {"type": "cubicBezier"}, "title": "\n        \u003cdiv style=\u0027font-family: Inter, sans-serif; max-width: 300px;\u0027\u003e\n            \u003cdiv style=\u0027font-size: 16px; font-weight: 600; margin-bottom: 4px; color: #8ab4f8;\u0027\u003e\n                MEMBER_OF\n            \u003c/div\u003e\n            \u003cdiv style=\u0027font-size: 12px; color: #9aa0a6; margin-bottom: 8px;\u0027\u003e\n                Reverend Mother \u2192 Sayyadina\n            \u003c/div\u003e\n            \u003cdiv style=\u0027font-size: 11px; color: #e8eaed; margin-bottom: 8px;\u0027\u003e\n                Confidence: \u003cspan style=\u0027color: #8ab4f8;\u0027\u003e0.90\u003c/span\u003e\n            \u003c/div\u003e\n        \n            \u003cdiv style=\u0027padding-top: 8px; border-top: 1px solid #3c4043;\u0027\u003e\n                \u003cdiv style=\u0027font-size: 10px; color: #9aa0a6; margin-bottom: 4px;\u0027\u003eEvidence:\u003c/div\u003e\n                \u003cdiv style=\u0027font-size: 11px; color: #e8eaed; font-style: italic;\u0027\u003e\n                    \"\"The Sayyadina,\" he said. \"Our Reverend Mother is old.\"\"\n                \u003c/div\u003e\n            \u003c/div\u003e\n            \u003c/div\u003e", "to": "Sayyadina", "width": 3.65}, {"arrows": {"to": {"enabled": true, "scaleFactor": 0.5}}, "color": {"color": "#8ab4f8", "opacity": 0.9400000000000001}, "dashes": false, "from": "Reverend Mother", "label": "MENTIONED_IN", "smooth": {"type": "cubicBezier"}, "title": "\n        \u003cdiv style=\u0027font-family: Inter, sans-serif; max-width: 300px;\u0027\u003e\n            \u003cdiv style=\u0027font-size: 16px; font-weight: 600; margin-bottom: 4px; color: #8ab4f8;\u0027\u003e\n                MENTIONED_IN\n            \u003c/div\u003e\n            \u003cdiv style=\u0027font-size: 12px; color: #9aa0a6; margin-bottom: 8px;\u0027\u003e\n                Reverend Mother \u2192 Mapes\n            \u003c/div\u003e\n            \u003cdiv style=\u0027font-size: 11px; color: #e8eaed; margin-bottom: 8px;\u0027\u003e\n                Confidence: \u003cspan style=\u0027color: #8ab4f8;\u0027\u003e0.90\u003c/span\u003e\n            \u003c/div\u003e\n        \n            \u003cdiv style=\u0027padding-top: 8px; border-top: 1px solid #3c4043;\u0027\u003e\n                \u003cdiv style=\u0027font-size: 10px; color: #9aa0a6; margin-bottom: 4px;\u0027\u003eEvidence:\u003c/div\u003e\n                \u003cdiv style=\u0027font-size: 11px; color: #e8eaed; font-style: italic;\u0027\u003e\n                    \"\"The Shadout Mapes was right to pity you.\"\"\n                \u003c/div\u003e\n            \u003c/div\u003e\n            \u003c/div\u003e", "to": "Mapes", "width": 3.65}, {"arrows": {"to": {"enabled": true, "scaleFactor": 0.5}}, "color": {"color": "#fdd663", "opacity": 0.9400000000000001}, "dashes": false, "from": "Reverend Mother", "label": "LEADS", "smooth": {"type": "cubicBezier"}, "title": "\n        \u003cdiv style=\u0027font-family: Inter, sans-serif; max-width: 300px;\u0027\u003e\n            \u003cdiv style=\u0027font-size: 16px; font-weight: 600; margin-bottom: 4px; color: #fdd663;\u0027\u003e\n                LEADS\n            \u003c/div\u003e\n            \u003cdiv style=\u0027font-size: 12px; color: #9aa0a6; margin-bottom: 8px;\u0027\u003e\n                Reverend Mother \u2192 the people of Misr\n            \u003c/div\u003e\n            \u003cdiv style=\u0027font-size: 11px; color: #e8eaed; margin-bottom: 8px;\u0027\u003e\n                Confidence: \u003cspan style=\u0027color: #fdd663;\u0027\u003e0.90\u003c/span\u003e\n            \u003c/div\u003e\n        \n            \u003cdiv style=\u0027padding-top: 8px; border-top: 1px solid #3c4043;\u0027\u003e\n                \u003cdiv style=\u0027font-size: 10px; color: #9aa0a6; margin-bottom: 4px;\u0027\u003eEvidence:\u003c/div\u003e\n                \u003cdiv style=\u0027font-size: 11px; color: #e8eaed; font-style: italic;\u0027\u003e\n                    \"\"We are the people of Misr,\" the old woman rasped.\"\n                \u003c/div\u003e\n            \u003c/div\u003e\n            \u003c/div\u003e", "to": "the people of Misr", "width": 3.65}, {"arrows": {"to": {"enabled": true, "scaleFactor": 0.5}}, "color": {"color": "#8ab4f8", "opacity": 0.9400000000000001}, "dashes": false, "from": "Reverend Mother", "label": "MENTIONED_IN", "smooth": {"type": "cubicBezier"}, "title": "\n        \u003cdiv style=\u0027font-family: Inter, sans-serif; max-width: 300px;\u0027\u003e\n            \u003cdiv style=\u0027font-size: 16px; font-weight: 600; margin-bottom: 4px; color: #8ab4f8;\u0027\u003e\n                MENTIONED_IN\n            \u003c/div\u003e\n            \u003cdiv style=\u0027font-size: 12px; color: #9aa0a6; margin-bottom: 8px;\u0027\u003e\n                Reverend Mother \u2192 Ceremony of the Seed\n            \u003c/div\u003e\n            \u003cdiv style=\u0027font-size: 11px; color: #e8eaed; margin-bottom: 8px;\u0027\u003e\n                Confidence: \u003cspan style=\u0027color: #8ab4f8;\u0027\u003e0.90\u003c/span\u003e\n            \u003c/div\u003e\n        \n            \u003cdiv style=\u0027padding-top: 8px; border-top: 1px solid #3c4043;\u0027\u003e\n                \u003cdiv style=\u0027font-size: 10px; color: #9aa0a6; margin-bottom: 4px;\u0027\u003eEvidence:\u003c/div\u003e\n                \u003cdiv style=\u0027font-size: 11px; color: #e8eaed; font-style: italic;\u0027\u003e\n                    \"\"I, the Reverend Mother Ramallo, whose voice speaks as a multitude, say this to you,\" the old woman said.\"\n                \u003c/div\u003e\n            \u003c/div\u003e\n            \u003c/div\u003e", "to": "Ceremony of the Seed", "width": 3.65}, {"arrows": {"to": {"enabled": true, "scaleFactor": 0.5}}, "color": {"color": "#8ab4f8", "opacity": 0.9400000000000001}, "dashes": false, "from": "Reverend Mother", "label": "PARTICIPATES_IN", "smooth": {"type": "cubicBezier"}, "title": "\n        \u003cdiv style=\u0027font-family: Inter, sans-serif; max-width: 300px;\u0027\u003e\n            \u003cdiv style=\u0027font-size: 16px; font-weight: 600; margin-bottom: 4px; color: #8ab4f8;\u0027\u003e\n                PARTICIPATES_IN\n            \u003c/div\u003e\n            \u003cdiv style=\u0027font-size: 12px; color: #9aa0a6; margin-bottom: 8px;\u0027\u003e\n                Reverend Mother \u2192 ritual\n            \u003c/div\u003e\n            \u003cdiv style=\u0027font-size: 11px; color: #e8eaed; margin-bottom: 8px;\u0027\u003e\n                Confidence: \u003cspan style=\u0027color: #8ab4f8;\u0027\u003e0.90\u003c/span\u003e\n            \u003c/div\u003e\n        \n            \u003cdiv style=\u0027padding-top: 8px; border-top: 1px solid #3c4043;\u0027\u003e\n                \u003cdiv style=\u0027font-size: 10px; color: #9aa0a6; margin-bottom: 4px;\u0027\u003eEvidence:\u003c/div\u003e\n                \u003cdiv style=\u0027font-size: 11px; color: #e8eaed; font-style: italic;\u0027\u003e\n                    \"Jessica looked back at the Reverend Mother Ramallo.\"\n                \u003c/div\u003e\n            \u003c/div\u003e\n            \u003c/div\u003e", "to": "ritual", "width": 3.65}, {"arrows": {"to": {"enabled": true, "scaleFactor": 0.5}}, "color": {"color": "#8ab4f8", "opacity": 0.9400000000000001}, "dashes": false, "from": "Reverend Mother", "label": "MENTIONED_IN", "smooth": {"type": "cubicBezier"}, "title": "\n        \u003cdiv style=\u0027font-family: Inter, sans-serif; max-width: 300px;\u0027\u003e\n            \u003cdiv style=\u0027font-size: 16px; font-weight: 600; margin-bottom: 4px; color: #8ab4f8;\u0027\u003e\n                MENTIONED_IN\n            \u003c/div\u003e\n            \u003cdiv style=\u0027font-size: 12px; color: #9aa0a6; margin-bottom: 8px;\u0027\u003e\n                Reverend Mother \u2192 EVENT\n            \u003c/div\u003e\n            \u003cdiv style=\u0027font-size: 11px; color: #e8eaed; margin-bottom: 8px;\u0027\u003e\n                Confidence: \u003cspan style=\u0027color: #8ab4f8;\u0027\u003e0.90\u003c/span\u003e\n            \u003c/div\u003e\n        \n            \u003cdiv style=\u0027padding-top: 8px; border-top: 1px solid #3c4043;\u0027\u003e\n                \u003cdiv style=\u0027font-size: 10px; color: #9aa0a6; margin-bottom: 4px;\u0027\u003eEvidence:\u003c/div\u003e\n                \u003cdiv style=\u0027font-size: 11px; color: #e8eaed; font-style: italic;\u0027\u003e\n                    \"She saw the old Reverend Mother Ramallo being brought to sit beside her on the carpeted ledge.\"\n                \u003c/div\u003e\n            \u003c/div\u003e\n            \u003c/div\u003e", "to": "EVENT", "width": 3.65}, {"arrows": {"to": {"enabled": true, "scaleFactor": 0.5}}, "color": {"color": "#8ab4f8", "opacity": 0.9400000000000001}, "dashes": false, "from": "Reverend Mother", "label": "MENTIONED_IN", "smooth": {"type": "cubicBezier"}, "title": "\n        \u003cdiv style=\u0027font-family: Inter, sans-serif; max-width: 300px;\u0027\u003e\n            \u003cdiv style=\u0027font-size: 16px; font-weight: 600; margin-bottom: 4px; color: #8ab4f8;\u0027\u003e\n                MENTIONED_IN\n            \u003c/div\u003e\n            \u003cdiv style=\u0027font-size: 12px; color: #9aa0a6; margin-bottom: 8px;\u0027\u003e\n                Reverend Mother \u2192 Bene Gesserit\u0027s need\n            \u003c/div\u003e\n            \u003cdiv style=\u0027font-size: 11px; color: #e8eaed; margin-bottom: 8px;\u0027\u003e\n                Confidence: \u003cspan style=\u0027color: #8ab4f8;\u0027\u003e0.90\u003c/span\u003e\n            \u003c/div\u003e\n        \n            \u003cdiv style=\u0027padding-top: 8px; border-top: 1px solid #3c4043;\u0027\u003e\n                \u003cdiv style=\u0027font-size: 10px; color: #9aa0a6; margin-bottom: 4px;\u0027\u003eEvidence:\u003c/div\u003e\n                \u003cdiv style=\u0027font-size: 11px; color: #e8eaed; font-style: italic;\u0027\u003e\n                    \"a subliminal training projector at the Bene Gesserit school\"\n                \u003c/div\u003e\n            \u003c/div\u003e\n            \u003c/div\u003e", "to": "Bene Gesserit\u0027s need", "width": 3.65}, {"arrows": {"to": {"enabled": true, "scaleFactor": 0.5}}, "color": {"color": "#8ab4f8", "opacity": 0.9400000000000001}, "dashes": false, "from": "Reverend Mother", "label": "MENTIONED_IN", "smooth": {"type": "cubicBezier"}, "title": "\n        \u003cdiv style=\u0027font-family: Inter, sans-serif; max-width: 300px;\u0027\u003e\n            \u003cdiv style=\u0027font-size: 16px; font-weight: 600; margin-bottom: 4px; color: #8ab4f8;\u0027\u003e\n                MENTIONED_IN\n            \u003c/div\u003e\n            \u003cdiv style=\u0027font-size: 12px; color: #9aa0a6; margin-bottom: 8px;\u0027\u003e\n                Reverend Mother \u2192 rite of joining\n            \u003c/div\u003e\n            \u003cdiv style=\u0027font-size: 11px; color: #e8eaed; margin-bottom: 8px;\u0027\u003e\n                Confidence: \u003cspan style=\u0027color: #8ab4f8;\u0027\u003e0.90\u003c/span\u003e\n            \u003c/div\u003e\n        \n            \u003cdiv style=\u0027padding-top: 8px; border-top: 1px solid #3c4043;\u0027\u003e\n                \u003cdiv style=\u0027font-size: 10px; color: #9aa0a6; margin-bottom: 4px;\u0027\u003eEvidence:\u003c/div\u003e\n                \u003cdiv style=\u0027font-size: 11px; color: #e8eaed; font-style: italic;\u0027\u003e\n                    \"I have met the Reverend Mother Ramallo,\" Jessica said. \"She is gone, but she remains. Let her memory be honored in the rite.\"\n                \u003c/div\u003e\n            \u003c/div\u003e\n            \u003c/div\u003e", "to": "rite of joining", "width": 3.65}, {"arrows": {"to": {"enabled": true, "scaleFactor": 0.5}}, "color": {"color": "#81c995", "opacity": 0.9400000000000001}, "dashes": false, "from": "Reverend Mother", "label": "FAMILY_OF", "smooth": {"type": "cubicBezier"}, "title": "\n        \u003cdiv style=\u0027font-family: Inter, sans-serif; max-width: 300px;\u0027\u003e\n            \u003cdiv style=\u0027font-size: 16px; font-weight: 600; margin-bottom: 4px; color: #81c995;\u0027\u003e\n                FAMILY_OF\n            \u003c/div\u003e\n            \u003cdiv style=\u0027font-size: 12px; color: #9aa0a6; margin-bottom: 8px;\u0027\u003e\n                Reverend Mother \u2192 Alia\n            \u003c/div\u003e\n            \u003cdiv style=\u0027font-size: 11px; color: #e8eaed; margin-bottom: 8px;\u0027\u003e\n                Confidence: \u003cspan style=\u0027color: #81c995;\u0027\u003e0.90\u003c/span\u003e\n            \u003c/div\u003e\n        \n            \u003cdiv style=\u0027padding-top: 8px; border-top: 1px solid #3c4043;\u0027\u003e\n                \u003cdiv style=\u0027font-size: 10px; color: #9aa0a6; margin-bottom: 4px;\u0027\u003eEvidence:\u003c/div\u003e\n                \u003cdiv style=\u0027font-size: 11px; color: #e8eaed; font-style: italic;\u0027\u003e\n                    \"Some of the women banded to appeal to the Reverend Mother. They demanded she exorcise the demon in her daughter.\"\n                \u003c/div\u003e\n            \u003c/div\u003e\n            \u003c/div\u003e", "to": "Alia", "width": 3.65}, {"arrows": {"to": {"enabled": true, "scaleFactor": 0.5}}, "color": {"color": "#f28b82", "opacity": 0.9400000000000001}, "dashes": false, "from": "Reverend Mother", "label": "HATES", "smooth": {"type": "cubicBezier"}, "title": "\n        \u003cdiv style=\u0027font-family: Inter, sans-serif; max-width: 300px;\u0027\u003e\n            \u003cdiv style=\u0027font-size: 16px; font-weight: 600; margin-bottom: 4px; color: #f28b82;\u0027\u003e\n                HATES\n            \u003c/div\u003e\n            \u003cdiv style=\u0027font-size: 12px; color: #9aa0a6; margin-bottom: 8px;\u0027\u003e\n                Reverend Mother \u2192 Alia\n            \u003c/div\u003e\n            \u003cdiv style=\u0027font-size: 11px; color: #e8eaed; margin-bottom: 8px;\u0027\u003e\n                Confidence: \u003cspan style=\u0027color: #f28b82;\u0027\u003e0.90\u003c/span\u003e\n            \u003c/div\u003e\n        \n            \u003cdiv style=\u0027padding-top: 8px; border-top: 1px solid #3c4043;\u0027\u003e\n                \u003cdiv style=\u0027font-size: 10px; color: #9aa0a6; margin-bottom: 4px;\u0027\u003eEvidence:\u003c/div\u003e\n                \u003cdiv style=\u0027font-size: 11px; color: #e8eaed; font-style: italic;\u0027\u003e\n                    \"\"That child is an abomination!\" the old woman said.\"\n                \u003c/div\u003e\n            \u003c/div\u003e\n            \u003c/div\u003e", "to": "Alia", "width": 3.65}, {"arrows": {"to": {"enabled": true, "scaleFactor": 0.5}}, "color": {"color": "#8ab4f8", "opacity": 0.9400000000000001}, "dashes": false, "from": "Reverend Mother", "label": "MENTIONED_IN", "smooth": {"type": "cubicBezier"}, "title": "\n        \u003cdiv style=\u0027font-family: Inter, sans-serif; max-width: 300px;\u0027\u003e\n            \u003cdiv style=\u0027font-size: 16px; font-weight: 600; margin-bottom: 4px; color: #8ab4f8;\u0027\u003e\n                MENTIONED_IN\n            \u003c/div\u003e\n            \u003cdiv style=\u0027font-size: 12px; color: #9aa0a6; margin-bottom: 8px;\u0027\u003e\n                Reverend Mother \u2192 law\n            \u003c/div\u003e\n            \u003cdiv style=\u0027font-size: 11px; color: #e8eaed; margin-bottom: 8px;\u0027\u003e\n                Confidence: \u003cspan style=\u0027color: #8ab4f8;\u0027\u003e0.90\u003c/span\u003e\n            \u003c/div\u003e\n        \n            \u003cdiv style=\u0027padding-top: 8px; border-top: 1px solid #3c4043;\u0027\u003e\n                \u003cdiv style=\u0027font-size: 10px; color: #9aa0a6; margin-bottom: 4px;\u0027\u003eEvidence:\u003c/div\u003e\n                \u003cdiv style=\u0027font-size: 11px; color: #e8eaed; font-style: italic;\u0027\u003e\n                    \"She recited the law and sent the women away abashed.\"\n                \u003c/div\u003e\n            \u003c/div\u003e\n            \u003c/div\u003e", "to": "law", "width": 3.65}, {"arrows": {"to": {"enabled": true, "scaleFactor": 0.5}}, "color": {"color": "#8ab4f8", "opacity": 0.9400000000000001}, "dashes": false, "from": "Reverend Mother", "label": "MENTIONED_IN", "smooth": {"type": "cubicBezier"}, "title": "\n        \u003cdiv style=\u0027font-family: Inter, sans-serif; max-width: 300px;\u0027\u003e\n            \u003cdiv style=\u0027font-size: 16px; font-weight: 600; margin-bottom: 4px; color: #8ab4f8;\u0027\u003e\n                MENTIONED_IN\n            \u003c/div\u003e\n            \u003cdiv style=\u0027font-size: 12px; color: #9aa0a6; margin-bottom: 8px;\u0027\u003e\n                Reverend Mother \u2192 Collected Legends of Arrakis\n            \u003c/div\u003e\n            \u003cdiv style=\u0027font-size: 11px; color: #e8eaed; margin-bottom: 8px;\u0027\u003e\n                Confidence: \u003cspan style=\u0027color: #8ab4f8;\u0027\u003e0.90\u003c/span\u003e\n            \u003c/div\u003e\n        \n            \u003cdiv style=\u0027padding-top: 8px; border-top: 1px solid #3c4043;\u0027\u003e\n                \u003cdiv style=\u0027font-size: 10px; color: #9aa0a6; margin-bottom: 4px;\u0027\u003eEvidence:\u003c/div\u003e\n                \u003cdiv style=\u0027font-size: 11px; color: #e8eaed; font-style: italic;\u0027\u003e\n                    \"-\"Collected Legends of Arrakis\" by the Princess Irulan\"\n                \u003c/div\u003e\n            \u003c/div\u003e\n            \u003c/div\u003e", "to": "Collected Legends of Arrakis", "width": 3.65}, {"arrows": {"to": {"enabled": true, "scaleFactor": 0.5}}, "color": {"color": "#f28b82", "opacity": 0.9400000000000001}, "dashes": false, "from": "Reverend Mother", "label": "HATES", "smooth": {"type": "cubicBezier"}, "title": "\n        \u003cdiv style=\u0027font-family: Inter, sans-serif; max-width: 300px;\u0027\u003e\n            \u003cdiv style=\u0027font-size: 16px; font-weight: 600; margin-bottom: 4px; color: #f28b82;\u0027\u003e\n                HATES\n            \u003c/div\u003e\n            \u003cdiv style=\u0027font-size: 12px; color: #9aa0a6; margin-bottom: 8px;\u0027\u003e\n                Reverend Mother \u2192 Jessica Atreides\n            \u003c/div\u003e\n            \u003cdiv style=\u0027font-size: 11px; color: #e8eaed; margin-bottom: 8px;\u0027\u003e\n                Confidence: \u003cspan style=\u0027color: #f28b82;\u0027\u003e0.90\u003c/span\u003e\n            \u003c/div\u003e\n        \n            \u003cdiv style=\u0027padding-top: 8px; border-top: 1px solid #3c4043;\u0027\u003e\n                \u003cdiv style=\u0027font-size: 10px; color: #9aa0a6; margin-bottom: 4px;\u0027\u003eEvidence:\u003c/div\u003e\n                \u003cdiv style=\u0027font-size: 11px; color: #e8eaed; font-style: italic;\u0027\u003e\n                    \"\"Her mother deserves a punishment greater than anything in history. Death!\"\"\n                \u003c/div\u003e\n            \u003c/div\u003e\n            \u003c/div\u003e", "to": "Jessica Atreides", "width": 3.65}, {"arrows": {"to": {"enabled": true, "scaleFactor": 0.5}}, "color": {"color": "#8ab4f8", "opacity": 0.9400000000000001}, "dashes": false, "from": "Reverend Mother", "label": "COMMANDS", "smooth": {"type": "cubicBezier"}, "title": "\n        \u003cdiv style=\u0027font-family: Inter, sans-serif; max-width: 300px;\u0027\u003e\n            \u003cdiv style=\u0027font-size: 16px; font-weight: 600; margin-bottom: 4px; color: #8ab4f8;\u0027\u003e\n                COMMANDS\n            \u003c/div\u003e\n            \u003cdiv style=\u0027font-size: 12px; color: #9aa0a6; margin-bottom: 8px;\u0027\u003e\n                Reverend Mother \u2192 Padishah Emperor\n            \u003c/div\u003e\n            \u003cdiv style=\u0027font-size: 11px; color: #e8eaed; margin-bottom: 8px;\u0027\u003e\n                Confidence: \u003cspan style=\u0027color: #8ab4f8;\u0027\u003e0.90\u003c/span\u003e\n            \u003c/div\u003e\n        \n            \u003cdiv style=\u0027padding-top: 8px; border-top: 1px solid #3c4043;\u0027\u003e\n                \u003cdiv style=\u0027font-size: 10px; color: #9aa0a6; margin-bottom: 4px;\u0027\u003eEvidence:\u003c/div\u003e\n                \u003cdiv style=\u0027font-size: 11px; color: #e8eaed; font-style: italic;\u0027\u003e\n                    \"\"Summon Count Fenring from his quarters,\" the Reverend Mother said. The Padishah Emperor nodded, waved for one of his aides to obey that command.\"\n                \u003c/div\u003e\n            \u003c/div\u003e\n            \u003c/div\u003e", "to": "Padishah Emperor", "width": 3.65}, {"arrows": {"to": {"enabled": true, "scaleFactor": 0.5}}, "color": {"color": "#fdd663", "opacity": 0.9400000000000001}, "dashes": false, "from": "Emperor", "label": "LEADS", "smooth": {"type": "cubicBezier"}, "title": "\n        \u003cdiv style=\u0027font-family: Inter, sans-serif; max-width: 300px;\u0027\u003e\n            \u003cdiv style=\u0027font-size: 16px; font-weight: 600; margin-bottom: 4px; color: #fdd663;\u0027\u003e\n                LEADS\n            \u003c/div\u003e\n            \u003cdiv style=\u0027font-size: 12px; color: #9aa0a6; margin-bottom: 8px;\u0027\u003e\n                Emperor \u2192 Empire\n            \u003c/div\u003e\n            \u003cdiv style=\u0027font-size: 11px; color: #e8eaed; margin-bottom: 8px;\u0027\u003e\n                Confidence: \u003cspan style=\u0027color: #fdd663;\u0027\u003e0.90\u003c/span\u003e\n            \u003c/div\u003e\n        \n            \u003cdiv style=\u0027padding-top: 8px; border-top: 1px solid #3c4043;\u0027\u003e\n                \u003cdiv style=\u0027font-size: 10px; color: #9aa0a6; margin-bottom: 4px;\u0027\u003eEvidence:\u003c/div\u003e\n                \u003cdiv style=\u0027font-size: 11px; color: #e8eaed; font-style: italic;\u0027\u003e\n                    \"the Emperor orders it\"\n                \u003c/div\u003e\n            \u003c/div\u003e\n            \u003c/div\u003e", "to": "Empire", "width": 3.65}, {"arrows": {"to": {"enabled": true, "scaleFactor": 0.5}}, "color": {"color": "#8ab4f8", "opacity": 0.9400000000000001}, "dashes": false, "from": "Emperor", "label": "INTERESTED_IN", "smooth": {"type": "cubicBezier"}, "title": "\n        \u003cdiv style=\u0027font-family: Inter, sans-serif; max-width: 300px;\u0027\u003e\n            \u003cdiv style=\u0027font-size: 16px; font-weight: 600; margin-bottom: 4px; color: #8ab4f8;\u0027\u003e\n                INTERESTED_IN\n            \u003c/div\u003e\n            \u003cdiv style=\u0027font-size: 12px; color: #9aa0a6; margin-bottom: 8px;\u0027\u003e\n                Emperor \u2192 smuggling operations on Arrakis\n            \u003c/div\u003e\n            \u003cdiv style=\u0027font-size: 11px; color: #e8eaed; margin-bottom: 8px;\u0027\u003e\n                Confidence: \u003cspan style=\u0027color: #8ab4f8;\u0027\u003e0.90\u003c/span\u003e\n            \u003c/div\u003e\n        \n            \u003cdiv style=\u0027padding-top: 8px; border-top: 1px solid #3c4043;\u0027\u003e\n                \u003cdiv style=\u0027font-size: 10px; color: #9aa0a6; margin-bottom: 4px;\u0027\u003eEvidence:\u003c/div\u003e\n                \u003cdiv style=\u0027font-size: 11px; color: #e8eaed; font-style: italic;\u0027\u003e\n                    \"indicating the Emperor\u0027s interest in smuggling operations on Arrakis\"\n                \u003c/div\u003e\n            \u003c/div\u003e\n            \u003c/div\u003e", "to": "smuggling operations on Arrakis", "width": 3.65}, {"arrows": {"to": {"enabled": true, "scaleFactor": 0.5}}, "color": {"color": "#81c995", "opacity": 0.9400000000000001}, "dashes": false, "from": "Emperor", "label": "FRIENDS_WITH", "smooth": {"type": "cubicBezier"}, "title": "\n        \u003cdiv style=\u0027font-family: Inter, sans-serif; max-width: 300px;\u0027\u003e\n            \u003cdiv style=\u0027font-size: 16px; font-weight: 600; margin-bottom: 4px; color: #81c995;\u0027\u003e\n                FRIENDS_WITH\n            \u003c/div\u003e\n            \u003cdiv style=\u0027font-size: 12px; color: #9aa0a6; margin-bottom: 8px;\u0027\u003e\n                Emperor \u2192 his friends\n            \u003c/div\u003e\n            \u003cdiv style=\u0027font-size: 11px; color: #e8eaed; margin-bottom: 8px;\u0027\u003e\n                Confidence: \u003cspan style=\u0027color: #81c995;\u0027\u003e0.90\u003c/span\u003e\n            \u003c/div\u003e\n        \n            \u003cdiv style=\u0027padding-top: 8px; border-top: 1px solid #3c4043;\u0027\u003e\n                \u003cdiv style=\u0027font-size: 10px; color: #9aa0a6; margin-bottom: 4px;\u0027\u003eEvidence:\u003c/div\u003e\n                \u003cdiv style=\u0027font-size: 11px; color: #e8eaed; font-style: italic;\u0027\u003e\n                    \"The Emperor and his friends now command fifty-nine point six-five per cent of the CHOAM directorship\u0027s votes.\"\n                \u003c/div\u003e\n            \u003c/div\u003e\n            \u003c/div\u003e", "to": "his friends", "width": 3.65}, {"arrows": {"to": {"enabled": true, "scaleFactor": 0.5}}, "color": {"color": "#8ab4f8", "opacity": 0.9400000000000001}, "dashes": false, "from": "Emperor", "label": "ORDERS", "smooth": {"type": "cubicBezier"}, "title": "\n        \u003cdiv style=\u0027font-family: Inter, sans-serif; max-width: 300px;\u0027\u003e\n            \u003cdiv style=\u0027font-size: 16px; font-weight: 600; margin-bottom: 4px; color: #8ab4f8;\u0027\u003e\n                ORDERS\n            \u003c/div\u003e\n            \u003cdiv style=\u0027font-size: 12px; color: #9aa0a6; margin-bottom: 8px;\u0027\u003e\n                Emperor \u2192 Paul Atreides\n            \u003c/div\u003e\n            \u003cdiv style=\u0027font-size: 11px; color: #e8eaed; margin-bottom: 8px;\u0027\u003e\n                Confidence: \u003cspan style=\u0027color: #8ab4f8;\u0027\u003e0.90\u003c/span\u003e\n            \u003c/div\u003e\n        \n            \u003cdiv style=\u0027padding-top: 8px; border-top: 1px solid #3c4043;\u0027\u003e\n                \u003cdiv style=\u0027font-size: 10px; color: #9aa0a6; margin-bottom: 4px;\u0027\u003eEvidence:\u003c/div\u003e\n                \u003cdiv style=\u0027font-size: 11px; color: #e8eaed; font-style: italic;\u0027\u003e\n                    \"Because the Emperor ordered it.\"\n                \u003c/div\u003e\n            \u003c/div\u003e\n            \u003c/div\u003e", "to": "Paul Atreides", "width": 3.65}, {"arrows": {"to": {"enabled": true, "scaleFactor": 0.5}}, "color": {"color": "#8ab4f8", "opacity": 0.9400000000000001}, "dashes": false, "from": "Emperor", "label": "CALLS", "smooth": {"type": "cubicBezier"}, "title": "\n        \u003cdiv style=\u0027font-family: Inter, sans-serif; max-width: 300px;\u0027\u003e\n            \u003cdiv style=\u0027font-size: 16px; font-weight: 600; margin-bottom: 4px; color: #8ab4f8;\u0027\u003e\n                CALLS\n            \u003c/div\u003e\n            \u003cdiv style=\u0027font-size: 12px; color: #9aa0a6; margin-bottom: 8px;\u0027\u003e\n                Emperor \u2192 Paul Atreides\n            \u003c/div\u003e\n            \u003cdiv style=\u0027font-size: 11px; color: #e8eaed; margin-bottom: 8px;\u0027\u003e\n                Confidence: \u003cspan style=\u0027color: #8ab4f8;\u0027\u003e0.90\u003c/span\u003e\n            \u003c/div\u003e\n        \n            \u003cdiv style=\u0027padding-top: 8px; border-top: 1px solid #3c4043;\u0027\u003e\n                \u003cdiv style=\u0027font-size: 10px; color: #9aa0a6; margin-bottom: 4px;\u0027\u003eEvidence:\u003c/div\u003e\n                \u003cdiv style=\u0027font-size: 11px; color: #e8eaed; font-style: italic;\u0027\u003e\n                    \"Only the Emperor calls the Atreides the Red Duke.\"\n                \u003c/div\u003e\n            \u003c/div\u003e\n            \u003c/div\u003e", "to": "Paul Atreides", "width": 3.65}, {"arrows": {"to": {"enabled": true, "scaleFactor": 0.5}}, "color": {"color": "#fdd663", "opacity": 0.88}, "dashes": false, "from": "Emperor", "label": "LEADS", "smooth": {"type": "cubicBezier"}, "title": "\n        \u003cdiv style=\u0027font-family: Inter, sans-serif; max-width: 300px;\u0027\u003e\n            \u003cdiv style=\u0027font-size: 16px; font-weight: 600; margin-bottom: 4px; color: #fdd663;\u0027\u003e\n                LEADS\n            \u003c/div\u003e\n            \u003cdiv style=\u0027font-size: 12px; color: #9aa0a6; margin-bottom: 8px;\u0027\u003e\n                Emperor \u2192 Duke Leto Atreides\n            \u003c/div\u003e\n            \u003cdiv style=\u0027font-size: 11px; color: #e8eaed; margin-bottom: 8px;\u0027\u003e\n                Confidence: \u003cspan style=\u0027color: #fdd663;\u0027\u003e0.80\u003c/span\u003e\n            \u003c/div\u003e\n        \n            \u003cdiv style=\u0027padding-top: 8px; border-top: 1px solid #3c4043;\u0027\u003e\n                \u003cdiv style=\u0027font-size: 10px; color: #9aa0a6; margin-bottom: 4px;\u0027\u003eEvidence:\u003c/div\u003e\n                \u003cdiv style=\u0027font-size: 11px; color: #e8eaed; font-style: italic;\u0027\u003e\n                    \"the Emperor\u0027s private note to his \"Noble Duke\"\"\n                \u003c/div\u003e\n            \u003c/div\u003e\n            \u003c/div\u003e", "to": "Duke Leto Atreides", "width": 3.3000000000000003}, {"arrows": {"to": {"enabled": true, "scaleFactor": 0.5}}, "color": {"color": "#f28b82", "opacity": 0.88}, "dashes": false, "from": "Emperor", "label": "HATES", "smooth": {"type": "cubicBezier"}, "title": "\n        \u003cdiv style=\u0027font-family: Inter, sans-serif; max-width: 300px;\u0027\u003e\n            \u003cdiv style=\u0027font-size: 16px; font-weight: 600; margin-bottom: 4px; color: #f28b82;\u0027\u003e\n                HATES\n            \u003c/div\u003e\n            \u003cdiv style=\u0027font-size: 12px; color: #9aa0a6; margin-bottom: 8px;\u0027\u003e\n                Emperor \u2192 barbarians\n            \u003c/div\u003e\n            \u003cdiv style=\u0027font-size: 11px; color: #e8eaed; margin-bottom: 8px;\u0027\u003e\n                Confidence: \u003cspan style=\u0027color: #f28b82;\u0027\u003e0.80\u003c/span\u003e\n            \u003c/div\u003e\n        \n            \u003cdiv style=\u0027padding-top: 8px; border-top: 1px solid #3c4043;\u0027\u003e\n                \u003cdiv style=\u0027font-size: 10px; color: #9aa0a6; margin-bottom: 4px;\u0027\u003eEvidence:\u003c/div\u003e\n                \u003cdiv style=\u0027font-size: 11px; color: #e8eaed; font-style: italic;\u0027\u003e\n                    \"the disdainful allusions to veiled men and women: \" . . . but what else is one to expect of barbarians\"\n                \u003c/div\u003e\n            \u003c/div\u003e\n            \u003c/div\u003e", "to": "barbarians", "width": 3.3000000000000003}, {"arrows": {"to": {"enabled": true, "scaleFactor": 0.5}}, "color": {"color": "#8ab4f8", "opacity": 0.8200000000000001}, "dashes": false, "from": "Emperor", "label": "WORKS_FOR", "smooth": {"type": "cubicBezier"}, "title": "\n        \u003cdiv style=\u0027font-family: Inter, sans-serif; max-width: 300px;\u0027\u003e\n            \u003cdiv style=\u0027font-size: 16px; font-weight: 600; margin-bottom: 4px; color: #8ab4f8;\u0027\u003e\n                WORKS_FOR\n            \u003c/div\u003e\n            \u003cdiv style=\u0027font-size: 12px; color: #9aa0a6; margin-bottom: 8px;\u0027\u003e\n                Emperor \u2192 Harkonnen\n            \u003c/div\u003e\n            \u003cdiv style=\u0027font-size: 11px; color: #e8eaed; margin-bottom: 8px;\u0027\u003e\n                Confidence: \u003cspan style=\u0027color: #8ab4f8;\u0027\u003e0.70\u003c/span\u003e\n            \u003c/div\u003e\n        \n            \u003cdiv style=\u0027padding-top: 8px; border-top: 1px solid #3c4043;\u0027\u003e\n                \u003cdiv style=\u0027font-size: 10px; color: #9aa0a6; margin-bottom: 4px;\u0027\u003eEvidence:\u003c/div\u003e\n                \u003cdiv style=\u0027font-size: 11px; color: #e8eaed; font-style: italic;\u0027\u003e\n                    \"The Emperor will put a Harkonnen back in power here\"\n                \u003c/div\u003e\n            \u003c/div\u003e\n            \u003c/div\u003e", "to": "Harkonnen", "width": 2.9499999999999997}, {"arrows": {"to": {"enabled": true, "scaleFactor": 0.5}}, "color": {"color": "#f28b82", "opacity": 0.88}, "dashes": false, "from": "Emperor", "label": "HATES", "smooth": {"type": "cubicBezier"}, "title": "\n        \u003cdiv style=\u0027font-family: Inter, sans-serif; max-width: 300px;\u0027\u003e\n            \u003cdiv style=\u0027font-size: 16px; font-weight: 600; margin-bottom: 4px; color: #f28b82;\u0027\u003e\n                HATES\n            \u003c/div\u003e\n            \u003cdiv style=\u0027font-size: 12px; color: #9aa0a6; margin-bottom: 8px;\u0027\u003e\n                Emperor \u2192 Fremen\n            \u003c/div\u003e\n            \u003cdiv style=\u0027font-size: 11px; color: #e8eaed; margin-bottom: 8px;\u0027\u003e\n                Confidence: \u003cspan style=\u0027color: #f28b82;\u0027\u003e0.80\u003c/span\u003e\n            \u003c/div\u003e\n        \n            \u003cdiv style=\u0027padding-top: 8px; border-top: 1px solid #3c4043;\u0027\u003e\n                \u003cdiv style=\u0027font-size: 10px; color: #9aa0a6; margin-bottom: 4px;\u0027\u003eEvidence:\u003c/div\u003e\n                \u003cdiv style=\u0027font-size: 11px; color: #e8eaed; font-style: italic;\u0027\u003e\n                    \"They needed practice in killing . . . and they hate to see a task left undone.\"\n                \u003c/div\u003e\n            \u003c/div\u003e\n            \u003c/div\u003e", "to": "Fremen", "width": 3.3000000000000003}, {"arrows": {"to": {"enabled": true, "scaleFactor": 0.5}}, "color": {"color": "#8ab4f8", "opacity": 0.9400000000000001}, "dashes": false, "from": "Emperor", "label": "PARTICIPATES_IN", "smooth": {"type": "cubicBezier"}, "title": "\n        \u003cdiv style=\u0027font-family: Inter, sans-serif; max-width: 300px;\u0027\u003e\n            \u003cdiv style=\u0027font-size: 16px; font-weight: 600; margin-bottom: 4px; color: #8ab4f8;\u0027\u003e\n                PARTICIPATES_IN\n            \u003c/div\u003e\n            \u003cdiv style=\u0027font-size: 12px; color: #9aa0a6; margin-bottom: 8px;\u0027\u003e\n                Emperor \u2192 rid him of the troublesome Duke\n            \u003c/div\u003e\n            \u003cdiv style=\u0027font-size: 11px; color: #e8eaed; margin-bottom: 8px;\u0027\u003e\n                Confidence: \u003cspan style=\u0027color: #8ab4f8;\u0027\u003e0.90\u003c/span\u003e\n            \u003c/div\u003e\n        \n            \u003cdiv style=\u0027padding-top: 8px; border-top: 1px solid #3c4043;\u0027\u003e\n                \u003cdiv style=\u0027font-size: 10px; color: #9aa0a6; margin-bottom: 4px;\u0027\u003eEvidence:\u003c/div\u003e\n                \u003cdiv style=\u0027font-size: 11px; color: #e8eaed; font-style: italic;\u0027\u003e\n                    \"I rid him of the troublesome Duke.\"\n                \u003c/div\u003e\n            \u003c/div\u003e\n            \u003c/div\u003e", "to": "rid him of the troublesome Duke", "width": 3.65}, {"arrows": {"to": {"enabled": true, "scaleFactor": 0.5}}, "color": {"color": "#8ab4f8", "opacity": 0.9400000000000001}, "dashes": false, "from": "Emperor", "label": "WORKS_FOR", "smooth": {"type": "cubicBezier"}, "title": "\n        \u003cdiv style=\u0027font-family: Inter, sans-serif; max-width: 300px;\u0027\u003e\n            \u003cdiv style=\u0027font-size: 16px; font-weight: 600; margin-bottom: 4px; color: #8ab4f8;\u0027\u003e\n                WORKS_FOR\n            \u003c/div\u003e\n            \u003cdiv style=\u0027font-size: 12px; color: #9aa0a6; margin-bottom: 8px;\u0027\u003e\n                Emperor \u2192 Count\n            \u003c/div\u003e\n            \u003cdiv style=\u0027font-size: 11px; color: #e8eaed; margin-bottom: 8px;\u0027\u003e\n                Confidence: \u003cspan style=\u0027color: #8ab4f8;\u0027\u003e0.90\u003c/span\u003e\n            \u003c/div\u003e\n        \n            \u003cdiv style=\u0027padding-top: 8px; border-top: 1px solid #3c4043;\u0027\u003e\n                \u003cdiv style=\u0027