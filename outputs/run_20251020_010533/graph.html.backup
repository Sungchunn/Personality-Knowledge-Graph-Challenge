an style=\u0027color: #81c995;\u0027\u003e0.90\u003c/span\u003e\n            \u003c/div\u003e\n        \n            \u003cdiv style=\u0027padding-top: 8px; border-top: 1px solid #3c4043;\u0027\u003e\n                \u003cdiv style=\u0027font-size: 10px; color: #9aa0a6; margin-bottom: 4px;\u0027\u003eEvidence:\u003c/div\u003e\n                \u003cdiv style=\u0027font-size: 11px; color: #e8eaed; font-style: italic;\u0027\u003e\n                    \"How did you trick my mother into leaving me alone with you?\"\n                \u003c/div\u003e\n            \u003c/div\u003e\n            \u003c/div\u003e", "to": "mother", "width": 3.65}, {"arrows": {"to": {"enabled": true, "scaleFactor": 0.5}}, "color": {"color": "#8ab4f8", "opacity": 0.9400000000000001}, "dashes": false, "from": "Paul Atreides", "label": "PARTICIPATES_IN", "smooth": {"type": "cubicBezier"}, "title": "\n        \u003cdiv style=\u0027font-family: Inter, sans-serif; max-width: 300px;\u0027\u003e\n            \u003cdiv style=\u0027font-size: 16px; font-weight: 600; margin-bottom: 4px; color: #8ab4f8;\u0027\u003e\n                PARTICIPATES_IN\n            \u003c/div\u003e\n            \u003cdiv style=\u0027font-size: 12px; color: #9aa0a6; margin-bottom: 8px;\u0027\u003e\n                Paul Atreides \u2192 test\n            \u003c/div\u003e\n            \u003cdiv style=\u0027font-size: 11px; color: #e8eaed; margin-bottom: 8px;\u0027\u003e\n                Confidence: \u003cspan style=\u0027color: #8ab4f8;\u0027\u003e0.90\u003c/span\u003e\n            \u003c/div\u003e\n        \n            \u003cdiv style=\u0027padding-top: 8px; border-top: 1px solid #3c4043;\u0027\u003e\n                \u003cdiv style=\u0027font-size: 10px; color: #9aa0a6; margin-bottom: 4px;\u0027\u003eEvidence:\u003c/div\u003e\n                \u003cdiv style=\u0027font-size: 11px; color: #e8eaed; font-style: italic;\u0027\u003e\n                    \"Your mother survived this test. Now it\u0027s your turn.\"\n                \u003c/div\u003e\n            \u003c/div\u003e\n            \u003c/div\u003e", "to": "test", "width": 3.65}, {"arrows": {"to": {"enabled": true, "scaleFactor": 0.5}}, "color": {"color": "#8ab4f8", "opacity": 0.88}, "dashes": false, "from": "Paul Atreides", "label": "PARTICIPATES_IN", "smooth": {"type": "cubicBezier"}, "title": "\n        \u003cdiv style=\u0027font-family: Inter, sans-serif; max-width: 300px;\u0027\u003e\n            \u003cdiv style=\u0027font-size: 16px; font-weight: 600; margin-bottom: 4px; color: #8ab4f8;\u0027\u003e\n                PARTICIPATES_IN\n            \u003c/div\u003e\n            \u003cdiv style=\u0027font-size: 12px; color: #9aa0a6; margin-bottom: 8px;\u0027\u003e\n                Paul Atreides \u2192 Bene Gesserit rite\n            \u003c/div\u003e\n            \u003cdiv style=\u0027font-size: 11px; color: #e8eaed; margin-bottom: 8px;\u0027\u003e\n                Confidence: \u003cspan style=\u0027color: #8ab4f8;\u0027\u003e0.80\u003c/span\u003e\n            \u003c/div\u003e\n        \n            \u003cdiv style=\u0027padding-top: 8px; border-top: 1px solid #3c4043;\u0027\u003e\n                \u003cdiv style=\u0027font-size: 10px; color: #9aa0a6; margin-bottom: 4px;\u0027\u003eEvidence:\u003c/div\u003e\n                \u003cdiv style=\u0027font-size: 11px; color: #e8eaed; font-style: italic;\u0027\u003e\n                    \"the Litany against Fear as his mother had taught him out of the Bene Gesserit rite.\"\n                \u003c/div\u003e\n            \u003c/div\u003e\n            \u003c/div\u003e", "to": "Bene Gesserit rite", "width": 3.3000000000000003}, {"arrows": {"to": {"enabled": true, "scaleFactor": 0.5}}, "color": {"color": "#8ab4f8", "opacity": 0.9400000000000001}, "dashes": false, "from": "Paul Atreides", "label": "KNOWS", "smooth": {"type": "cubicBezier"}, "title": "\n        \u003cdiv style=\u0027font-family: Inter, sans-serif; max-width: 300px;\u0027\u003e\n            \u003cdiv style=\u0027font-size: 16px; font-w