rgin-bottom: 4px; color: #8ab4f8;\u0027\u003e\n                LOCATED_IN\n            \u003c/div\u003e\n            \u003cdiv style=\u0027font-size: 12px; color: #9aa0a6; margin-bottom: 8px;\u0027\u003e\n                Count Hasimir Fenring \u2192 Salusa Secundus\n            \u003c/div\u003e\n            \u003cdiv style=\u0027font-size: 11px; color: #e8eaed; margin-bottom: 8px;\u0027\u003e\n                Confidence: \u003cspan style=\u0027color: #8ab4f8;\u0027\u003e0.90\u003c/span\u003e\n            \u003c/div\u003e\n        \n            \u003cdiv style=\u0027padding-top: 8px; border-top: 1px solid #3c4043;\u0027\u003e\n                \u003cdiv style=\u0027font-size: 10px; color: #9aa0a6; margin-bottom: 4px;\u0027\u003eEvidence:\u003c/div\u003e\n                \u003cdiv style=\u0027font-size: 11px; color: #e8eaed; font-style: italic;\u0027\u003e\n                    \"He joined Shaddam IV in retirement on Salusa Secundus.\"\n                \u003c/div\u003e\n            \u003c/div\u003e\n            \u003c/div\u003e", "to": "Salusa Secundus", "width": 3.65}, {"arrows": {"to": {"enabled": true, "scaleFactor": 0.5}}, "color": {"color": "#81c995", "opacity": 0.9400000000000001}, "dashes": false, "from": "Count", "label": "FAMILY_OF", "smooth": {"type": "cubicBezier"}, "title": "\n        \u003cdiv style=\u0027font-family: Inter, sans-serif; max-width: 300px;\u0027\u003e\n            \u003cdiv style=\u0027font-size: 16px; font-weight: 600; margin-bottom: 4px; color: #81c995;\u0027\u003e\n                FAMILY_OF\n            \u003c/div\u003e\n            \u003cdiv style=\u0027font-size: 12px; color: #9aa0a6; margin-bottom: 8px;\u0027\u003e\n                Count \u2192 Lady\n            \u003c/div\u003e\n            \u003cdiv style=\u0027font-size: 11px; color: #e8eaed; margin-bottom: 8px;\u0027\u003e\n                Confidence: \u003cspan style=\u0027color: #81c995;\u0027\u003e0.90\u003c/span\u003e\n            \u003c/div\u003e\n        \n            \u003cdiv style=\u0027padding-top: 8px; border-top: 1px solid #3c4043;\u0027\u003e\n                \u003cdiv style=\u0027font-size: 10px; color: #9aa0a6; margin-bottom: 4px;\u0027\u003eEvidence:\u003c/div\u003e\n                \u003cdiv style=\u0027font-size: 11px; color: #e8eaed; font-style: italic;\u0027\u003e\n                    \"The Count married his Lady.\"\n                \u003c/div\u003e\n            \u003c/div\u003e\n            \u003c/div\u003e", "to": "Lady", "width": 3.65}, {"arrows": {"to": {"enabled": true, "scaleFactor": 0.5}}, "color": {"color": "#8ab4f8", "opacity": 0.9400000000000001}, "dashes": false, "from": "Count", "label": "PARTICIPATES_IN", "smooth": {"type": "cubicBezier"}, "title": "\n        \u003cdiv style=\u0027font-family: Inter, sans-serif; max-width: 300px;\u0027\u003e\n            \u003cdiv style=\u0027font-size: 16px; font-weight: 600; margin-bottom: 4px; color: #8ab4f8;\u0027\u003e\n                PARTICIPATES_IN\n            \u003c/div\u003e\n            \u003cdiv style=\u0027font-size: 12px; color: #9aa0a6; margin-bottom: 8px;\u0027\u003e\n                Count \u2192 arena gathering\n            \u003c/div\u003e\n            \u003cdiv style=\u0027font-size: 11px; color: #e8eaed; margin-bottom: 8px;\u0027\u003e\n                Confidence: \u003cspan style=\u0027color: #8ab4f8;\u0027\u003e0.90\u003c/span\u003e\n            \u003c/div\u003e\n        \n            \u003cdiv style=\u0027padding-top: 8px; border-top: 1px solid #3c4043;\u0027\u003e\n                \u003cdiv style=\u0027font-size: 10px; color: #9aa0a6; margin-bottom: 4px;\u0027\u003eEvidence:\u003c/div\u003e\n                \u003cdiv style=\u0027font-size: 11px; color: #e8eaed; font-style: italic;\u0027\u003e\n                    \"It\u0027s time to go to the arena.\"\n                \u003c/div\u003e\n            \u003c/div\u003e\n            \u003c/div\u003e", "to": "arena gathering", "width": 3.65}, {"arrows": {"to": {"enabled": true, "scaleFactor": 0.5}}, "color": {"color": "#fdd663", "opacity": 0.9400000000000001}, "dashes": false, "from": "Count", "label": "LEADS", "smooth": {"type": "cubicBezier"}, "title": "\n        \u003cdiv style=\u0027font-family: Inter, sans-serif; max-width: 300px;\u0027\u003e\n            \u003cdiv style=\u0027font-size: 16px; font-weight: 600; margin-bottom: 4px; color: #fdd663;\u0027\u003e\n                LEADS\n            \u003c/div\u003e\n            \u003cdiv style=\u0027font-size: 12px; color: #9aa0a6; margin-bottom: 8px;\u0027\u003e\n                Count \u2192 Count\u0027s lady\n            \u003c/div\u003e\n            \u003cdiv style=\u0027font-size: 11px; color: #e8eaed; margin-bottom: 8px;\u0027\u003e\n                Confidence: \u003cspan style=\u0027color: #fdd663;\u0027\u003e0.90\u003c/span\u003e\n            \u003c/div\u003e\n        \n            \u003cdiv style=\u0027padding-top: 8px; border-top: 1px solid #3c4043;\u0027\u003e\n                \u003cdiv style=\u0027font-size: 10px; color: #9aa0a6; margin-bottom: 4px;\u0027\u003eEvidence:\u003c/div\u003e\n                \u003cdiv style=\u0027font-size: 11px; color: #e8eaed; font-style: italic;\u0027\u003e\n                    \"the Count\u0027s lady come through the guards beyond to join the party in the golden box\"\n                \u003c/div\u003e\n            \u003c/div\u003e\n            \u003c/div\u003e", "to": "Count\u0027s lady", "width": 3.65}, {"arrows": {"to": {"enabled": true, "scaleFactor": 0.5}}, "color": {"color": "#81c995", "opacity": 0.9400000000000001}, "dashes": false, "from": "Count", "label": "FRIENDS_WITH", "smooth": {"type": "cubicBezier"}, "title": "\n        \u003cdiv style=\u0027font-family: Inter, sans-serif; max-width: 300px;\u0027\u003e\n            \u003cdiv style=\u0027font-size: 16px; font-weight: 600; margin-bottom: 4px; color: #81c995;\u0027\u003e\n                FRIENDS_WITH\n            \u003c/div\u003e\n            \u003cdiv style=\u0027font-size: 12px; color: #9aa0a6; margin-bottom: 8px;\u0027\u003e\n                Count \u2192 Emperor\n            \u003c/div\u003e\n            \u003cdiv style=\u0027font-size: 11px; color: #e8eaed; margin-bottom: 8px;\u0027\u003e\n                Confidence: \u003cspan style=\u0027color: #81c995;\u0027\u003e0.90\u003c/span\u003e\n            \u003c/div\u003e\n        \n            \u003cdiv style=\u0027padding-top: 8px; border-top: 1px solid #3c4043;\u0027\u003e\n                \u003cdiv style=\u0027font-size: 10px; color: #9aa0a6; margin-bottom: 4px;\u0027\u003eEvidence:\u003c/div\u003e\n                \u003cdiv style=\u0027font-size: 11px; color: #e8eaed; font-style: italic;\u0027\u003e\n                    \"We have been friends, Majesty.\"\n                \u003c/div\u003e\n            \u003c/div\u003e\n            \u003c/div\u003e", "to": "Emperor", "width": 3.65}, {"arrows": {"to": {"enabled": true, "scaleFactor": 0.5}}, "color": {"color": "#8ab4f8", "opacity": 0.9400000000000001}, "dashes": false, "from": "Harkonnen agents", "label": "MEMBER_OF", "smooth": {"type": "cubicBezier"}, "title": "\n        \u003cdiv style=\u0027font-family: Inter, sans-serif; max-width: 300px;\u0027\u003e\n            \u003cdiv style=\u0027font-size: 16px; font-weight: 600; margin-bottom: 4px; color: #8ab4f8;\u0027\u003e\n                MEMBER_OF\n            \u003c/div\u003e\n            \u003cdiv style=\u0027font-size: 12px; color: #9aa0a6; margin-bottom: 8px;\u0027\u003e\n                Harkonnen agents \u2192 Harkonnen\n            \u003c/div\u003e\n            \u003cdiv style=\u0027font-size: 11px; color: #e8eaed; margin-bottom: 8px;\u0027\u003e\n                Confidence: \u003cspan style=\u0027color: #8ab4f8;\u0027\u003e0.90\u003c/span\u003e\n            \u003c/div\u003e\n        \n            \u003cdiv style=\u0027padding-top: 8px; border-top: 1px solid #3c4043;\u0027\u003e\n                \u003cdiv style=\u0027font-size: 10px; color: #9aa0a6; margin-bottom: 4px;\u0027\u003eEvidence:\u003c/div\u003e\n                \u003cdiv style=\u0027font-size: 11px; color: #e8eaed; font-style: italic;\u0027\u003e\n                    \"A Harkonnen agent in the crew\"\n                \u003c/div\u003e\n            \u003c/div\u003e\n            \u003c/div\u003e", "to": "Harkonnen", "width": 3.65}, {"arrows": {"to": {"enabled": true, "scaleFactor": 0.5}}, "color": {"color": "#8ab4f8", "opacity": 0.88}, "dashes": false, "from": "Harkonnen agents", "label": "PARTICIPATES_IN", "smooth": {"type": "cubicBezier"}, "title": "\n        \u003cdiv style=\u0027font-family: Inter, sans-serif; max-width: 300px;\u0027\u003e\n            \u003cdiv style=\u0027font-size: 16px; font-weight: 600; margin-bottom: 4px; color: #8ab4f8;\u0027\u003e\n                PARTICIPATES_IN\n            \u003c/div\u003e\n            \u003cdiv style=\u0027font-size: 12px; color: #9aa0a6; margin-bottom: 8px;\u0027\u003e\n                Harkonnen agents \u2192 smugglers\u0027 base\n            \u003c/div\u003e\n            \u003cdiv style=\u0027font-size: 11px; color: #e8eaed; margin-bottom: 8px;\u0027\u003e\n                Confidence: \u003cspan style=\u0027color: #8ab4f8;\u0027\u003e0.80\u003c/span\u003e\n            \u003c/div\u003e\n        \n            \u003cdiv style=\u0027padding-top: 8px; border-top: 1px solid #3c4043;\u0027\u003e\n                \u003cdiv style=\u0027font-size: 10px; color: #9aa0a6; margin-bottom: 4px;\u0027\u003eEvidence:\u003c/div\u003e\n                \u003cdiv style=\u0027font-size: 11px; color: #e8eaed; font-style: italic;\u0027\u003e\n                    \"flew the machine to a smugglers\u0027 base, hoping to sell it there.\"\n                \u003c/div\u003e\n            \u003c/div\u003e\n            \u003c/div\u003e", "to": "smugglers\u0027 base", "width": 3.3000000000000003}, {"arrows": {"to": {"enabled": true, "scaleFactor": 0.5}}, "color": {"color": "#8ab4f8", "opacity": 0.9400000000000001}, "dashes": false, "from": "Thufir", "label": "WORKS_FOR", "smooth": {"type": "cubicBezier"}, "title": "\n        \u003cdiv style=\u0027font-family: Inter, sans-serif; max-width: 300px;\u0027\u003e\n            \u003cdiv style=\u0027font-size: 16px; font-weight: 600; margin-bottom: 4px; color: #8ab4f8;\u0027\u003e\n                WORKS_FOR\n            \u003c/div\u003e\n            \u003cdiv style=\u0027font-size: 12px; color: #9aa0a6; margin-bottom: 8px;\u0027\u003e\n                Thufir \u2192 Duke\n            \u003c/div\u003e\n            \u003cdiv style=\u0027font-size: 11px; color: #e8eaed; margin-bottom: 8px;\u0027\u003e\n                Confidence: \u003cspan style=\u0027color: #8ab4f8;\u0027\u003e0.90\u003c/span\u003e\n            \u003c/div\u003e\n        \n            \u003cdiv style=\u0027padding-top: 8px; border-top: 1px solid #3c4043;\u0027\u003e\n                \u003cdiv style=\u0027font-size: 10px; color: #9aa0a6; margin-bottom: 4px;\u0027\u003eEvidence:\u003c/div\u003e\n                \u003cdiv style=\u0027font-size: 11px; color: #e8eaed; font-style: italic;\u0027\u003e\n                    \"\"How many men can you let Hawat have?\" the Duke asked.\"\n                \u003c/div\u003e\n            \u003c/div\u003e\n            \u003c/div\u003e", "to": "Duke", "width": 3.65}, {"arrows": {"to": {"enabled": true, "scaleFactor": 0.5}}, "color": {"color": "#8ab4f8", "opacity": 0.9400000000000001}, "dashes": false, "from": "Thufir", "label": "KNOWS", "smooth": {"type": "cubicBezier"}, "title": "\n        \u003cdiv style=\u0027font-family: Inter, sans-serif; max-width: 300px;\u0027\u003e\n            \u003cdiv style=\u0027font-size: 16px; font-weight: 600; margin-bottom: 4px; color: #8ab4f8;\u0027\u003e\n                KNOWS\n            \u003c/div\u003e\n            \u003cdiv style=\u0027font-size: 12px; color: #9aa0a6; margin-bottom: 8px;\u0027\u003e\n                Thufir \u2192 Duke\n            \u003c/div\u003e\n            \u003cdiv style=\u0027font-size: 11px; color: #e8eaed; margin-bottom: 8px;\u0027\u003e\n                Confidence: \u003cspan style=\u0027color: #8ab4f8;\u0027\u003e0.90\u003c/span\u003e\n            \u003c/div\u003e\n        \n            \u003cdiv style=\u0027padding-top: 8px; border-top: 1px solid #3c4043;\u0027\u003e\n                \u003cdiv style=\u0027font-size: 10px; color: #9aa0a6; margin-bottom: 4px;\u0027\u003eEvidence:\u003c/div\u003e\n                \u003cdiv style=\u0027font-size: 11px; color: #e8eaed; font-style: italic;\u0027\u003e\n                    \"A move worthy of your grandsire, my Lord.\"\n                \u003c/div\u003e\n            \u003c/div\u003e\n            \u003c/div\u003e", "to": "Duke", "width": 3.65}, {"arrows": {"to": {"enabled": true, "scaleFactor": 0.5}}, "color": {"color": "#8ab4f8", "opacity": 0.9400000000000001}, "dashes": false, "from": "Thufir", "label": "MEMBER_OF", "smooth": {"type": "cubicBezier"}, "title": "\n        \u003cdiv style=\u0027font-family: Inter, sans-serif; max-width: 300px;\u0027\u003e\n            \u003cdiv style=\u0027font-size: 16px; font-weight: 600; margin-bottom: 4px; color: #8ab4f8;\u0027\u003e\n                MEMBER_OF\n            \u003c/div\u003e\n            \u003cdiv style=\u0027font-size: 12px; color: #9aa0a6; margin-bottom: 8px;\u0027\u003e\n                Thufir \u2192 Duke\u0027s crew\n            \u003c/div\u003e\n            \u003cdiv style=\u0027font-size: 11px; color: #e8eaed; margin-bottom: 8px;\u0027\u003e\n                Confidence: \u003cspan style=\u0027color: #8ab4f8;\u0027\u003e0.90\u003c/span\u003e\n            \u003c/div\u003e\n        \n            \u003cdiv style=\u0027padding-top: 8px; border-top: 1px solid #3c4043;\u0027\u003e\n                \u003cdiv style=\u0027font-size: 10px; color: #9aa0a6; margin-bottom: 4px;\u0027\u003eEvidence:\u003c/div\u003e\n                \u003cdiv style=\u0027font-size: 11px; color: #e8eaed; font-style: italic;\u0027\u003e\n                    \"I think first we\u0027d better learn if Thufir has anything to add to his report on the Fremen,\" the Duke said. \"Thufir?\"\"\n                \u003c/div\u003e\n            \u003c/div\u003e\n            \u003c/div\u003e", "to": "Duke\u0027s crew", "width": 3.65}, {"arrows": {"to": {"enabled": true, "scaleFactor": 0.5}}, "color": {"color": "#81c995", "opacity": 0.88}, "dashes": false, "from": "Thufir", "label": "LOVES", "smooth": {"type": "cubicBezier"}, "title": "\n        \u003cdiv style=\u0027font-family: Inter, sans-serif; max-width: 300px;\u0027\u003e\n            \u003cdiv style=\u0027font-size: 16px; font-weight: 600; margin-bottom: 4px; color: #81c995;\u0027\u003e\n                LOVES\n            \u003c/div\u003e\n            \u003cdiv style=\u0027font-size: 12px; color: #9aa0a6; margin-bottom: 8px;\u0027\u003e\n                Thufir \u2192 Duke Leto\n            \u003c/div\u003e\n            \u003cdiv style=\u0027font-size: 11px; color: #e8eaed; margin-bottom: 8px;\u0027\u003e\n                Confidence: \u003cspan style=\u0027color: #81c995;\u0027\u003e0.80\u003c/span\u003e\n            \u003c/div\u003e\n        \n            \u003cdiv style=\u0027padding-top: 8px; border-top: 1px solid #3c4043;\u0027\u003e\n                \u003cdiv style=\u0027font-size: 10px; color: #9aa0a6; margin-bottom: 4px;\u0027\u003eEvidence:\u003c/div\u003e\n                \u003cdiv style=\u0027font-size: 11px; color: #e8eaed; font-style: italic;\u0027\u003e\n                    \"You and I, Thufir, of all those who love the Duke, are most ideally situated to destroy the other\u0027s place.\"\n                \u003c/div\u003e\n            \u003c/div\u003e\n            \u003c/div\u003e", "to": "Duke Leto", "width": 3.3000000000000003}, {"arrows": {"to": {"enabled": true, "scaleFactor": 0.5}}, "color": {"color": "#8ab4f8", "opacity": 0.9400000000000001}, "dashes": false, "from": "Thufir", "label": "KNOWS", "smooth": {"type": "cubicBezier"}, "title": "\n        \u003cdiv style=\u0027font-family: Inter, sans-serif; max-width: 300px;\u0027\u003e\n            \u003cdiv style=\u0027font-size: 16px; font-weight: 600; margin-bottom: 4px; color: #8ab4f8;\u0027\u003e\n                KNOWS\n            \u003c/div\u003e\n            \u003cdiv style=\u0027font-size: 12px; color: #9aa0a6; margin-bottom: 8px;\u0027\u003e\n                Thufir \u2192 Lady Jessica\n            \u003c/div\u003e\n            \u003cdiv style=\u0027font-size: 11px; color: #e8eaed; margin-bottom: 8px;\u0027\u003e\n                Confidence: \u003cspan style=\u0027color: #8ab4f8;\u0027\u003e0.90\u003c/span\u003e\n            \u003c/div\u003e\n        \n            \u003cdiv style=\u0027padding-top: 8px; border-top: 1px solid #3c4043;\u0027\u003e\n                \u003cdiv style=\u0027font-size: 10px; color: #9aa0a6; margin-bottom: 4px;\u0027\u003eEvidence:\u003c/div\u003e\n                \u003cdiv style=\u0027font-size: 11px; color: #e8eaed; font-style: italic;\u0027\u003e\n                    \"\"I don\u0027t trust your Bene Gesserit motives,\" he said.\"\n                \u003c/div\u003e\n            \u003c/div\u003e\n            \u003c/div\u003e", "to": "Lady Jessica", "width": 3.65}, {"arrows": {"to": {"enabled": true, "scaleFactor": 0.5}}, "color": {"color": "#8ab4f8", "opacity": 0.9400000000000001}, "dashes": false, "from": "Thufir", "label": "KNOWS", "smooth": {"type": "cubicBezier"}, "title": "\n        \u003cdiv style=\u0027font-family: Inter, sans-serif; max-width: 300px;\u0027\u003e\n            \u003cdiv style=\u0027font-size: 16px; font-weight: 600; margin-bottom: 4px; color: #8ab4f8;\u0027\u003e\n                KNOWS\n            \u003c/div\u003e\n            \u003cdiv style=\u0027font-size: 12px; color: #9aa0a6; margin-bottom: 8px;\u0027\u003e\n                Thufir \u2192 Jessica Atreides\n            \u003c/div\u003e\n            \u003cdiv style=\u0027font-size: 11px; color: #e8eaed; margin-bottom: 8px;\u0027\u003e\n                Confidence: \u003cspan style=\u0027color: #8ab4f8;\u0027\u003e0.90\u003c/span\u003e\n            \u003c/div\u003e\n        \n            \u003cdiv style=\u0027padding-top: 8px; border-top: 1px solid #3c4043;\u0027\u003e\n                \u003cdiv style=\u0027font-size: 10px; color: #9aa0a6; margin-bottom: 4px;\u0027\u003eEvidence:\u003c/div\u003e\n                \u003cdiv style=\u0027font-size: 11px; color: #e8eaed; font-style: italic;\u0027\u003e\n                    \"You may go now, Thufir.\"\n                \u003c/div\u003e\n            \u003c/div\u003e\n            \u003c/div\u003e", "to": "Jessica Atreides", "width": 3.65}, {"arrows": {"to": {"enabled": true, "scaleFactor": 0.5}}, "color": {"color": "#8ab4f8", "opacity": 0.9400000000000001}, "dashes": false, "from": "Thufir", "label": "MENTIONED_IN", "smooth": {"type": "cubicBezier"}, "title": "\n        \u003cdiv style=\u0027font-family: Inter, sans-serif; max-width: 300px;\u0027\u003e\n            \u003cdiv style=\u0027font-size: 16px; font-weight: 600; margin-bottom: 4px; color: #8ab4f8;\u0027\u003e\n                MENTIONED_IN\n            \u003c/div\u003e\n            \u003cdiv style=\u0027font-size: 12px; color: #9aa0a6; margin-bottom: 8px;\u0027\u003e\n                Thufir \u2192 Jessica Atreides\n            \u003c/div\u003e\n            \u003cdiv style=\u0027font-size: 11px; color: #e8eaed; margin-bottom: 8px;\u0027\u003e\n                Confidence: \u003cspan style=\u0027color: #8ab4f8;\u0027\u003e0.90\u003c/span\u003e\n            \u003c/div\u003e\n        \n            \u003cdiv style=\u0027padding-top: 8px; border-top: 1px solid #3c4043;\u0027\u003e\n                \u003cdiv style=\u0027font-size: 10px; color: #9aa0a6; margin-bottom: 4px;\u0027\u003eEvidence:\u003c/div\u003e\n                \u003cdiv style=\u0027font-size: 11px; color: #e8eaed; font-style: italic;\u0027\u003e\n                    \"he would never forget this moment nor lose this sense of supreme admiration for the Lady Jessica.\"\n                \u003c/div\u003e\n            \u003c/div\u003e\n            \u003c/div\u003e", "to": "Jessica Atreides