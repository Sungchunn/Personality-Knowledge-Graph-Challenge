c/div\u003e\n            \u003c/div\u003e", "to": "Harkonnen", "width": 2.9499999999999997}, {"arrows": {"to": {"enabled": true, "scaleFactor": 0.5}}, "color": {"color": "#8ab4f8", "opacity": 0.9400000000000001}, "dashes": false, "from": "Feyd-Rautha", "label": "LOCATED_IN", "smooth": {"type": "cubicBezier"}, "title": "\n        \u003cdiv style=\u0027font-family: Inter, sans-serif; max-width: 300px;\u0027\u003e\n            \u003cdiv style=\u0027font-size: 16px; font-weight: 600; margin-bottom: 4px; color: #8ab4f8;\u0027\u003e\n                LOCATED_IN\n            \u003c/div\u003e\n            \u003cdiv style=\u0027font-size: 12px; color: #9aa0a6; margin-bottom: 8px;\u0027\u003e\n                Feyd-Rautha \u2192 Giedi Prime\n            \u003c/div\u003e\n            \u003cdiv style=\u0027font-size: 11px; color: #e8eaed; margin-bottom: 8px;\u0027\u003e\n                Confidence: \u003cspan style=\u0027color: #8ab4f8;\u0027\u003e0.90\u003c/span\u003e\n            \u003c/div\u003e\n        \n            \u003cdiv style=\u0027padding-top: 8px; border-top: 1px solid #3c4043;\u0027\u003e\n                \u003cdiv style=\u0027font-size: 10px; color: #9aa0a6; margin-bottom: 4px;\u0027\u003eEvidence:\u003c/div\u003e\n                \u003cdiv style=\u0027font-size: 11px; color: #e8eaed; font-style: italic;\u0027\u003e\n                    \"the Harkonnen homeworld of Giedi Prime\"\n                \u003c/div\u003e\n            \u003c/div\u003e\n            \u003c/div\u003e", "to": "Giedi Prime", "width": 3.65}, {"arrows": {"to": {"enabled": true, "scaleFactor": 0.5}}, "color": {"color": "#8ab4f8", "opacity": 0.88}, "dashes": false, "from": "Feyd-Rautha", "label": "MEMBER_OF", "smooth": {"type": "cubicBezier"}, "title": "\n        \u003cdiv style=\u0027font-family: Inter, sans-serif; max-width: 300px;\u0027\u003e\n            \u003cdiv style=\u0027font-size: 16px; font-weight: 600; margin-bottom: 4px; color: #8ab4f8;\u0027\u003e\n                MEMBER_OF\n            \u003c/div\u003e\n            \u003cdiv style=\u0027font-size: 12px; color: #9aa0a6; margin-bottom: 8px;\u0027\u003e\n                Feyd-Rautha \u2192 Vladimir Harkonnen\n            \u003c/div\u003e\n            \u003cdiv style=\u0027font-size: 11px; color: #e8eaed; margin-bottom: 8px;\u0027\u003e\n                Confidence: \u003cspan style=\u0027color: #8ab4f8;\u0027\u003e0.80\u003c/span\u003e\n            \u003c/div\u003e\n        \n            \u003cdiv style=\u0027padding-top: 8px; border-top: 1px solid #3c4043;\u0027\u003e\n                \u003cdiv style=\u0027font-size: 10px; color: #9aa0a6; margin-bottom: 4px;\u0027\u003eEvidence:\u003c/div\u003e\n                \u003cdiv style=\u0027font-size: 11px; color: #e8eaed; font-style: italic;\u0027\u003e\n                    \"At the Baron\u0027s elbow walked Feyd-Rautha.\"\n                \u003c/div\u003e\n            \u003c/div\u003e\n            \u003c/div\u003e", "to": "Vladimir Harkonnen", "width": 3.3000000000000003}, {"arrows": {"to": {"enabled": true, "scaleFactor": 0.5}}, "color": {"color": "#81c995", "opacity": 0.9400000000000001}, "dashes": false, "from": "Feyd-Rautha", "label": "FAMILY_OF", "smooth": {"type": "cubicBezier"}, "title": "\n        \u003cdiv style=\u0027font-family: Inter, sans-serif; max-width: 300px;\u0027\u003e\n            \u003cdiv style=\u0027font-size: 16px; font-weight: 600; margin-bottom: 4px; color: #81c995;\u0027\u003e\n                FAMILY_OF\n            \u003c/div\u003e\n            \u003cdiv style=\u0027font-size: 12px; color: #9aa0a6; margin-bottom: 8px;\u0027\u003e\n                Feyd-Rautha \u2192 Vladimir Harkonnen\n            \u003c/div\u003e\n            \u003cdiv style=\u0027font-size: 11px; color: #e8eaed; margin-bottom: 8px;\u0027\u003e\n                Confidence: \u003cspan style=\u0027color: #81c995;\u0027\u003e0.90\u003c/span\u003e\n            \u003c/div\u003e\n        \n            \u003cdiv style=\u0027padding-top: 8px; border-top: 1px solid #3c4043;\u0027\u003e\n                \u003cdiv style=\u0027font-size: 10px; color: #9aa0a6; margin-bottom: 4px;\u0027\u003eEvidence:\u003c/div\u003e\n                \u003cdiv style=\u0027font-size: 11px; color: #e8eaed; font-style: italic;\u0027\u003e\n                    \"Title passed briefly to the na-Baron, Feyd-Rautha Harkonnen.\"\n                \u003c/div\u003e\n            \u003c/div\u003e\n            \u003c/div\u003e", "to": "Vladimir Harkonnen", "width": 3.65}, {"arrows": {"to": {"enabled": true, "scaleFactor": 0.5}}, "color": {"color": "#8ab4f8", "opacity": 0.9400000000000001}, "dashes": false, "from": "Feyd-Rautha", "label": "MENTIONED_IN", "smooth": {"type": "cubicBezier"}, "title": "\n        \u003cdiv style=\u0027font-family: Inter, sans-serif; max-width: 300px;\u0027\u003e\n            \u003cdiv style=\u0027font-size: 16px; font-weight: 600; margin-bottom: 4px; color: #8ab4f8;\u0027\u003e\n                MENTIONED_IN\n            \u003c/div\u003e\n            \u003cdiv style=\u0027font-size: 12px; color: #9aa0a6; margin-bottom: 8px;\u0027\u003e\n                Feyd-Rautha \u2192 Baron\u0027s speech\n            \u003c/div\u003e\n            \u003cdiv style=\u0027font-size: 11px; color: #e8eaed; margin-bottom: 8px;\u0027\u003e\n                Confidence: \u003cspan style=\u0027color: #8ab4f8;\u0027\u003e0.90\u003c/span\u003e\n            \u003c/div\u003e\n        \n            \u003cdiv style=\u0027padding-top: 8px; border-top: 1px solid #3c4043;\u0027\u003e\n                \u003cdiv style=\u0027font-size: 10px; color: #9aa0a6; margin-bottom: 4px;\u0027\u003eEvidence:\u003c/div\u003e\n                \u003cdiv style=\u0027font-size: 11px; color: #e8eaed; font-style: italic;\u0027\u003e\n                    \"The Baron stopped in front of them, took Feyd-Rautha\u0027s arm in a possessive grip, said, \"My nephew, the na-Baron, Feyd-Rautha Harkonnen.\"\"\n                \u003c/div\u003e\n            \u003c/div\u003e\n            \u003c/div\u003e", "t