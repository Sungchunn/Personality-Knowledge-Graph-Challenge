  Confidence: \u003cspan style=\u0027color: #81c995;\u0027\u003e0.70\u003c/span\u003e\n            \u003c/div\u003e\n        \n            \u003cdiv style=\u0027padding-top: 8px; border-top: 1px solid #3c4043;\u0027\u003e\n                \u003cdiv style=\u0027font-size: 10px; color: #9aa0a6; margin-bottom: 4px;\u0027\u003eEvidence:\u003c/div\u003e\n                \u003cdiv style=\u0027font-size: 11px; color: #e8eaed; font-style: italic;\u0027\u003e\n                    \"a hardness in the expression that reminded Gurney of the Old Duke, Paul\u0027s grandfather.\"\n                \u003c/div\u003e\n            \u003c/div\u003e\n            \u003c/div\u003e", "to": "Duke Paulus Atreides", "width": 2.9499999999999997}, {"arrows": {"to": {"enabled": true, "scaleFactor": 0.5}}, "color": {"color": "#fdd663", "opacity": 0.88}, "dashes": false, "from": "Paul Atreides", "label": "LEADS", "smooth": {"type": "cubicBezier"}, "title": "\n        \u003cdiv style=\u0027font-family: Inter, sans-serif; max-width: 300px;\u0027\u003e\n            \u003cdiv style=\u0027font-size: 16px; font-weight: 600; margin-bottom: 4px; color: #fdd663;\u0027\u003e\n                LEADS\n            \u003c/div\u003e\n            \u003cdiv style=\u0027font-size: 12px; color: #9aa0a6; margin-bottom: 8px;\u0027\u003e\n                Paul Atreides \u2192 smuggler crew\n            \u003c/div\u003e\n            \u003cdiv style=\u0027font-size: 11px; color: #e8eaed; margin-bottom: 8px;\u0027\u003e\n                Confidence: \u003cspan style=\u0027color: #fdd663;\u0027\u003e0.80\u003c/span\u003e\n            \u003c/div\u003e\n        \n            \u003cdiv style=\u0027padding-top: 8px; border-top: 1px solid #3c4043;\u0027\u003e\n                \u003cdiv style=\u0027font-size: 10px; color: #9aa0a6; margin-bottom: 4px;\u0027\u003eEvidence:\u003c/div\u003e\n                \u003cdiv style=\u0027font-size: 11px; color: #e8eaed; font-style: italic;\u0027\u003e\n                    \"Paul\u0027s ordering the smuggler crew disarmed until they could be questioned.\"\n                \u003c/div\u003e\n            \u003c/div\u003e\n            \u003c/div\u003e", "to": "smuggler crew", "width": 3.3000000000000003}, {"arrows": {"to": {"enabled": true, "scaleFactor": 0.5}}, "color": {"color": "#81c995", "opacity": 0.9400000000000001}, "dashes": false, "from": "Paul Atreides", "label": "FAMILY_OF", "smooth": {"type": "cubicBezier"}, "title": "\n        \u003cdiv style=\u0027font-family: Inter, sans-serif; max-width: 300px;\u0027\u003e\n            \u003cdiv style=\u0027font-size: 16px; font-weight: 600; margin-bottom: 4px; color: #81c995;\u0027\u003e\n                FAMILY_OF\n            \u003c/div\u003e\n            \u003cdiv style=\u0027font-size: 12px; color: #9aa0a6; margin-bottom: 8px;\u0027\u003e\n                Paul Atreides \u2192 Duke of Arrakis\n            \u003c/div\u003e\n            \u003cdiv style=\u0027font-size: 11px; color: #e8eaed; margin-bottom: 8px;\u0027\u003e\n                Confidence: \u003cspan style=\u0027color: #81c995;\u0027\u003e0.90\u003c/span\u003e\n            \u003c/div\u003e\n        \n            \u003cdiv style=\u0027padding-top: 8px; border-top: 1px solid #3c4043;\u0027\u003e\n                \u003cdiv style=\u0027font-size: 10px; color: #9aa0a6; margin-bottom: 4px;\u0027\u003eEvidence:\u003c/div\u003e\n                \u003cdiv style=\u0027font-size: 11px; color: #e8eaed; font-style: italic;\u0027\u003e\n                    \"This is the rightful Duke of Arrakis. Do as he commands.\"\n                \u003c/div\u003e\n            \u003c/div\u003e\n            \u003c/div\u003e", "to": "Duke of Arrakis", "width": 3.65}, {"arrows": {"to": {"enabled": true, "scaleFactor": 0.5}}, "color": {"color": "#8ab4f8", "opacity": 0.9400000000000001}, "dashes": false, "from": "Paul Atreides", "label": "MENTIONED_IN", "smooth": {"type": "cubicBezier"}, "title": "\n        \u003cdiv style=\u0027font-family: Inter, sans-serif; max-width: 300px;\u0027\u003e\n            \u003cdiv style=\u0027font-size: 16px; font-weight: 600; margin-bottom: 4px; color: #8ab4f8;\u0027\u003e\n                MENTIONED_IN\n            \u003c/div\u003e\n            \u003cdiv style=\u0027font-size: 12px; color: #9aa0a6; margin-bottom: 8px;\u0027\u003e\n                Paul Atreides \u2192 desert power\n            \u003c/div\u003e\n            \u003cdiv style=\u0027font-size: 11px; color: #e8eaed; margin-bottom: 8px;\u0027\u003e\n                Confidence: \u003cspan style=\u0027color: #8ab4f8;\u0027\u003e0.90\u003c/span\u003e\n            \u003c/div\u003e\n        \n            \u003cdiv style=\u0027padding-top: 8px; border-top: 1px solid #3c4043;\u0027\u003e\n                \u003cdiv style=\u0027font-size: 10px; color: #9aa0a6; margin-bottom: 4px;\u0027\u003eEvidence:\u003c/div\u003e\n                \u003cdiv style=\u0027font-size: 11px; color: #e8eaed; font-style: italic;\u0027\u003e\n                    \"\"You heard my father speak of desert power,\" Paul said.\"\n                \u003c/div\u003e\n            \u003c/div\u003e\n            \u003c/div\u003e", "to": "desert power", "width": 3.65}, {"arrows": {"to": {"enabled": true, "scaleFactor": 0.5}}, "color": {"color": "#f28b82", "opacity": 0.9400000000000001}, "dashes": false, "from": "Paul Atreides", "label": "ENEMY_OF", "smooth": {"type": "cubicBezier"}, "title": "\n        \u003cdiv style=\u0027font-family: Inter, sans-serif; max-width: 300px;\u0027\u003e\n            \u003cdiv style=\u0027font-size: 16px; font-weight: 600; margin-bottom: 4px; color: #f28b82;\u0027\u003e\n                ENEMY_OF\n            \u003c/div\u003e\n            \u003cdiv style=\u0027font-size: 12px; color: #9aa0a6; margin-bottom: 8px;\u0027\u003e\n                Paul Atreides \u2192 Rabban\n            \u003c/div\u003e\n            \u003cdiv style=\u0027font-size: 11px; color: #e8eaed; margin-bottom: 8px;\u0027\u003e\n                Confidence: \u003cspan style=\u0027color: #f28b82;\u0027\u003e0.90\u003c/span\u003e\n            \u003c/div\u003e\n        \n            \u003cdiv style=\u0027padding-top: 8px; border-top: 1px solid #3c4043;\u0027\u003e\n                \u003cdiv style=\u0027font-size: 10px; color: #9aa0a6; margin-bottom: 4px;\u0027\u003eEvidence:\u003c/div\u003e\n                \u003cdiv style=\u0027font-size: 11px; color: #e8eaed; font-style: italic;\u0027\u003e\n                    \"\"Our enemy is exactly where I want him to be,\" Paul said.\"\n                \u003c/div\u003e\n            \u003c/div\u003e\n            \u003c/div\u003e", "to": "Rabban", "width": 3.65}, {"arrows": {"to": {"enabled": true, "scaleFactor": 0.5}}, "color": {"color": "#8ab4f8", "opacity": 0.9400000000000001}, "dashes": false, "from": "Paul Atreides", "label": "MENTIONED_IN", "smooth": {"type": "cubicBezier"}, "title": "\n        \u003cdiv style=\u0027font-family: Inter, sans-serif; max-width: 300px;\u0027\u003e\n            \u003cdiv style=\u0027font-size: 16px; font-weight: 600; margin-bottom: 4px; color: #8ab4f8;\u0027\u003e\n                MENTIONED_IN\n            \u003c/div\u003e\n            \u003cdiv style=\u0027font-size: 12px; color: #9aa0a6; margin-bottom: 8px;\u0027\u003e\n                Paul Atreides \u2192 will-o\u0027-the-sand\n            \u003c/div\u003e\n            \u003cdiv style=\u0027font-size: 11px; color: #e8eaed; margin-bottom: 8px;\u0027\u003e\n                Confidence: \u003cspan style=\u0027color: #8ab4f8;\u0027\u003e0.90\u003c/span\u003e\n            \u003c/div\u003e\n        \n            \u003cdiv style=\u0027padding-top: 8px; border-top: 1px solid #3c4043;\u0027\u003e\n                \u003cdiv style=\u0027font-size: 10px; color: #9aa0a6; margin-bottom: 4px;\u0027\u003eEvidence:\u003c/div\u003e\n                \u003cdiv style=\u0027font-size: 11px; color: #e8eaed; font-style: italic;\u0027\u003e\n                    \"\"You\u0027re the will-o\u0027-the-sand?\"\"\n                \u003c/div\u003e\n            \u003c/div\u00